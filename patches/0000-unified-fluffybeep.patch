+Future<void> syncAndroidNotificationChannels({
+  required Client client,
+  required FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin,
+  L10n? l10n,
+}) async {
+  if (!PlatformInfos.isAndroid) return;
+  final store = await AppSettings.init();
+  final beeperLabels = BeeperBridgeUtils.getBeeperLabels(client);
+
+  final androidPlugin = flutterLocalNotificationsPlugin
+      .resolvePlatformSpecificImplementation<
+        AndroidFlutterLocalNotificationsPlugin
+      >();
+  if (androidPlugin == null) return;
+
+  // 1. Pre-create channels for all custom Beeper labels
+  for (final entry in beeperLabels.entries) {
+    if (entry.key == '_hidden_networks') continue;
+    final val = entry.value;
+    if (val is Map) {
+      final labelId = entry.key;
+      final labelName = (val['title'] ?? val['name']) as String?;
+      if (labelName == null || labelName.isEmpty) continue;
+
+      final sound = store.getString('beeper_sound_$labelId');
+      final targetSound = (sound != null && sound != 'default') ? sound : null;
+      final channelIdBase = 'chan_$labelId';
+      final channelId = targetSound != null ? '${channelIdBase}_$targetSound' : channelIdBase;
+
+      final channel = AndroidNotificationChannel(
+        channelId,
+        labelName,
+        sound: targetSound != null ? RawResourceAndroidNotificationSound(targetSound) : null,
+        playSound: true,
+        importance: Importance.high,
+      );
+
+      await androidPlugin.createNotificationChannel(channel);
+    }
+  }
+
+  // 2. Pre-create channels for network bridges
+  for (final netKey in BeeperBridgeUtils.networkMap.keys) {
+    final baseKey = BeeperBridgeUtils.getBaseNetworkKey(netKey);
+    final spec = BeeperBridgeUtils.networkMap[baseKey];
+    final netName = spec?.name ?? baseKey;
+
+    final sound = store.getString('beeper_sound_$baseKey');
+    final targetSound = (sound != null && sound != 'default') ? sound : null;
+    final channelIdBase = 'chan_$baseKey';
+    final channelId = targetSound != null ? '${channelIdBase}_$targetSound' : channelIdBase;
+
+    final channel = AndroidNotificationChannel(
+      channelId,
+      netName,
+      sound: targetSound != null ? RawResourceAndroidNotificationSound(targetSound) : null,
+      playSound: true,
+      importance: Importance.high,
+    );
+
+    await androidPlugin.createNotificationChannel(channel);
+  }
+
+  // 3. Pre-create default fallback channels
+  final defaultDirectChannel = AndroidNotificationChannel(
+    'chan_direct',
+    l10n?.directChats ?? 'Chat directo',
+    importance: Importance.high,
+  );
+  final defaultGroupChannel = AndroidNotificationChannel(
+    'chan_group',
+    l10n?.groups ?? 'Grupos',
+    importance: Importance.high,
+  );
+  await androidPlugin.createNotificationChannel(defaultDirectChannel);
+  await androidPlugin.createNotificationChannel(defaultGroupChannel);
+}
+
+class FluffyChatPushPayload {
+  final String? clientName, roomId, eventId;
+  final bool isWhatsAppCall;
+
+  FluffyChatPushPayload(
+    this.clientName,
+    this.roomId,
+    this.eventId, {
+    this.isWhatsAppCall = false,
+  });
+
+  factory FluffyChatPushPayload.fromString(String payload) {
+    final parts = payload.split('|');
+    if (parts.length < 3) {
+      return FluffyChatPushPayload(null, null, null);
+    }
+    final isWhatsAppCall = parts.length >= 4 && parts[3] == '1';
+    return FluffyChatPushPayload(
+      parts.first,
+      parts[1],
+      parts[2],
+      isWhatsAppCall: isWhatsAppCall,
+    );
+  }
+
+  @override
+  String toString() => '$clientName|$roomId|$eventId|${isWhatsAppCall ? 1 : 0}';
+}
+
+/// Creates a shortcut for Android platform but does not block displaying the
+/// notification. This is optional but provides a nicer view of the
+/// notification popup.
+Future<void> _setShortcut(
+  Event event,
+  L10n l10n,
+  String title,
+  Uint8List? avatarFile,
+) async {
+  final flutterShortcuts = FlutterShortcuts();
+  await flutterShortcuts.initialize(debug: !kReleaseMode);
+  await flutterShortcuts.pushShortcutItem(
+    shortcut: ShortcutItem(
+      id: event.room.id,
+      action: AppConfig.inviteLinkPrefix + event.room.id,
+      shortLabel: title,
+      conversationShortcut: true,
+      icon: avatarFile == null ? null : base64Encode(avatarFile),
+      shortcutIconAsset: avatarFile == null
+          ? ShortcutIconAsset.androidAsset
+          : ShortcutIconAsset.memoryAsset,
+      isImportant: event.room.isFavourite,
+    ),
+  );
+}
+
+extension on Client {
+  Future<Uint8List?> tryDownloadNotificationAvatar(Uri? avatar) async {
+    if (avatar == null) return null;
+    try {
+      return await downloadMxcCached(
+        avatar,
+        thumbnailMethod: ThumbnailMethod.crop,
+        width: notificationAvatarDimension,
+        height: notificationAvatarDimension,
+        animated: false,
+        isThumbnail: true,
+        rounded: true,
+      ).timeout(const Duration(seconds: 3));
+    } catch (e, s) {
+      Logs().e('Unable to get avatar picture', e, s);
+      return null;
+    }
+  }
+}
