diff --git a/lib/widgets/cache_refresh_overlay.dart b/lib/widgets/cache_refresh_overlay.dart
new file mode 100644
index 0000000..feac688
--- /dev/null
+++ b/lib/widgets/cache_refresh_overlay.dart
@@ -0,0 +1,239 @@
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/beeper_bridge_utils.dart';
+import 'package:fluffychat/utils/client_download_content_extension.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:wakelock_plus/wakelock_plus.dart';
+
+class CacheRefreshOverlay extends StatefulWidget {
+  final Client client;
+  final SharedPreferences store;
+  final Widget child;
+  final VoidCallback? onCompleted;
+
+  const CacheRefreshOverlay({
+    required this.client,
+    required this.store,
+    required this.child,
+    this.onCompleted,
+    super.key,
+  });
+
+  @override
+  State<CacheRefreshOverlay> createState() => _CacheRefreshOverlayState();
+}
+
+class _CacheRefreshOverlayState extends State<CacheRefreshOverlay> {
+  bool _completed = false;
+  bool _fullscreenDismissed = false;
+  int _processedRooms = 0;
+  int _totalRooms = 0;
+  String _currentRoomName = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _startPrewarming();
+  }
+
+  Future<void> _startPrewarming() async {
+    try {
+      // 1. Wait for the initial sync to finish
+      await widget.client.onSync.stream.firstWhere(
+        (s) => widget.client.prevBatch != null,
+      );
+
+      // 2. Fetch and sort rooms by last message (latest first)
+      final rooms = List<Room>.from(widget.client.rooms);
+      rooms.sort((a, b) {
+        final aTime = a.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        final bTime = b.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        return bTime.compareTo(aTime);
+      });
+
+      if (mounted) {
+        setState(() {
+          _totalRooms = rooms.length;
+        });
+      }
+
+      final locals = MatrixLocals(L10n.of(context));
+      final throttleTimer = Stopwatch()..start();
+
+      // 3. Process rooms in parallel batches of 5
+      const batchSize = 5;
+      for (var i = 0; i < rooms.length; i += batchSize) {
+        if (!mounted) break;
+        final batch = rooms.sublist(i, (i + batchSize).clamp(0, rooms.length));
+        
+        await Future.wait(batch.map((room) async {
+          try {
+            final roomName = room.getBeeperDisplayname(locals);
+            if (mounted && throttleTimer.elapsedMilliseconds > 100) {
+              throttleTimer.reset();
+              setState(() {
+                _currentRoomName = roomName;
+                _processedRooms = i; // Approximate since it's concurrent
+              });
+            }
+            await room.getTimeline().then((t) => t.requestHistory(historyCount: 30));
+            if (room.beeperAvatarUrl != null) {
+              await widget.client.downloadMxcCached(room.beeperAvatarUrl!);
+            }
+          } catch (_) {}
+        }));
+
+        _processedRooms = i + batch.length;
+        if (mounted && (throttleTimer.elapsedMilliseconds > 100 || i + batchSize >= rooms.length)) {
+          throttleTimer.reset();
+          setState(() {});
+        }
+
+        // Once we process at least 30 rooms (or all of them if less),
+        // dismiss the fullscreen overlay and enable the wakelock to prevent suspension.
+        if (!_fullscreenDismissed && (_processedRooms >= 30 || _processedRooms >= rooms.length)) {
+          WakelockPlus.enable().catchError((_) {});
+          if (mounted) {
+            setState(() {
+              _fullscreenDismissed = true;
+            });
+          }
+        }
+      }
+    } catch (e) {
+      debugPrint('Error during prewarming cache: $e');
+    } finally {
+      WakelockPlus.disable().catchError((_) {});
+      if (mounted) {
+        final prefs = await SharedPreferences.getInstance();
+        await prefs.setBool('beeper_needs_cache_refresh', false);
+        setState(() {
+          _completed = true;
+        });
+        widget.onCompleted?.call();
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Stack(
+      children: [
+        // Always build the main app child first in the background
+        widget.child,
+
+        // If not completed and fullscreen not dismissed, display the progress overlay on top
+        if (!_completed && !_fullscreenDismissed)
+          Positioned.fill(
+            child: Scaffold(
+              backgroundColor: Colors.black.withOpacity(0.9),
+              body: Center(
+                child: Padding(
+                  padding: const EdgeInsets.symmetric(horizontal: 32.0),
+                  child: Column(
+                    mainAxisAlignment: MainAxisAlignment.center,
+                    children: [
+                      const CircularProgressIndicator(
+                        valueColor: AlwaysStoppedAnimation<Color>(Colors.white),
+                        strokeWidth: 3,
+                      ),
+                      const SizedBox(height: 32),
+                      const Text(
+                        'Sincronizando chats...',
+                        style: TextStyle(
+                          color: Colors.white,
+                          fontSize: 20,
+                          fontWeight: FontWeight.bold,
+                        ),
+                      ),
+                      const SizedBox(height: 12),
+                      Text(
+                        _totalRooms > 0
+                            ? 'Procesando $_processedRooms de $_totalRooms'
+                            : 'Iniciando conexión...',
+                        style: TextStyle(
+                          color: Colors.white.withOpacity(0.7),
+                          fontSize: 14,
+                        ),
+                      ),
+                      if (_currentRoomName.isNotEmpty) ...[
+                        const SizedBox(height: 16),
+                        Text(
+                          _currentRoomName,
+                          style: TextStyle(
+                            color: Colors.white.withOpacity(0.5),
+                            fontSize: 12,
+                            fontStyle: FontStyle.italic,
+                          ),
+                          textAlign: TextAlign.center,
+                          maxLines: 1,
