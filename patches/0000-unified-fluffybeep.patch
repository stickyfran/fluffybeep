+class PresenceManager {
+  static final Map<String, ValueNotifier<CachedPresence?>> notifiers = {};
+  static StreamSubscription? _globalSub;
+  static final Map<String, DateTime> _lastFetch = {};
+
+  /// Max simultaneous presence HTTP requests. Prevents cascading network
+  /// calls when the 5-minute cooldown expires for many users at once
+  /// (e.g. opening the chat list with 50+ DM rooms).
+  static int _inflight = 0;
+  static const int _maxInflight = 3;
+
+  static ValueNotifier<CachedPresence?> getNotifier(Client client, String userId) {
+    if (_globalSub == null) {
+      _globalSub = client.onPresenceChanged.stream.listen((presence) {
+        if (notifiers.containsKey(presence.userid)) {
+          notifiers[presence.userid!]!.value = presence;
+        }
+      });
+    }
+    if (!notifiers.containsKey(userId)) {
+      if (notifiers.length >= 300) {
+        final oldestKey = notifiers.keys.first;
+        notifiers.remove(oldestKey)?.dispose();
+        _lastFetch.remove(oldestKey);
+      }
+      notifiers[userId] = ValueNotifier(null);
+    }
+
+    final last = _lastFetch[userId];
+    if (last == null || DateTime.now().difference(last).inMinutes > 5) {
+      // Only proceed if below the concurrency cap
+      if (_inflight < _maxInflight) {
+        _lastFetch[userId] = DateTime.now();
+        _inflight++;
+        client.fetchCurrentPresence(userId).then((presence) {
+          if (notifiers.containsKey(userId)) {
+            notifiers[userId]!.value = presence;
+          }
+        }).catchError((_) {}).whenComplete(() => _inflight--);
+      }
+      // If at cap, skip this fetch — the cooldown will be retried next time
+      // getNotifier is called (e.g. next scroll event).
+    }
+
+    return notifiers[userId]!;
+  }
+
+  /// Cancel the global presence stream subscription. Should be called when
+  /// the client logs out to prevent a retained static subscription.
+  static void dispose() {
+    _globalSub?.cancel();
+    _globalSub = null;
+    for (final notifier in notifiers.values) {
+      notifier.dispose();
+    }
+    notifiers.clear();
+    _lastFetch.clear();
+    _inflight = 0;
+  }
+}
