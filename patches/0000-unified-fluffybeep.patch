+import 'dart:io';
+import 'dart:isolate';
+import 'dart:typed_data';
+
+import 'package:matrix/matrix.dart';
+import 'package:sqflite_common/sqflite.dart';
+
+/// FluffyBeep custom extension of [MatrixSdkDatabase] that optimizes
+/// file cache management to prevent Main Thread / Event Loop starvation.
+///
+/// Features:
+/// 1. Runs cache cleanup in a background [Isolate] so file I/O never freezes the UI.
+/// 2. Throttles `deleteOldFiles` to run at most once every 12 hours (since Matrix SDK
+///    triggers it on every single sync cycle).
+/// 3. Prevents overlapping concurrent cleanup runs via lock flag.
+/// 4. Catches and suppresses [PathNotFoundException] and [FileSystemException] safely.
+/// 5. Provides cooperative yielding (`Future.delayed(Duration.zero)`) fallback
+///    if background isolates fail or are unsupported.
+class FluffyMatrixSdkDatabase extends MatrixSdkDatabase {
+  bool _isDeletingOldFiles = false;
+  DateTime? _lastCleanupTime;
+  static const Duration _minCleanupInterval = Duration(hours: 12);
+
+  FluffyMatrixSdkDatabase.buildWithoutOpen(
+    super.name, {
+    super.database,
+    super.idbFactory,
+    super.sqfliteFactory,
+    super.maxFileSize = 0,
+    super.fileStorageLocation,
+    super.deleteFilesAfterDuration,
+  }) : super.buildWithoutOpen();
+
+  static Future<FluffyMatrixSdkDatabase> init(
+    String name, {
+    Database? database,
+    dynamic idbFactory,
+    DatabaseFactory? sqfliteFactory,
+    int maxFileSize = 0,
+    Uri? fileStorageLocation,
+    Duration? deleteFilesAfterDuration,
+  }) async {
+    final matrixSdkDatabase = FluffyMatrixSdkDatabase.buildWithoutOpen(
+      name,
+      database: database,
+      idbFactory: idbFactory,
+      sqfliteFactory: sqfliteFactory,
+      maxFileSize: maxFileSize,
+      fileStorageLocation: fileStorageLocation,
+      deleteFilesAfterDuration: deleteFilesAfterDuration,
+    );
+    await matrixSdkDatabase.open();
+    return matrixSdkDatabase;
+  }
+
+  @override
+  Future<void> deleteOldFiles(int savedAt) async {
+    final dirUri = fileStorageLocation;
+    final deleteDuration = deleteFilesAfterDuration;
+    if (!supportsFileStoring || dirUri == null || deleteDuration == null) {
+      return;
+    }
+
+    // 1. Concurrency Guard: Prevent overlapping cleanups from multiple sync cycles
+    if (_isDeletingOldFiles) return;
+
+    // 2. Throttling Guard: Matrix SDK triggers deleteOldFiles after every sync cycle.
+    // Cache pruning of files older than 30 days should only run once every 12 hours.
+    final now = DateTime.now();
+    if (_lastCleanupTime != null &&
+        now.difference(_lastCleanupTime!) < _minCleanupInterval) {
+      return;
+    }
+
+    _isDeletingOldFiles = true;
+    _lastCleanupTime = now;
+
+    try {
+      final dirPath = Directory.fromUri(dirUri).path;
+      final maxAgeMillis = deleteDuration.inMilliseconds;
+
+      // 3. Offload all heavy file system operations to a background Isolate
+      try {
+        final deleted = await Isolate.run(
+          () => _isolateDeleteOldFiles(dirPath, maxAgeMillis),
+        );
+        if (deleted > 0) {
+          Logs().i(
+            '[DatabaseFileStorage] Purged $deleted expired cache files in background isolate',
+          );
+        }
+      } catch (isolateError) {
+        Logs().w(
+          '[DatabaseFileStorage] Background isolate failed ($isolateError), falling back to cooperative cleanup',
+        );
+        await _deleteOldFilesCooperative(dirPath, maxAgeMillis);
+      }
+    } catch (e, s) {
+      Logs().w('[DatabaseFileStorage] Error during deleteOldFiles', e, s);
+    } finally {
+      _isDeletingOldFiles = false;
+    }
+  }
+
+  /// Synchronous I/O executed inside a background Isolate.
+  /// Does not touch or block the Flutter UI Isolate Event Loop.
+  static int _isolateDeleteOldFiles(String dirPath, int maxAgeMillis) {
+    final dir = Directory(dirPath);
+    if (!dir.existsSync()) return 0;
+
+    final now = DateTime.now().millisecondsSinceEpoch;
+    int deletedCount = 0;
+
+    try {
+      final entities = dir.listSync(followLinks: false);
+      for (final entity in entities) {
+        if (entity is! File) continue;
+        try {
+          final stat = entity.statSync();
+          final ageMillis = now - stat.modified.millisecondsSinceEpoch;
+          if (ageMillis > maxAgeMillis) {
+            try {
+              entity.deleteSync();
+              deletedCount++;
+            } on PathNotFoundException {
+              // File was already deleted or moved; safe to ignore
+            } on FileSystemException {
+              // File is locked, busy, or permission denied; safely ignore
+            } catch (_) {}
+          }
+        } on PathNotFoundException {
+          // File missing during stat check; safely ignore
+        } on FileSystemException {
+          // Stat failed; safely ignore
+        } catch (_) {}
+      }
+    } catch (_) {
+      // Directory listing failed; safely ignore
+    }
+    return deletedCount;
+  }
+
+  /// Cooperative async cleanup with event-loop yielding.
+  /// Yields execution every 20 files to prevent starving UI frames or MethodChannels.
+  Future<void> _deleteOldFilesCooperative(
+    String dirPath,
+    int maxAgeMillis,
+  ) async {
+    final dir = Directory(dirPath);
+    if (!await dir.exists()) return;
+
+    final now = DateTime.now().millisecondsSinceEpoch;
+    int processedCount = 0;
+    int deletedCount = 0;
+
+    try {
+      await for (final entity in dir.list(followLinks: false)) {
+        if (entity is! File) continue;
+
+        processedCount++;
+        // Yield to the Flutter Event Loop every 20 files
+        if (processedCount % 20 == 0) {
+          await Future.delayed(Duration.zero);
+        }
+
+        try {
+          final stat = await entity.stat();
+          final ageMillis = now - stat.modified.millisecondsSinceEpoch;
+          if (ageMillis > maxAgeMillis) {
+            try {
+              await entity.delete();
+              deletedCount++;
+            } on PathNotFoundException {
+              // Safe silent ignore
+            } on FileSystemException {
+              // Safe silent ignore
+            } catch (_) {}
+          }
+        } on PathNotFoundException {
+          // Safe silent ignore
+        } on FileSystemException {
+          // Safe silent ignore
+        } catch (_) {}
+      }
+      if (deletedCount > 0) {
+        Logs().i(
+          '[DatabaseFileStorage] Purged $deletedCount expired cache files cooperatively',
+        );
+      }
+    } catch (e) {
+      Logs().w('[DatabaseFileStorage] Error during cooperative cleanup: $e');
+    }
+  }
+
+  @override
+  Future<bool> deleteFile(Uri mxcUri) async {
+    try {
+      return await super.deleteFile(mxcUri);
+    } on PathNotFoundException {
+      return false;
+    } on FileSystemException {
+      return false;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  @override
+  Future<Uint8List?> getFile(Uri mxcUri) async {
+    try {
+      return await super.getFile(mxcUri);
+    } on FileSystemException catch (e) {
+      Logs().w('[DatabaseFileStorage] Failed to read cache file for $mxcUri: $e');
+      return null;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  @override
+  Future<void> storeFile(Uri mxcUri, Uint8List bytes, int time) async {
+    try {
+      await super.storeFile(mxcUri, bytes, time);
+    } on FileSystemException catch (e) {
+      Logs().w('[DatabaseFileStorage] Failed to store cache file for $mxcUri: $e');
+    } catch (_) {}
+  }
+}
