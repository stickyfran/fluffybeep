+
+class SpacesNavigationRail extends StatefulWidget {
+  final String? activeSpaceId;
+  final void Function() onGoToChats;
+  final void Function(String) onGoToSpaceId;
+
+  const SpacesNavigationRail({
+    required this.activeSpaceId,
+    required this.onGoToChats,
+    required this.onGoToSpaceId,
+    super.key,
+  });
+
+  @override
+  State<SpacesNavigationRail> createState() => _SpacesNavigationRailState();
+}
+
+class _SpacesNavigationRailState extends State<SpacesNavigationRail> {
+  List<_CombinedRailItem>? _cachedCombinedItems;
+  List<BeeperNetwork>? _cachedVisibleNetworks;
+  String _lastCombinedHash = '';
+
+  void _showNetworkMenu(
+    BuildContext context,
+    BeeperNetwork net,
+    List<BeeperNetwork> allNets,
+    SharedPreferences store,
+  ) {
+    final client = Matrix.of(context).client;
+    showModalBottomSheet(
+      context: context,
+      builder: (context) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ListTile(
+              leading: const Icon(Icons.visibility_off_outlined),
+              title: Text('Ocultar ${net.name} del menú'),
+              onTap: () async {
+                final navigator = Navigator.of(context);
+                final hidden = BeeperBridgeUtils.getHiddenNetworks(client);
+                if (!hidden.contains(net.key)) {
+                  final newHidden = List<String>.from(hidden)..add(net.key);
+                  await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                }
+                navigator.pop();
+                setState(() {});
+              },
+            ),
+            ListTile(
+              leading: Icon(
+                BeeperBridgeUtils.isNetworkContained(client, net.key, net.name)
+                    ? Icons.inbox_outlined
+                    : Icons.inbox,
+              ),
+              title: Text(
+                BeeperBridgeUtils.isNetworkContained(client, net.key, net.name)
+                    ? 'Mostrar en listado principal'
+                    : 'Contener chats solo aquí',
+              ),
+              onTap: () async {
+                final navigator = Navigator.of(context);
+                final isContained = BeeperBridgeUtils.isNetworkContained(client, net.key, net.name);
+                await BeeperBridgeUtils.setNetworkContained(client, net.key, net.name, !isContained);
+                navigator.pop();
+                setState(() {});
+              },
+            ),
+            ListTile(
+              leading: const Icon(Icons.arrow_upward_outlined),
+              title: const Text('Mover hacia arriba'),
+              onTap: () async {
+                final navigator = Navigator.of(context);
+                final order = List<String>.from(store.getStringList('beeper_networks_order') ?? allNets.map((n) => n.key).toList());
+                final idx = order.indexOf(net.key);
+                if (idx > 0) {
+                  final temp = order[idx];
+                  order[idx] = order[idx - 1];
+                  order[idx - 1] = temp;
+                  await store.setStringList('beeper_networks_order', order);
+                }
+                navigator.pop();
+                setState(() {});
+              },
+            ),
+            ListTile(
+              leading: const Icon(Icons.arrow_downward_outlined),
+              title: const Text('Mover hacia abajo'),
+              onTap: () async {
+                final navigator = Navigator.of(context);
+                final order = List<String>.from(store.getStringList('beeper_networks_order') ?? allNets.map((n) => n.key).toList());
+                final idx = order.indexOf(net.key);
+                if (idx != -1 && idx < order.length - 1) {
+                  final temp = order[idx];
+                  order[idx] = order[idx + 1];
+                  order[idx + 1] = temp;
+                  await store.setStringList('beeper_networks_order', order);
+                }
+                navigator.pop();
+                setState(() {});
+              },
+            ),
+            ListTile(
+              leading: const Icon(Icons.restore_outlined),
+              title: const Text('Gestionar redes ocultas'),
+              onTap: () {
+                Navigator.of(context).pop();
+                _showManageHiddenNetworksDialog(context, client);
+              },
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  void _showSpaceMenu(
+    BuildContext context,
+    Room space,
+    Client client,
+  ) {
+    final displayname = space.getLocalizedDisplayname(
+      MatrixLocals(L10n.of(context)),
+    );
+    showModalBottomSheet(
+      context: context,
+      builder: (context) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ListTile(
+              leading: const Icon(Icons.visibility_off_outlined),
+              title: Text('Ocultar $displayname del menú'),
+              onTap: () async {
+                final navigator = Navigator.of(context);
+                final hidden = BeeperBridgeUtils.getHiddenNetworks(client);
+                if (!hidden.contains(space.id)) {
+                  final newHidden = List<String>.from(hidden)..add(space.id);
+                  await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                }
+                navigator.pop();
+                setState(() {});
+              },
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  void _showLabelMenu(
+    BuildContext context,
+    String uuid,
+    String title,
+    String? emoji,
+    Map labelData,
+    Client client,
+  ) {
+    showModalBottomSheet(
+      context: context,
+      builder: (context) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ListTile(
+              leading: const Icon(Icons.edit_outlined),
+              title: const Text('Editar etiqueta'),
+              onTap: () async {
+                Navigator.of(context).pop();
+                final edited = await showDialog<bool>(
+                  context: context,
+                  useRootNavigator: false,
+                  builder: (context) => LabelEditorDialog(
+                    labelUuid: uuid,
+                    initialTitle: title,
+                    initialEmoji: emoji,
+                    initialIsShownInInbox: labelData['isShownInInbox'] != false,
+                  ),
+                );
+                if (edited == true && mounted) {
+                  setState(() {});
+                }
+              },
+            ),
+            ListTile(
+              leading: const Icon(Icons.delete_outline, color: Colors.red),
+              title: const Text('Eliminar etiqueta', style: TextStyle(color: Colors.red)),
+              onTap: () async {
