+  static Set<String>? _cachedHiddenRoomIds;
+  static dynamic _lastLabelsAccountDataRef;
+
+  /// Cached set of room IDs hidden from inbox for O(1) checks.
+  static Set<String> getHiddenInboxRoomIds(Client client) {
+    final accountDataEvent = client.accountData['com.beeper.labels'];
+    final contentRef = accountDataEvent?.content;
+    if (_cachedHiddenRoomIds != null && _lastLabelsAccountDataRef == contentRef) {
+      return _cachedHiddenRoomIds!;
+    }
+    _lastLabelsAccountDataRef = contentRef;
+    final hiddenSet = <String>{};
+    final labels = getBeeperLabels(client);
+    for (final entry in labels.values) {
+      if (entry is Map && entry['isShownInInbox'] == false) {
+        final rooms = entry['rooms'];
+        if (rooms is List) {
+          for (final r in rooms) {
+            if (r is String) hiddenSet.add(r);
+          }
+        }
+      }
+    }
+    _cachedHiddenRoomIds = hiddenSet;
+    return hiddenSet;
+  }
+
+  static void invalidateHiddenInboxCache() {
+    _cachedHiddenRoomIds = null;
+    _lastLabelsAccountDataRef = null;
+  }
+
+  /// Check if a room is hidden from the main inbox due to a label with isShownInInbox = false.
+  static bool isRoomHiddenInInbox(Client client, String roomId) {
