+import 'dart:io';
+import 'dart:async';
+import 'package:path_provider/path_provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class FileLogger {
+  static String? _logFilePath;
+  static Future<void> _lock = Future.value();
+
+  static Future<String> _getLogFilePath() async {
+    if (_logFilePath != null) return _logFilePath!;
+    try {
+      final directory = await getApplicationDocumentsDirectory();
+      _logFilePath = '${directory.path}/fluffybeep_debug.txt';
+    } catch (e) {
+      // Fallback path in case path_provider is not fully initialized in background isolate
+      _logFilePath = '/sdcard/Download/fluffybeep_debug.txt';
+    }
+    return _logFilePath!;
+  }
+
+  static Future<void> log(String message) async {
+    // Check debugging flag first before acquiring lock or performing disk I/O.
+    // If SharedPreferences is not yet initialized or throws, we can print to stderr but bypass file I/O.
+    bool enabled = false;
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      enabled = prefs.getBool('beeper_debug_logging_enabled') ?? false;
+    } catch (_) {
+      // SharedPreferences might fail to init in some isolates
+    }
+
+    if (!enabled) {
+      // Print to stderr even if disabled on disk, or just ignore. The prompt says "El logger solo debe escribir si esta variable es true".
+      // We will only do print to stderr as a fallback or skip entirely. Let's print to stderr as per usual, but skip file write.
+      stderr.writeln('[${DateTime.now().toIso8601String()}] FileLogger (disabled): $message');
+      return;
+    }
+
+    final completer = Completer<void>();
+    final previousLock = _lock;
+    _lock = completer.future;
+
+    await previousLock;
+
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+      final raf = await file.open(mode: FileMode.writeOnlyAppend);
+      try {
+        await raf.lock(FileLock.blockingExclusive);
+        final timestamp = DateTime.now().toIso8601String();
+        await raf.writeString('[$timestamp] $message\n');
+        // Also print to stderr/stdout
+        stderr.writeln('[$timestamp] FileLogger: $message');
+      } finally {
+        try {
+          await raf.unlock();
+        } catch (_) {}
+        await raf.close();
+      }
+    } catch (e) {
+      // print to console if write fails
+      stderr.writeln('FileLogger write failed: $e');
+    } finally {
+      completer.complete();
+    }
+  }
+
+  static Future<int> getLogSize() async {
+    final completer = Completer<void>();
+    final previousLock = _lock;
+    _lock = completer.future;
+
+    await previousLock;
+
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+      if (await file.exists()) {
+        return await file.length();
+      }
+    } catch (_) {} finally {
+      completer.complete();
+    }
+    return 0;
+  }
+
+  static Future<void> clearLog() async {
+    final completer = Completer<void>();
+    final previousLock = _lock;
+    _lock = completer.future;
+
+    await previousLock;
+
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+      if (await file.exists()) {
+        await file.delete();
+      }
+    } catch (_) {} finally {
+      completer.complete();
+    }
+  }
+
+  static Future<String> getLogPath() async {
+    return await _getLogFilePath();
+  }
+}
