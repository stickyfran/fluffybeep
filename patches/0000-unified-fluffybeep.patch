+      if (index == null) {
+        throw Exception(
+          '⚠️ Found ${finder.evaluate().length} "$object" objects. Please specify an index!',
+        );
+      }
+      if (finder.evaluate().length <= index) {
+        throw Exception(
+          '⚠️ Found ${finder.evaluate().length} "$object" objects. So index $index does not exist!',
+        );
+      }
+      finder = finder.at(index);
+    }
+    return finder;
+  }
+
+  Future<void> tapOn(
