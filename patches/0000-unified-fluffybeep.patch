+  Future<void> _loadPushers(Client client) async {
+    if (_loadingPushers) return;
+    setState(() {
+      _loadingPushers = true;
+    });
+    try {
+      final pushers = await client.getPushers();
+      if (mounted) {
+        setState(() {
+          _pushers = pushers;
+          _loadingPushers = false;
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(() {
+          _loadingPushers = false;
+        });
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Error al cargar pushers: $e')),
+        );
+      }
+    }
+  }
+
+  List<BeeperNetwork>? _networksList;
+  List<String>? _tagsList;
+
+  void _computeNetworksAndTags(Client client) {
+    if (_networksList != null && _tagsList != null) return;
+    final beeperNetworks = <String, BeeperNetwork>{};
+    final customTags = <String>{};
+    for (final r in client.rooms) {
+      final net = BeeperBridgeUtils.getRoomNetwork(r);
+      if (net != null) {
+        beeperNetworks[net.key] = net;
+      }
+      for (final tag in r.tags.keys) {
+        if (tag.startsWith('u.')) {
+          customTags.add(tag);
+        }
+      }
+    }
+
+    _networksList = beeperNetworks.values.toList()
+      ..sort((a, b) => a.name.compareTo(b.name));
+    _tagsList = customTags.toList()..sort();
+  }
