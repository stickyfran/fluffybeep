+  DateTime _getMessageTimestamp(Room room) {
+    // 1. RAM: in-session cache (fastest)
+    final cached = BeeperBridgeUtils.getLastMessageTime(room.id);
+    if (cached != null) return cached;
+
+    // 2. SDK: evento ya cargado en memoria por Matrix
+    final event = room.lastEvent;
+    if (event != null) {
+      final type = event.type;
+      if (type == 'm.room.message' ||
+          type == 'm.room.encrypted' ||
+          type == 'm.sticker') {
+        BeeperBridgeUtils.setLastMessageTime(room.id, event.originServerTs);
+        // Persistir en disco para el próximo arranque
+        BeeperBridgeUtils.saveLastTimestamp(room.id, event.originServerTs.millisecondsSinceEpoch);
+        return event.originServerTs;
+      }
+    }
+
+    // 3. Disco: SharedPreferences — disponible instantáneamente al abrir la app,
+    //    antes de que Matrix lea su SQLite. Evita el "salto" del orden de la lista.
+    final cachedDiskTs = BeeperBridgeUtils.getCachedLastTimestamp(room.id);
+    if (cachedDiskTs != null) {
+      final ts = DateTime.fromMillisecondsSinceEpoch(cachedDiskTs);
+      BeeperBridgeUtils.setLastMessageTime(room.id, ts); // promover a RAM
+      _fetchLastMessageTimeAsync(room); // actualizar en segundo plano si cambio
+      return ts;
+    }
+
+    // 4. Último recurso: disparar búsqueda async en la DB de Matrix
+    _fetchLastMessageTimeAsync(room);
+    return room.latestEventReceivedTime;
+  }
+
+  void _fetchLastMessageTimeAsync(Room room) async {
+    try {
+      final events = await room.client.database.getEventList(room, limit: 30);
+      for (final ev in events) {
+        final t = ev.type;
+        if (t == 'm.room.message' || t == 'm.room.encrypted' || t == 'm.sticker') {
+          BeeperBridgeUtils.setLastMessageTime(room.id, ev.originServerTs);
+          BeeperBridgeUtils.saveLastTimestamp(room.id, ev.originServerTs.millisecondsSinceEpoch);
+          BeeperBridgeUtils.lastRealMessageCache[room.id] = ev;
+          if (mounted) setState(() {});
+          break;
+        }
+      }
+    } catch (_) {}
+  }
