+// SPDX-FileCopyrightText: 2026 Beeper / Fluffybeep Contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:io';
+import 'dart:typed_data';
+import 'package:flutter/foundation.dart';
+import 'package:matrix/matrix.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:video_compress/video_compress.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+
+/// Performance-optimized asynchronous thumbnail cache for video events.
+/// Provides instant in-memory (RAM) retrieval and persistent disk caching
+/// to prevent UI jank and eliminate blurry BlurHash placeholders for videos.
+class BeeperVideoThumbnailCache {
+  static final Map<String, Uint8List> _memoryCache = {};
+  static final Map<String, Future<Uint8List?>> _pendingTasks = {};
+  static String? _cacheDirPath;
+
+  /// Retrieves thumbnail bytes from memory or disk cache if available.
+  static Uint8List? getMemoryThumbnail(String key) {
+    return _memoryCache[key];
+  }
+
+  /// Ensures cache directory path is initialized.
+  static Future<String> _getCacheDir() async {
+    if (_cacheDirPath != null) return _cacheDirPath!;
+    final tempDir = await getTemporaryDirectory();
+    final dir = Directory('${tempDir.path}/beeper_video_thumbnails');
+    if (!await dir.exists()) {
+      await dir.create(recursive: true);
+    }
+    _cacheDirPath = dir.path;
+    return _cacheDirPath!;
+  }
+
+  /// Gets or generates high-quality thumbnail bytes for a video event.
+  static Future<Uint8List?> getOrGenerateThumbnail(Event event) async {
+    final key = event.transactionId ?? event.eventId;
+    if (key.isEmpty) return null;
+
+    // 1. Check memory RAM cache
+    if (_memoryCache.containsKey(key)) {
+      return _memoryCache[key];
+    }
+
+    // 2. Prevent duplicate concurrent extraction requests
+    if (_pendingTasks.containsKey(key)) {
+      return _pendingTasks[key];
+    }
+
+    final task = _loadOrGenerate(event, key);
+    _pendingTasks[key] = task;
+
+    try {
+      final result = await task;
+      if (result != null) {
+        _memoryCache[key] = result;
+      }
+      return result;
+    } finally {
+      _pendingTasks.remove(key);
+    }
+  }
+
+  static Future<Uint8List?> _loadOrGenerate(Event event, String key) async {
+    try {
+      final cacheDir = await _getCacheDir();
+      final fileKey = key.replaceAll(RegExp(r'[^\w\.-]'), '_');
+      final diskFile = File('$cacheDir/$fileKey.jpg');
+
+      // Check disk cache
+      if (await diskFile.exists()) {
+        final bytes = await diskFile.readAsBytes();
+        if (bytes.isNotEmpty) {
+          _memoryCache[key] = bytes;
+          return bytes;
+        }
+      }
+
+      // If matrix event thumbnail is available, download and cache it
+      if (event.hasThumbnail) {
+        try {
+          final thumbnailData = await event.downloadAndDecryptAttachment(
+            getThumbnail: true,
+          );
+          if (thumbnailData.bytes.isNotEmpty) {
+            await diskFile.writeAsBytes(thumbnailData.bytes);
+            _memoryCache[key] = thumbnailData.bytes;
+            return thumbnailData.bytes;
+          }
+        } catch (_) {}
+      }
+
+      // Otherwise, download full video attachment and generate frame thumbnail locally
+      final attachmentData = await event.downloadAndDecryptAttachment(
+        getThumbnail: false,
+      );
+
+      final tempVideoFile = File('$cacheDir/temp_$fileKey.mp4');
+      await tempVideoFile.writeAsBytes(attachmentData.bytes);
+
+      Uint8List? thumbBytes;
+      if (PlatformInfos.isMobile) {
+        thumbBytes = await VideoCompress.getByteThumbnail(tempVideoFile.path);
+      }
+
+      // Cleanup temp video file
+      if (await tempVideoFile.exists()) {
+        await tempVideoFile.delete();
+      }
+
+      if (thumbBytes != null && thumbBytes.isNotEmpty) {
+        await diskFile.writeAsBytes(thumbBytes);
+        _memoryCache[key] = thumbBytes;
+        return thumbBytes;
+      }
+    } catch (e) {
+      debugPrint('BeeperVideoThumbnailCache error for ${event.eventId}: $e');
+    }
+    return null;
+  }
+}
