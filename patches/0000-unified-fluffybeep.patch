+class _ChatAppBar extends StatefulWidget implements PreferredSizeWidget {
+  final ChatController controller;
+
+  const _ChatAppBar(this.controller);
+  static bool _isUiRelevantStateEvent(dynamic update) {
+    final type = update.state?.type;
+    return type == EventTypes.RoomName ||
+        type == EventTypes.RoomAvatar ||
+        type == EventTypes.RoomTopic ||
+        type == EventTypes.RoomPinnedEvents ||
+        type == EventTypes.RoomMember ||
+        type == EventTypes.RoomPowerLevels;
+  }
+
+  @override
+  Size get preferredSize {
+    var height = kToolbarHeight;
+    final activeThreadId = controller.activeThreadId;
+    if (activeThreadId != null) {
+      height += ChatAppBarListTile.fixedHeight;
+    }
+    if (controller.room.pinnedEventIds.isNotEmpty && activeThreadId == null) {
+      height += ChatAppBarListTile.fixedHeight;
+    }
+    if (controller.scrollUpBannerEventId != null && activeThreadId == null) {
+      height += ChatAppBarListTile.fixedHeight;
+    }
+    return Size.fromHeight(height);
+  }
+
+  @override
+  State<_ChatAppBar> createState() => _ChatAppBarState();
+}
