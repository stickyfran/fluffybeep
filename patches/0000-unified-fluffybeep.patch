new file mode 100644
index 0000000000000000000000000000000000000000..f23e48fe29044de44b4b54bc69f06c91c5e37223
--- /dev/null
+++ b/lib/utils/beeper_app_launcher.dart
@@ -0,0 +1,271 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:io';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:matrix/matrix.dart';
+import 'package:url_launcher/url_launcher.dart';
+import 'package:flutter_foreground_task/flutter_foreground_task.dart';
+import '../config/setting_keys.dart';
+import 'beeper_bridge_utils.dart';
+import 'beeper_merge_utils.dart';
+import 'beeper_phone_contacts.dart';
+
+class BeeperAppLauncher {
+  static const MethodChannel _channel = MethodChannel('chat.fluffy.fluffybeep/native_launcher');
+  static final Set<String> _callListenerClients = {};
+
+  /// Listens to live sync updates to detect incoming WhatsApp calls in foreground / active connection
+  static void startCallListener(Client client) {
+    if (_callListenerClients.contains(client.clientName)) return;
+    _callListenerClients.add(client.clientName);
+
+    client.onSync.stream.listen(
+      (syncUpdate) {
+        if (!AppSettings.autoOpenWhatsAppOnCall.value) return;
+        final rooms = syncUpdate.rooms?.join;
+        if (rooms == null) return;
+
+        for (final entry in rooms.entries) {
+          final roomId = entry.key;
+          final events = entry.value.timeline?.events;
+          if (events == null) continue;
+
+          for (final e in events) {
+            final body = (e.content['body'] is String) ? e.content['body'] as String : '';
+            if (body.contains('Incoming call. Use the WhatsApp app to answer.')) {
+              final ts = e.originServerTs;
+              if (DateTime.now().difference(ts).inSeconds.abs() < 45) {
+                launchWhatsAppApp();
+                break;
+              }
+            }
+          }
+        }
+      },
+      onError: (e, s) => Logs().w('BeeperAppLauncher: call listener error', e, s),
+      cancelOnError: false,
+    );
+  }
+
+  /// Robust extraction of WhatsApp phone number from a room (optionally checking merged sibling rooms)
+  static String? extractWhatsAppPhone(Room room, {bool checkSiblings = false}) {
+    // 1. Direct extraction from this room
+    final direct = BeeperBridgeUtils.extractWhatsAppPhone(room);
+    if (direct != null && direct.isNotEmpty) return direct;
+
+    if (checkSiblings) {
+      // 2. Check sibling rooms if merged
+      final siblings = BeeperMergeUtils.getSiblingRooms(room.id);
+      for (final s in siblings) {
+        if (s.id == room.id) continue;
+        final sPhone = BeeperBridgeUtils.extractWhatsAppPhone(s);
+        if (sPhone != null && sPhone.isNotEmpty) return sPhone;
+      }
+
+      // 3. Check matched phone contact
+      final mergeId = BeeperMergeUtils.getMergeIdForRoom(room.id);
+      if (mergeId != null) {
+        final mc = BeeperMergeUtils.getMergedContacts(room.client)[mergeId];
+        if (mc?.phoneContactId != null && BeeperPhoneContacts.isLoaded) {
+          final pc = BeeperPhoneContacts.findById(mc!.phoneContactId!);
+          if (pc != null && pc.normalizedPhones.isNotEmpty) {
+            final digits = pc.normalizedPhones.first.replaceAll(RegExp(r'\D'), '');
+            if (digits.isNotEmpty) return digits;
+          }
+        }
+      }
+    }
+
+    return null;
+  }
+
+  /// Robust extraction of Instagram user or numeric ID from a room (optionally checking merged sibling rooms)
+  static String? extractInstagramId(Room room, {bool checkSiblings = false}) {
+    // 1. Direct extraction from this room
+    final direct = BeeperBridgeUtils.extractInstagramDetails(room);
+    if (direct.username != null) return direct.username;
+    if (direct.numericId != null) return direct.numericId;
+
+    if (checkSiblings) {
+      // 2. Check sibling rooms if merged
+      final siblings = BeeperMergeUtils.getSiblingRooms(room.id);
+      for (final s in siblings) {
+        if (s.id == room.id) continue;
+        final sIg = BeeperBridgeUtils.extractInstagramDetails(s);
+        if (sIg.username != null) return sIg.username;
+        if (sIg.numericId != null) return sIg.numericId;
+      }
+    }
+
+    return null;
+  }
+
+  /// Open Instagram with custom package name support (e.g. com.instagram.android.piko)
+  static Future<bool> openInstagram({
+    String? userOrId,
+    Room? room,
+  }) async {
+    final targetId = userOrId ?? (room != null ? extractInstagramId(room) : null);
+    final packageName = AppSettings.instagramPackageName.value.trim();
+
+    if (Platform.isAndroid) {
+      try {
+        final res = await _channel.invokeMethod<bool>('openInstagram', {
+          'packageName': packageName.isNotEmpty ? packageName : 'com.instagram.android',
+          'userOrId': targetId,
+        });
+        if (res == true) return true;
+      } catch (_) {}
+    }
+
+    // Fallback using url_launcher
+    if (targetId != null && targetId.isNotEmpty) {
+      final isNumeric = RegExp(r'^\d+$').hasMatch(targetId);
+      final uri = Uri.parse(isNumeric ? 'instagram://user?user_id=$targetId' : 'https://instagram.com/$targetId');
+      try {
+        if (await launchUrl(uri, mode: LaunchMode.externalApplication)) return true;
+      } catch (_) {}
+      try {
+        return await launchUrl(Uri.parse('https://instagram.com/$targetId'), mode: LaunchMode.externalApplication);
+      } catch (_) {}
+    }
+
+    try {
+      return await launchUrl(Uri.parse('instagram://'), mode: LaunchMode.externalApplication);
+    } catch (_) {
+      return await launchUrl(Uri.parse('https://instagram.com'), mode: LaunchMode.externalApplication);
+    }
+  }
+
+  /// Open WhatsApp with custom package name support (e.g. com.whatsapp or com.whatsapp.w4b)
+  static Future<bool> openWhatsApp({
+    String? phone,
+    Room? room,
+  }) async {
+    final targetPhone = phone ?? (room != null ? extractWhatsAppPhone(room) : null);
+    final packageName = AppSettings.whatsappPackageName.value.trim();
+    final targetPackage = packageName.isNotEmpty ? packageName : 'com.whatsapp';
+
+    if (targetPhone == null || targetPhone.isEmpty) {
+      return await launchWhatsAppApp();
+    }
+
+    if (Platform.isAndroid) {
+      try {
+        final res = await _channel.invokeMethod<bool>('openWhatsApp', {
+          'packageName': targetPackage,
+          'phone': targetPhone,
+        });
+        if (res == true) return true;
+      } catch (_) {}
+    }
+
+    // Fallback using url_launcher
+    final clean = targetPhone.replaceAll(RegExp(r'\D'), '');
+    if (clean.isNotEmpty) {
+      try {
+        final uri = Uri.parse('whatsapp://send?phone=$clean');
+        if (await launchUrl(uri, mode: LaunchMode.externalApplication)) return true;
+      } catch (_) {}
+      try {
+        final waUri = Uri.parse('https://api.whatsapp.com/send?phone=$clean');
+        if (await launchUrl(waUri, mode: LaunchMode.externalApplication)) return true;
+      } catch (_) {}
+    }
+
+    return await launchWhatsAppApp();
+  }
+
+  /// Directly launches WhatsApp application process without any URI or redirecting to chat
+  static Future<bool> launchWhatsAppApp() async {
+    final packageName = AppSettings.whatsappPackageName.value.trim();
+    final targetPackage = packageName.isNotEmpty ? packageName : 'com.whatsapp';
+
+    if (Platform.isAndroid) {
+      try {
+        FlutterForegroundTask.wakeUpScreen();
+      } catch (_) {}
+      try {
+        final res = await _channel.invokeMethod<bool>('openWhatsApp', {
+          'packageName': targetPackage,
+          'onlyLaunchApp': true,
+        });
+        if (res == true) return true;
+      } catch (_) {}
+      try {
+        final res = await _channel.invokeMethod<bool>('launchApp', {
+          'packageName': targetPackage,
+        });
+        if (res == true) return true;
+      } catch (_) {}
+
+      // Try other common WhatsApp package candidates via native channel
+      for (final candidate in ['com.whatsapp', 'com.whatsapp.w4b', 'com.gbwhatsapp', 'com.yowhatsapp']) {
+        if (candidate == targetPackage) continue;
+        try {
+          final res = await _channel.invokeMethod<bool>('launchApp', {
+            'packageName': candidate,
+          });
+          if (res == true) return true;
+        } catch (_) {}
+      }
+    }
+
+    // Never fall back to generic whatsapp:// or https:// which triggers Android interceptors/choosers
+    return false;
+  }
+
+  /// Dial phone number via native Android dialer
+  static Future<bool> dialPhone({
+    String? phone,
+    Room? room,
+  }) async {
+    final targetPhone = phone ?? (room != null ? extractWhatsAppPhone(room) : null);
+    if (targetPhone == null || targetPhone.isEmpty) return false;
+
+    final cleanPhone = targetPhone.replaceAll(RegExp(r'\D'), '');
+    if (cleanPhone.isEmpty) return false;
+
+    if (Platform.isAndroid) {
+      try {
+        final res = await _channel.invokeMethod<bool>('dialPhone', {
+          'phone': cleanPhone,
+        });
+        if (res == true) return true;
+      } catch (_) {}
+    }
+
+    // Fallback using url_launcher tel scheme
+    final telUri = Uri.parse('tel:+$cleanPhone');
+    try {
+      return await launchUrl(telUri, mode: LaunchMode.externalApplication);
+    } catch (_) {
+      return false;
+    }
+  }
+
+  /// Checks if SYSTEM_ALERT_WINDOW ("Display over other apps") permission is granted on Android
+  static Future<bool> canDrawOverlays() async {
+    if (!Platform.isAndroid) return true;
+    try {
+      final res = await _channel.invokeMethod<bool>('canDrawOverlays');
+      return res ?? false;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  /// Opens the system settings screen to request SYSTEM_ALERT_WINDOW permission on Android
+  static Future<bool> requestOverlayPermission() async {
+    if (!Platform.isAndroid) return true;
+    try {
+      final res = await _channel.invokeMethod<bool>('requestOverlayPermission');
+      return res ?? false;
+    } catch (_) {
+      return false;
+    }
+  }
+}
