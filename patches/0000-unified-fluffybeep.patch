+object AudioRouteManager : SensorEventListener {
+    private const val AUDIO_CHANNEL = "chat.fluffy.fluffybeep/audio_router"
+    private var methodChannel: MethodChannel? = null
+    private var appContext: Context? = null
+    private var audioManager: AudioManager? = null
+    private var sensorManager: SensorManager? = null
+    private var proximitySensor: Sensor? = null
+    private var proximityWakeLock: PowerManager.WakeLock? = null
+
+    var currentActivity: Activity? = null
+    private var currentMode: String = "auto" // auto, speaker, earpiece
+    private var isSessionActive: Boolean = false
+    private var isNearEar: Boolean = false
+
+    fun setup(flutterEngine: FlutterEngine, context: Context) {
+        appContext = context.applicationContext
+        if (context is Activity) {
+            currentActivity = context
+        }
+        audioManager = appContext?.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        sensorManager = appContext?.getSystemService(Context.SENSOR_SERVICE) as? SensorManager
+        proximitySensor = sensorManager?.getDefaultSensor(Sensor.TYPE_PROXIMITY)
+
+        val powerManager = appContext?.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        if (powerManager != null && powerManager.isWakeLockLevelSupported(PowerManager.PROXIMITY_SCREEN_OFF_WAKE_LOCK)) {
+            try {
+                proximityWakeLock = powerManager.newWakeLock(
+                    PowerManager.PROXIMITY_SCREEN_OFF_WAKE_LOCK,
+                    "fluffybeep:proximity_screen_off"
+                )
+            } catch (_: Exception) {}
+        }
+
+        methodChannel = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, AUDIO_CHANNEL).apply {
+            setMethodCallHandler { call, result ->
+                when (call.method) {
+                    "startSession" -> {
+                        val mode = call.argument<String>("mode") ?: "auto"
+                        startSession(mode)
+                        result.success(true)
+                    }
+                    "stopSession" -> {
+                        stopSession()
+                        result.success(true)
+                    }
+                    "setOutputMode" -> {
+                        val mode = call.argument<String>("mode") ?: "auto"
+                        setOutputMode(mode)
+                        result.success(true)
+                    }
+                    "isNear" -> {
+                        result.success(isNearEar)
+                    }
+                    else -> result.notImplemented()
+                }
+            }
+        }
+    }
+
+    private fun startSession(mode: String) {
+        currentMode = mode
+        isSessionActive = true
+        applyRoutingForCurrentState()
+        registerProximityListener()
+    }
+
+    private fun setOutputMode(mode: String) {
+        currentMode = mode
+        if (isSessionActive) {
+            applyRoutingForCurrentState()
+        }
+    }
+
+    private fun stopSession() {
+        isSessionActive = false
+        unregisterProximityListener()
+        releaseWakeLock()
+
+        val am = audioManager ?: return
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                am.clearCommunicationDevice()
+            }
+            @Suppress("DEPRECATION")
+            am.isSpeakerphoneOn = false
+            am.mode = AudioManager.MODE_NORMAL
+            currentActivity?.volumeControlStream = AudioManager.USE_DEFAULT_STREAM_TYPE
+        } catch (_: Exception) {}
+    }
+
+    private fun applyRoutingForCurrentState() {
+        val am = audioManager ?: return
+        try {
+            val shouldRouteToEarpiece = when (currentMode) {
+                "earpiece" -> true
+                "speaker" -> false
+                "auto" -> isNearEar
+                else -> isNearEar
+            }
+
+            if (shouldRouteToEarpiece) {
+                am.mode = AudioManager.MODE_IN_COMMUNICATION
+                routeToEarpiece(am)
+                // En modo auricular, el volumen físico del dispositivo debe regular el canal de llamada (VOICE_CALL)
+                currentActivity?.volumeControlStream = AudioManager.STREAM_VOICE_CALL
+                if (currentMode == "auto" || currentMode == "earpiece") {
+                    acquireWakeLock()
+                }
+            } else {
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                    am.clearCommunicationDevice()
+                }
+                @Suppress("DEPRECATION")
+                am.isSpeakerphoneOn = false
+                am.mode = AudioManager.MODE_NORMAL
+                // En modo altavoz, regular el volumen de música/multimedia
+                currentActivity?.volumeControlStream = AudioManager.STREAM_MUSIC
+                releaseWakeLock()
+            }
+        } catch (_: Exception) {}
+    }
+
+    private fun routeToEarpiece(am: AudioManager) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val devices = am.availableCommunicationDevices
+            val earpiece = devices.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_EARPIECE }
+            if (earpiece != null) {
+                am.setCommunicationDevice(earpiece)
+                return
+            }
+        }
+        @Suppress("DEPRECATION")
+        am.isSpeakerphoneOn = false
+    }
+
+    private fun routeToSpeaker(am: AudioManager) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val devices = am.availableCommunicationDevices
+            val speaker = devices.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
+            if (speaker != null) {
+                am.setCommunicationDevice(speaker)
+                return
+            }
+        }
+        @Suppress("DEPRECATION")
+        am.isSpeakerphoneOn = true
+    }
+
+    private fun registerProximityListener() {
+        val sm = sensorManager ?: return
+        val sensor = proximitySensor ?: return
+        try {
+            sm.registerListener(this, sensor, SensorManager.SENSOR_DELAY_NORMAL)
+        } catch (_: Exception) {}
+    }
+
+    private fun unregisterProximityListener() {
+        val sm = sensorManager ?: return
+        try {
+            sm.unregisterListener(this)
+        } catch (_: Exception) {}
+        isNearEar = false
+    }
+
+    private fun acquireWakeLock() {
+        val lock = proximityWakeLock ?: return
+        try {
+            if (!lock.isHeld) {
+                lock.acquire(30 * 60 * 1000L /* 30 minutes max safeguard */)
+            }
+        } catch (_: Exception) {}
+    }
+
+    private fun releaseWakeLock() {
+        val lock = proximityWakeLock ?: return
+        try {
+            if (lock.isHeld) {
+                lock.release()
+            }
+        } catch (_: Exception) {}
+    }
+
+    override fun onSensorChanged(event: SensorEvent?) {
+        if (event?.sensor?.type != Sensor.TYPE_PROXIMITY) return
+        val distance = event.values.firstOrNull() ?: return
+        val maxRange = event.sensor.maximumRange
+
+        val wasNear = isNearEar
+        // Near threshold logic: standard proximity sensors report 0.0 or distance < maxRange / 5cm
+        isNearEar = if (maxRange <= 1.0f) {
+            distance < maxRange // binary sensor (0 = near, 1 = far)
+        } else {
+            distance < 5.0f && distance < maxRange
+        }
+
+        if (wasNear != isNearEar) {
+            methodChannel?.invokeMethod("onProximityChanged", isNearEar)
+            if (isSessionActive && currentMode == "auto") {
+                applyRoutingForCurrentState()
+            }
+        }
+    }
+
+    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
+}
