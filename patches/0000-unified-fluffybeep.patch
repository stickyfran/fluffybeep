diff --git a/lib/utils/beeper_bridge_utils.dart b/lib/utils/beeper_bridge_utils.dart
new file mode 100644
index 0000000..65b59c5
--- /dev/null
+++ b/lib/utils/beeper_bridge_utils.dart
@@ -0,0 +1,560 @@
+import 'dart:typed_data';
+
+import 'package:fluffychat/widgets/future_loading_dialog.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+
+class BeeperBridgeUtils {
+  /// Regular expression to detect Beeper bridge bots.
+  /// Matches pattern like: @whatsappbot:beeper.local
+  static final RegExp beeperBotRegex = RegExp(r'^@.*bot.*:beeper\..*$');
+
+
+  /// Checks if a given matrix user ID belongs to a Beeper bridge bot.
+  static bool isBeeperBot(String userId) {
+    return beeperBotRegex.hasMatch(userId);
+  }
+
+  /// Determines if a room is a "Fake DM" created by Beeper.
+  /// A Fake DM is defined as a room with exactly 3 members:
+  /// 1. The local user (You)
+  /// 2. The real contact
+  /// 3. The Beeper bridge bot
+  static bool isFakeDM(Room room) {
+    // Check 1 (FAST PATH — no member loading needed):
+    // directChatMatrixID comes from account data (m.direct), which is loaded
+    // immediately from the DB before member events. If it points to a Beeper
+    // network user, this is definitively a Fake DM regardless of isDirectChat.
+    final directId = room.directChatMatrixID;
+    if (directId != null && directId.startsWith('@')) {
+      final localpart = directId.split(':').first.substring(1);
+      for (final entry in networkMap.entries) {
+        if (localpart.startsWith('${entry.key}_') || localpart == '${entry.key}bot') {
+          return true;
+        }
+      }
+    }
+
+    // Check 2: Real groups have an explicit name; Beeper fake DMs are anonymous.
+    final nameEvent = room.states['m.room.name'];
+    if (nameEvent != null && nameEvent.isNotEmpty) {
+      final firstName = nameEvent.values.firstOrNull;
+      final roomName = firstName?.content.tryGet<String>('name') ?? '';
+      if (roomName.trim().isNotEmpty) {
+        return false;
+      }
+    }
+
+    // Check 3: m.bridge state event — explicit bridge marker.
+    final hasBridgeEvent = room.states['m.bridge']?.isNotEmpty ?? false;
+    if (hasBridgeEvent && room.isDirectChat) {
+      return true;
+    }
+
+    // Check 4: Only direct chats can be Fake DMs via the 3-member heuristic.
+    // Bridged rooms without the isDirectChat flag are already handled above.
+    if (!room.isDirectChat) return false;
+
+    // Check 5: Fallback — 3-member structure: local user + bot + real contact.
+    final members = room.getParticipants();
+    if (members.length != 3) {
+      return false;
+    }
+
+    bool hasLocalUser = false;
+    bool hasBot = false;
+    bool hasRealContact = false;
+
+    final clientUserId = room.client.userID;
+
+    for (var member in members) {
+      if (member.id == clientUserId) {
+        hasLocalUser = true;
+      } else if (isBeeperBot(member.id)) {
+        hasBot = true;
+      } else {
+        hasRealContact = true;
+      }
+    }
+
+    return hasLocalUser && hasBot && hasRealContact;
+  }
+
+  /// Extracts the real contact from a Fake DM room.
+  /// Returns null if it's not a Fake DM or if members haven't loaded yet.
+  ///
+  /// Uses directChatMatrixID as a fast-path to avoid the race condition
+  /// where getParticipants() is incomplete during the initial sync.
+  static User? getRealContactFromFakeDM(Room room) {
+    if (!isFakeDM(room)) return null;
+
+    // Fast-path: resolve the contact directly from the known DM target ID.
+    // This works even before all room members are fully loaded from the DB.
+    // Note: matrix SDK 8.x has no getParticipant(id) — use where+firstOrNull.
+    final directId = room.directChatMatrixID;
+    if (directId != null) {
+      final participant = room
+          .getParticipants()
+          .where((m) => m.id == directId)
+          .firstOrNull;
+      if (participant != null) return participant;
+    }
+
+    final members = room.getParticipants();
+    final clientUserId = room.client.userID;
+
+    // First try: member who is neither local user nor bot
+    for (var member in members) {
+      if (member.id != clientUserId && !isBeeperBot(member.id)) {
+        return member;
+      }
+    }
+
+    // Second try fallback: any member who is not the local user
+    for (var member in members) {
+      if (member.id != clientUserId) {
+        return member;
+      }
+    }
+
+    return null;
+  }
+
+  static const Map<String, BeeperNetSpec> networkMap = {
+    'whatsapp': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'whatsappgo': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'instagram': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'instagramgo': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'telegram': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'telegramgo': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'signal': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'signalgo': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'discord': BeeperNetSpec('Discord', 0xFF5865F2),
+    'discordgo': BeeperNetSpec('Discord', 0xFF5865F2),
+    'facebook': BeeperNetSpec('Messenger', 0xFF00B2FF),
+    'facebookgo': BeeperNetSpec('Messenger', 0xFF00B2FF),
+    'slack': BeeperNetSpec('Slack', 0xFF4A154B),
+    'slackgo': BeeperNetSpec('Slack', 0xFF4A154B),
+    'googlechat': BeeperNetSpec('Google Chat', 0xFF34A853),
+    'googlechatgo': BeeperNetSpec('Google Chat', 0xFF34A853),
+  };
+
+  static String getBaseNetworkKey(String key) {
+    if (key.endsWith('go')) {
+      return key.substring(0, key.length - 2);
+    }
+    return key;
+  }
+
+  /// Returns the detected Beeper network for a given room, or null if none is found.
+  /// Computed in real-time on every call to avoid caching stale state during initial sync.
+  static BeeperNetwork? getRoomNetwork(Room room) {
+    return _detectRoomNetwork(room);
+  }
+
+  static BeeperNetwork? _detectRoomNetwork(Room room) {
+    final participants = room.getParticipants();
+    for (final p in participants) {
+      if (p.id == room.client.userID) continue;
+      final localpart = p.id.split(':').first;
+      if (localpart.startsWith('@')) {
+        final rawPrefix = localpart.substring(1);
+        for (final entry in networkMap.entries) {
+          if (rawPrefix.startsWith('${entry.key}_') || rawPrefix == '${entry.key}bot') {
+            final baseKey = getBaseNetworkKey(entry.key);
+            final spec = networkMap[baseKey] ?? entry.value;
+            return BeeperNetwork(spec.name, spec.colorHex, baseKey);
+          }
+        }
+      }
+    }
+    final directId = room.directChatMatrixID;
+    if (directId != null) {
+      final localpart = directId.split(':').first;
+      if (localpart.startsWith('@')) {
+        final rawPrefix = localpart.substring(1);
+        for (final entry in networkMap.entries) {
+          if (rawPrefix.startsWith('${entry.key}_') || rawPrefix == '${entry.key}bot') {
+            final baseKey = getBaseNetworkKey(entry.key);
+            final spec = networkMap[baseKey] ?? entry.value;
+            return BeeperNetwork(spec.name, spec.colorHex, baseKey);
+          }
+        }
+      }
+    }
+    return null;
+  }
+
+  static Future<void> addStickerToWhatsappPack(BuildContext context, Event event) async {
+    final client = event.room.client;
+    final messenger = ScaffoldMessenger.of(context);
+
+    final result = await showFutureLoadingDialog<Uri?>(
+      context: context,
+      future: () async {
+        final MatrixFile matrixFile = await event.downloadAndDecryptAttachment();
+        final String filename = event.content['body']?.toString() ?? 'sticker';
+        final rawInfo = event.content['info'];
+        final String mimetype = (rawInfo is Map) ? (rawInfo['mimetype']?.toString() ?? 'image/png') : 'image/png';
+        final uri = await client.uploadContent(
+          matrixFile.bytes,
+          filename: filename,
+          contentType: mimetype,
+        );
+        return uri;
+      },
+    );
+
+    final mxcUri = result.result;
+    if (mxcUri == null) {
+      messenger.showSnackBar(
+        const SnackBar(content: Text('Error al subir el sticker a la cuenta')),
+      );
+      return;
+    }
+
+    try {
+      final accountDataEvent = client.accountData['im.ponies.user_emotes'];
+      Map<String, dynamic> packData;
+      if (accountDataEvent != null) {
+        packData = Map<String, dynamic>.from(accountDataEvent.content);
+      } else {
+        packData = {
+          'images': <String, dynamic>{},
+          'pack': {
+            'display_name': 'Mis stickers',
+            'usage': ['sticker'],
+          },
+        };
+      }
+
+      final images = Map<String, dynamic>.from(packData['images'] ?? <String, dynamic>{});
+      
+      final info = <String, dynamic>{};
+      final rawInfo = event.content['info'];
+      if (rawInfo is Map) {
+        info.addAll(Map<String, dynamic>.from(rawInfo));
+      }
+      
+      if (info['w'] is int && info['h'] is int) {
+        final int w = info['w'];
+        final int h = info['h'];
+        final ratio = w / h;
+        if (w > h) {
+          info['w'] = 256;
+          info['h'] = (256.0 / ratio).round();
+        } else {
+          info['h'] = 256;
+          info['w'] = (ratio * 256.0).round();
+        }
+      }
+
+      final stickerContent = <String, dynamic>{
+        'url': mxcUri.toString(),
+        'info': info,
+        'body': event.content['body'] ?? 'sticker',
+        'usage': ['sticker'],
+      };
+
+      // De-duplication check: if a sticker with the same URL already exists, don't add it again.
+      bool isDuplicate = false;
+      if (images.values.any((val) => val is Map && val['url'] == mxcUri.toString())) {
+        isDuplicate = true;
+      }
+
+      if (!isDuplicate) {
+        final String code = 'sticker_${DateTime.now().millisecondsSinceEpoch}';
+        images[code] = stickerContent;
+        packData['images'] = images;
+
+        await client.setAccountData(
+          client.userID!,
+          'im.ponies.user_emotes',
+          packData,
+        );
+
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Sticker agregado al paquete Mis stickers')),
+        );
+      } else {
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Este sticker ya está en tu paquete')),
+        );
+      }
+    } catch (e) {
+      messenger.showSnackBar(
+        SnackBar(content: Text('Error al guardar el sticker: $e')),
+      );
+    }
+  }
+
+  /// Get all Beeper labels from Account Data.
+  static Map<String, dynamic> getBeeperLabels(Client client) {
+    try {
+      final accountDataEvent = client.accountData['com.beeper.labels'];
+      if (accountDataEvent != null && accountDataEvent.content is Map) {
+        return Map<String, dynamic>.from(accountDataEvent.content);
+      }
+    } catch (e) {
+      Logs().e('Error reading com.beeper.labels: $e');
+    }
+    return {};
+  }
+
+  /// Save Beeper labels map to Account Data.
+  static Future<void> setBeeperLabels(Client client, Map<String, dynamic> labels) async {
+    try {
+      await client.setAccountData(
+        client.userID!,
+        'com.beeper.labels',
+        labels,
+      );
+    } catch (e) {
+      Logs().e('Error saving com.beeper.labels: $e');
+    }
+  }
+
+  /// Check if a room is hidden from the main inbox due to a label with isShownInInbox = false.
+  static bool isRoomHiddenInInbox(Client client, String roomId) {
+    final labels = getBeeperLabels(client);
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map) {
+        final isShown = val['isShownInInbox'];
+        if (isShown == false) {
+          final rooms = val['rooms'];
+          if (rooms is List && rooms.contains(roomId)) {
+            return true;
+          }
+        }
+      }
+    }
+    return false;
+  }
+
+  /// Helper to get hidden networks using a special '_hidden_networks' key in Beeper labels.
+  static List<String> getHiddenNetworks(Client client) {
+    final labels = getBeeperLabels(client);
+    final hiddenEntry = labels['_hidden_networks'];
+    if (hiddenEntry is Map) {
+      final rooms = hiddenEntry['rooms'];
+      if (rooms is List) {
+        return List<String>.from(rooms);
+      }
+    }
+    return [];
+  }
+
+  /// Helper to set hidden networks using a special '_hidden_networks' key in Beeper labels.
+  static Future<void> setHiddenNetworks(Client client, List<String> hiddenKeys) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    labels['_hidden_networks'] = {
+      'title': 'Hidden Networks',
+      'rooms': hiddenKeys,
+      'isShownInInbox': false,
+      'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+    };
+    await setBeeperLabels(client, labels);
+  }
+
+  /// Check if a network is contained (hidden from inbox).
+  static bool isNetworkContained(Client client, String networkKey, String networkName) {
+    final labels = getBeeperLabels(client);
+    for (final val in labels.values) {
+      if (val is Map && val['title'] == networkName) {
+        return val['isShownInInbox'] == false;
+      }
+    }
+    return false;
+  }
+
+  /// Toggle containment of a network.
+  static Future<void> setNetworkContained(Client client, String networkKey, String networkName, bool contained) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    String? foundUuid;
+    Map<String, dynamic>? foundLabel;
+
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map && val['title'] == networkName) {
+        foundUuid = entry.key;
+        foundLabel = Map<String, dynamic>.from(val);
+        break;
+      }
+    }
+
+    final netRooms = client.rooms
+        .where((r) => getRoomNetwork(r)?.key == networkKey)
+        .map((r) => r.id)
+        .toList();
+
+    if (foundLabel != null && foundUuid != null) {
+      foundLabel['isShownInInbox'] = !contained;
+      final existingRooms = List<String>.from(foundLabel['rooms'] ?? []);
+      for (final rId in netRooms) {
+        if (contained) {
+          if (!existingRooms.contains(rId)) existingRooms.add(rId);
+        } else {
+          existingRooms.remove(rId);
+        }
+      }
+      foundLabel['rooms'] = existingRooms;
+      labels[foundUuid] = foundLabel;
+    } else if (contained) {
+      final newUuid = 'label_${DateTime.now().millisecondsSinceEpoch}_$networkKey';
+      labels[newUuid] = {
+        'title': networkName,
+        'rooms': netRooms,
+        'isShownInInbox': false,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await setBeeperLabels(client, labels);
+  }
+
+  /// Check if a tag is contained.
+  static bool isTagContained(Client client, String tag) {
+    final labels = getBeeperLabels(client);
+    final displayName = tag.replaceFirst('u.', '');
+    for (final val in labels.values) {
+      if (val is Map && val['title'] == displayName) {
+        return val['isShownInInbox'] == false;
+      }
+    }
+    return false;
+  }
+
+  /// Toggle containment of a custom tag.
+  static Future<void> setTagContained(Client client, String tag, bool contained) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    final displayName = tag.replaceFirst('u.', '');
+    String? foundUuid;
+    Map<String, dynamic>? foundLabel;
+
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map && val['title'] == displayName) {
+        foundUuid = entry.key;
+        foundLabel = Map<String, dynamic>.from(val);
+        break;
+      }
+    }
+
+    final tagRooms = client.rooms
+        .where((r) => r.tags.keys.contains(tag))
+        .map((r) => r.id)
+        .toList();
+
+    if (foundLabel != null && foundUuid != null) {
+      foundLabel['isShownInInbox'] = !contained;
+      final existingRooms = List<String>.from(foundLabel['rooms'] ?? []);
+      for (final rId in tagRooms) {
+        if (contained) {
+          if (!existingRooms.contains(rId)) existingRooms.add(rId);
+        } else {
+          existingRooms.remove(rId);
+        }
+      }
+      foundLabel['rooms'] = existingRooms;
+      labels[foundUuid] = foundLabel;
+    } else if (contained) {
+      final newUuid = 'label_${DateTime.now().millisecondsSinceEpoch}_${tag.replaceAll(".", "_")}';
+      labels[newUuid] = {
+        'title': displayName,
+        'rooms': tagRooms,
+        'isShownInInbox': false,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await setBeeperLabels(client, labels);
+  }
+
+  static final Map<String, DateTime> _lastMessageTimeCache = {};
+
+  static DateTime? getLastMessageTime(String roomId) => _lastMessageTimeCache[roomId];
+
+  static void setLastMessageTime(String roomId, DateTime time) {
+    _lastMessageTimeCache[roomId] = time;
+  }
+
+  /// Returns the last real message event in a room, skipping state events
+  /// and other technical events (e.g. m.room.member, m.room.topic, etc.).
+  /// Only returns events of type m.room.message, m.room.encrypted, or m.sticker.
+  ///
+  /// Strategy:
+  ///   1. Walk room.timeline?.events backward (in-memory, already loaded events)
+  ///      for the most accurate result without any DB hit.
+  ///   2. Fall back to room.lastEvent if the timeline is empty or unavailable.
+  static Event? getLastRealMessage(Room room) {
+    const realMessageTypes = {
+      EventTypes.Message,    // m.room.message
+      EventTypes.Encrypted,  // m.room.encrypted
+      EventTypes.Sticker,    // m.sticker
+    };
+
+    // matrix SDK 8.x doesn't expose a room.timeline getter.
+    // Fallback directly to room.lastEvent.
+    final lastEvent = room.lastEvent;
+    if (lastEvent != null && realMessageTypes.contains(lastEvent.type)) {
+      return lastEvent;
+    }
+
+    return null;
+  }
+}
+
+class BeeperNetwork {
+  final String name;
+  final int colorHex;
+  final String key;
+  const BeeperNetwork(this.name, this.colorHex, this.key);
+}
+
+class BeeperNetSpec {
+  final String name;
+  final int colorHex;
+  const BeeperNetSpec(this.name, this.colorHex);
+}
+
+extension RoomBeeperExtension on Room {
+  String getBeeperDisplayname(MatrixLocalizations localizations) {
+    // Primary path: room is a confirmed Fake DM
+    if (BeeperBridgeUtils.isFakeDM(this)) {
+      final contact = BeeperBridgeUtils.getRealContactFromFakeDM(this);
+      if (contact != null) {
+        return contact.calcDisplayname();
+      }
+
+      // Members are still loading (race condition during initial sync).
+      // Use the raw directChatMatrixID localpart as a placeholder instead
+      // of falling back to getLocalizedDisplayname() which would show
+      // "Group with [Bot]". The UI will re-render once members are loaded.
+      final directId = directChatMatrixID;
+      if (directId != null) {
+        // e.g. "@whatsapp_12345:beeper.local" → "whatsapp_12345"
+        return directId.split(':').first.replaceAll('@', '');
+      }
+    }
+
+    // Secondary path: isFakeDM may have returned false during initial load
+    // (e.g. isDirectChat not yet set), but the directChatMatrixID already
+    // contains a Beeper network user ID. Detect and display the raw ID
+    // instead of "Group with..." to avoid the flash.
+    final directId = directChatMatrixID;
+    if (directId != null && directId.startsWith('@')) {
+      final localpart = directId.split(':').first.substring(1);
+      for (final entry in BeeperBridgeUtils.networkMap.entries) {
+        if (localpart.startsWith('${entry.key}_') ||
+            localpart == '${entry.key}bot') {
+          // This is a Beeper bridged room in its loading window.
+          // Return the raw localpart (e.g. "whatsapp_12345") as placeholder.
+          return localpart;
+        }
+      }
+    }
+
+    return getLocalizedDisplayname(localizations);
+  }
+}
diff --git a/lib/widgets/cache_refresh_overlay.dart b/lib/widgets/cache_refresh_overlay.dart
