+class _AudioTimeText extends StatelessWidget {
+  final AudioPlayer? audioPlayer;
+  final String durationString;
+  final bool isWaitingForEar;
+  final double? downloadProgress;
+  final ValueListenable<Duration?>? scrubbingDurationListenable;
+  final Color color;
+
+  const _AudioTimeText({
+    required this.audioPlayer,
+    required this.durationString,
+    required this.isWaitingForEar,
+    this.downloadProgress,
+    this.scrubbingDurationListenable,
+    required this.color,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (isWaitingForEar) {
+      return Text(
+        'Oído...',
+        style: TextStyle(color: color, fontSize: 11),
+      );
+    }
+
+    if (downloadProgress != null &&
+        downloadProgress! > 0 &&
+        downloadProgress! < 1.0) {
+      return Text(
+        '${(downloadProgress! * 100).toInt()}%',
+        style: TextStyle(color: color, fontSize: 11),
+      );
+    }
+
+    Widget content;
+    final player = audioPlayer;
+    if (player == null) {
+      content = Text(
+        durationString,
+        style: TextStyle(color: color, fontSize: 11),
+      );
+    } else {
+      content = StreamBuilder<Duration>(
+        stream: player.positionStream.distinct(
+          (prev, next) => prev.inSeconds == next.inSeconds,
+        ),
+        initialData: player.position,
+        builder: (context, snapshot) {
+          final pos = snapshot.data ?? player.position;
+          return Text(
+            pos.minuteSecondString,
+            style: TextStyle(color: color, fontSize: 11),
+          );
+        },
+      );
+    }
+
+    if (scrubbingDurationListenable != null) {
+      return ValueListenableBuilder<Duration?>(
+        valueListenable: scrubbingDurationListenable!,
+        builder: (context, scrubDur, child) {
+          if (scrubDur != null) {
+            return Text(
+              scrubDur.minuteSecondString,
+              style: TextStyle(
+                color: color,
+                fontSize: 11,
+                fontWeight: FontWeight.bold,
+              ),
+            );
+          }
+          return child!;
+        },
+        child: content,
+      );
+    }
+
+    return content;
+  }
+}
