+class _ConvertedSticker {
+  final Uint8List bytes;
+  final String mimeType;
+  final String ext;
+  const _ConvertedSticker(this.bytes, this.mimeType, this.ext);
+}
+
+_ConvertedSticker _convertStickerBytes(Uint8List rawBytes) {
+  // Check for GIF signature: GIF87a or GIF89a
+  if (rawBytes.length >= 6 &&
+      rawBytes[0] == 0x47 &&
+      rawBytes[1] == 0x49 &&
+      rawBytes[2] == 0x46) {
+    return _ConvertedSticker(rawBytes, 'image/gif', 'gif');
+  }
+
+  // Check for animated WebP (RIFF....WEBPVP8X with animation bit)
+  bool isLikelyAnimatedWebp = false;
+  if (rawBytes.length >= 21 &&
+      rawBytes[0] == 0x52 &&
+      rawBytes[1] == 0x49 &&
+      rawBytes[2] == 0x46 &&
+      rawBytes[3] == 0x46 &&
+      rawBytes[8] == 0x57 &&
+      rawBytes[9] == 0x45 &&
+      rawBytes[10] == 0x42 &&
+      rawBytes[11] == 0x50 &&
+      rawBytes[12] == 0x56 &&
+      rawBytes[13] == 0x50 &&
+      rawBytes[14] == 0x38 &&
+      rawBytes[15] == 0x58) {
+    // 20th byte holds flags: 0x02 is animation flag
+    if ((rawBytes[20] & 0x02) != 0) {
+      isLikelyAnimatedWebp = true;
+    }
+  }
+
+  final decoded = img.decodeImage(rawBytes);
+  if (decoded != null) {
+    if (decoded.hasAnimation || isLikelyAnimatedWebp) {
+      try {
+        final gifBytes = img.encodeGif(decoded);
+        return _ConvertedSticker(Uint8List.fromList(gifBytes), 'image/gif', 'gif');
+      } catch (e) {
+        // If GIF encoding fails, fallback to PNG first frame
+      }
+    }
+    final pngBytes = img.encodePng(decoded);
+    return _ConvertedSticker(Uint8List.fromList(pngBytes), 'image/png', 'png');
+  }
+
+  return _ConvertedSticker(rawBytes, 'image/png', 'png');
+}
