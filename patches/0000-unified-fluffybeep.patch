+}
+
+class ContentShareItem extends ShareItem {
+  final Map<String, Object?> value;
+  ContentShareItem(this.value);
+}
+
+class FileShareItem extends ShareItem {
+  final XFile value;
+  FileShareItem(this.value);
+}
