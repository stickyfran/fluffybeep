+  Future<void> _handleAutoAdvance(MatrixState matrix, Event currentEvent) async {
+    try {
+      final nextAudio = await findNextAudioEvent(currentEvent);
+      if (nextAudio != null) {
+        HapticFeedback.lightImpact();
+        await playEvent(matrix, nextAudio, context: matrix.context);
