diff --git a/lib/controllers/beeper_reinit_controller.dart b/lib/controllers/beeper_reinit_controller.dart
new file mode 100644
index 0000000..1ef4102
--- /dev/null
+++ b/lib/controllers/beeper_reinit_controller.dart
@@ -0,0 +1,132 @@
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+
+import 'package:fluffychat/widgets/fluffy_chat_app.dart';
+import 'package:fluffychat/widgets/matrix.dart';
+
+class BeeperReinitController {
+  final Client client;
+
+  BeeperReinitController({required this.client});
+
+  /// Purges local cache (SQLite tables for messages and avatars)
+  Future<void> reinitCache(BuildContext context) async {
+    try {
+      // 1. Pause sync loop
+      client.backgroundSync = false;
+
+      // 2. Clear the database cache while keeping keys and session
+      await client.database?.clearCache();
+    } catch (e) {
+      debugPrint('Error during Beeper cache reinitialization: $e');
+      rethrow;
+    }
+  }
+
+  /// Displays an overlay to block the UI while reinitializing and restarts the app.
+  static Future<void> showReinitOverlay(BuildContext context, Client client) async {
+    // Show a confirmation dialog first
+    final confirm = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Re-sincronizar chats (Beeper)'),
+        content: const Text('Se limpiará la caché de chats y perfiles. Para completar el proceso, la aplicación se cerrará y deberás volver a abrirla. ¿Deseas continuar?'),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('Cancelar'),
+          ),
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: const Text('Aceptar'),
+          ),
+        ],
+      ),
+    );
+
+    if (confirm != true) return;
+
+    // Show the progress overlay
+    final overlay = OverlayEntry(
+      builder: (context) => Stack(
+        children: [
+          const ModalBarrier(
+            color: Colors.black54,
+            dismissible: false,
+          ),
+          Center(
+            child: Container(
+              padding: const EdgeInsets.all(24),
+              decoration: BoxDecoration(
+                color: Theme.of(context).dialogBackgroundColor,
+                borderRadius: BorderRadius.circular(12),
+              ),
+              child: const Column(
+                mainAxisSize: MainAxisSize.min,
+                children: [
+                  CircularProgressIndicator(),
+                  SizedBox(height: 16),
+                  Text(
+                    'Limpiando caché...',
+                    style: TextStyle(fontSize: 16, decoration: TextDecoration.none),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+
+    Overlay.of(context).insert(overlay);
+
+    try {
+      final controller = BeeperReinitController(client: client);
+      await controller.reinitCache(context);
+      
+      // Remove overlay before showing success dialog
+      overlay.remove();
+
+      // Show success dialog then navigate softly to restart session
+      if (context.mounted) {
+        await showDialog(
+          context: context,
+          barrierDismissible: false,
+          builder: (context) => AlertDialog(
+            title: const Text('Caché limpiada'),
+            content: const Text(
+              'La caché se ha limpiado correctamente. La app se recargará ahora para aplicar los cambios.',
+            ),
+            actions: [
+              TextButton(
+                onPressed: () {
+                  Navigator.of(context).pop();
+                  // Soft reload: navigate to root so the app re-initializes
+                  FluffyChatApp.router.go('/');
+                },
+                child: const Text('Aceptar'),
+              ),
+            ],
+          ),
+        );
+      }
+    } catch (e) {
+      overlay.remove();
+      if (context.mounted) {
+        showDialog(
+          context: context,
+          builder: (context) => AlertDialog(
+            title: const Text('Error'),
+            content: Text('Ocurrió un error al limpiar la caché: $e'),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('Aceptar'),
+              ),
+            ],
+          ),
+        );
+      }
+    }
+  }
+}
