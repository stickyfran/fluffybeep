+  late AnimationController _moveController;
+  late Animation<Offset> _moveAnimation;
+
+  double _dragExtent = 0.0;
+  bool _dragUnderway = false;
+  Size? _sizePriorToCollapse;
+
+  bool _isTouch = true;
+
