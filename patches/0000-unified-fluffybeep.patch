@@ -0,0 +1,154 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:matrix/matrix.dart';
+import '../../config/setting_keys.dart';
+import '../../config/themes.dart';
+import '../../l10n/l10n.dart';
+import '../../utils/beeper_bridge_utils.dart';
+import 'chat.dart';
+
+class FloatingManualReadButton extends StatefulWidget {
+  final ChatController controller;
+
+  const FloatingManualReadButton({super.key, required this.controller});
+
+  @override
+  State<FloatingManualReadButton> createState() => _FloatingManualReadButtonState();
+}
+
+class _FloatingManualReadButtonState extends State<FloatingManualReadButton> {
+  bool _isMarkingRead = false;
+  bool _isMarkedReadLocally = false;
+  StreamSubscription? _syncSub;
+
+  @override
+  void initState() {
+    super.initState();
+    _syncSub = widget.controller.room.client.onSync.stream.listen((syncUpdate) {
+      if (!mounted) return;
+      final roomUpdate = syncUpdate.rooms?.join?[widget.controller.room.id];
+      if (roomUpdate != null) {
+        final newEvents = roomUpdate.timeline?.events;
+        final myUserId = widget.controller.room.client.userID;
+        final hasIncomingMessage = newEvents != null &&
+            newEvents.any((e) => e.senderId != myUserId && e.type != 'm.reaction' && e.type != 'm.receipt');
+        if (hasIncomingMessage) {
+          setState(() {
+            _isMarkedReadLocally = false;
+          });
+        }
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _syncSub?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _handleMarkAsRead() async {
+    HapticFeedback.mediumImpact();
+    if (mounted) {
+      setState(() {
+        _isMarkingRead = true;
+        _isMarkedReadLocally = true;
+      });
+    }
+
+    await BeeperBridgeUtils.markRoomAsRead(
+      widget.controller.room,
+      publicReceipt: AppSettings.sendPublicReadReceipts.value,
+    );
+
+    widget.controller.setReadMarker(force: true);
+
+    await Future.delayed(const Duration(milliseconds: 300));
+    if (mounted) {
+      setState(() => _isMarkingRead = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final prefs = BeeperBridgeUtils.prefs;
+    final isEnabled = (prefs?.getBool('beeper_manual_read_receipts') ?? false) &&
