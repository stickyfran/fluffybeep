+                      await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                      setState(() {});
+                    },
+                  ),
+                  const Divider(indent: 16, endIndent: 16),
+                ],
+              );
+            }),
+          const Divider(),
+          Padding(
+            padding: const EdgeInsets.all(16.0),
+            child: Row(
+              mainAxisAlignment: MainAxisAlignment.spaceBetween,
+              children: [
+                Text(
+                  'Etiquetas de Beeper (Labels)',
+                  style: TextStyle(
+                    color: theme.colorScheme.primary,
+                    fontWeight: FontWeight.bold,
+                  ),
+                ),
+                IconButton(
+                  icon: const Icon(Icons.add),
+                  tooltip: 'Nueva etiqueta',
+                  onPressed: () async {
+                    final created = await showDialog<bool>(
+                      context: context,
+                      useRootNavigator: false,
+                      builder: (context) => const LabelEditorDialog(),
+                    );
+                    if (created == true && mounted) {
+                      setState(() {});
+                    }
+                  },
+                ),
+              ],
+            ),
+          ),
+          Builder(
+            builder: (context) {
+              final beeperLabels = BeeperBridgeUtils.getBeeperLabels(client);
+              final hiddenNets = BeeperBridgeUtils.getHiddenNetworks(client);
+
+              final validEntries = beeperLabels.entries
+                  .where((e) => e.key != '_hidden_networks' && e.value is Map && (e.value['title']?.toString().isNotEmpty ?? false))
+                  .toList();
+
+              if (validEntries.isEmpty) {
+                return const Padding(
+                  padding: EdgeInsets.symmetric(horizontal: 16.0),
+                  child: Text('No tienes etiquetas de Beeper creadas actualmente.'),
+                );
+              }
+
+              return Column(
+                children: validEntries.map((entry) {
+                  final uuid = entry.key;
+                  final map = Map<String, dynamic>.from(entry.value as Map);
+                  final title = map['title']?.toString() ?? '';
+                  final emoji = map['emoji']?.toString() ?? '🏷️';
+                  final rooms = (map['rooms'] as List?) ?? [];
+                  final isContained = map['isShownInInbox'] == false;
+
+                  final isHidden = hiddenNets.contains(uuid) ||
+                      hiddenNets.contains(title) ||
+                      hiddenNets.contains(title.toLowerCase());
+
+                  return Card(
+                    margin: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 4.0),
+                    child: Padding(
+                      padding: const EdgeInsets.all(8.0),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          ListTile(
+                            leading: CircleAvatar(
+                              backgroundColor: theme.colorScheme.tertiaryContainer,
+                              child: Text(emoji, style: const TextStyle(fontSize: 20)),
+                            ),
+                            title: Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
+                            subtitle: Text('${rooms.length} chats asignados'),
+                            trailing: Row(
+                              mainAxisSize: MainAxisSize.min,
+                              children: [
+                                IconButton(
+                                  icon: const Icon(Icons.edit_outlined),
+                                  tooltip: 'Editar etiqueta',
+                                  onPressed: () async {
+                                    final edited = await showDialog<bool>(
+                                      context: context,
+                                      useRootNavigator: false,
+                                      builder: (context) => LabelEditorDialog(
+                                        labelUuid: uuid,
+                                        initialTitle: title,
+                                        initialEmoji: emoji,
+                                        initialIsShownInInbox: !isContained,
+                                      ),
+                                    );
+                                    if (edited == true && mounted) {
+                                      setState(() {});
+                                    }
+                                  },
+                                ),
+                                IconButton(
+                                  icon: const Icon(Icons.delete_outline, color: Colors.red),
+                                  tooltip: 'Eliminar etiqueta',
+                                  onPressed: () async {
+                                    final confirmed = await showOkCancelAlertDialog(
+                                      context: context,
+                                      title: '¿Eliminar etiqueta?',
+                                      message: '¿Estás seguro de que quieres eliminar "$title"?',
+                                      okLabel: 'Eliminar',
+                                      cancelLabel: 'Cancelar',
+                                      isDestructive: true,
+                                    );
+                                    if (confirmed == OkCancelResult.ok) {
+                                      final labels = Map<String, dynamic>.from(BeeperBridgeUtils.getBeeperLabels(client));
+                                      labels.remove(uuid);
+                                      await BeeperBridgeUtils.setBeeperLabels(client, labels);
+                                      if (mounted) setState(() {});
+                                    }
+                                  },
+                                ),
+                              ],
+                            ),
+                          ),
+                          SwitchListTile.adaptive(
+                            dense: true,
+                            value: isContained,
+                            title: const Text('Contener chats'),
+                            subtitle: const Text('Muestra los chats solo dentro de la etiqueta.'),
+                            onChanged: (val) async {
+                              final labels = Map<String, dynamic>.from(BeeperBridgeUtils.getBeeperLabels(client));
+                              map['isShownInInbox'] = !val;
+                              labels[uuid] = map;
+                              await BeeperBridgeUtils.setBeeperLabels(client, labels);
+                              if (mounted) setState(() {});
+                            },
+                          ),
+                          SwitchListTile.adaptive(
+                            dense: true,
+                            value: isHidden,
+                            title: const Text('Ocultar de la barra lateral'),
+                            subtitle: const Text('Oculta este ícono del menú de la izquierda.'),
+                            onChanged: (val) async {
+                              final newHidden = List<String>.from(hiddenNets);
+                              if (val) {
+                                if (!newHidden.contains(uuid)) newHidden.add(uuid);
+                                if (!newHidden.contains(title)) newHidden.add(title);
+                              } else {
+                                newHidden.remove(uuid);
+                                newHidden.remove(title);
+                                newHidden.remove(title.toLowerCase());
+                              }
+                              await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                              if (mounted) setState(() {});
+                            },
+                          ),
+                        ],
+                      ),
+                    ),
+                  );
+                }).toList(),
+              );
+            },
+          ),
+          if (tagsList.isNotEmpty) ...[
+            const Divider(),
+            Padding(
+              padding: const EdgeInsets.all(16.0),
+              child: Text(
+                'Etiquetas personalizadas Matrix (u.xxx)',
+                style: TextStyle(
+                  color: theme.colorScheme.primary,
+                  fontWeight: FontWeight.bold,
+                ),
+              ),
+            ),
+            ...tagsList.map((tag) {
+              final displayName = tag.replaceFirst('u.', '');
+              final isContained = BeeperBridgeUtils.isTagContained(client, tag);
+              return SwitchListTile.adaptive(
+                value: isContained,
+                title: Text('Contener etiqueta: $displayName'),
+                subtitle: const Text('Muestra estos chats solo dentro de la etiqueta en el menú lateral.'),
+                onChanged: (val) async {
+                  await BeeperBridgeUtils.setTagContained(client, tag, val);
+                  setState(() {});
+                },
+              );
+            }),
+          ],
+        ],
+      ),
+    );
+  }
+}
