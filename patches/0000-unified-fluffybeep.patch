+
+  /// Normalize mathematical alphanumeric symbols (U+1D400..U+1D7FF) and fullwidth forms (U+FF01..U+FF5E)
+  static String normalizeFancyUnicode(String input) {
+    final buffer = StringBuffer();
+    for (final rune in input.runes) {
+      int char = rune;
+      if (char >= 0x1D400 && char <= 0x1D7FF) {
+        for (final base in const [
+          0x1D400, // Bold
+          0x1D434, // Italic
+          0x1D468, // Bold Italic
+          0x1D49C, // Script
+          0x1D4B6, // Bold Script
+          0x1D4D0, // Fraktur
+          0x1D504, // Double-struck
+          0x1D51E, // Bold Fraktur
+          0x1D56C, // Sans-serif
+          0x1D5A0, // Sans-serif Bold
+          0x1D5D4, // Sans-serif Italic
+          0x1D608, // Sans-serif Bold Italic
+          0x1D670, // Monospace
+        ]) {
+          if (char >= base && char < base + 26) {
+            char = 0x41 + (char - base);
+            break;
+          } else if (char >= base + 26 && char < base + 52) {
+            char = 0x61 + (char - (base + 26));
+            break;
+          }
+        }
+        for (final base in const [0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6]) {
+          if (char >= base && char < base + 10) {
+            char = 0x30 + (char - base);
+            break;
+          }
+        }
+      } else if (char >= 0xFF01 && char <= 0xFF5E) {
+        char = char - 0xFEE0;
+      }
+      buffer.writeCharCode(char);
+    }
+    return buffer.toString();
+  }
+
+  /// Remove accents, emojis, punctuation, bridge tags and normalize
+  static String clean(String input) {
+    var s = normalizeFancyUnicode(input).toLowerCase();
+    // Remove bridge tags like [WhatsApp], [Instagram]
+    s = s.replaceAll(_bridgeTagsRegExp, '');
+    // Remove accents (diacritics)
+    const withDia = 'áàäâãéèëêíìïîóòöôõúùüûñç';
+    const withoutDia = 'aaaaaeeeeiiiiooooouuuunc';
+    for (var i = 0; i < withDia.length; i++) {
+      s = s.replaceAll(withDia[i], withoutDia[i]);
+    }
+    return s.trim();
+  }
+
+  /// Split string into semantic alpha words/tokens (splits on numbers, underscores, dots, whitespace)
+  static List<String> extractTokens(String input) {
+    final cleaned = clean(input);
+    if (cleaned.isEmpty) return const [];
+    // Replace non-alphanumeric with spaces
+    final separated = cleaned.replaceAll(_nonAlphaNumRegExp, ' ');
+    // Split into tokens, separating digit blocks
+    final tokens = <String>[];
+    for (final part in separated.split(_whitespaceRegExp)) {
+      if (part.isEmpty) continue;
+      // Split sub-parts if contains digits, e.g. "ramiro25caraballo" -> "ramiro", "caraballo"
+      final alphaParts = part.split(_digitsRegExp);
+      for (final ap in alphaParts) {
+        final t = ap.trim();
+        if (t.length >= 2) {
+          tokens.add(t);
+        }
+      }
+    }
+    return tokens;
+  }
+
+  /// Check if two tokens are nickname variations of each other
+  static bool isNicknameMatch(String t1, String t2) {
+    if (t1 == t2) return true;
+    for (final entry in _nicknameMap.entries) {
+      final formal = entry.key;
+      final nicks = entry.value;
+      final matches1 = formal == t1 ||
+          nicks.contains(t1) ||
+          t1.startsWith(formal) ||
+          (formal.startsWith(t1) && t1.length >= 3);
+      final matches2 = formal == t2 ||
+          nicks.contains(t2) ||
+          t2.startsWith(formal) ||
+          (formal.startsWith(t2) && t2.length >= 3);
+      if (matches1 && matches2) return true;
+    }
+    return false;
+  }
+
+  /// Sørensen–Dice character bigram similarity (0.0 to 1.0)
+  static double diceBigramSimilarity(String s1, String s2) {
+    final a = clean(s1).replaceAll(RegExp(r'[^a-z0-9]'), '');
+    final b = clean(s2).replaceAll(RegExp(r'[^a-z0-9]'), '');
+    if (a.isEmpty || b.isEmpty) return 0.0;
+    if (a == b) return 1.0;
+    if (a.length < 2 || b.length < 2) {
+      return a == b ? 1.0 : (a.contains(b) || b.contains(a) ? 0.7 : 0.0);
+    }
+
+    final bigramsA = <int, int>{};
+    for (var i = 0; i < a.length - 1; i++) {
+      final code = (a.codeUnitAt(i) << 8) | a.codeUnitAt(i + 1);
+      bigramsA[code] = (bigramsA[code] ?? 0) + 1;
+    }
+
+    var matches = 0;
+    for (var i = 0; i < b.length - 1; i++) {
+      final code = (b.codeUnitAt(i) << 8) | b.codeUnitAt(i + 1);
+      final count = bigramsA[code] ?? 0;
+      if (count > 0) {
+        bigramsA[code] = count - 1;
+        matches++;
+      }
+    }
+
+    final totalBigrams = (a.length - 1) + (b.length - 1);
+    return (2.0 * matches) / totalBigrams;
+  }
+
+  /// Jaro-Winkler string distance (0.0 to 1.0)
+  static double jaroWinkler(String s1, String s2) {
+    if (s1 == s2) return 1.0;
+    if (s1.isEmpty || s2.isEmpty) return 0.0;
+
+    final matchWindow = max(s1.length, s2.length) ~/ 2 - 1;
+    final s1Matches = List<bool>.filled(s1.length, false);
+    final s2Matches = List<bool>.filled(s2.length, false);
+
+    var matches = 0;
+    for (var i = 0; i < s1.length; i++) {
+      final start = max(0, i - matchWindow);
+      final end = min(i + matchWindow + 1, s2.length);
+      for (var j = start; j < end; j++) {
+        if (s2Matches[j] || s1[i] != s2[j]) continue;
+        s1Matches[i] = true;
+        s2Matches[j] = true;
+        matches++;
+        break;
+      }
+    }
+
+    if (matches == 0) return 0.0;
+
+    var transpositions = 0;
+    var k = 0;
+    for (var i = 0; i < s1.length; i++) {
+      if (!s1Matches[i]) continue;
+      while (!s2Matches[k]) {
+        k++;
+      }
+      if (s1[i] != s2[k]) transpositions++;
+      k++;
+    }
+
+    final jaro = (matches / s1.length +
+            matches / s2.length +
+            (matches - transpositions / 2) / matches) /
+        3.0;
+
+    // Winkler prefix bonus
+    var prefix = 0;
+    final maxPrefix = min(4, min(s1.length, s2.length));
+    for (var i = 0; i < maxPrefix; i++) {
+      if (s1[i] == s2[i]) {
+        prefix++;
+      } else {
+        break;
+      }
+    }
+
+    return jaro + prefix * 0.1 * (1.0 - jaro);
+  }
+
+  /// Token-based similarity: splits both inputs into words and matches token pairs
+  static double tokenSimilarity(String s1, String s2) {
+    final tokens1 = extractTokens(s1);
+    final tokens2 = extractTokens(s2);
+    if (tokens1.isEmpty || tokens2.isEmpty) return 0.0;
+
+    var totalScore1 = 0.0;
+    for (final t1 in tokens1) {
+      var bestT1 = 0.0;
+      for (final t2 in tokens2) {
+        if (t1 == t2) {
+          bestT1 = max(bestT1, 1.0);
+        } else if (isNicknameMatch(t1, t2)) {
+          bestT1 = max(bestT1, 0.95);
+        } else if (t1.startsWith(t2) || t2.startsWith(t1)) {
+          final ratio = min(t1.length, t2.length) / max(t1.length, t2.length);
+          bestT1 = max(bestT1, 0.7 + 0.25 * ratio);
+        } else {
+          final jw = jaroWinkler(t1, t2);
+          if (jw > 0.7) bestT1 = max(bestT1, jw);
+        }
+      }
+      totalScore1 += bestT1;
+    }
+
+    var totalScore2 = 0.0;
+    for (final t2 in tokens2) {
+      var bestT2 = 0.0;
+      for (final t1 in tokens1) {
+        if (t1 == t2) {
+          bestT2 = max(bestT2, 1.0);
+        } else if (isNicknameMatch(t1, t2)) {
+          bestT2 = max(bestT2, 0.95);
+        } else if (t1.startsWith(t2) || t2.startsWith(t1)) {
+          final ratio = min(t1.length, t2.length) / max(t1.length, t2.length);
+          bestT2 = max(bestT2, 0.7 + 0.25 * ratio);
+        } else {
+          final jw = jaroWinkler(t1, t2);
+          if (jw > 0.7) bestT2 = max(bestT2, jw);
+        }
+      }
+      totalScore2 += bestT2;
+    }
+
+    final avg1 = totalScore1 / tokens1.length;
+    final avg2 = totalScore2 / tokens2.length;
+    return (avg1 + avg2) / 2.0;
+  }
+
+  /// Hybrid similarity combining Token-level and Character-level matching (0.0 to 1.0, cached)
+  static double matchStrings(String s1, String s2) {
+    if (s1.isEmpty || s2.isEmpty) return 0.0;
+    final c1 = clean(s1);
+    final c2 = clean(s2);
+    if (c1 == c2) return 1.0;
+
+    final key = c1.compareTo(c2) <= 0 ? '$c1::$c2' : '$c2::$c1';
+    final cached = _stringMatchCache[key];
+    if (cached != null) return cached;
+
+    final tokenScore = tokenSimilarity(c1, c2);
+    final diceScore = diceBigramSimilarity(c1, c2);
+
+    final score = max(tokenScore, diceScore);
+    _stringMatchCache[key] = score;
+    if (_stringMatchCache.length > _maxCacheSize) {
+      _stringMatchCache.remove(_stringMatchCache.keys.first);
+    }
+    return score;
+  }
+
+  /// Calculate similarity score between source room (or selected rooms) and a candidate room (0.0 to 1.0, cached O(1))
+  static double computeRoomSimilarity(Room sourceRoom, Room candidateRoom) {
+    if (sourceRoom.id == candidateRoom.id) return 1.0;
+
+    final pairKey = sourceRoom.id.compareTo(candidateRoom.id) <= 0
+        ? '${sourceRoom.id}::${candidateRoom.id}'
+        : '${candidateRoom.id}::${sourceRoom.id}';
+    final cached = _roomSimilarityCache[pairKey];
+    if (cached != null) return cached;
+
+    final sourceData = BeeperBridgeUtils.getRoomData(sourceRoom);
+    final candData = BeeperBridgeUtils.getRoomData(candidateRoom);
+
+    // 1. WhatsApp phone match (exact 1.0)
+    final sPhone = BeeperBridgeUtils.extractWhatsAppPhone(sourceRoom);
+    final cPhone = BeeperBridgeUtils.extractWhatsAppPhone(candidateRoom);
+    if (sPhone != null &&
+        cPhone != null &&
+        sPhone.length >= 7 &&
+        cPhone.length >= 7) {
+      final sTail = sPhone.substring(max(0, sPhone.length - 8));
+      final cTail = cPhone.substring(max(0, cPhone.length - 8));
+      if (sTail == cTail) {
+        _roomSimilarityCache[pairKey] = 1.0;
+        return 1.0;
+      }
+    }
+
+    // 2. Candidate strings from source
+    final sList = <String>[
+      if (sourceData.displayName != null) sourceData.displayName!,
+      sourceRoom.name,
+      if (BeeperBridgeUtils.getAccountHandle(sourceRoom) != null)
+        BeeperBridgeUtils.getAccountHandle(sourceRoom)!,
+    ];
+
+    // 3. Candidate strings from candidate
+    final cList = <String>[
+      if (candData.displayName != null) candData.displayName!,
+      candidateRoom.name,
+      if (BeeperBridgeUtils.getAccountHandle(candidateRoom) != null)
+        BeeperBridgeUtils.getAccountHandle(candidateRoom)!,
+    ];
+
+    // If either room is connected to phone contact, add contact names
+    if (BeeperPhoneContacts.isLoaded) {
+      if (sPhone != null) {
+        final pc = BeeperPhoneContacts.findByPhone(sPhone);
+        if (pc != null) sList.add(pc.displayName);
+      }
+      if (cPhone != null) {
+        final pc = BeeperPhoneContacts.findByPhone(cPhone);
+        if (pc != null) cList.add(pc.displayName);
+      }
+    }
+
+    var maxScore = 0.0;
+    for (final s in sList) {
+      for (final c in cList) {
+        final score = matchStrings(s, c);
+        if (score > maxScore) {
+          maxScore = score;
+        }
+      }
+    }
+
+    _roomSimilarityCache[pairKey] = maxScore;
+    if (_roomSimilarityCache.length > _maxCacheSize) {
+      _roomSimilarityCache.remove(_roomSimilarityCache.keys.first);
+    }
+    return maxScore;
+  }
+}
