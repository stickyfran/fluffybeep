+  Future<void> _requestPhonePermission() async {
+    setState(() => _isLoadingContacts = true);
+    await BeeperPhoneContacts.load(requestPermission: true);
+    if (mounted) {
+      _checkPhoneMatch();
+      _computeSuggestions();
+      setState(() => _isLoadingContacts = false);
+    }
+  }
+
+  Future<void> _saveMerge() async {
+    if (_isSaving || _isUnmerging) return;
+    final client = widget.client;
+    final name = _nameController.text.trim();
+    final isTriple = _matchedPhoneContactId != null ||
+        (_selectedRoomIds.length == 1 &&
+            (BeeperMergeUtils.getCustomWhatsAppPhone(_selectedRoomIds.first) != null ||
+             BeeperMergeUtils.getCustomInstagramHandle(_selectedRoomIds.first) != null));
+
+    if (name.isEmpty || (_selectedRoomIds.length < 2 && !isTriple) || _selectedRoomIds.isEmpty) return;
+
+    setState(() => _isSaving = true);
+    try {
+      await BeeperMergeUtils.addMerge(
+        client,
+        existingMergeId: _existingMergeId,
+        roomIds: _selectedRoomIds.toList(),
+        displayName: name,
+        phoneContactId: _matchedPhoneContactId,
+      );
+      invalidateRoomItemsCache();
+
+      if (mounted) {
+        Navigator.of(context).pop();
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Contacto "$name" fusionado exitosamente (${_selectedRoomIds.length} chats${_matchedPhoneContactId != null ? ' + libreta' : ''})')),
+        );
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _isSaving = false);
+      }
+    }
+  }
+
+  Future<void> _unmerge() async {
+    if (_existingMergeId == null || _isSaving || _isUnmerging) return;
+    final client = widget.client;
+    setState(() => _isUnmerging = true);
+    try {
+      await BeeperMergeUtils.removeMerge(client, _existingMergeId!);
+      invalidateRoomItemsCache();
+      if (mounted) {
+        Navigator.of(context).pop();
+        ScaffoldMessenger.of(context).showSnackBar(
