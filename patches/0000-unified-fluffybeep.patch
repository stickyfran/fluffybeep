+  /// Check if a tag is contained.
+  static bool isTagContained(Client client, String tag) {
+    final labels = getBeeperLabels(client);
+    final displayName = tag.replaceFirst('u.', '');
+    for (final val in labels.values) {
+      if (val is Map && val['title'] == displayName) {
+        return val['isShownInInbox'] == false;
+      }
+    }
+    return false;
+  }
+
+  /// Toggle containment of a custom tag.
+  static Future<void> setTagContained(Client client, String tag, bool contained) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    final displayName = tag.replaceFirst('u.', '');
+    String? foundUuid;
+    Map<String, dynamic>? foundLabel;
+
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map && val['title'] == displayName) {
+        foundUuid = entry.key;
+        foundLabel = Map<String, dynamic>.from(val);
+        break;
+      }
+    }
+
+    final tagRooms = client.rooms
+        .where((r) => r.tags.keys.contains(tag))
+        .map((r) => r.id)
+        .toList();
+
+    if (foundLabel != null && foundUuid != null) {
+      foundLabel['isShownInInbox'] = !contained;
+      final existingRooms = List<String>.from(foundLabel['rooms'] ?? []);
+      for (final rId in tagRooms) {
+        if (contained) {
+          if (!existingRooms.contains(rId)) existingRooms.add(rId);
+        } else {
+          existingRooms.remove(rId);
+        }
+      }
+      foundLabel['rooms'] = existingRooms;
+      labels[foundUuid] = foundLabel;
+    } else if (contained) {
+      final newUuid = 'label_${DateTime.now().millisecondsSinceEpoch}_${tag.replaceAll(".", "_")}';
+      labels[newUuid] = {
+        'title': displayName,
+        'rooms': tagRooms,
+        'isShownInInbox': false,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await setBeeperLabels(client, labels);
+  }
+
+  static final Map<String, DateTime> _lastMessageTimeCache = {};
+
+  static DateTime? getLastMessageTime(String roomId) => _lastMessageTimeCache[roomId];
+
+  static void setLastMessageTime(String roomId, DateTime time) {
+    _lastMessageTimeCache[roomId] = time;
+  }
+
+  static void invalidateLastMessageTime(String roomId) {
+    _lastMessageTimeCache.remove(roomId);
+  }
+
+  /// Optimistic tracking of rooms marked as read locally (roomId -> timestamp in ms).
+  /// Prevents stale sync states from flickering the room back to unread until newer messages arrive.
+  static final Map<String, int> locallyReadRooms = {};
+
+  static void saveLocallyReadTimestamp(String roomId, int milliseconds) {
+    locallyReadRooms[roomId] = milliseconds;
+    if (prefs != null) {
+      prefs?.setInt('beeper_read_ts_$roomId', milliseconds);
+    } else {
+      SharedPreferences.getInstance().then((p) {
+        prefs = p;
+        p.setInt('beeper_read_ts_$roomId', milliseconds);
+      }).catchError((_) {});
+    }
+  }
+
+  static int? getLocallyReadTimestamp(String roomId) {
+    return locallyReadRooms[roomId] ?? prefs?.getInt('beeper_read_ts_$roomId');
+  }
+
+  static void clearLocallyReadTimestamp(String roomId) {
+    locallyReadRooms.remove(roomId);
+    prefs?.remove('beeper_read_ts_$roomId');
+  }
+
+  /// Checks if a room has unread messages, factoring in optimistic local read suppression.
+  static bool isRoomUnread(Room room) {
+    final readTs = getLocallyReadTimestamp(room.id);
+    if (readTs != null) {
+      final lastMsgTs = getLastMessageTime(room.id)?.millisecondsSinceEpoch ??
+          room.lastEvent?.originServerTs.millisecondsSinceEpoch ??
+          getCachedLastTimestamp(room.id) ??
+          0;
+      if (lastMsgTs <= readTs && !room.markedUnread) {
+        return false;
+      } else if (lastMsgTs > readTs) {
+        clearLocallyReadTimestamp(room.id);
+      }
+    }
+    // If the last real message in this room was sent by the current user
+    // (the user already responded either here or from another client/web/phone),
+    // or if the last real message is from me, suppress unread status.
+    if (!room.markedUnread) {
+      final myUserId = room.client.userID;
+      final lastReal = findLastRealMessageFast(room);
+      if (lastReal != null && lastReal.senderId == myUserId) {
+        return false;
+      }
+    }
+
+    // A room is unread if marked unread explicitly, or has real unread notifications,
+    // or SDK reports unread/new messages.
+    return room.isUnreadOrInvited ||
+        room.hasNewMessages ||
+        room.isUnread ||
+        room.markedUnread ||
+        room.notificationCount > 0;
+  }
+
+  /// Returns the last real message event in a room, skipping state events
+  static bool isRealMessageType(String type) {
+    return type == EventTypes.Message ||
+        type == EventTypes.Encrypted ||
+        type == EventTypes.Sticker;
+  }
+
+  /// Returns the last real message in a room, checking lastEvent, in-memory caches,
+  /// and loaded timeline if available.
+  static Event? findLastRealMessageFast(Room room, {Timeline? timeline}) {
+    final lastEvent = room.lastEvent;
+    if (lastEvent != null && isRealMessageType(lastEvent.type)) {
+      return lastEvent;
+    }
+
+    final cached = lastRealMessageCache[room.id];
+    if (cached != null && isRealMessageType(cached.type)) {
+      return cached;
+    }
+
+    if (timeline != null && timeline.events.isNotEmpty) {
+      for (final ev in timeline.events) {
+        if (isRealMessageType(ev.type)) {
+          lastRealMessageCache[room.id] = ev;
+          return ev;
+        }
+      }
+    }
+
+    return (lastEvent?.type.startsWith('com.beeper') == true ? null : lastEvent);
+  }
+
+  /// Returns the last real message event in a room, skipping state events
+  /// and other technical events (e.g. m.room.member, m.room.topic, etc.).
+  /// Only returns events of type m.room.message, m.room.encrypted, or m.sticker.
+  static Event? getLastRealMessage(Room room) {
+    final lastEvent = room.lastEvent;
+    if (lastEvent != null && isRealMessageType(lastEvent.type)) {
+      return lastEvent;
+    }
+
+    return null;
+  }
+
+  /// Returns the last incoming real message event in a room (senderId != client.userID).
+  /// Essential for Beeper bridges (e.g. WhatsApp, Telegram) which ignore read receipts
+  /// pointing to outbound user events (e.g. when the user already replied from desktop/web).
+  static Event? getLastIncomingRealMessage(Room room, {Timeline? timeline}) {
+    final myUserId = room.client.userID;
+
+    if (timeline != null) {
+      for (final ev in timeline.events) {
+        if (ev.senderId != myUserId && isRealMessageType(ev.type)) {
+          return ev;
+        }
+      }
+    }
+
+    // Check cached real message first if not from me
+    final cached = lastRealMessageCache[room.id];
+    if (cached != null && cached.senderId != myUserId && isRealMessageType(cached.type)) {
+      return cached;
+    }
+
+    // Check lastEvent
+    final lastEvent = room.lastEvent;
+    if (lastEvent != null && lastEvent.senderId != myUserId && isRealMessageType(lastEvent.type)) {
+      return lastEvent;
+    }
+
+    return null;
+  }
+
+  /// Asynchronously finds the last incoming real message event in a room (senderId != client.userID),
+  /// searching the provided timeline, caches, and falling back to database history.
+  static Future<Event?> findLastIncomingRealMessage(Room room, {Timeline? timeline}) async {
+    final syncResult = getLastIncomingRealMessage(room, timeline: timeline);
+    if (syncResult != null) return syncResult;
+
+    final myUserId = room.client.userID;
+    try {
+      final events = await room.client.database.getEventList(room, limit: 20);
+      for (final ev in events) {
+        if (ev.senderId != myUserId && isRealMessageType(ev.type)) {
+          return ev;
+        }
+      }
+    } catch (_) {}
+
+    return null;
+  }
+
+  static final RegExp _leadingPrefixHtmlRegExp = RegExp(r'^<p>\s*\[[^\]]+\]\s*');
+  static final RegExp _leadingPrefixPlainRegExp = RegExp(r'^\s*\[[^\]]+\]\s*');
+
+  /// Strips leading bridge prefixes like [WhatsApp], [Telegram], [Signal], etc.
+  /// when AppSettings.hideNetworkPrefixInNotification is enabled.
+  static String stripNetworkPrefix(String text) {
+    if (!AppSettings.hideNetworkPrefixInNotification.value) return text;
+    if (text.startsWith('<p>[')) {
+      return text.replaceFirst(_leadingPrefixHtmlRegExp, '<p>');
+    }
+    return text.replaceFirst(_leadingPrefixPlainRegExp, '');
+  }
+
+  /// Global notifier that broadcasts when a room has been marked as read locally
+  static final ValueNotifier<String?> roomReadChangeNotifier = ValueNotifier<String?>(null);
+
+  /// Unified, robust method to mark a room as read with immediate local feedback,
+  /// notification clearing, and retry loop on connection hiccups.
+  static Future<void> markRoomAsRead(
+    Room room, {
+    String? targetEventId,
+    Timeline? timeline,
+    bool publicReceipt = true,
+  }) async {
+    // 1. Optimistically mark as read locally and persist timestamp to disk
+    final nowTs = DateTime.now().millisecondsSinceEpoch;
+    saveLocallyReadTimestamp(room.id, nowTs);
+    room.notificationCount = 0;
+    room.highlightCount = 0;
+    if (room.markedUnread) {
+      await room.markUnread(false).catchError((_) {});
+    }
+
+    // 2. Resolve target incoming event for mRead (crucial for WhatsApp/Telegram bridges):
+    // Prioritize the latest incoming real message in the room so the bridge marks all incoming
+    // messages read, even if a specific older message was quoted/replied to.
+    final latestIncoming = await findLastIncomingRealMessage(room, timeline: timeline);
+    final mReadId = latestIncoming?.eventId ?? targetEventId;
+
+    // Resolve fullyRead ID (advances to latest event in room so no unread banners remain):
+    final anyRealMsg = findLastRealMessageFast(room, timeline: timeline);
+    final fullyReadId = room.lastEvent?.eventId ??
+        anyRealMsg?.eventId ??
+        mReadId ??
+        room.fullyRead;
+
+    // 3. Clear system notifications & update app badge
+    if (PlatformInfos.isMobile) {
+      try {
+        final notifId = '${room.client.clientName}_${room.id}'.hashCode;
+        await FlutterLocalNotificationsPlugin().cancel(id: notifId);
+      } catch (_) {}
+    }
+    final unreadCount = room.client.rooms.where((r) => isRoomUnread(r) || r.membership == Membership.invite).length;
+    updateAppBadge(unreadCount);
+
+    // 4. Notify listeners (such as ChatListController) immediately
+    roomReadChangeNotifier.value = room.id;
+
+    // 5. Send read marker with up to 3 retries
+    if (fullyReadId != null && fullyReadId.isNotEmpty) {
+      for (int attempt = 0; attempt < 3; attempt++) {
+        try {
+          await room.setReadMarker(
+            fullyReadId,
+            mRead: mReadId ?? fullyReadId,
+            public: publicReceipt,
+          );
+          break;
+        } catch (e) {
+          if (attempt == 2) {
+            Logs().w('Failed to setReadMarker after 3 attempts', e);
+          } else {
+            await Future.delayed(const Duration(milliseconds: 400));
+          }
+        }
+      }
+    }
+  }
+}
+
+class BeeperNetwork {
+  final String name;
+  final int colorHex;
+  final String key;
+  const BeeperNetwork(this.name, this.colorHex, this.key);
+}
+
+class BeeperNetSpec {
+  final String name;
+  final int colorHex;
+  const BeeperNetSpec(this.name, this.colorHex);
+}
+
+extension RoomBeeperExtension on Room {
+  BeeperRoomData get _beeperData => BeeperBridgeUtils.getRoomData(this);
+
+  String? get beeperContactId => _beeperData.contactId;
+  bool get isBeeperFakeDM => _beeperData.isFakeDM;
+  Uri? get beeperAvatarUrl => _beeperData.avatarUrl;
+  String? get beeperPhone => BeeperBridgeUtils.extractWhatsAppPhone(this);
+
+  String getBeeperDisplayname(MatrixLocalizations locals) {
+    final raw = _beeperData.displayName ?? getLocalizedDisplayname(locals);
+    return BeeperBridgeUtils.sanitizeDisplayName(raw);
+  }
+}
