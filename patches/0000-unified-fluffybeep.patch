+    bool useDeviceSpecificAppId = false,
+  }) async {
+    await FileLogger.log('[UnifiedPush] setupPusher started for client: ${client.clientName}, useDeviceSpecificAppId: $useDeviceSpecificAppId');
+    if (PlatformInfos.isIOS) {
+      //<GOOGLE_SERVICES>await firebase.requestPermission();
+    }
+    if (PlatformInfos.isAndroid && !isIntegrationTest) {
+      _flutterLocalNotificationsPlugin
+          .resolvePlatformSpecificImplementation<
+            AndroidFlutterLocalNotificationsPlugin
+          >()
+          ?.requestNotificationsPermission();
+    }
+    final appDisplayName = PlatformInfos.appDisplayName;
+
+    final pushers =
+        await (client.getPushers().then((value) {
+          FileLogger.log('[UnifiedPush] Fetched ${value?.length} existing pushers from server.');
+          return value;
+        }).catchError((e) {
+          Logs().w('[Push] Unable to request pushers', e);
+          FileLogger.log('[UnifiedPush] Error fetching existing pushers: $e');
+          return <Pusher>[];
+        })) ??
+        [];
+
+    // Just the plain app id, we add the .data_message suffix later
+    var appId = AppConfig.pushNotificationsAppId;
+    // we need the deviceAppId to remove potential legacy UP pusher
+    var deviceAppId = '$appId.${client.deviceID}';
+    // appId may only be up to 64 chars as per spec
+    if (deviceAppId.length > 64) {
+      deviceAppId = deviceAppId.substring(0, 64);
+    }
+    if (!useDeviceSpecificAppId && PlatformInfos.isAndroid) {
+      appId += '.data_message';
+    }
+    final thisAppId = useDeviceSpecificAppId ? deviceAppId : appId;
+    if (gatewayUrl == null || token == null) {
+      Logs().w('[Push] Missing required push credentials');
+      await FileLogger.log('[UnifiedPush] Missing required push credentials: gatewayUrl=$gatewayUrl, token=$token');
+      return;
+    }
+
+    await FileLogger.log('[UnifiedPush] Target configuration: appId=$thisAppId, token=$token, gatewayUrl=$gatewayUrl');
+
+    if (pushers.any(
+      (currentPusher) =>
+          currentPusher.pushkey == token &&
+          currentPusher.data.additionalProperties['client_name'] ==
+              client.clientName &&
+          currentPusher.kind == 'http' &&
+          currentPusher.appId == thisAppId &&
+          currentPusher.appDisplayName == appDisplayName &&
+          currentPusher.deviceDisplayName == client.deviceName &&
+          currentPusher.lang == 'en' &&
+          currentPusher.data.url.toString() == gatewayUrl &&
+          currentPusher.data.format ==
+              AppSettings.pushNotificationsPusherFormat.value &&
+          currentPusher.data.additionalProperties['data_message'] ==
+              pusherDataMessageFormat,
+    )) {
+      Logs().i('[Push] Pusher already set for ${client.clientName}');
+      await FileLogger.log('[UnifiedPush] Pusher already set and matching on server. Skip posting.');
+      return;
+    }
+
+    if (!client.isLogged()) {
+      await FileLogger.log('[UnifiedPush] Client not logged in. Cannot post pusher.');
+      return;
+    }
+
+    final legacyPushers = pushers.where(
+      (pusher) =>
+          pusher.kind == 'http' &&
+          (pusher.pushkey == token ||
+              pusher.appId.startsWith(AppConfig.pushNotificationsAppId)),
+    );
+    for (final pusher in legacyPushers) {
+      try {
+        await client.deletePusher(pusher);
+        Logs().i('[Push] Removed legacy pusher for ${client.clientName}');
+        await FileLogger.log('[UnifiedPush] Removed legacy/conflicting pusher: ${pusher.appId}');
+      } catch (err) {
+        Logs().w(
+          '[Push] Failed to remove old pusher for ${client.clientName}',
+          err,
+        );
+        await FileLogger.log('[UnifiedPush] Failed to remove legacy pusher: $err');
+      }
+    }
+
+    Logs().i('Need to set new pusher for ${client.clientName}');
+    await FileLogger.log('[UnifiedPush] Need to register new pusher. Sending postPusher...');
+    try {
+      await client.postPusher(
+        Pusher(
+          pushkey: token,
+          appId: thisAppId,
+          appDisplayName: appDisplayName,
+          deviceDisplayName: PlatformInfos.appDisplayName,
+          lang: 'en',
+          data: PusherData(
+            url: Uri.parse(gatewayUrl),
+            format: AppSettings.pushNotificationsPusherFormat.value,
+            additionalProperties: {
+              'client_name': client.clientName,
+              'data_message': pusherDataMessageFormat,
+            },
+          ),
+          kind: 'http',
+        ),
+        append: true,
+      );
+      await FileLogger.log('[UnifiedPush] postPusher completed successfully!');
+    } catch (e, s) {
+      Logs().e('[Push] Unable to set pushers', e, s);
+      await FileLogger.log('[UnifiedPush] CRITICAL: postPusher failed! Error: $e\nStacktrace:\n$s');
+    }
+  }
+
+  final pusherDataMessageFormat = Platform.isAndroid
+      ? 'android'
+      : Platform.isIOS
+      ? 'ios'
+      : null;
+
+  static bool _wentToRoomOnStartup = false;
+
+  Future<void> setupPush() async {
+    final context = matrix?.context;
+    if (PlatformInfos.isAndroid &&
+        (await UnifiedPush.getDistributors()).isNotEmpty &&
+        context != null &&
+        context.mounted) {
+      await UnifiedPushUi(
+        context: context,
+        instances: ['default'],
+        unifiedPushFunctions: UPFunctions(),
+        showNoDistribDialog: false,
+        onNoDistribDialogDismissed: () {}, // TODO: Implement me
+      ).registerAppWithDialog();
+
+      final savedEndpoint = AppSettings.unifiedPushEndpoint.value;
+      final isRegistered = AppSettings.unifiedPushRegistered.value;
+      if (isRegistered && savedEndpoint.isNotEmpty) {
+        await FileLogger.log('[UnifiedPush] Startup: Force verifying pusher with saved endpoint: $savedEndpoint');
+        var endpoint = 'https://matrix.gateway.unifiedpush.org/_matrix/push/v1/notify';
+        try {
+          final prefs = await SharedPreferences.getInstance();
+          final forcePublic = prefs.getBool('beeper_force_public_push_gateway') ?? false;
+          if (!forcePublic) {
+            final url = Uri.parse(savedEndpoint)
+                .replace(path: '/_matrix/push/v1/notify', query: '')
+                .toString()
+                .split('?')
+                .first;
+            final res = json.decode(
+              utf8.decode((await http.get(Uri.parse(url))).bodyBytes),
+            );
+            if (res['gateway'] == 'matrix' ||
+                (res['unifiedpush'] is Map &&
+                    res['unifiedpush']['gateway'] == 'matrix')) {
+              endpoint = url;
+            }
+          }
+        } catch (_) {}
+        for (final client in clients) {
+          await setupPusher(
+            client: client,
+            gatewayUrl: endpoint,
+            token: savedEndpoint,
+            useDeviceSpecificAppId: false,
+          );
+        }
+      }
+
+      if (Platform.isAndroid) {
+        final isExempted = await BackgroundPush.isIgnoringBatteryOptimizations();
+        if (!isExempted && context.mounted) {
+          await Future.delayed(const Duration(milliseconds: 800));
+          await BackgroundPush.requestBatteryOptimizationExemption();
+        }
+      }
+    } else {
+      for (final client in clients) {
+        Logs().d('SetupPush for Client ${client.clientName}');
+        if (client.onLoginStateChanged.value != LoginState.loggedIn ||
+            !PlatformInfos.isMobile ||
+            matrix == null) {
+          return;
+        }
+        // Do not setup unifiedpush if this has been initialized by
+        // an unifiedpush action
+        if (upAction) {
+          return;
+        }
+        await setupFirebase(client);
+      }
+    }
+
+    if (clients.isNotEmpty) {
+      await syncAndroidNotificationChannels(
+        client: clients.first,
+        flutterLocalNotificationsPlugin: _flutterLocalNotificationsPlugin,
+        l10n: l10n,
+      );
+    }
+
+    // ignore: unawaited_futures
+    _flutterLocalNotificationsPlugin.getNotificationAppLaunchDetails().then((
+      details,
+    ) {
+      if (details == null ||
+          !details.didNotificationLaunchApp ||
+          _wentToRoomOnStartup) {
+        return;
+      }
+      _wentToRoomOnStartup = true;
+      final response = details.notificationResponse;
+      if (response != null) {
+        notificationTap(
+          response,
+          clients: clients,
+          router: FluffyChatApp.router,
+          l10n: l10n,
+        );
+      }
+    });
+  }
+
+  Future<void> _noFcmWarning() async {
+    return; // Beeper Patch: Disable Firebase missing warning completely
+  }
+
+  /// Requests the user to exempt the app from battery optimizations.
+  /// Without this, Android (Doze Mode) can delay or drop ntfy broadcasts.
+  static Future<bool> requestBatteryOptimizationExemption() async {
+    if (!Platform.isAndroid) return true;
+    try {
+      final isIgnoring = await FlutterForegroundTask.isIgnoringBatteryOptimizations;
+      if (isIgnoring) {
+        Logs().v('[Push] Battery optimization already exempted.');
+        return true;
+      }
+      Logs().i('[Push] Requesting battery optimization exemption...');
+      await FlutterForegroundTask.requestIgnoreBatteryOptimization();
+      return false;
+    } catch (e, s) {
+      Logs().w('[Push] Failed to request battery optimization exemption', e, s);
+      return false;
+    }
+  }
+
+  /// Checks if the app is currently ignoring battery optimizations.
+  static Future<bool> isIgnoringBatteryOptimizations() async {
+    if (!Platform.isAndroid) return true;
+    try {
+      return await FlutterForegroundTask.isIgnoringBatteryOptimizations;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  Future<void> setupFirebase(Client client) async {
+    Logs().v('Setup firebase');
+    if (!firebaseEnabled) {
+      await _noFcmWarning();
+      return;
+    }
+    if (_fcmToken?.isEmpty ?? true) {
+      if (PlatformInfos.isIOS) {
+        //<GOOGLE_SERVICES>await firebase.requestPermission();
+      }
+      const max = 5;
+      for (var i = 0; i < max; i++) {
+        try {
+          await Future.delayed(const Duration(seconds: 1));
+          //<GOOGLE_SERVICES>_fcmToken = await firebase.getToken();
+          if (_fcmToken != null) break;
+        } catch (e, s) {
+          Logs().w(
+            '[Push] cannot get token - try ($i/$max)',
+            e,
+            e is String ? null : s,
+          );
+        }
+      }
+      if (_fcmToken == null) {
+        await _noFcmWarning();
+        return;
+      }
+    }
+    await setupPusher(
+      client: client,
+      gatewayUrl: AppSettings.pushNotificationsGatewayUrl.value,
+      token: _fcmToken,
+    );
+  }
+
+  Future<void> _newUpEndpoint(PushEndpoint newPushEndpoint, String i) async {
+    final newEndpoint = newPushEndpoint.url;
+    upAction = true;
+    await FileLogger.log('[UnifiedPush] _newUpEndpoint triggered with endpoint: $newEndpoint');
+    if (newEndpoint.isEmpty) {
+      await FileLogger.log('[UnifiedPush] Endpoint is empty, unregistering...');
+      await _upUnregistered(i);
+      return;
+    }
+    var endpoint =
+        'https://matrix.gateway.unifiedpush.org/_matrix/push/v1/notify';
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final forcePublic = prefs.getBool('beeper_force_public_push_gateway') ?? false;
+      if (!forcePublic) {
+        final url = Uri.parse(newEndpoint)
+            .replace(path: '/_matrix/push/v1/notify', query: '')
+            .toString()
+            .split('?')
+            .first;
+        await FileLogger.log('[UnifiedPush] Checking self-hosted gateway URL: $url');
+        final res = json.decode(
+          utf8.decode((await http.get(Uri.parse(url))).bodyBytes),
+        );
+        if (res['gateway'] == 'matrix' ||
+            (res['unifiedpush'] is Map &&
+                res['unifiedpush']['gateway'] == 'matrix')) {
+          endpoint = url;
+          await FileLogger.log('[UnifiedPush] Self-hosted gateway detected successfully!');
+        }
+      } else {
+        await FileLogger.log('[UnifiedPush] Forcing public UnifiedPush gateway as per settings (beeper_force_public_push_gateway = true)');
+      }
+    } catch (e) {
+      Logs().i(
+        '[Push] No self-hosted unified push gateway present: $newEndpoint',
+      );
+      await FileLogger.log('[UnifiedPush] Self-hosted check failed (expected if using public/standard ntfy.sh): $e. Using fallback endpoint.');
+    }
+    Logs().i('[Push] UnifiedPush using endpoint $endpoint');
+    await FileLogger.log('[UnifiedPush] UnifiedPush will register using gateway endpoint: $endpoint');
+
+    for (final client in clients) {
+      await setupPusher(
+        client: client,
+        gatewayUrl: endpoint,
+        token: newEndpoint,
+        useDeviceSpecificAppId: false,
+      );
+    }
+    await AppSettings.unifiedPushEndpoint.setItem(newEndpoint);
+    await AppSettings.unifiedPushRegistered.setItem(true);
+    await FileLogger.log('[UnifiedPush] Registration settings saved to disk (registered=true)');
+  }
+
+  Future<void> _upUnregistered(String i) async {
+    upAction = true;
+    Logs().i('[Push] Removing UnifiedPush endpoint...');
+    await FileLogger.log('[UnifiedPush] _upUnregistered triggered. Clearing endpoint from settings...');
+    await AppSettings.unifiedPushEndpoint.setItem(
+      AppSettings.unifiedPushEndpoint.defaultValue,
+    );
+    await AppSettings.unifiedPushRegistered.setItem(false);
+  }
+
+  Future<void> _onUpMessage(PushMessage pushMessage, String i) async {
+    await FileLogger.log('[UnifiedPush] _onUpMessage triggered');
+
+    bool foregroundServiceStarted = false;
+    if (Platform.isAndroid) {
+      try {
+        FlutterForegroundTask.init(
+          androidNotificationOptions: AndroidNotificationOptions(
+            channelId: 'push_processing',
+            channelName: 'Push Processing',
+            channelDescription: 'Processing incoming message',
+            importance: NotificationImportance.LOW,
+            enableVibration: false,
+            playSound: false,
+          ),
+          iosNotificationOptions: const IOSNotificationOptions(
+            showNotification: false,
+          ),
+          foregroundTaskOptions: ForegroundTaskOptions(
+            eventAction: ForegroundTaskEventAction.nothing(),
+            allowWakeLock: true,
+          ),
+        );
+        final result = await FlutterForegroundTask.startService(
+          serviceId: _pushProcessingServiceId,
+          serviceTypes: [ForegroundServiceTypes.remoteMessaging],
+          notificationTitle: 'FluffyBeep',
+          notificationText: 'Procesando notificación...',
+        );
+        foregroundServiceStarted = result.success;
+        await FileLogger.log('[UnifiedPush] Foreground service started: ${result.success}');
+      } catch (e) {
+        await FileLogger.log('[UnifiedPush] Could not start foreground service: $e. Continuing without it.');
+      }
+    }
+
+    final pushIsolateReceivePort = ReceivePort();
+    IsolateNameServer.removePortNameMapping(AppConfig.pushIsolatePortName);
+    IsolateNameServer.registerPortWithName(
+      pushIsolateReceivePort.sendPort,
+      AppConfig.pushIsolatePortName,
+    );
+    try {
+      final messageContentStr = utf8.decode(pushMessage.content);
+      await FileLogger.log('[UnifiedPush] Payload received: $messageContentStr');
+      upAction = true;
+      final rawJson = json.decode(messageContentStr);
+      final notificationMap = (rawJson is Map && rawJson.containsKey('notification') && rawJson['notification'] is Map)
+          ? rawJson['notification'] as Map
+          : (rawJson is Map ? rawJson : <String, dynamic>{});
+      final data = Map<String, dynamic>.from(notificationMap);
+      // UP may strip the devices list
+      data['devices'] ??= [];
+      await FileLogger.log('[UnifiedPush] Starting pushHelper sync...');
+      await pushHelper(
+        PushNotification.fromJson(data),
+        clients: clients,
+        l10n: l10n,
+        activeRoomId: matrix?.activeRoomId,
+        flutterLocalNotificationsPlugin: _flutterLocalNotificationsPlugin,
+        useNotificationActions: false,
+      );
+      await FileLogger.log('[UnifiedPush] Finished pushHelper sync successfully');
+    } catch (e, s) {
+      await FileLogger.log('[UnifiedPush] CRITICAL ERROR in _onUpMessage: $e\nStacktrace:\n$s');
+      rethrow;
+    } finally {
+      IsolateNameServer.removePortNameMapping(AppConfig.pushIsolatePortName);
+      pushIsolateReceivePort.close();
+      if (foregroundServiceStarted) {
+        try {
+          await FlutterForegroundTask.stopService();
+          await FileLogger.log('[UnifiedPush] Foreground service stopped.');
+        } catch (e) {
+          await FileLogger.log('[UnifiedPush] Failed to stop foreground service: $e');
+        }
+      }
+    }
+  }
+}
+
+class UPFunctions extends UnifiedPushFunctions {
+  final List<String> features = [
+    /*list of features*/
+  ];
+
+  @override
+  Future<String?> getDistributor() async {
+    return await UnifiedPush.getDistributor();
+  }
+
+  @override
+  Future<List<String>> getDistributors() async {
+    return await UnifiedPush.getDistributors(features);
+  }
+
+  @override
+  Future<void> registerApp(String instance) async {
+    await UnifiedPush.register(instance: instance, features: features);
+  }
+
+  @override
+  Future<void> saveDistributor(String distributor) async {
+    await UnifiedPush.saveDistributor(distributor);
+  }
+}
