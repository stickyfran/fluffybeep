--- /dev/null
+++ b/lib/utils/room_sort_isolate.dart
@@ -0,0 +1,28 @@
+import 'package:matrix/matrix.dart';
+
+class RoomSortData {
+  final String id;
+  final int timestamp;
+  final bool isFavourite;
+  final bool isLowPriority;
+
+  const RoomSortData({
+    required this.id,
+    required this.timestamp,
+    required this.isFavourite,
+    required this.isLowPriority,
+  });
+}
+
+List<String> sortRoomsInIsolate(List<RoomSortData> data) {
+  data.sort((a, b) {
+    if (a.isFavourite && !b.isFavourite) return -1;
+    if (!a.isFavourite && b.isFavourite) return 1;
+    if (a.isLowPriority && !b.isLowPriority) return 1;
+    if (!a.isLowPriority && b.isLowPriority) return -1;
+
+    return b.timestamp.compareTo(a.timestamp);
+  });
+
+  return data.map((d) => d.id).toList();
+}
diff --git a/lib/utils/scheduled_message_service.dart b/lib/utils/scheduled_message_service.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2d81a70a3ea954adc9fc15e2d91131d833f6071e
--- /dev/null
+++ b/lib/utils/scheduled_message_service.dart
@@ -0,0 +1,263 @@
+// SPDX-FileCopyrightText: 2024-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:collection/collection.dart';
+import 'package:flutter/widgets.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../config/setting_keys.dart';
+import 'beeper_bridge_utils.dart';
+
+class ScheduledMessage {
+  final String id;
+  final String roomId;
+  final String body;
+  final DateTime scheduledAt;
+  final String? inReplyToId;
+  final String? editEventId;
+  final String? threadRootEventId;
+
+  const ScheduledMessage({
+    required this.id,
+    required this.roomId,
+    required this.body,
+    required this.scheduledAt,
+    this.inReplyToId,
+    this.editEventId,
+    this.threadRootEventId,
+  });
+
+  Map<String, dynamic> toJson() => {
+    'id': id,
+    'roomId': roomId,
+    'body': body,
+    'scheduledAt': scheduledAt.millisecondsSinceEpoch,
+    if (inReplyToId != null) 'inReplyToId': inReplyToId,
+    if (editEventId != null) 'editEventId': editEventId,
+    if (threadRootEventId != null) 'threadRootEventId': threadRootEventId,
+  };
+
+  factory ScheduledMessage.fromJson(Map<String, dynamic> json) =>
+      ScheduledMessage(
+        id: json['id'] as String,
+        roomId: json['roomId'] as String,
+        body: json['body'] as String,
+        scheduledAt: DateTime.fromMillisecondsSinceEpoch(
+          json['scheduledAt'] as int,
+        ),
+        inReplyToId: json['inReplyToId'] as String?,
+        editEventId: json['editEventId'] as String?,
+        threadRootEventId: json['threadRootEventId'] as String?,
+      );
+}
+
+class ScheduledMessageService extends ChangeNotifier with WidgetsBindingObserver {
+  static final ScheduledMessageService _instance =
+      ScheduledMessageService._internal();
+  factory ScheduledMessageService() => _instance;
+
+  ScheduledMessageService._internal();
+
+  static const String _storageKey = 'fluffybeep_scheduled_messages';
+
+  final List<ScheduledMessage> _messages = [];
+  Timer? _activeTimer;
+  List<Client> _clients = [];
+  bool _initialized = false;
+
+  List<ScheduledMessage> get allMessages => List.unmodifiable(_messages);
+
+  Future<void> init({List<Client>? clients}) async {
+    if (clients != null) {
+      _clients = clients;
+    }
+    if (_initialized) {
+      _scheduleNextTimer();
+      return;
+    }
+    _initialized = true;
+    WidgetsBinding.instance.addObserver(this);
+
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final rawList = prefs.getStringList(_storageKey) ?? [];
+      _messages.clear();
+      for (final raw in rawList) {
+        try {
+          final map = jsonDecode(raw) as Map<String, dynamic>;
+          _messages.add(ScheduledMessage.fromJson(map));
+        } catch (e) {
+          Logs().w('[ScheduledMessageService] Error parsing item: $e');
+        }
+      }
+    } catch (e) {
+      Logs().w('[ScheduledMessageService] Error reading store: $e');
+    }
+
+    await checkOverdueMessages();
+    _scheduleNextTimer();
+    notifyListeners();
+  }
+
+  void setClients(List<Client> clients) {
+    _clients = clients;
+  }
+
+  void addClient(Client client) {
+    if (!_clients.contains(client)) {
+      _clients.add(client);
+    }
+  }
+
+  List<ScheduledMessage> getMessagesForRoom(String roomId) {
+    return _messages
+        .where((m) => m.roomId == roomId)
+        .toList()
+      ..sort((a, b) => a.scheduledAt.compareTo(b.scheduledAt));
+  }
+
+  Future<void> scheduleMessage({
+    required String roomId,
+    required String body,
+    required DateTime scheduledAt,
+    String? inReplyToId,
+    String? editEventId,
+    String? threadRootEventId,
+  }) async {
+    final msg = ScheduledMessage(
+      id: '${DateTime.now().millisecondsSinceEpoch}_${roomId.hashCode}',
+      roomId: roomId,
+      body: body,
+      scheduledAt: scheduledAt,
+      inReplyToId: inReplyToId,
+      editEventId: editEventId,
+      threadRootEventId: threadRootEventId,
+    );
+
+    _messages.add(msg);
+    await _save();
+    _scheduleNextTimer();
+    notifyListeners();
+  }
+
+  Future<void> cancelMessage(String id) async {
+    _messages.removeWhere((m) => m.id == id);
+    await _save();
+    _scheduleNextTimer();
+    notifyListeners();
+  }
+
+  Future<void> sendNow(String id) async {
+    final msg = _messages.firstWhereOrNull((m) => m.id == id);
+    if (msg == null) return;
+    await _dispatchMessage(msg);
+  }
+
+  Future<void> _save() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final list = _messages.map((m) => jsonEncode(m.toJson())).toList();
+      await prefs.setStringList(_storageKey, list);
+    } catch (e) {
+      Logs().w('[ScheduledMessageService] Error saving messages: $e');
+    }
+  }
+
+  void _scheduleNextTimer() {
+    _activeTimer?.cancel();
+    _activeTimer = null;
+
+    if (_messages.isEmpty) return;
+
+    _messages.sort((a, b) => a.scheduledAt.compareTo(b.scheduledAt));
+    final next = _messages.first;
+    final diff = next.scheduledAt.difference(DateTime.now());
+
+    if (diff <= Duration.zero) {
+      // Overdue or immediate
+      unawaited(_dispatchMessage(next));
+    } else {
+      // Zero-polling: a single kernel timer scheduled for the exact duration
+      _activeTimer = Timer(diff, () {
+        unawaited(_dispatchMessage(next));
+      });
+    }
+  }
+
+  Future<void> _dispatchMessage(ScheduledMessage msg) async {
+    _messages.removeWhere((m) => m.id == msg.id);
+    await _save();
+    _scheduleNextTimer();
+    notifyListeners();
+
+    Room? targetRoom;
+    for (final client in _clients) {
+      targetRoom = client.getRoomById(msg.roomId);
+      if (targetRoom != null) break;
+    }
+
+    if (targetRoom == null) {
+      Logs().w(
+        '[ScheduledMessageService] Target room ${msg.roomId} not found across clients.',
+      );
+      return;
+    }
+
+    Event? inReplyToEvent;
+    if (msg.inReplyToId != null) {
+      try {
+        final timeline = await targetRoom.getTimeline();
+        inReplyToEvent = timeline.events.firstWhereOrNull(
+          (e) => e.eventId == msg.inReplyToId,
+        );
+      } catch (_) {}
+    }
+
+    try {
+      await targetRoom.sendTextEvent(
+        msg.body,
+        inReplyTo: inReplyToEvent,
+        editEventId: msg.editEventId,
+        threadRootEventId: msg.threadRootEventId,
+        parseCommands: true,
+      );
+      BeeperBridgeUtils.markRoomAsRead(
+        targetRoom,
+        publicReceipt: AppSettings.sendPublicReadReceipts.value,
+      );
+    } catch (e, s) {
+      Logs().e('[ScheduledMessageService] Failed to send scheduled message', e, s);
+    }
+  }
+
+  Future<void> checkOverdueMessages() async {
+    final now = DateTime.now();
+    final overdue = _messages
+        .where((m) => m.scheduledAt.isBefore(now))
+        .toList();
+
+    for (final msg in overdue) {
+      await _dispatchMessage(msg);
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      unawaited(checkOverdueMessages());
+      _scheduleNextTimer();
+    }
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _activeTimer?.cancel();
+    super.dispose();
+  }
+}
