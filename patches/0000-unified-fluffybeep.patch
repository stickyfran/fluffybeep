+class SettingsPatches extends StatefulWidget {
+  const SettingsPatches({super.key});
+
+  @override
+  State<SettingsPatches> createState() => _SettingsPatchesState();
+}
+
+class _SettingsPatchesState extends State<SettingsPatches> {
+  int _logSize = 0;
+  bool _debugLoggingEnabled = false;
+  bool _logRoomOrderEnabled = false;
+  bool _forcePublicPushGateway = false;
+  bool _manualReadReceipts = false;
+  bool _manualReadShowBanner = true;
+  bool _manualReadShowBottom = true;
+  bool _manualReadShowInputBar = true;
+  bool _showJumpBanner = true;
+  List<Pusher>? _pushers;
+  bool _loadingPushers = false;
+  bool _didLoadPushers = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadAllSettings();
+  }
+
+  Future<void> _loadAllSettings() async {
+    final prefs = await SharedPreferences.getInstance();
+    final logSize = await FileLogger.getLogSize();
+    if (!mounted) return;
+    setState(() {
+      _logSize = logSize;
+      _debugLoggingEnabled = prefs.getBool('beeper_debug_logging_enabled') ?? false;
+      _logRoomOrderEnabled = prefs.getBool('beeper_log_room_order_enabled') ?? false;
+      _forcePublicPushGateway = prefs.getBool('beeper_force_public_push_gateway') ?? false;
+      _manualReadReceipts = prefs.getBool('beeper_manual_read_receipts') ?? false;
+      _manualReadShowBanner = prefs.getBool('beeper_manual_read_show_banner') ?? true;
+      _manualReadShowBottom = prefs.getBool('beeper_manual_read_show_bottom') ?? true;
+      _manualReadShowInputBar = prefs.getBool('beeper_manual_read_show_input_bar') ?? true;
+      _showJumpBanner = prefs.getBool('beeper_show_jump_banner') ?? true;
+    });
+  }
+
+  Future<void> _loadLogSize() async {
+    final size = await FileLogger.getLogSize();
+    if (mounted) {
+      setState(() {
+        _logSize = size;
+      });
+    }
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    if (!_didLoadPushers) {
