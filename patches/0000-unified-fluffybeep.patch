+
+    // Precalculate timestamps to avoid O(N log N) timeline iteration during sorting
+    final timestamps = <String, DateTime>{};
+    for (final r in rooms) {
+      timestamps[r.id] = _getMessageTimestamp(r);
+    }
+
+    rooms.sort((a, b) {
+      if (a.isFavourite && !b.isFavourite) return -1;
+      if (!a.isFavourite && b.isFavourite) return 1;
+      if (a.isLowPriority && !b.isLowPriority) return 1;
+      if (!a.isLowPriority && b.isLowPriority) return -1;
+
+      final aTime = timestamps[a.id] ?? DateTime.fromMillisecondsSinceEpoch(0);
+      final bTime = timestamps[b.id] ?? DateTime.fromMillisecondsSinceEpoch(0);
+      return bTime.compareTo(aTime);
+    });
+    return rooms;
+  }
 
