+
+  void _showManageHiddenNetworksDialog(BuildContext context, Client client) {
+    showDialog(
+      context: context,
+      builder: (context) {
+        final hidden = BeeperBridgeUtils.getHiddenNetworks(client);
+        if (hidden.isEmpty) {
+          return AlertDialog(
+            title: const Text('Redes ocultas'),
+            content: const Text('No tienes ninguna red oculta actualmente.'),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('Aceptar'),
+              ),
+            ],
+          );
+        }
+        return AlertDialog(
+          title: const Text('Restaurar redes ocultas'),
+          content: SizedBox(
+            width: double.maxFinite,
+            child: ListView.builder(
+              shrinkWrap: true,
+              itemCount: hidden.length,
+              itemBuilder: (context, i) {
+                final netKey = hidden[i];
+                final displayName = BeeperBridgeUtils.networkMap[netKey]?.name ?? netKey;
+                return ListTile(
+                  title: Text(displayName),
+                  trailing: IconButton(
+                    icon: const Icon(Icons.add_circle_outline),
+                    onPressed: () async {
+                      final navigator = Navigator.of(context);
+                      final newHidden = List<String>.from(hidden)..remove(netKey);
+                      await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                      navigator.pop();
+                      setState(() {});
+                    },
+                  ),
+                );
+              },
+            ),
+          ),
+        );
+      },
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final client = Matrix.of(context).client;
+    final store = Matrix.of(context).store;
+    final coloredMode = !FluffyThemes.isColumnMode(context);
+    final theme = Theme.of(context);
+    return Material(
+      color: coloredMode ? theme.colorScheme.surfaceContainer : null,
+      child: SafeArea(
+        child: StreamBuilder(
+          key: ValueKey(client.userID.toString()),
+          stream: client.onSync.stream
+              .where((s) => s.hasRoomUpdate)
+              .rateLimit(const Duration(seconds: 1)),
+          builder: (context, _) {
+            final storeOrder = store.getStringList('beeper_networks_order')?.join(',') ?? '';
+            final accountDataHash = '${client.rooms.length}_${client.accountData['im.ponies.user_emotes']?.content.hashCode}_$storeOrder';
+            
+            var roomsTagHash = 0;
+            for (final r in client.rooms) {
+              roomsTagHash ^= r.tags.length;
+              roomsTagHash ^= r.isSpace ? 1 : 0;
+            }
+            final totalHash = '${accountDataHash}_$roomsTagHash';
+            
+            if (_cachedCombinedItems != null && _lastCombinedHash == totalHash) {
+              // Usa los elementos cacheados sin volver a recalcular todo
+            } else {
+              _lastCombinedHash = totalHash;
+              final hiddenNets = BeeperBridgeUtils.getHiddenNetworks(client);
+
+              final allSpaces = client.rooms
+                  .where((room) {
+                    if (!room.isSpace) return false;
+                    if (BeeperBridgeUtils.isBeeperBot(room.directChatMatrixID ?? '')) return false;
+                    final members = room.states['m.room.member'];
+                    if (members == null) return true;
+                    return !members.keys.any((mxid) => BeeperBridgeUtils.isBeeperBot(mxid));
+                  })
+                  .where((room) {
+                    final spaceName = room.getLocalizedDisplayname(MatrixLocals(L10n.of(context)));
+                    final isHidden = hiddenNets.contains(room.id) ||
+                        hiddenNets.contains(spaceName) ||
+                        hiddenNets.contains(spaceName.toLowerCase()) ||
+                        hiddenNets.any((hn) {
+                          final hnl = hn.toLowerCase();
+                          final snl = spaceName.toLowerCase();
+                          return snl.contains(hnl) || hnl.contains(snl);
+                        });
+                    return !isHidden;
+                  })
+                  .toList();
+
+              // Read real Beeper labels from account data (com.beeper.labels)
+              final beeperLabels = BeeperBridgeUtils.getBeeperLabels(client);
+              final beeperLabelItems = <_CombinedRailItem>[];
+              final roomsInVisibleLabels = <String>{};
+              final labelTitlesLower = <String>{};
+
+              for (final entry in beeperLabels.entries) {
+                if (entry.key == '_hidden_networks') continue;
+                final val = entry.value;
+                if (val is! Map) continue;
+                final title = val['title']?.toString() ?? '';
+                if (title.isEmpty) continue;
+
+                final isHidden = hiddenNets.contains(entry.key) ||
+                    hiddenNets.contains(title) ||
+                    hiddenNets.contains(title.toLowerCase()) ||
+                    hiddenNets.any((hn) {
+                      final hnl = hn.toLowerCase();
+                      final tl = title.toLowerCase();
+                      return tl.contains(hnl) || hnl.contains(tl);
+                    });
+                if (isHidden) continue;
+
+                final rooms = (val['rooms'] as List?)?.cast<String>() ?? [];
+                final isSelected = widget.activeSpaceId == 'virtual_beeper_label_${entry.key}';
+                if (rooms.isEmpty && !isSelected) continue;
+
+                roomsInVisibleLabels.addAll(rooms);
+                labelTitlesLower.add(title.toLowerCase());
+
+                final emoji = val['emoji']?.toString();
+                beeperLabelItems.add(_CombinedRailItem.beeperLabel(entry.key, title, emoji: emoji));
+              }
+
+              beeperLabelItems.sort((a, b) {
+                final cA = beeperLabels[a.labelUuid]?['createdAt'] ?? 0;
+                final cB = beeperLabels[b.labelUuid]?['createdAt'] ?? 0;
+                return cB.compareTo(cA); // Newer first
+              });
+
+              final beeperNetworks = <String, BeeperNetwork>{};
+              final customTags = <String>{};
+              for (final r in client.rooms) {
+                final net = BeeperBridgeUtils.getRoomNetwork(r);
+                if (net != null) {
+                  final baseKey = BeeperBridgeUtils.getBaseNetworkKey(net.key);
+                  final netNameLower = net.name.toLowerCase();
+                  final isHidden = hiddenNets.contains(baseKey) ||
+                      hiddenNets.contains(net.key) ||
+                      hiddenNets.contains(netNameLower) ||
+                      hiddenNets.any((hn) {
+                        final hnl = hn.toLowerCase();
+                        return netNameLower.contains(hnl) || hnl.contains(netNameLower) || baseKey.contains(hnl);
+                      });
+
+                  final coveredByLabel = labelTitlesLower.any(
+                        (t) => t.contains(baseKey) || t.contains(netNameLower) || netNameLower.contains(t),
+                      ) ||
+                      roomsInVisibleLabels.contains(r.id);
+
+                  if (!isHidden && !coveredByLabel) {
+                    beeperNetworks[baseKey] = BeeperNetwork(net.name, net.colorHex, baseKey);
+                  }
+                }
+                for (final tag in r.tags.keys) {
+                  if (tag.startsWith('u.')) customTags.add(tag);
+                }
+              }
+
+              final visibleNetworks = beeperNetworks.values.toList();
+              final tagsList = customTags.toList()..sort();
+
+              final order = store.getStringList('beeper_networks_order') ?? [];
+              visibleNetworks.sort((a, b) {
+                final idxA = order.indexOf(a.key);
+                final idxB = order.indexOf(b.key);
+                if (idxA != -1 && idxB != -1) return idxA.compareTo(idxB);
+                if (idxA != -1) return -1;
+                if (idxB != -1) return 1;
+                return a.name.compareTo(b.name);
+              });
+
+              final combinedItems = <_CombinedRailItem>[];
+              for (final space in allSpaces) {
+                combinedItems.add(_CombinedRailItem.space(space));
+              }
+              for (final net in visibleNetworks) {
+                combinedItems.add(_CombinedRailItem.network(net));
+              }
+              for (final labelItem in beeperLabelItems) {
+                combinedItems.add(labelItem);
+              }
+              for (final tag in tagsList) {
+                combinedItems.add(_CombinedRailItem.tag(tag));
+              }
+               _cachedCombinedItems = combinedItems;
+              _cachedVisibleNetworks = visibleNetworks;
+            }
+            
+            final combinedItems = _cachedCombinedItems!;
+            final visibleNetworks = _cachedVisibleNetworks!;
+
+            return SizedBox(
+              width: FluffyThemes.isColumnMode(context)
+                  ? FluffyThemes.navRailWidth
+                  : FluffyThemes.navRailWidth - 8,
+              child: Column(
+                children: [
+                  Expanded(
+                    child: ListView.builder(
+                      padding: const EdgeInsets.symmetric(vertical: 4),
+                      scrollDirection: Axis.vertical,
+                      itemCount: combinedItems.length + 2,
+                      itemBuilder: (context, i) {
+                        if (i == 0) {
+                          return NaviRailItem(
+                            isSelected: widget.activeSpaceId == null,
+                            onTap: widget.onGoToChats,
