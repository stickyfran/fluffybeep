+
+class SettingsPatches extends StatefulWidget {
+  const SettingsPatches({super.key});
+
+  @override
+  State<SettingsPatches> createState() => _SettingsPatchesState();
+}
+
+class _SettingsPatchesState extends State<SettingsPatches> {
+  @override
+  Widget build(BuildContext context) {
+    final client = Matrix.of(context).client;
+    final store = Matrix.of(context).store;
+    final theme = Theme.of(context);
+
+    // Extract unique Beeper networks from client rooms
+    final beeperNetworks = <String, BeeperNetwork>{};
+    final customTags = <String>{};
+    for (final r in client.rooms) {
+      final net = BeeperBridgeUtils.getRoomNetwork(r);
+      if (net != null) {
+        beeperNetworks[net.key] = net;
+      }
+      for (final tag in r.tags.keys) {
+        if (tag.startsWith('u.')) {
+          customTags.add(tag);
+        }
+      }
+    }
+
+    final networksList = beeperNetworks.values.toList()
+      ..sort((a, b) => a.name.compareTo(b.name));
+    final tagsList = customTags.toList()..sort();
+
+
+
+    return Scaffold(
+      appBar: AppBar(
+        title: const Text('Parches de Beeper'),
+      ),
+      body: ListView(
+        children: [
+          Padding(
+            padding: const EdgeInsets.all(16.0),
+            child: Text(
+              'Acciones rápidas',
+              style: TextStyle(
+                color: theme.colorScheme.primary,
+                fontWeight: FontWeight.bold,
+              ),
+            ),
+          ),
+          ListTile(
+            leading: const Icon(Icons.sync_outlined),
+            title: const Text('Re-sincronizar chats (Beeper)'),
+            subtitle: const Text('Limpia la caché de perfiles, avatares y nombres e inicia una sincronización completa.'),
+            onTap: () => BeeperReinitController.showReinitOverlay(
+              context,
+              client,
+            ),
+          ),
+          const Divider(),
+          Padding(
+            padding: const EdgeInsets.all(16.0),
+            child: Text(
+              'Contener Bridges (Ocultar de la lista principal)',
+              style: TextStyle(
+                color: theme.colorScheme.primary,
+                fontWeight: FontWeight.bold,
+              ),
+            ),
+          ),
+          if (networksList.isEmpty)
+            const Padding(
+              padding: EdgeInsets.symmetric(horizontal: 16.0),
+              child: Text('No se detectaron puentes de Beeper activos.'),
+            )
+          else
+            ...networksList.map((net) {
+              final isContained = BeeperBridgeUtils.isNetworkContained(client, net.key, net.name);
+              final isHidden = BeeperBridgeUtils.getHiddenNetworks(client).contains(net.key);
+              return Column(
+                children: [
+                  SwitchListTile.adaptive(
+                    value: isContained,
+                    title: Text('Contener ${net.name}'),
+                    subtitle: Text('Muestra los chats de ${net.name} solo dentro de su sala virtual en el menú lateral.'),
+                    onChanged: (val) async {
+                      await BeeperBridgeUtils.setNetworkContained(client, net.key, net.name, val);
+                      setState(() {});
+                    },
+                  ),
+                  SwitchListTile.adaptive(
+                    value: isHidden,
+                    title: Text('Ocultar ${net.name} de la barra lateral'),
+                    subtitle: Text('Oculta el ícono de acceso directo de ${net.name} de la izquierda.'),
+                    onChanged: (val) async {
+                      final hidden = BeeperBridgeUtils.getHiddenNetworks(client);
+                      final newHidden = List<String>.from(hidden);
+                      if (val) {
+                        if (!newHidden.contains(net.key)) newHidden.add(net.key);
+                      } else {
+                        newHidden.remove(net.key);
+                      }
+                      await BeeperBridgeUtils.setHiddenNetworks(client, newHidden);
+                      setState(() {});
+                    },
+                  ),
+                  const Divider(indent: 16, endIndent: 16),
+                ],
+              );
+            }),
+          const Divider(),
+          Padding(
+            padding: const EdgeInsets.all(16.0),
+            child: Text(
+              'Contener Etiquetas personalizadas (Labels)',
+              style: TextStyle(
+                color: theme.colorScheme.primary,
+                fontWeight: FontWeight.bold,
+              ),
+            ),
+          ),
+          if (tagsList.isEmpty)
+            const Padding(
+              padding: EdgeInsets.symmetric(horizontal: 16.0),
+              child: Text('No tienes etiquetas (u.xxx) creadas todavía.'),
+            )
+          else
+            ...tagsList.map((tag) {
+              final displayName = tag.replaceFirst('u.', '');
+              final isContained = BeeperBridgeUtils.isTagContained(client, tag);
+              return SwitchListTile.adaptive(
+                value: isContained,
+                title: Text('Contener etiqueta: $displayName'),
+                subtitle: const Text('Muestra estos chats solo dentro de la etiqueta en el menú lateral.'),
+                onChanged: (val) async {
+                  await BeeperBridgeUtils.setTagContained(client, tag, val);
+                  setState(() {});
+                },
+              );
+            }),
+        ],
+      ),
+    );
+  }
+}
