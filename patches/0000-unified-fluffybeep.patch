+  static String getBaseNetworkKey(String key) {
+    if (key == 'wa') return 'whatsapp';
+    if (key == 'ig') return 'instagram';
+    if (key.endsWith('go')) {
+      return key.substring(0, key.length - 2);
+    }
+    return key;
+  }
+
+  static BeeperNetwork? getRoomNetwork(Room room) {
+    var key = getRoomData(room).networkKey;
+    if (key == null) {
+      if (extractInstagramDetails(room).username != null ||
+          extractInstagramDetails(room).numericId != null) {
+        key = 'instagram';
+      } else if (extractWhatsAppPhone(room) != null) {
+        key = 'whatsapp';
+      }
+    }
+    if (key == null) return null;
+    key = getBaseNetworkKey(key);
+    if (!networkMap.containsKey(key)) return null;
+    final spec = networkMap[key]!;
+    return BeeperNetwork(spec.name, spec.colorHex, key);
+  }
+
+  /// Format raw phone number into human-readable phone format
+  static String formatPhoneNumber(String raw) {
+    final digits = raw.replaceAll(RegExp(r'\D'), '');
+    if (digits.length < 7) return raw;
+    if (digits.startsWith('549') && digits.length >= 12) {
+      final area = digits.substring(3, 5);
+      final mid = digits.substring(5, 9);
+      final rest = digits.substring(9);
+      return '+54 9 $area $mid-$rest';
+    }
+    if (digits.startsWith('1') && digits.length == 11) {
+      final area = digits.substring(1, 4);
+      final mid = digits.substring(4, 7);
+      final rest = digits.substring(7);
+      return '+1 ($area) $mid-$rest';
+    }
+    if (digits.length == 10) {
+      return '(${digits.substring(0, 3)}) ${digits.substring(3, 6)}-${digits.substring(6)}';
+    }
+    return '+$digits';
+  }
+
+  /// Get all room aliases from canonical alias and state events
+  static List<String> getRoomAliases(Room room) {
+    final list = <String>[];
+    if (room.canonicalAlias.isNotEmpty) {
+      list.add(room.canonicalAlias);
+    }
+    final aliasesEvents = room.states['m.room.aliases']?.values;
+    if (aliasesEvents != null) {
+      for (final e in aliasesEvents) {
+        final aliases = e.content['aliases'];
+        if (aliases is List) {
+          list.addAll(aliases.whereType<String>());
+        }
+      }
+    }
+    final canonEvents = room.states['m.room.canonical_alias']?.values;
+    if (canonEvents != null) {
+      for (final e in canonEvents) {
+        final alt = e.content['alt_aliases'];
+        if (alt is List) {
+          list.addAll(alt.whereType<String>());
+        }
+      }
+    }
+    return list;
+  }
+
+  /// Robust extraction of WhatsApp phone number from a room or its members/bridge state (cached O(1))
+  static String? extractWhatsAppPhone(Room room) {
+    if (_extractedPhoneCache.containsKey(room.id)) {
+      return _extractedPhoneCache[room.id];
+    }
+    final phone = _computeWhatsAppPhone(room);
+    _extractedPhoneCache[room.id] = phone;
+    if (_extractedPhoneCache.length > maxCacheSize) {
+      _extractedPhoneCache.remove(_extractedPhoneCache.keys.first);
+    }
+    return phone;
+  }
+
+  static String? _computeWhatsAppPhone(Room room) {
+    // 0. Check custom assigned WhatsApp phone
+    final customPhone = BeeperMergeUtils.getCustomWhatsAppPhone(room.id);
+    if (customPhone != null && customPhone.isNotEmpty) {
+      return customPhone;
+    }
+
+    // 1. Check all bridge state events
+    for (final stateKey in const [
+      'com.beeper.bridge',
+      'm.bridge',
+      'fi.mau.whatsapp',
+      'com.beeper.whatsapp',
+      'uk.half-shot.bridge',
+    ]) {
+      final events = room.states[stateKey]?.values ?? const <Event>[];
+      for (final event in events) {
+        final content = event.content;
+        final channel = content['channel'] is Map ? (content['channel'] as Map) : null;
+        final sender = content['sender'] is Map ? (content['sender'] as Map) : null;
+        final user = content['user'] is Map ? (content['user'] as Map) : null;
+        final beeper = content['beeper'] is Map ? (content['beeper'] as Map) : null;
+
+        final candidates = [
+          content['phone'],
+          content['remote_id'],
+          content['user_id'],
+          content['jid'],
+          content['recipient_id'],
+          content['beeper_guid'],
+          channel?['id'],
+          channel?['phone'],
+          channel?['displayname'],
+          sender?['id'],
+          sender?['phone'],
+          user?['phone'],
+          user?['id'],
+          beeper?['remote_user_id'],
+          beeper?['phone'],
+        ];
+
+        for (final raw in candidates) {
+          if (raw == null) continue;
+          final str = raw.toString();
+          final match = RegExp(r'(?:whatsapp:)?(?:\+{1,2})?(\d{7,16})').firstMatch(str);
+          if (match != null) {
+            final digits = match.group(1)!;
+            if (!str.contains('lid') || digits.length <= 14) {
+              return digits;
+            }
+          }
+        }
+      }
+    }
+
+    // 2. Check m.room.member events custom fields
+    final memberEvents = room.states['m.room.member']?.values ?? const <Event>[];
+    for (final mEvent in memberEvents) {
+      final content = mEvent.content;
+      final candidates = [
+        content['phone'],
+        content['beeper_phone'],
+        content['beeper_guid'],
+        content['custom_mxid'],
+        content['user_id'],
+        content['jid'],
+      ];
+      for (final raw in candidates) {
+        if (raw == null) continue;
+        final str = raw.toString();
+        final match = RegExp(r'(?:whatsapp:)?(?:\+{1,2})?(\d{7,16})').firstMatch(str);
+        if (match != null) {
+          final digits = match.group(1)!;
+          if (!str.contains('lid') || digits.length <= 14) {
+            return digits;
+          }
+        }
+      }
+    }
+
+    // 3. Check canonicalAlias & aliases
+    final allAliases = getRoomAliases(room);
+    for (final alias in allAliases) {
+      final match = RegExp(r'whatsapp[^:]*?(\d{7,16})', caseSensitive: false).firstMatch(alias);
+      if (match != null) {
+        return match.group(1)!;
+      }
+    }
+
+    // 4. Check candidate MXIDs (directChatMatrixID, contactId, room.id) first to avoid getParticipants()
+    final candidateMxids = <String>[
+      if (room.directChatMatrixID != null) room.directChatMatrixID!,
+      if ((_roomDataCache[room.id]?.contactId ?? getCachedContactId(room.id)) != null)
+        (_roomDataCache[room.id]?.contactId ?? getCachedContactId(room.id))!,
+      room.id,
+    ];
+
+    for (final mxid in candidateMxids) {
+      if (mxid == room.client.userID || isBeeperBot(mxid)) continue;
+      final match = RegExp(r'(?:whatsapp|w4b)[^:]*?(\d{7,16})', caseSensitive: false).firstMatch(mxid);
+      if (match != null) {
+        final digits = match.group(1)!;
+        if (!mxid.contains('lid') || digits.length <= 14) {
+          return digits;
+        }
+      }
+    }
+
+    // 5. Check room participants only if not found from candidate MXIDs
+    for (final p in room.getParticipants()) {
+      final mxid = p.id;
+      if (mxid == room.client.userID || isBeeperBot(mxid)) continue;
+      final match = RegExp(r'(?:whatsapp|w4b)[^:]*?(\d{7,16})', caseSensitive: false).firstMatch(mxid);
+      if (match != null) {
+        final digits = match.group(1)!;
+        if (!mxid.contains('lid') || digits.length <= 14) {
+          return digits;
+        }
+      }
+    }
+
+    // 6. Check room name or member display names (e.g. "+54 9 11 1234-5678" or "Name (+54911...)")
+    final candidateNames = [
+      room.name,
+      ...memberEvents.map((v) => v.content.tryGet<String>('displayname') ?? ''),
+    ];
+
+    for (final name in candidateNames) {
+      if (name.isEmpty) continue;
+      final phoneMatch = RegExp(r'(?:\+{1,2})?(?:[0-9][\s\-\.\(\)]*){7,16}').firstMatch(name);
+      if (phoneMatch != null) {
+        final digits = phoneMatch.group(0)!.replaceAll(RegExp(r'\D'), '');
+        if (digits.length >= 7 && digits.length <= 16) {
+          return digits;
+        }
+      }
+    }
+
+    // 7. Check room topic
+    if (room.topic.isNotEmpty) {
+      final topicMatch = RegExp(r'(?:\+{1,2})?(?:[0-9][\s\-\.\(\)]*){7,16}').firstMatch(room.topic);
+      if (topicMatch != null) {
+        final digits = topicMatch.group(0)!.replaceAll(RegExp(r'\D'), '');
+        if (digits.length >= 7 && digits.length <= 16) {
+          return digits;
+        }
+      }
+    }
+
+    // 8. Check device phone contacts by name
+    final cleanName = sanitizeDisplayName(room.name);
+    if (cleanName.isNotEmpty) {
+      final pc = BeeperPhoneContacts.findByName(cleanName);
+      if (pc != null && pc.normalizedPhones.isNotEmpty) {
+        return pc.normalizedPhones.first;
+      }
+    }
+
+    return null;
+  }
