diff --git a/lib/utils/ai_profile_service.dart b/lib/utils/ai_profile_service.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1aaaee3532b22ac5ac7434e9a40d8defba81c6fb
--- /dev/null
+++ b/lib/utils/ai_profile_service.dart
@@ -0,0 +1,461 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+import 'package:intl/intl.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:fluffychat/models/contact_profile.dart';
+import 'beeper_bridge_utils.dart';
+import 'beeper_merge_utils.dart';
+import 'file_logger.dart';
+import 'transcription_service.dart';
+
+class ChatExtractionResult {
+  final String textContext;
+  final String? newestEventId;
+  final int? newestEventTimestamp;
+  final int messageCount;
+
+  const ChatExtractionResult({
+    required this.textContext,
+    this.newestEventId,
+    this.newestEventTimestamp,
+    required this.messageCount,
+  });
+}
+
+/// Servicio de IA para la extracción y síntesis de perfiles de contactos.
+/// Diseñado para ser ultraligero y compatible con:
+/// 1. Endpoint local en Android (p.ej. llama.cpp / Ollama / Termux en localhost).
+/// 2. APIs compatibles con OpenAI/Gemini/Groq configurables.
+/// 3. Heurísticas offline inteligentes de extracción si la IA externa/local no está activa.
+/// 4. Sistema de CHECKPOINTS para no reprocesar mensajes ya leídos ni sobrepensar.
+/// 5. Soporte para chats fusionados (combina mensajes de WhatsApp, Instagram, etc.).
+/// 6. Inclusión de marcas temporales legibles [YYYY-MM-DD HH:mm] y transcripciones de notas de voz.
+class AiProfileService {
+  static const String prefAiEndpointKey = 'ai_profile_endpoint';
+  static const String prefAiApiKey = 'ai_profile_api_key';
+  static const String prefAiModelKey = 'ai_profile_model';
+
+  static final DateFormat _dateFormat = DateFormat('yyyy-MM-dd HH:mm');
+
+  /// Extrae el texto limpio de mensajes posteriores al último checkpoint registrado en [currentProfile].
+  /// Si [forceFull] es true, procesa todo el historial disponible sin considerar el checkpoint.
+  /// Si el chat está fusionado con otros ([BeeperMergeUtils.isRoomMerged]), extrae y unifica
+  /// cronológicamente los mensajes de todas las salas hermanas vinculadas.
+  static Future<ChatExtractionResult> extractChatContext(
+    Room room, {
+    ContactProfile? currentProfile,
+    bool forceFull = false,
+    int maxMessages = 300,
+  }) async {
+    final client = room.client;
+    final myUserId = client.userID;
+    final checkpointTs = forceFull ? null : currentProfile?.lastProcessedTimestamp;
+    final checkpointId = forceFull ? null : currentProfile?.lastProcessedEventId;
+
+    // Determinar salas a consultar: principal y cualquier sala fusionada
+    final isMerged = BeeperMergeUtils.isRoomMerged(room.id);
+    final targetRooms = <Room>[room];
+    if (isMerged) {
+      final siblings = BeeperMergeUtils.getSiblingRooms(room.id);
+      for (final sib in siblings) {
+        if (!targetRooms.any((r) => r.id == sib.id)) {
+          targetRooms.add(sib);
+        }
+      }
+    }
+
+    final candidateEvents = <({Event event, String networkLabel, String contentText})>[];
+
+    for (final targetRoom in targetRooms) {
+      final net = BeeperBridgeUtils.getRoomNetwork(targetRoom)?.name ??
+          (targetRoom.id.contains('whatsapp') ? 'WhatsApp' : 'Matrix');
+
+      // Intentar obtener eventos de la base de datos local
+      List<Event> localEvents = [];
+      try {
+        localEvents = await client.database.getEventList(targetRoom, limit: maxMessages);
+      } catch (e) {
+        FileLogger.log('[AiProfileService] Error getting database events: $e');
+      }
+
+      // Si la base de datos local tiene pocos o ningún evento, intentar con el timeline en memoria
+      if (localEvents.isEmpty) {
+        try {
+          final timeline = await targetRoom.getTimeline();
+          localEvents = timeline.events.toList();
+        } catch (_) {}
+      }
+
+      for (final event in localEvents) {
+        if (event.type != EventTypes.Message) continue;
+
+        final ts = event.originServerTs.millisecondsSinceEpoch;
+
+        // Si tenemos un checkpoint, filtrar solo los eventos estrictamente más recientes
+        if (checkpointTs != null && ts <= checkpointTs) {
+          continue;
+        }
+        if (checkpointId != null && event.eventId == checkpointId) {
+          continue;
+        }
+
+        final msgType = event.content['msgtype'];
+        String body = '';
+
+        if (msgType == MessageTypes.Text) {
+          body = event.content['body']?.toString().trim() ?? '';
+        } else if (msgType == MessageTypes.Audio) {
+          // Consultar si hay transcripción de la nota de voz
+          final transcription = TranscriptionService().getCachedTranscription(event.eventId) ??
+              await TranscriptionService().getTranscription(event.eventId);
+          if (transcription != null && transcription.trim().isNotEmpty) {
+            body = '[Nota de voz]: ${transcription.trim()}';
+          }
+        }
+
+        if (body.isEmpty) continue;
+
+        candidateEvents.add((event: event, networkLabel: net, contentText: body));
+      }
+    }
+
+    if (candidateEvents.isEmpty) {
+      return const ChatExtractionResult(textContext: '', messageCount: 0);
+    }
+
+    // Ordenar cronológicamente ascendente (antiguos primero, recientes al final)
+    candidateEvents.sort(
+      (a, b) => a.event.originServerTs.compareTo(b.event.originServerTs),
+    );
+
+    // Limitar al número máximo solicitado de mensajes
+    final limitedCandidates = candidateEvents.length > maxMessages
+        ? candidateEvents.sublist(candidateEvents.length - maxMessages)
+        : candidateEvents;
+
+    final buffer = StringBuffer();
+    String? newestEventId;
+    int? newestEventTimestamp;
+
+    for (final item in limitedCandidates) {
+      final event = item.event;
+      final sender = (event.senderId == myUserId) ? 'Yo' : 'Contacto';
+      final body = item.contentText;
+      final label = isMerged ? '[${item.networkLabel}] ' : '';
+      final timeStr = _dateFormat.format(event.originServerTs.toLocal());
+
+      buffer.writeln('[$timeStr] $label$sender: $body');
+
+      newestEventId = event.eventId;
+      newestEventTimestamp = event.originServerTs.millisecondsSinceEpoch;
+    }
+
+    return ChatExtractionResult(
+      textContext: buffer.toString(),
+      newestEventId: newestEventId,
+      newestEventTimestamp: newestEventTimestamp,
+      messageCount: limitedCandidates.length,
+    );
+  }
+
+  /// Resuelve el mejor nombre conocido para el contacto
+  static String resolveContactName(Room room, {ContactProfile? profile}) {
+    if (profile?.nombre != null && profile!.nombre!.trim().isNotEmpty) {
+      return profile.nombre!.trim();
+    }
+    final cached = BeeperBridgeUtils.getCachedName(room.id);
+    if (cached != null && cached.trim().isNotEmpty && !cached.startsWith('@')) {
+      return cached.trim();
+    }
+    final beeperData = BeeperBridgeUtils.getRoomData(room);
+    if (beeperData.displayName != null &&
+        beeperData.displayName!.trim().isNotEmpty &&
+        !beeperData.displayName!.startsWith('@')) {
+      return beeperData.displayName!.trim();
+    }
+    final localized = room.getLocalizedDisplayname().trim();
+    if (localized.isNotEmpty && !localized.startsWith('@') && !localized.startsWith('!')) {
+      return localized;
+    }
+    return '';
+  }
+
+  /// Ejecuta la actualización asistida por IA comparando el perfil actual con los nuevos mensajes.
+  static Future<ContactProfile> analyzeAndMergeProfile({
+    required Room room,
+    required ContactProfile currentProfile,
+    bool forceFull = false,
+  }) async {
+    final contactName = resolveContactName(room, profile: currentProfile);
+
+    final extraction = await extractChatContext(
+      room,
+      currentProfile: currentProfile,
+      forceFull: forceFull,
+    );
+
+    if (extraction.textContext.trim().isEmpty) {
+      FileLogger.log('[AiProfileService] No new messages to analyze since last checkpoint.');
+      // Si el perfil no tenía nombre y lo conocemos de la sala, lo completamos
+      if ((currentProfile.nombre == null || currentProfile.nombre!.isEmpty) && contactName.isNotEmpty) {
+        return currentProfile.copyWith(nombre: contactName);
+      }
+      return currentProfile;
+    }
+
+    final prefs = await SharedPreferences.getInstance();
+    final endpoint = prefs.getString(prefAiEndpointKey)?.trim();
+    final apiKey = prefs.getString(prefAiApiKey)?.trim();
+    final model = prefs.getString(prefAiModelKey)?.trim() ?? 'llama3.2';
+
+    ContactProfile? suggested;
+
+    // Si hay endpoint configurado (Ollama local, OpenAI, Groq, etc.), usamos el LLM:
+    if (endpoint != null && endpoint.isNotEmpty) {
+      try {
+        suggested = await _queryLlm(
+          endpoint: endpoint,
+          apiKey: apiKey,
+          model: model,
+          currentProfile: currentProfile,
+          contactName: contactName,
+          chatText: extraction.textContext,
+        );
+      } catch (e) {
+        FileLogger.log('[AiProfileService] LLM query failed: $e. Falling back to heuristic.');
+      }
+    }
+
+    // Fallback inteligente: extractor heurístico por expresiones regulares
+    suggested ??= _heuristicExtraction(extraction.textContext, currentProfile, contactName: contactName);
+
+    // Integrar checkpoint en la sugerencia
+    final updatedProfileWithCheckpoint = suggested.copyWith(
+      nombre: (suggested.nombre != null && suggested.nombre!.isNotEmpty)
+          ? suggested.nombre
+          : (currentProfile.nombre ?? (contactName.isNotEmpty ? contactName : null)),
+      lastProcessedEventId: extraction.newestEventId ?? currentProfile.lastProcessedEventId,
+      lastProcessedTimestamp: extraction.newestEventTimestamp ?? currentProfile.lastProcessedTimestamp,
+      lastAnalysisTime: DateTime.now().millisecondsSinceEpoch,
+    );
+
+    return currentProfile.mergeWith(updatedProfileWithCheckpoint);
+  }
+
+  static Future<ContactProfile?> _queryLlm({
+    required String endpoint,
+    String? apiKey,
+    required String model,
+    required ContactProfile currentProfile,
+    required String contactName,
+    required String chatText,
+  }) async {
+    final nowStr = _dateFormat.format(DateTime.now());
+
+    final systemPrompt = '''
+Eres un asistente ultra preciso de gestión de contactos personales y síntesis de conversaciones.
+Tu objetivo es analizar los mensajes recientes entre el usuario ("Yo") y el "Contacto" para extraer o actualizar una ficha verídica del contacto.
+
+REGLAS ESTRICTAS DE EXTRACCIÓN:
+1. PRESERVACIÓN: Si en los mensajes no se menciona nueva información verificable de un campo, NO inventes nada y devuelve null en ese campo.
+2. NOMBRE: Si se conoce el nombre por la conversación o por el sistema, consérvalo.
+3. PROFESIÓN / OFICIO / TRABAJO: Extrae a qué se dedica el contacto (p.ej. "Desarrollador de software", "Arquitecta", "Médico", "Atención al cliente en X").
+4. ESTUDIOS FORMALES: Menciones de carreras, facultades, títulos, postgrados o secundario (p.ej. "Ingeniería en la UBA", "Abogacía").
+5. HOBBIES E INTERESES: Pasatiempos, deportes, aficiones, gustos o actividades recreativas habituales (p.ej. "Toca la guitarra, juega al pádel, fanático de la fotografía").
+6. PRÓXIMOS EVENTOS (MUY IMPORTANTE):
+   - NUNCA agregues preguntas sueltas como eventos (ESTÁ PROHIBIDO poner frases como "¿dónde nos vemos exactamente?" o "¿a qué hora?").
+   - Los eventos deben tener CONTEXTO y SENTIDO completo: Quién, Cuándo (fecha/hora estimada o exacta calculada a partir de la fecha de referencia) y Dónde o Qué harán.
+   - Si acordaron una cita: "[YYYY-MM-DD HH:mm] Encuentro en Bar X para cenar".
+   - Si están debatiendo o evaluando opciones ("en disputa"): "[Fecha/Día tentativo] En disputa: Lugares (Lugar A vs Lugar B) / Horarios (20:00 vs 21:30)".
+   - Si no hay planes concretos ni acuerdos en debate, deja la lista vacía [].
+7. FORMATO OBLIGATORIO: Responde ÚNICAMENTE con un JSON válido con exactamente esta estructura:
+{
+  "nombre": string o null,
+  "cumpleanos": string o null,
+  "direccion": string o null,
+  "profesion": string o null,
+  "estudios_formales": string o null,
+  "hobbies_intereses": string o null,
+  "ultimas_actividades_relevantes": [lista de strings breves],
+  "proximos_eventos": [lista de strings con fecha y contexto completo],
+  "eventos_pasados": [lista de strings (máximo 10)],
+  "notas_libres": string o null
+}
+''';
+
+    final userPrompt = '''
+FECHA ACTUAL DE REFERENCIA (HOY): $nowStr
+NOMBRE REGISTRADO DEL CONTACTO: ${contactName.isNotEmpty ? contactName : "Desconocido"}
+
+PERFIL ACTUAL PREVIO:
+${jsonEncode(currentProfile.toJson())}
+
+MENSAJES RECIENTES A ANALIZAR (con marca temporal [YYYY-MM-DD HH:mm]):
+$chatText
+
+Analiza con rigor la conversación y actualiza el JSON según las reglas indicadas.
+''';
+
+    final uri = Uri.parse(endpoint);
+    final headers = <String, String>{
+      'Content-Type': 'application/json',
+      if (apiKey != null && apiKey.isNotEmpty) 'Authorization': 'Bearer $apiKey',
+    };
+
+    Map<String, dynamic> body;
+    if (endpoint.contains('/chat/completions')) {
+      body = {
+        'model': model,
+        'messages': [
+          {'role': 'system', 'content': systemPrompt},
+          {'role': 'user', 'content': userPrompt},
+        ],
+        'temperature': 0.1,
+      };
+    } else {
+      body = {
+        'model': model,
+        'system': systemPrompt,
+        'prompt': userPrompt,
+        'stream': false,
+        'format': 'json',
+      };
+    }
+
+    final response = await http
+        .post(uri, headers: headers, body: jsonEncode(body))
+        .timeout(const Duration(seconds: 35));
+
+    if (response.statusCode >= 200 && response.statusCode < 300) {
+      final jsonResponse = jsonDecode(utf8.decode(response.bodyBytes));
+      String content = '';
+      if (jsonResponse is Map<String, dynamic>) {
+        if (jsonResponse.containsKey('choices')) {
+          content = jsonResponse['choices'][0]['message']['content'] ?? '';
+        } else if (jsonResponse.containsKey('response')) {
+          content = jsonResponse['response'] ?? '';
+        }
+      }
+
+      final jsonMatch = RegExp(r'\{[\s\S]*\}').firstMatch(content);
+      if (jsonMatch != null) {
+        final parsed = jsonDecode(jsonMatch.group(0)!);
+        if (parsed is Map<String, dynamic>) {
+          return ContactProfile.fromJson(parsed);
+        }
+      }
+    } else {
+      FileLogger.log('[AiProfileService] HTTP error: ${response.statusCode} - ${response.body}');
+    }
+
+    return null;
+  }
+
+  /// Extractor heurístico rápido offline para detectar menciones comunes cuando no hay LLM
+  static ContactProfile _heuristicExtraction(
+    String text,
+    ContactProfile current, {
+    String contactName = '',
+  }) {
+    String? foundCumple;
+    String? foundDireccion;
+    String? foundProfesion;
+    String? foundEstudios;
+    String? foundHobbies;
+    final actividades = <String>[];
+    final proximos = <String>[];
+
+    final lines = text.split('\n');
+    for (int i = 0; i < lines.length; i++) {
+      final line = lines[i];
+      final l = line.toLowerCase();
+
+      // Extraer timestamp si existe: [YYYY-MM-DD HH:mm]
+      final tsMatch = RegExp(r'^\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})\]').firstMatch(line);
+      final msgDate = tsMatch?.group(1);
+
+      // Limpiar prefijos de metadata
+      final cleanText = line
+          .replaceFirst(RegExp(r'^\[\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}\]\s*'), '')
+          .replaceFirst(RegExp(r'^(\[[^\]]+\]\s*)?(Yo|Contacto):\s*', caseSensitive: false), '')
+          .trim();
+
+      // Cumpleaños
+      if (foundCumple == null && (l.contains('cumple') || l.contains('cumpleaños') || l.contains('nací el'))) {
+        if (!cleanText.contains('?') && !cleanText.startsWith('¿')) {
+          foundCumple = cleanText;
+        }
+      }
+
+      // Dirección / Residencia
+      if (foundDireccion == null && (l.contains('vivo en') || l.contains('mi dirección es') || l.contains('me mudé a') || l.contains('vivo por'))) {
+        if (!cleanText.contains('?') && !cleanText.startsWith('¿')) {
+          foundDireccion = cleanText;
+        }
+      }
+
+      // Profesión / Trabajo
+      if (foundProfesion == null && (l.contains('trabajo de') || l.contains('trabajo en') || l.contains('soy arquitect') || l.contains('soy medic') || l.contains('soy abogad') || l.contains('soy programad') || l.contains('soy diseñad') || l.contains('soy ingenier'))) {
+        if (!cleanText.contains('?') && !cleanText.startsWith('¿')) {
+          foundProfesion = cleanText;
+        }
+      }
+
+      // Estudios
+      if (foundEstudios == null && (l.contains('estudio en') || l.contains('facultad de') || l.contains('estudio ingenier') || l.contains('estudio medic') || l.contains('estudio abogac') || l.contains('estudio programac'))) {
+        if (!cleanText.contains('?') && !cleanText.startsWith('¿')) {
+          foundEstudios = cleanText;
+        }
+      }
+
+      // Hobbies
+      if (foundHobbies == null && (l.contains('juego al') || l.contains('hago crossfit') || l.contains('hago yoga') || l.contains('toco la') || l.contains('entreno en') || l.contains('fanático de'))) {
+        if (!cleanText.contains('?') && !cleanText.startsWith('¿')) {
+          foundHobbies = cleanText;
+        }
+      }
+
+      // Próximos eventos: filtrar preguntas estrictamente
+      final isQuestion = cleanText.endsWith('?') || cleanText.startsWith('¿') || cleanText.startsWith('donde') || cleanText.startsWith('a que hora') || cleanText.startsWith('cuando');
+
+      if (!isQuestion) {
+        final hasTimeAnchor = l.contains('el lunes') ||
+            l.contains('el martes') ||
+            l.contains('el miércoles') ||
+            l.contains('el jueves') ||
+            l.contains('el viernes') ||
+            l.contains('el sábado') ||
+            l.contains('el domingo') ||
+            l.contains('mañana') ||
+            l.contains('la semana que viene') ||
+            l.contains('nos vemos en') ||
+            l.contains('quedamos en') ||
+            l.contains('juntamos en');
+
+        if (hasTimeAnchor && cleanText.length > 8) {
+          final entry = (msgDate != null) ? '[$msgDate] $cleanText' : cleanText;
+          if (!proximos.contains(entry)) {
+            proximos.add(entry);
+          }
+        }
+      }
+    }
+
+    return ContactProfile(
+      nombre: contactName.isNotEmpty ? contactName : null,
+      cumpleanos: foundCumple,
+      direccion: foundDireccion,
+      profesion: foundProfesion,
+      estudiosFormales: foundEstudios,
+      hobbiesIntereses: foundHobbies,
+      ultimasActividades: actividades,
+      proximosEventos: proximos.take(5).toList(),
+    );
+  }
+}
+
