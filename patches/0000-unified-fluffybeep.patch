+  @override
+  void dispose() {
+    // Cancel all timers FIRST to prevent race conditions where a timer
+    // fires after a ValueNotifier has been disposed, causing
+    // "used after dispose" errors on fast navigation.
+    _debounceUpdateViewTimer?.cancel();
+    _debounceInputHeightTimer?.cancel();
+    _storeInputTimeoutTimer?.cancel();
+    typingCoolDown?.cancel();
+    typingTimeout?.cancel();
+
+    // Now safe to dispose notifiers — no pending timers can touch them.
+    timelineUpdateNotifier.dispose();
+    isInputEmptyNotifier.dispose();
+    inputBarHeightNotifier.dispose();
+    scrollUpBannerEventIdNotifier.dispose();
+    _displayChatDetailsColumn.dispose();
+
+    MxcImage.clearCache(room.id);
+    timeline?.cancelSubscriptions();
+    timeline = null;
+    sendController.dispose();
+    scrollController.dispose();
+    inputFocus.removeListener(_inputFocusListener);
+    inputFocus.dispose();
+    web.window.removeEventListener('paste', _handleClipboardFilePasteWeb);
+    if (currentlyTyping) room.setTyping(false);
+    super.dispose();
+  }
