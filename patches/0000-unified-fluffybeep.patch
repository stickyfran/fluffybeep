+                            } else if (cleanPhone.length >= 10 && (cleanPhone.startsWith("54") || cleanPhone.startsWith("1") || cleanPhone.startsWith("34") || cleanPhone.startsWith("44") || cleanPhone.startsWith("52") || cleanPhone.startsWith("55") || cleanPhone.startsWith("56") || cleanPhone.startsWith("57"))) {
+                                Uri.parse("tel:+$cleanPhone")
+                            } else {
+                                Uri.parse("tel:$cleanPhone")
+                            }
+                            val intent = Intent(Intent.ACTION_DIAL, telUri).apply {
+                                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            }
+                            context.startActivity(intent)
+                            result.success(true)
+                        } catch (e: Exception) {
+                            result.error("DIAL_FAILED", e.message, null)
