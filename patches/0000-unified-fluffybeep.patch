diff --git a/lib/controllers/beeper_reinit_controller.dart b/lib/controllers/beeper_reinit_controller.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a7c1e6b0559ab5ff3c92ecd274aefa72a3600bac
--- /dev/null
+++ b/lib/controllers/beeper_reinit_controller.dart
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import '../l10n/l10n.dart';
+import '../utils/beeper_sync_manager.dart';
+import '../utils/matrix_sdk_extensions/matrix_locals.dart';
+
+class BeeperReinitController {
+  final Client client;
+
+  BeeperReinitController({required this.client});
+
+  /// Starts full background synchronization with non-blocking progress banner
+  static Future<void> showReinitOverlay(BuildContext context, Client client) async {
+    final confirm = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Re-sincronizar chats (Beeper)'),
+        content: const Text(
+          'Se descargarán los últimos mensajes y avatares de todos tus chats en segundo plano mientras continúas usando la aplicación con normalidad.',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('Cancelar'),
+          ),
+          ElevatedButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: const Text('Sincronizar ahora'),
+          ),
+        ],
+      ),
+    );
+
+    if (confirm != true) return;
+
+    if (context.mounted) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(
+          content: Text('Sincronización de todos los chats iniciada en segundo plano.'),
+          duration: Duration(seconds: 3),
+        ),
+      );
+
+      final locals = MatrixLocals(L10n.of(context));
+      BeeperSyncManager.startFullSync(
+        client,
+        invalidateCachesFirst: true,
+        locals: locals,
+        onCompleted: () {
+          if (context.mounted) {
+            ScaffoldMessenger.of(context).showSnackBar(
+              const SnackBar(
+                content: Text('Sincronización de Beeper completada con éxito.'),
+                duration: Duration(seconds: 3),
+              ),
+            );
+          }
+        },
+      );
+    }
+  }
+}
