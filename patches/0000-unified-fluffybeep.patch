+
+class LabelEditorDialog extends StatefulWidget {
+  final String? labelUuid;
+  final String? initialTitle;
+  final String? initialEmoji;
+  final bool initialIsShownInInbox;
+
+  const LabelEditorDialog({
+    this.labelUuid,
+    this.initialTitle,
+    this.initialEmoji,
+    this.initialIsShownInInbox = true,
+    super.key,
+  });
+
+  @override
+  State<LabelEditorDialog> createState() => _LabelEditorDialogState();
+}
+
+class _LabelEditorDialogState extends State<LabelEditorDialog> {
+  late final TextEditingController _titleController;
+  String? _selectedEmoji;
+  bool _isShownInInbox = true;
+  bool _showEmojiPicker = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _titleController = TextEditingController(text: widget.initialTitle);
+    _selectedEmoji = widget.initialEmoji;
+    _isShownInInbox = widget.initialIsShownInInbox;
+  }
+
+  @override
+  void dispose() {
+    _titleController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _save() async {
+    final title = _titleController.text.trim();
+    if (title.isEmpty) return;
+
+    final client = Matrix.of(context).client;
+    final labels = Map<String, dynamic>.from(BeeperBridgeUtils.getBeeperLabels(client));
+
+    final uuid = widget.labelUuid ?? 'label_${DateTime.now().millisecondsSinceEpoch}';
+    final existingLabel = labels[uuid] as Map?;
+
+    labels[uuid] = {
+      'title': title,
+      'emoji': _selectedEmoji,
+      'isShownInInbox': _isShownInInbox,
+      'rooms': existingLabel != null ? List<String>.from(existingLabel['rooms'] ?? []) : <String>[],
+      'createdAt': existingLabel != null ? (existingLabel['createdAt'] ?? (DateTime.now().millisecondsSinceEpoch ~/ 1000)) : (DateTime.now().millisecondsSinceEpoch ~/ 1000),
+    };
+
+    await BeeperBridgeUtils.setBeeperLabels(client, labels);
+    if (mounted) {
+      Navigator.of(context).pop(true);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+
+    return Scaffold(
+      appBar: AppBar(
+        title: Text(widget.labelUuid == null ? 'Nueva etiqueta' : 'Editar etiqueta'),
+        actions: [
+          IconButton(
+            icon: const Icon(Icons.check),
+            onPressed: _save,
+          ),
+        ],
+      ),
+      body: SafeArea(
+        child: Column(
+          children: [
+            Expanded(
+              child: ListView(
+                padding: const EdgeInsets.all(16),
+                children: [
+                  Row(
+                    children: [
+                      InkWell(
+                        onTap: () {
+                          setState(() {
+                            _showEmojiPicker = !_showEmojiPicker;
+                          });
+                        },
+                        child: CircleAvatar(
+                          radius: 28,
+                          backgroundColor: theme.colorScheme.primaryContainer,
+                          child: Text(
+                            _selectedEmoji ?? '🏷️',
+                            style: const TextStyle(fontSize: 28),
+                          ),
+                        ),
+                      ),
+                      const SizedBox(width: 16),
+                      Expanded(
+                        child: TextField(
+                          controller: _titleController,
+                          decoration: const InputDecoration(
+                            labelText: 'Título de la etiqueta',
+                            border: OutlineInputBorder(),
+                          ),
+                        ),
+                      ),
+                    ],
+                  ),
+                  const SizedBox(height: 16),
+                  SwitchListTile(
+                    title: const Text('Mostrar en la bandeja de entrada'),
+                    subtitle: const Text('Si se desactiva, los chats con esta etiqueta no aparecerán en el buzón general.'),
+                    value: _isShownInInbox,
+                    onChanged: (val) {
+                      setState(() {
+                        _isShownInInbox = val;
+                      });
+                    },
+                  ),
+                ],
+              ),
+            ),
+            if (_showEmojiPicker)
+              SizedBox(
+                height: 250,
+                child: EmojiPicker(
+                  onEmojiSelected: (category, emoji) {
+                    setState(() {
+                      _selectedEmoji = emoji.emoji;
+                      _showEmojiPicker = false;
+                    });
+                  },
+                  config: Config(
+                    height: 256,
+                    checkPlatformCompatibility: true,
+                    emojiViewConfig: EmojiViewConfig(
+                      emojiSizeMax: 28 *
+                          (foundation.defaultTargetPlatform ==
+                                  TargetPlatform.iOS
+                              ? 1.20
+                              : 1.0),
+                    ),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
