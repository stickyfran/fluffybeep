diff --git a/lib/widgets/cache_refresh_overlay.dart b/lib/widgets/cache_refresh_overlay.dart
new file mode 100644
index 0000000..8230a07
--- /dev/null
+++ b/lib/widgets/cache_refresh_overlay.dart
@@ -0,0 +1,173 @@
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/beeper_bridge_utils.dart';
+import 'package:fluffychat/utils/client_download_content_extension.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class CacheRefreshOverlay extends StatefulWidget {
+  final Client client;
+  final SharedPreferences store;
+  final Widget child;
+
+  const CacheRefreshOverlay({
+    required this.client,
+    required this.store,
+    required this.child,
+    super.key,
+  });
+
+  @override
+  State<CacheRefreshOverlay> createState() => _CacheRefreshOverlayState();
+}
+
+class _CacheRefreshOverlayState extends State<CacheRefreshOverlay> {
+  bool _completed = false;
+  int _processedRooms = 0;
+  int _totalRooms = 0;
+  String _currentRoomName = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _startPrewarming();
+  }
+
+  Future<void> _startPrewarming() async {
+    try {
+      // 1. Wait for the initial sync to finish
+      await widget.client.onSync.stream.firstWhere(
+        (s) => widget.client.prevBatch != null,
+      );
+
+      // 2. Fetch and sort rooms by last message (latest first)
+      final rooms = List<Room>.from(widget.client.rooms);
+      rooms.sort((a, b) {
+        final aTime = a.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        final bTime = b.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        return bTime.compareTo(aTime);
+      });
+
+      if (mounted) {
+        setState(() {
+          _totalRooms = rooms.length;
+        });
+      }
+
+      final locals = MatrixLocals(L10n.of(context));
+
+      // 3. Process each room
+      for (final room in rooms) {
+        if (!mounted) break;
+        final roomName = room.getBeeperDisplayname(locals);
+        setState(() {
+          _currentRoomName = roomName;
+        });
+
+        // Force download history (last 30 messages)
+        try {
+          final timeline = await room.getTimeline();
+          await timeline.requestHistory(historyCount: 30);
+          timeline.cancelSubscriptions();
+        } catch (_) {}
+
+        // Pre-download avatar to local cache
+        final avatarUri = room.avatar;
+        if (avatarUri != null) {
+          try {
+            await widget.client.downloadMxcCached(avatarUri);
+          } catch (_) {}
+        }
+
+        // Also pre-download contact avatar for fake DMs
+        final contactAvatar = BeeperBridgeUtils.getRealContactFromFakeDM(room)?.avatarUrl;
+        if (contactAvatar != null) {
+          try {
+            await widget.client.downloadMxcCached(contactAvatar);
+          } catch (_) {}
+        }
+
+        if (mounted) {
+          setState(() {
+            _processedRooms++;
+          });
+        }
+      }
+    } catch (e) {
+      debugPrint('Error during prewarming cache: $e');
+    } finally {
+      if (mounted) {
+        await widget.store.setBool('beeper_needs_cache_refresh', false);
+        setState(() {
+          _completed = true;
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Stack(
+      children: [
+        // Always build the main app child first in the background
+        widget.child,
+
+        // If not completed, display the progress overlay on top
+        if (!_completed)
+          Positioned.fill(
+            child: Scaffold(
+              backgroundColor: Colors.black.withOpacity(0.9),
+              body: Center(
+                child: Padding(
+                  padding: const EdgeInsets.symmetric(horizontal: 32.0),
+                  child: Column(
+                    mainAxisAlignment: MainAxisAlignment.center,
+                    children: [
+                      const CircularProgressIndicator(
+                        valueColor: AlwaysStoppedAnimation<Color>(Colors.white),
+                        strokeWidth: 3,
+                      ),
+                      const SizedBox(height: 32),
+                      const Text(
+                        'Sincronizando chats...',
+                        style: TextStyle(
+                          color: Colors.white,
+                          fontSize: 20,
+                          fontWeight: FontWeight.bold,
+                        ),
+                      ),
+                      const SizedBox(height: 12),
+                      Text(
+                        _totalRooms > 0
+                            ? 'Procesando $_processedRooms de $_totalRooms'
+                            : 'Iniciando conexión...',
+                        style: TextStyle(
+                          color: Colors.white.withOpacity(0.7),
+                          fontSize: 14,
+                        ),
+                      ),
+                      if (_currentRoomName.isNotEmpty) ...[
+                        const SizedBox(height: 16),
+                        Text(
+                          _currentRoomName,
+                          style: TextStyle(
+                            color: Colors.white.withOpacity(0.5),
+                            fontSize: 12,
+                            fontStyle: FontStyle.italic,
+                          ),
+                          textAlign: TextAlign.center,
+                          maxLines: 1,
+                          overflow: TextOverflow.ellipsis,
+                        ),
+                      ],
+                    ],
+                  ),
+                ),
+              ),
+            ),
+          ),
+      ],
+    );
+  }
+}
