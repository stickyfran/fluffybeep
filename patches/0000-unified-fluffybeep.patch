+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import '../../config/app_config.dart';
+import '../../config/themes.dart';
+import '../../utils/beeper_bridge_utils.dart';
+import '../../utils/beeper_merge_utils.dart';
+import '../../utils/beeper_phone_contacts.dart';
+import '../../utils/date_time_extension.dart';
+import '../../widgets/avatar.dart';
+import 'unread_bubble.dart';
+
+class MergedContactEntry {
+  final MergedContact contact;
+  final List<Room> rooms;
+  final DateTime latestTs;
+  final int totalUnread;
+  final Room? latestRoom;
+  final String displayName;
+  final Uri? avatarUrl;
+  final String? lastMessageSnippet;
+  final BeeperNetwork? latestNetwork;
+
+  const MergedContactEntry({
+    required this.contact,
+    required this.rooms,
+    required this.latestTs,
+    required this.totalUnread,
+    this.latestRoom,
+    required this.displayName,
+    this.avatarUrl,
+    this.lastMessageSnippet,
+    this.latestNetwork,
+  });
+}
+
+class MergedContactListItem extends StatelessWidget {
+  final MergedContactEntry entry;
+  final bool activeChat;
+  final VoidCallback onTap;
+  final void Function(BuildContext context)? onLongPress;
+  final String? filter;
+
+  const MergedContactListItem({
+    super.key,
+    required this.entry,
+    this.activeChat = false,
+    required this.onTap,
+    this.onLongPress,
+    this.filter,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final backgroundColor = activeChat ? theme.colorScheme.secondaryContainer : null;
+
+    final phoneContact = entry.contact.phoneContactId != null
+        ? BeeperPhoneContacts.findById(entry.contact.phoneContactId!)
+        : null;
+
+    final Widget avatarWidget = SizedBox(
+      width: Avatar.defaultSize,
+      height: Avatar.defaultSize,
+      child: Stack(
+        clipBehavior: Clip.none,
+        children: [
+          if (phoneContact?.thumbnail != null)
+            ClipRRect(
+              borderRadius: BorderRadius.circular(Avatar.defaultSize),
+              child: Image.memory(
+                phoneContact!.thumbnail!,
+                width: Avatar.defaultSize,
+                height: Avatar.defaultSize,
+                cacheWidth: (Avatar.defaultSize * MediaQuery.devicePixelRatioOf(context)).round(),
+                cacheHeight: (Avatar.defaultSize * MediaQuery.devicePixelRatioOf(context)).round(),
+                fit: BoxFit.cover,
+              ),
+            )
+          else
+            Avatar(
+              mxContent: entry.avatarUrl,
+              size: Avatar.defaultSize,
+              name: BeeperBridgeUtils.sanitizeDisplayName(entry.displayName),
+              onTap: () => onLongPress?.call(context),
+            ),
+          Positioned(
+            bottom: -2,
+            right: -2,
+            child: _NetworkBadgeRow(
+              rooms: entry.rooms,
+              activeNetworkKey: entry.latestNetwork?.key ??
+                  (entry.latestRoom != null
+                      ? BeeperBridgeUtils.getRoomNetwork(entry.latestRoom!)?.key
+                      : null),
+            ),
+          ),
+        ],
+      ),
+    );
+
+    final snippet = entry.lastMessageSnippet ?? 'Chat unificado';
+    final hasNewMessages = entry.totalUnread > 0 || entry.rooms.any(BeeperBridgeUtils.isRoomUnread);
+
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 8),
+      child: Material(
+        borderRadius: BorderRadius.circular(AppConfig.borderRadius),
+        clipBehavior: Clip.hardEdge,
+        color: backgroundColor,
+        child: RepaintBoundary(
+          child: ListTile(
+          minVerticalPadding: 16,
+          contentPadding: const EdgeInsets.symmetric(horizontal: 8),
+          onLongPress: () => onLongPress?.call(context),
+          onTap: onTap,
+          leading: avatarWidget,
+          title: Row(
+            children: [
+              Expanded(
+                child: Row(
+                  children: [
+                    Flexible(
+                      child: Text(
+                        BeeperBridgeUtils.sanitizeDisplayName(entry.displayName),
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(
+                          fontWeight: hasNewMessages ? FontWeight.bold : FontWeight.w600,
+                        ),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+          subtitle: Text(
+            snippet,
+            maxLines: 1,
+            overflow: TextOverflow.ellipsis,
+            style: TextStyle(
+              color: theme.textTheme.bodyMedium?.color?.withValues(alpha: 0.8),
+            ),
+          ),
+          trailing: Material(
+            color: Colors.transparent,
+            child: InkWell(
+              borderRadius: BorderRadius.circular(16),
+              onTap: hasNewMessages
+                  ? () async {
+                      for (final room in entry.rooms) {
+                        await BeeperBridgeUtils.markRoomAsRead(
+                          room,
+                          publicReceipt: true,
+                        );
+                      }
+                      BeeperBridgeUtils.roomReadChangeNotifier.value = null;
+                      BeeperBridgeUtils.roomReadChangeNotifier.value = entry.rooms.firstOrNull?.id;
+                    }
+                  : null,
+              child: AnimatedContainer(
+                duration: FluffyThemes.animationDuration,
+                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+                decoration: BoxDecoration(
+                  borderRadius: BorderRadius.circular(16),
+                  border: hasNewMessages
+                      ? Border.all(
+                          color: theme.colorScheme.primary.withValues(alpha: 0.3),
+                          width: 1,
+                        )
+                      : null,
+                  color: hasNewMessages
+                      ? theme.colorScheme.primary.withValues(alpha: 0.08)
+                      : Colors.transparent,
+                ),
+                child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  mainAxisAlignment: MainAxisAlignment.center,
+                  children: [
+                    if (entry.latestTs.millisecondsSinceEpoch > 0)
+                      Text(
+                        entry.latestTs.localizedTimeShort(context),
+                        style: TextStyle(
+                          fontSize: 11,
+                          fontWeight: hasNewMessages ? FontWeight.bold : null,
+                          color: hasNewMessages
+                              ? theme.colorScheme.primary
+                              : theme.colorScheme.onSurfaceVariant,
+                        ),
+                      ),
+                    if (hasNewMessages) ...[
+                      const SizedBox(height: 4),
+                      Container(
+                        padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
+                        decoration: BoxDecoration(
+                          color: theme.colorScheme.primary,
+                          borderRadius: BorderRadius.circular(10),
+                        ),
+                        child: Text(
+                          entry.totalUnread > 0 ? '${entry.totalUnread}' : '!',
+                          style: TextStyle(
+                            fontSize: 11,
+                            color: theme.colorScheme.onPrimary,
+                            fontWeight: FontWeight.bold,
+                          ),
+                        ),
+                      ),
+                    ],
+                  ],
+                ),
+              ),
+            ),
+          ),
+        ),
+        ),
+      ),
+    );
+  }
+}
+
+class _NetworkBadgeRow extends StatelessWidget {
+  final List<Room> rooms;
+  final String? activeNetworkKey;
+
+  const _NetworkBadgeRow({
+    required this.rooms,
+    this.activeNetworkKey,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final networks = <BeeperNetwork>[];
+    final seenKeys = <String>{};
+
+    for (final room in rooms) {
+      final net = BeeperBridgeUtils.getRoomNetwork(room);
+      if (net != null && seenKeys.add(net.key)) {
+        networks.add(net);
+      }
+    }
+
+    if (networks.isEmpty) {
+      return Container(
+        width: 8,
+        height: 8,
+        decoration: BoxDecoration(
+          shape: BoxShape.circle,
+          color: Theme.of(context).colorScheme.primary,
+          border: Border.all(color: Theme.of(context).colorScheme.surface, width: 1.0),
+        ),
+        child: Icon(Icons.link, size: 5, color: Theme.of(context).colorScheme.onPrimary),
+      );
+    }
+
+    return Row(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.center,
+      children: networks.take(5).map((net) {
+        final isActive = net.key == activeNetworkKey;
+        final size = isActive ? 10.0 : 6.5;
+        return Container(
+          margin: const EdgeInsets.symmetric(horizontal: 1.0),
+          width: size,
+          height: size,
+          decoration: BoxDecoration(
+            shape: BoxShape.circle,
+            color: Color(net.colorHex),
+            border: Border.all(
+              color: Theme.of(context).colorScheme.surface,
+              width: isActive ? 1.5 : 1.0,
+            ),
+          ),
+        );
+      }).toList(),
+    );
+  }
+}
