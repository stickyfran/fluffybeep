+          final val = e.value as Map;
+          final emoji = val['emoji']?.toString() ?? '🏷️';
+          final title = val['title']?.toString() ?? '';
+          return '$emoji $title'.trim();
+        })
+        .toList();
+
+    if (activeLabels.isEmpty) {
+      return const Text('Sin etiquetas asignadas (toca para asignar)');
+    }
+    return Text(
+      activeLabels.join(', '),
+      maxLines: 1,
+      overflow: TextOverflow.ellipsis,
+      style: TextStyle(
+        color: Theme.of(context).colorScheme.primary,
+        fontWeight: FontWeight.w500,
       ),
     );
   }
+
+  Future<void> _showManageLabelsDialog(BuildContext context, Room room) async {
+    final client = room.client;
+    final isMerged = BeeperMergeUtils.isRoomMerged(room.id);
+    final targetRoomIds = isMerged
+        ? {room.id, ...BeeperMergeUtils.getSiblingRooms(room.id).map((r) => r.id)}.toList()
+        : [room.id];
+
+    await showModalBottomSheet(
+      context: context,
+      isScrollControlled: true,
+      shape: const RoundedRectangleBorder(
+        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
+      ),
+      builder: (ctx) {
+        return StatefulBuilder(
+          builder: (ctx, setModalState) {
+            final labels = BeeperBridgeUtils.getBeeperLabels(client);
+            final labelEntries = labels.entries
+                .where((e) => e.key != '_hidden_networks')
+                .toList();
+
+            return SafeArea(
+              child: Padding(
+                padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 8),
+                child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    Container(
+                      width: 40,
+                      height: 4,
+                      margin: const EdgeInsets.only(bottom: 16),
+                      decoration: BoxDecoration(
+                        color: Theme.of(context).dividerColor,
+                        borderRadius: BorderRadius.circular(2),
+                      ),
+                    ),
+                    Padding(
+                      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
+                      child: Row(
+                        children: [
+                          const Icon(Icons.label_outlined),
+                          const SizedBox(width: 12),
+                          Expanded(
+                            child: Text(
+                              isMerged
+                                  ? 'Etiquetas del contacto fusionado'
+                                  : 'Etiquetas de este chat',
+                              style: Theme.of(context).textTheme.titleMedium?.copyWith(
+                                    fontWeight: FontWeight.bold,
+                                  ),
+                            ),
+                          ),
+                        ],
+                      ),
+                    ),
+                    if (isMerged)
+                      Padding(
+                        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
+                        child: Text(
+                          'Al asignar o quitar una etiqueta, se aplicará a todas las cuentas vinculadas (${targetRoomIds.length} chats).',
+                          style: TextStyle(
+                            fontSize: 12,
+                            color: Theme.of(context).textTheme.bodySmall?.color,
+                          ),
+                        ),
+                      ),
+                    const Divider(),
+                    if (labelEntries.isEmpty)
+                      const Padding(
+                        padding: EdgeInsets.all(24.0),
+                        child: Text('No tienes etiquetas creadas todavía.'),
+                      )
+                    else
+                      Flexible(
+                        child: ListView.builder(
+                          shrinkWrap: true,
+                          itemCount: labelEntries.length,
+                          itemBuilder: (ctx, idx) {
+                            final entry = labelEntries[idx];
+                            final val = entry.value as Map;
+                            final emoji = val['emoji']?.toString() ?? '🏷️';
+                            final title = val['title']?.toString() ?? '';
+                            final rooms = List<String>.from(val['rooms'] ?? []);
+                            final isAssigned = targetRoomIds.any((id) => rooms.contains(id));
+
+                            return CheckboxListTile(
+                              value: isAssigned,
+                              title: Text('$emoji $title'.trim()),
+                              onChanged: (checked) async {
+                                final updatedLabels = Map<String, dynamic>.from(labels);
+                                final labelData = Map<String, dynamic>.from(updatedLabels[entry.key] as Map);
+                                final currentRooms = List<String>.from(labelData['rooms'] ?? []);
+                                if (checked == true) {
+                                  for (final id in targetRoomIds) {
+                                    if (!currentRooms.contains(id)) {
+                                      currentRooms.add(id);
+                                    }
+                                  }
+                                } else {
+                                  currentRooms.removeWhere((id) => targetRoomIds.contains(id));
+                                }
+                                labelData['rooms'] = currentRooms;
+                                updatedLabels[entry.key] = labelData;
+                                await BeeperBridgeUtils.setBeeperLabels(client, updatedLabels);
+                                setModalState(() {});
+                                if (mounted) setState(() {});
+                              },
+                            );
+                          },
+                        ),
+                      ),
+                    const Divider(),
+                    ListTile(
+                      leading: const Icon(Icons.add_circle_outline),
+                      title: const Text('Crear nueva etiqueta...'),
+                      onTap: () async {
+                        Navigator.of(ctx).pop();
+                        final created = await showDialog<bool>(
+                          context: context,
+                          builder: (_) => const LabelEditorDialog(),
+                        );
+                        if (created == true && mounted) {
+                          _showManageLabelsDialog(context, room);
+                          setState(() {});
+                        }
+                      },
+                    ),
+                  ],
+                ),
+              ),
+            );
+          },
+        );
+      },
+    );
+  }
 }
