diff --git a/lib/utils/encryption_health_monitor.dart b/lib/utils/encryption_health_monitor.dart
new file mode 100644
index 0000000000000000000000000000000000000000..40f273a475175900235631ffdafa2c94e211e15f
--- /dev/null
+++ b/lib/utils/encryption_health_monitor.dart
@@ -0,0 +1,98 @@
+import 'dart:async';
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:matrix/encryption.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+
+class EncryptionHealthMonitor {
+  static final EncryptionHealthMonitor _instance = EncryptionHealthMonitor._internal();
+  factory EncryptionHealthMonitor() => _instance;
+  EncryptionHealthMonitor._internal();
+
+  Timer? _timer;
+  Client? _client;
+  BuildContext? _context;
+  String? _cachedRecoveryKey;
+
+  int _checkCount = 0;
+  static const int _maxRetries = 5;
+
+  void start(Client client, BuildContext context) {
+    _client = client;
+    _context = context;
+    _timer?.cancel();
+    _checkCount = 0;
+    // Run initial check and schedule fallback check every 15 minutes only if disconnected
+    _checkHealth();
+  }
+
+  void stop() {
+    _timer?.cancel();
+    _timer = null;
+    _client = null;
+    _context = null;
+    _cachedRecoveryKey = null;
+    _checkCount = 0;
+  }
+
+  Future<void> _checkHealth() async {
+    // Capture local refs before the first await so that a concurrent stop()
+    // (which nulls _client/_context) does not cause NPE force-unwraps later.
+    final client = _client;
+    final context = _context;
+    if (client == null || context == null || !context.mounted) return;
+    _checkCount++;
+    final state = await client.getCryptoIdentityState();
+
+    // After the async gap: bail out if stop() was called or client replaced.
+    if (_client == null || _client != client) return;
+
+    if (state.connected) {
+      // Identity is connected and healthy; cancel timer to conserve battery
+      _timer?.cancel();
+      _timer = null;
+      _checkCount = 0;
+      return;
+    }
+
+    if (_checkCount >= _maxRetries) {
+      // Cease polling after max retries to avoid wasting battery indefinitely
+      _timer?.cancel();
+      _timer = null;
+      return;
+    }
+
+    // Schedule fallback periodic check every 15 minutes while disconnected
+    _timer ??= Timer.periodic(const Duration(minutes: 15), (_) => _checkHealth());
+    
+    if (state.initialized && !state.connected) {
+      // Try to auto-restore using secure storage
+      final supportsSecureStorage = PlatformInfos.isMobile || PlatformInfos.isDesktop;
+      if (supportsSecureStorage) {
+        try {
+          _cachedRecoveryKey ??= await const FlutterSecureStorage().read(
+            key: 'ssss_recovery_key_${client.userID}',
+          );
+          // Re-check: stop() may have been called during the await above.
+          if (_client == null || _client != client) return;
+          if (_cachedRecoveryKey != null) {
+            await client.restoreCryptoIdentity(_cachedRecoveryKey!);
+            if (_client == null || _client != client) return;
+            final newState = await client.getCryptoIdentityState();
+            if (_client == null || _client != client) return;
+            if (newState.connected) {
+              Logs().i('EncryptionHealthMonitor: Successfully auto-restored crypto identity from secure storage.');
+              _timer?.cancel();
+              _timer = null;
+              return;
+            }
+          }
+        } catch (e) {
+          Logs().w('EncryptionHealthMonitor: Failed to auto-restore crypto identity', e);
+        }
+      }
+    }
+  }
+}
