+    final event = room.lastEvent;
+    if (event != null) {
+      final type = event.type;
+      if (type == 'm.room.message' ||
+          type == 'm.room.encrypted' ||
+          type == 'm.sticker') {
+        return event.originServerTs;
+      }
+    }
+    
+    final events = room.timeline?.events;
+    if (events != null && events.isNotEmpty) {
+      for (var i = events.length - 1; i >= 0; i--) {
+        final ev = events[i];
+        final t = ev.type;
+        if (t == 'm.room.message' ||
+            t == 'm.room.encrypted' ||
+            t == 'm.sticker') {
+          return ev.originServerTs;
+        }
+      }
+    }
+
+    return room.latestEventReceivedTime;
