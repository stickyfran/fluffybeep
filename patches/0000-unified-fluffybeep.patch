+import 'dart:io';
+import 'dart:async';
+import 'package:fluffychat/utils/beeper_bridge_utils.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class FileLogger {
+  static String? _logFilePath;
+  static bool? _enabledCache;
+  static final List<String> _logQueue = [];
+  static Timer? _flushTimer;
+  static bool _isFlushing = false;
+
+  static bool isEnabled() {
+    if (_enabledCache != null) return _enabledCache!;
+    try {
+      if (BeeperBridgeUtils.prefs != null) {
+        _enabledCache = BeeperBridgeUtils.prefs!.getBool('beeper_debug_logging_enabled') ?? false;
+        return _enabledCache!;
+      }
+    } catch (_) {}
+    return false;
+  }
+
+  static void setEnabled(bool val) {
+    _enabledCache = val;
+  }
+
+  static Future<void> checkEnabledAsync() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      _enabledCache = prefs.getBool('beeper_debug_logging_enabled') ?? false;
+    } catch (_) {}
+  }
+
+  static Future<String> _getLogFilePath() async {
+    if (_logFilePath != null) return _logFilePath!;
+    try {
+      final directory = await getApplicationDocumentsDirectory();
+      _logFilePath = '${directory.path}/fluffybeep_debug.txt';
+    } catch (e) {
+      _logFilePath = '/sdcard/Download/fluffybeep_debug.txt';
+    }
+    return _logFilePath!;
+  }
+
+  static Future<void> log(String message) async {
+    if (!isEnabled()) return;
+
+    final timestamp = DateTime.now().toIso8601String();
+    final formattedMessage = '[$timestamp] $message';
+
+    stderr.writeln(formattedMessage);
+    _logQueue.add(formattedMessage);
+
+    if (_logQueue.length >= 40) {
+      _flushQueue();
+    } else if (_flushTimer == null) {
+      _flushTimer = Timer(const Duration(milliseconds: 250), () {
+        _flushQueue();
+      });
+    }
+  }
+
+  static Future<void> _flushQueue() async {
+    _flushTimer?.cancel();
+    _flushTimer = null;
+
+    if (_logQueue.isEmpty || _isFlushing) return;
+    _isFlushing = true;
+
+    final batch = List<String>.from(_logQueue);
+    _logQueue.clear();
+
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+
+      if (await file.exists()) {
+        final length = await file.length();
+        if (length > 15 * 1024 * 1024) {
+          try {
+            final backupFile = File('$path.1');
+            if (await backupFile.exists()) {
+              await backupFile.delete();
+            }
+            await file.rename('$path.1');
+            await file.writeAsString(
+              '[LOG_ROTATED] Log size exceeded 15MB. Rotated to $path.1\n',
+            );
+          } catch (_) {}
+        }
+      }
+
+      final textToAppend = '${batch.join('\n')}\n';
+      await file.writeAsString(textToAppend, mode: FileMode.writeOnlyAppend, flush: false);
+    } catch (e) {
+      stderr.writeln('FileLogger flush failed: $e');
+    } finally {
+      _isFlushing = false;
+      if (_logQueue.isNotEmpty) {
+        _flushQueue();
+      }
+    }
+  }
+
+  static Future<int> getLogSize() async {
+    await _flushQueue();
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+      if (await file.exists()) {
+        return await file.length();
+      }
+    } catch (_) {}
+    return 0;
+  }
+
+  static Future<void> clearLog() async {
+    _logQueue.clear();
+    try {
+      final path = await _getLogFilePath();
+      final file = File(path);
+      if (await file.exists()) {
+        await file.delete();
+      }
+      final backup = File('$path.1');
+      if (await backup.exists()) {
+        await backup.delete();
+      }
+    } catch (_) {}
+  }
+
+  static Future<String> getLogPath() async {
+    return await _getLogFilePath();
+  }
+}
