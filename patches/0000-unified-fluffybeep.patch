diff --git a/lib/controllers/beeper_reinit_controller.dart b/lib/controllers/beeper_reinit_controller.dart
new file mode 100644
index 0000000..5f34c85
--- /dev/null
+++ b/lib/controllers/beeper_reinit_controller.dart
@@ -0,0 +1,124 @@
+import 'dart:io';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:fluffychat/widgets/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class BeeperReinitController {
+  final Client client;
+
+  BeeperReinitController({required this.client});
+
+  /// Purges local cache using the SDK's official lifecycle method.
+  /// client.clearCache() handles pausing sync, wiping the DB tables, and
+  /// restarting the sync loop — preventing any database corruption.
+  Future<void> reinitCache(BuildContext context) async {
+    try {
+      // Use the official SDK method: it stops sync, clears the cache,
+      // and restarts the sync loop in a safe, atomic sequence.
+      await client.clearCache();
+    } catch (e) {
+      debugPrint('Error during Beeper cache reinitialization: $e');
+      rethrow;
+    }
+  }
+
+  /// Displays an overlay to block the UI while reinitializing and restarts the app.
+  static Future<void> showReinitOverlay(BuildContext context, Client client) async {
+    // Show a confirmation dialog first
+    final confirm = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Re-sincronizar chats (Beeper)'),
+        content: const Text('La caché se limpiará y la aplicación se cerrará. Al volver a abrirla, descargará todo tu historial y avatares forzosamente.'),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('Cancelar'),
+          ),
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: const Text('Aceptar'),
+          ),
+        ],
+      ),
+    );
+
+    if (confirm != true) return;
+
+    // Show the progress overlay
+    final overlay = OverlayEntry(
+      builder: (context) => Stack(
+        children: [
+          const ModalBarrier(
+            color: Colors.black54,
+            dismissible: false,
+          ),
+          Center(
+            child: Container(
+              padding: const EdgeInsets.all(24),
+              decoration: BoxDecoration(
+                color: Theme.of(context).dialogBackgroundColor,
+                borderRadius: BorderRadius.circular(12),
+              ),
+              child: const Column(
+                mainAxisSize: MainAxisSize.min,
+                children: [
+                  CircularProgressIndicator(),
+                  SizedBox(height: 16),
+                  Text(
+                    'Limpiando caché...',
+                    style: TextStyle(fontSize: 16, decoration: TextDecoration.none),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+
+    Overlay.of(context).insert(overlay);
+
+    try {
+      await client.clearCache();
+      final prefs = await SharedPreferences.getInstance();
+      await prefs.setBool('beeper_needs_cache_refresh', true);
+      await Future.delayed(const Duration(milliseconds: 500));
+      overlay.remove();
+      if (context.mounted) {
+        showDialog(
+          context: context,
+          barrierDismissible: false,
+          builder: (context) => AlertDialog(
+            title: const Text('Caché limpiada'),
+            content: const Text('Para descargar el historial completo de Beeper, CIERRA ESTA APLICACIÓN forzadamente desde las tareas recientes de tu celular y vuelve a abrirla.'),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('Entendido'),
+              ),
+            ],
+          ),
+        );
+      }
+    } catch (e) {
+      overlay.remove();
+      if (context.mounted) {
+        showDialog(
+          context: context,
+          builder: (context) => AlertDialog(
+            title: const Text('Error'),
+            content: Text('Ocurrió un error al limpiar la caché: $e'),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('Aceptar'),
+              ),
+            ],
+          ),
+        );
+      }
+    }
+  }
+}
