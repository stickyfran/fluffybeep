+
+/// Logger especializado exclusivamente en capturar crasheos no controlados, freezes/tildes (ANRs) de la UI
+/// y migas de pan (Breadcrumbs) de contexto en tiempo real con filtrado de segundo plano.
+class CrashLogger {
+  static const String prefKey = 'beeper_crash_logging_enabled';
+  static bool _enabled = false;
+  static bool get isEnabled => _enabled;
+
+  static File? _logFile;
+  static Timer? _watchdogTimer;
+  static DateTime _lastHeartbeat = DateTime.now();
+  static bool _watchdogActive = false;
+  static bool _handlersHooked = false;
+
+  // Umbral de bloqueo del hilo principal para considerarlo congelamiento severo (freeze)
+  static const int freezeThresholdMs = 3500;
+
+  // Estado del ciclo de vida de la aplicación para evitar falsos positivos por suspensión de Android (Doze / segundo plano)
+  static bool _isForeground = true;
+  static bool get isForeground => _isForeground;
+  static _CrashLoggerLifecycleObserver? _lifecycleObserver;
+
+  // Buffer circular de migas de pan (Breadcrumbs)
+  static final ListQueue<String> _breadcrumbs = ListQueue<String>();
+  static const int _maxBreadcrumbs = 40;
+  static String? _lastDumpedBreadcrumb;
+
+  /// Obtiene el consumo actual de memoria RAM del proceso en formato legible.
+  static String get currentRamUsage {
+    try {
+      final bytes = ProcessInfo.currentRss;
+      if (bytes > 0) {
+        return '${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB';
+      }
+    } catch (_) {}
+    return 'N/A';
+  }
+
+  static Future<void> checkEnabledAsync() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      _enabled = prefs.getBool(prefKey) ?? false;
+      if (_enabled) {
+        await _initFile();
+      }
+    } catch (_) {}
+  }
+
+  static Future<void> setEnabled(bool val) async {
+    _enabled = val;
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      await prefs.setBool(prefKey, val);
+      if (val) {
+        await _initFile();
+        init();
+        logEvent('CrashLogger activado manualmente por el usuario. RAM inicial: $currentRamUsage');
+      } else {
+        stopWatchdog();
+        logEvent('CrashLogger desactivado por el usuario.');
+      }
+    } catch (_) {}
+  }
+
+  static Future<void> _initFile() async {
+    if (_logFile != null) return;
+    try {
+      final dir = await getApplicationDocumentsDirectory();
+      _logFile = File('${dir.path}/fluffybeep_crash_freeze.txt');
+    } catch (_) {
+      final fallback = File('/sdcard/Download/fluffybeep_crash_freeze.txt');
+      _logFile = fallback;
+    }
+  }
+
+  static void onLifecycleChanged(AppLifecycleState state) {
+    final wasForeground = _isForeground;
+    _isForeground = (state == AppLifecycleState.resumed);
+
+    if (_isForeground) {
+      _lastHeartbeat = DateTime.now();
+      if (_enabled) {
+        startWatchdog();
+      }
+      addBreadcrumb('LIFECYCLE', 'App reanudada en primer plano (resumed)');
+    } else if (wasForeground) {
+      // Si la app pasa a segundo plano o se apaga la pantalla, detener el watchdog
+      // para evitar que el estrangulamiento de CPU del sistema operativo (Doze) genere falsos positivos de freeze.
+      stopWatchdog();
+      addBreadcrumb('LIFECYCLE', 'App en segundo plano o suspendida (${state.name})');
+    }
+  }
+
+  static void init() {
+    // Siempre asegurar que el observador de ciclo de vida esté registrado
+    // si el framework de Flutter está listo, para mantener _isForeground actualizado.
+    if (_lifecycleObserver == null) {
+      _lifecycleObserver = _CrashLoggerLifecycleObserver();
+      WidgetsBinding.instance.addObserver(_lifecycleObserver!);
+    }
+    final currentLifecycle = WidgetsBinding.instance.lifecycleState;
+    _isForeground = currentLifecycle == null || currentLifecycle == AppLifecycleState.resumed;
+
+    if (!_enabled) return;
+
+    _checkPreviousSession();
+
+    if (!_handlersHooked) {
+      _handlersHooked = true;
+
+      // 1. Flutter framework error handler
+      final originalOnError = FlutterError.onError;
+      FlutterError.onError = (FlutterErrorDetails details) {
+        logCrash('FLUTTER_ERROR', details.exceptionAsString(), details.stack);
+        if (originalOnError != null) {
+          originalOnError(details);
+        }
+      };
+
+      // 2. Async error handler (PlatformDispatcher)
+      PlatformDispatcher.instance.onError = (Object error, StackTrace stack) {
+        logCrash('PLATFORM_ASYNC_ERROR', error.toString(), stack);
+        return false;
+      };
+
+      // 3. Isolate errors
+      final errorPort = ReceivePort();
+      errorPort.listen((message) {
+        if (message is List && message.length >= 2) {
+          logCrash('ISOLATE_ERROR', message[0].toString(), StackTrace.fromString(message[1].toString()));
+        } else {
+          logCrash('ISOLATE_ERROR', message.toString(), null);
+        }
+      });
+      Isolate.current.addErrorListener(errorPort.sendPort);
+
+      // 4. Detección de frames bloqueados (> 150ms)
+      WidgetsBinding.instance.addTimingsCallback((List<FrameTiming> timings) {
+        if (!_enabled || !_isForeground) return;
+        for (final timing in timings) {
+          final totalDuration = timing.totalSpan.inMilliseconds;
+          final buildDuration = timing.buildDuration.inMilliseconds;
+          final rasterDuration = timing.rasterDuration.inMilliseconds;
+          if (totalDuration > 150) {
+            logFreeze(
+              'UI_FRAME_DROP',
+              'Frame demoro ' + totalDuration.toString() + 'ms (Build: ' + buildDuration.toString() + 'ms, Raster: ' + rasterDuration.toString() + 'ms)',
+            );
+          }
+        }
+      });
+    }
+
+    if (_isForeground) {
+      startWatchdog();
+    }
+  }
+
+  static void _checkPreviousSession() {
+    if (_logFile == null) return;
+    try {
+      if (_logFile!.existsSync() && _logFile!.lengthSync() > 0) {
+        _write('[SESSION_START] [' + DateTime.now().toIso8601String() + '] CrashLogger iniciado en nueva sesión. (Si la sesión previa cerró abruptamente, revisa el último BREADCRUMB previo) | RAM: ' + currentRamUsage + '\n');
+      } else {
+        _write('[SESSION_START] [' + DateTime.now().toIso8601String() + '] CrashLogger iniciado | RAM: ' + currentRamUsage + '\n');
+      }
+    } catch (_) {}
+  }
+
+  /// Añade una miga de pan contextual al buffer y la persiste inmediatamente en disco.
+  static void addBreadcrumb(String category, String message) {
+    final now = DateTime.now().toIso8601String();
+    final ram = currentRamUsage;
+    final breadcrumb = '[$now] [$category] $message | RAM: $ram';
+
+    if (_breadcrumbs.length >= _maxBreadcrumbs) {
+      _breadcrumbs.removeFirst();
+    }
+    _breadcrumbs.addLast(breadcrumb);
+
+    if (_enabled) {
+      _write('[BREADCRUMB] $breadcrumb\n');
+    }
+  }
+
+  /// Watchdog para detectar ANRs o freezes donde el event loop se queda colgado en primer plano
+  static void startWatchdog() {
+    if (_watchdogActive || !_enabled) return;
+
+    final currentLifecycle = WidgetsBinding.instance.lifecycleState;
+    final isActuallyForeground = _isForeground &&
+        (currentLifecycle == null || currentLifecycle == AppLifecycleState.resumed);
+
+    if (!isActuallyForeground) return;
+
+    _watchdogActive = true;
+    _lastHeartbeat = DateTime.now();
+
+    _watchdogTimer = Timer.periodic(const Duration(milliseconds: 1000), (timer) {
+      final now = DateTime.now();
+
+      // Si la app no está en primer plano, detener watchdog inmediatamente
+      final state = WidgetsBinding.instance.lifecycleState;
+      final isForegroundNow = _isForeground &&
+          (state == null || state == AppLifecycleState.resumed);
+
+      if (!isForegroundNow) {
+        stopWatchdog();
+        return;
+      }
+
+      final diff = now.difference(_lastHeartbeat).inMilliseconds;
+
+      // Descartar saltos causados por despertar tardío de suspensión (> 15s)
+      if (diff > 15000) {
+        _lastHeartbeat = now;
+        return;
+      }
+
+      if (diff > freezeThresholdMs) {
+        logFreeze(
+          'MAIN_THREAD_FROZEN',
+          'El hilo principal estuvo bloqueado por ' + diff.toString() + 'ms (posible ANR o tarea pesada sincrona)',
+        );
+      }
+      _lastHeartbeat = now;
+    });
+  }
+
+  static void stopWatchdog() {
+    _watchdogActive = false;
+    _watchdogTimer?.cancel();
+    _watchdogTimer = null;
+  }
+
+  static void logEvent(String message) {
+    _write('[EVENT] [' + DateTime.now().toIso8601String() + '] ' + message + '\n');
+  }
+
+  static void logFreeze(String type, String details) {
+    final buffer = StringBuffer();
+    buffer.writeln('[FREEZE] [' + DateTime.now().toIso8601String() + '] [' + type + '] ' + details + ' | RAM: ' + currentRamUsage);
+    if (_breadcrumbs.isNotEmpty) {
+      final currentLastBreadcrumb = _breadcrumbs.last;
+      if (_lastDumpedBreadcrumb == currentLastBreadcrumb) {
+        buffer.writeln('  ↳ Contexto previo: (Sin cambios en breadcrumbs)');
+      } else {
+        _lastDumpedBreadcrumb = currentLastBreadcrumb;
+        buffer.writeln('  ↳ Contexto previo (Breadcrumbs):');
+        for (final b in _breadcrumbs) {
+          buffer.writeln('     * $b');
+        }
+      }
+    }
+    _write(buffer.toString());
+  }
+
+  static void logCrash(String type, String error, StackTrace? stack) {
+    final buffer = StringBuffer();
+    buffer.writeln('==================== CRASH / EXCEPTION ====================');
+    buffer.writeln('Timestamp: ' + DateTime.now().toIso8601String());
+    buffer.writeln('Type: ' + type);
+    buffer.writeln('Error: ' + error);
+    buffer.writeln('RAM: ' + currentRamUsage);
+    if (_breadcrumbs.isNotEmpty) {
+      buffer.writeln('Contexto previo (Breadcrumbs):');
+      for (final b in _breadcrumbs) {
+        buffer.writeln('  * $b');
+      }
+    }
+    if (stack != null) {
+      buffer.writeln('StackTrace:\n' + stack.toString());
+    }
+    buffer.writeln('===========================================================');
+    _write(buffer.toString());
+  }
+
+  static void _write(String text) {
+    if (!_enabled) return;
+    try {
+      if (_logFile != null) {
+        _logFile!.writeAsStringSync(text, mode: FileMode.append, flush: true);
+      }
+    } catch (_) {}
+  }
+
+  static Future<String?> getLogPath() async {
+    await _initFile();
+    if (_logFile != null && await _logFile!.exists()) {
+      return _logFile!.path;
+    }
+    return null;
+  }
+
+  static Future<int> getLogSize() async {
+    try {
+      await _initFile();
+      if (_logFile != null && await _logFile!.exists()) {
+        return await _logFile!.length();
+      }
+    } catch (_) {}
+    return 0;
+  }
+
+  static Future<void> clearLog() async {
+    _breadcrumbs.clear();
+    _lastDumpedBreadcrumb = null;
+    try {
+      await _initFile();
+      if (_logFile != null && await _logFile!.exists()) {
+        await _logFile!.delete();
+      }
+    } catch (_) {}
+  }
+}
+
+class _CrashLoggerLifecycleObserver with WidgetsBindingObserver {
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    CrashLogger.onLifecycleChanged(state);
+  }
+}
