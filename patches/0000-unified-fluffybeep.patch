+++ b/lib/utils/transcription_service.dart
@@ -0,0 +1,441 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:io';
+
+import 'package:ffmpeg_kit_flutter_new_min/ffmpeg_kit.dart';
+import 'package:ffmpeg_kit_flutter_new_min/return_code.dart';
+import 'package:flutter/foundation.dart';
+import 'package:http/http.dart' as http;
+import 'package:matrix/matrix.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:whisper_ggml/whisper_ggml.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/utils/crash_logger.dart';
+
+class TranscriptionService {
+  static final TranscriptionService _instance =
+      TranscriptionService._internal();
+  factory TranscriptionService() => _instance;
+  TranscriptionService._internal();
+
+  final WhisperController _whisperController = WhisperController();
+  final Map<String, String> _memoryCache = {};
+  SharedPreferences? _prefs;
+  Timer? _idleTimer;
+
+  static const String _prefPrefix = 'audio_transcription_';
+
+  void _scheduleModelRelease() {
+    _idleTimer?.cancel();
+    _idleTimer = Timer(const Duration(seconds: 90), () {
+      releaseModel();
+    });
+  }
+
+  Future<void> _initPrefs() async {
+    _prefs ??= await SharedPreferences.getInstance();
+  }
+
+  /// Retorna la transcripción desde la caché en memoria si ya fue cargada.
+  String? getCachedTranscription(String eventId) {
+    if (_memoryCache.containsKey(eventId)) {
+      return _memoryCache[eventId];
+    }
+    final fromPrefs = _prefs?.getString('$_prefPrefix$eventId');
+    if (fromPrefs != null && fromPrefs.isNotEmpty) {
+      _memoryCache[eventId] = fromPrefs;
+      return fromPrefs;
+    }
+    return null;
+  }
+
+  /// Obtiene la transcripción persistida de forma asíncrona.
+  Future<String?> getTranscription(String eventId) async {
+    final cached = getCachedTranscription(eventId);
+    if (cached != null) return cached;
+    await _initPrefs();
+    final stored = _prefs?.getString('$_prefPrefix$eventId');
+    if (stored != null && stored.isNotEmpty) {
+      _memoryCache[eventId] = stored;
+      return stored;
+    }
+    return null;
+  }
+
+  /// Guarda la transcripción en memoria y en almacenamiento persistente.
+  Future<void> saveTranscription(String eventId, String text) async {
+    final cleanText = text.trim();
+    if (cleanText.isEmpty) return;
+    _memoryCache[eventId] = cleanText;
+    await _initPrefs();
+    await _prefs?.setString('$_prefPrefix$eventId', cleanText);
+  }
+
+  /// Elimina una transcripción guardada.
+  Future<void> deleteTranscription(String eventId) async {
+    _memoryCache.remove(eventId);
+    await _initPrefs();
+    await _prefs?.remove('$_prefPrefix$eventId');
+  }
+
+  /// Obtiene o descarga el archivo de audio local correspondiente al evento Matrix.
+  Future<File> getAudioFileForEvent(Event event) async {
+    final tempDir = await getTemporaryDirectory();
+    final safeId = event.eventId.replaceAll(RegExp(r'[^a-zA-Z0-9]'), '_');
+
+    final matrixFile = await event.downloadAndDecryptAttachment();
+    if (matrixFile.bytes.isEmpty) {
+      throw 'El archivo de audio descargado está vacío';
+    }
+
+    var ext = 'ogg';
+    final lowerName = matrixFile.name.toLowerCase();
+    if (lowerName.contains('.')) {
+      ext = lowerName.split('.').last;
+    } else if (matrixFile.mimeType.contains('mp4') ||
+        matrixFile.mimeType.contains('m4a') ||
+        matrixFile.mimeType.contains('aac')) {
+      ext = 'm4a';
+    } else if (matrixFile.mimeType.contains('mp3') ||
+        matrixFile.mimeType.contains('mpeg')) {
+      ext = 'mp3';
+    } else if (matrixFile.mimeType.contains('wav')) {
+      ext = 'wav';
+    } else if (matrixFile.mimeType.contains('flac')) {
+      ext = 'flac';
+    }
+
+    final rawAudioPath = '${tempDir.path}/audio_${safeId}.$ext';
+    final rawAudioFile = File(rawAudioPath);
+
+    if (await rawAudioFile.exists() && await rawAudioFile.length() > 0) {
+      return rawAudioFile;
+    }
+
+    await rawAudioFile.writeAsBytes(matrixFile.bytes);
+    return rawAudioFile;
+  }
+
+  /// Convierte el audio a formato WAV 16kHz mono para procesamiento óptimo con Whisper.
+  Future<String> _ensure16kWav(File sourceAudio) async {
+    if (sourceAudio.path.endsWith('.16k.wav') && await sourceAudio.exists()) {
+      return sourceAudio.path;
+    }
+    final tempDir = await getTemporaryDirectory();
+    final wavName = '${sourceAudio.uri.pathSegments.last}.16k.wav';
+    final wavPath = '${tempDir.path}/$wavName';
+    final wavFile = File(wavPath);
+    if (await wavFile.exists() && await wavFile.length() > 0) {
+      Logs().d('WAV 16k ya existe en caché: $wavPath');
+      return wavPath;
+    }
+
+    if (!kIsWeb) {
+      try {
+        Logs().d(
+          'Convirtiendo audio a WAV 16kHz: ${sourceAudio.path} → $wavPath',
+        );
+        final session = await FFmpegKit.execute(
+          '-y -i "${sourceAudio.path}" -ar 16000 -ac 1 -c:a pcm_s16le "$wavPath"',
+        );
+        final returnCode = await session.getReturnCode();
+        if (ReturnCode.isSuccess(returnCode) &&
+            await wavFile.exists() &&
+            await wavFile.length() > 0) {
+          Logs().d('Conversión exitosa: $wavPath');
+          return wavPath;
+        }
+        final logs = await session.getAllLogsAsString();
+        Logs().e(
+          'FFmpegKit falló al convertir audio. RC=$returnCode',
+          null,
+          null,
+        );
+        Logs().d('FFmpeg output: $logs');
+        throw 'FFmpeg falló al procesar el formato de audio (código: $returnCode)';
+      } catch (e) {
+        Logs().e('Error al convertir audio a WAV 16k: $e', null, null);
+        rethrow;
+      }
+    }
+
+    return sourceAudio.path;
+  }
+
+  /// Descarga el modelo de HuggingFace si no existe localmente o lo busca en almacenamiento local/externo
+  Future<void> _ensureModel(
+    String modelName, {
+    void Function(double)? onProgress,
+  }) async {
+    final modelDir = await WhisperController.getModelDir();
+    final modelFileName = 'ggml-$modelName.bin';
+    final modelFile = File('$modelDir/$modelFileName');
+
+    // Asegurar que el directorio de destino exista
+    await modelFile.parent.create(recursive: true);
+
+    if (await modelFile.exists() && await modelFile.length() > 1024 * 1024) {
+      Logs().d('Modelo $modelName ya existe en ${modelFile.path}');
+      return;
+    }
+
+    // Verificar nombre alternativo sin prefijo en modelDir
+    final altModelFile = File('$modelDir/$modelName.bin');
+    if (await altModelFile.exists() && await altModelFile.length() > 1024 * 1024) {
+      try {
+        await altModelFile.copy(modelFile.path);
+        Logs().d('Modelo copiado desde ${altModelFile.path} a ${modelFile.path}');
+        return;
+      } catch (e) {
+        Logs().e('Error copiando modelo alternativo: $e');
+      }
+    }
+
+    // Verificar directorios candidatos locales y de almacenamiento externo
+    final candidateDirs = <String>[];
+    try {
+      final docDir = await getApplicationDocumentsDirectory();
+      candidateDirs.add(docDir.path);
+    } catch (_) {}
+    try {
+      final tempDir = await getTemporaryDirectory();
+      candidateDirs.add(tempDir.path);
+    } catch (_) {}
+    try {
+      final extDir = await getExternalStorageDirectory();
+      if (extDir != null) {
+        candidateDirs.add(extDir.path);
+        candidateDirs.add('${extDir.path}/Download');
+        candidateDirs.add('${extDir.path}/files');
+        candidateDirs.add('${extDir.path}/files/support');
+      }
+    } catch (_) {}
+
+    if (!kIsWeb && Platform.isAndroid) {
+      candidateDirs.addAll([
+        '/sdcard/Download',
+        '/sdcard/Download/whisper',
+        '/sdcard/Android/data/chat.fluffy.fluffychat/files',
+        '/sdcard/Android/data/chat.fluffy.fluffychat/files/support',
+        '/sdcard/Android/data/chat.fluffy.fluffychat/files/models',
+        '/sdcard/Android/data/chat.fluffy.fluffychat/cache',
+        '/storage/emulated/0/Download',
+        '/storage/emulated/0/Download/whisper',
+        '/storage/emulated/0/Android/data/chat.fluffy.fluffychat/files',
+        '/storage/emulated/0/Android/data/chat.fluffy.fluffychat/files/support',
+        '/storage/emulated/0/Android/data/chat.fluffy.fluffychat/files/models',
+        '/storage/emulated/0/Android/data/chat.fluffy.fluffychat/cache',
+      ]);
+    }
+
+    final fileNamesToCheck = [
+      modelFileName,
+      '$modelName.bin',
+      'ggml-$modelName-q5_0.bin',
+      'ggml-$modelName-q5_1.bin',
+    ];
+
+    for (final dirPath in candidateDirs) {
+      for (final name in fileNamesToCheck) {
+        final extFile = File('$dirPath/$name');
+        if (await extFile.exists() && await extFile.length() > 1024 * 1024) {
+          Logs().i(
+            'Modelo $modelName encontrado en ${extFile.path} (${(await extFile.length() / (1024 * 1024)).toStringAsFixed(1)} MB). Copiando a ${modelFile.path}...',
+          );
+          try {
+            await extFile.copy(modelFile.path);
+            if (await modelFile.exists() &&
+                await modelFile.length() > 1024 * 1024) {
+              Logs().i('Modelo copiado exitosamente desde ${extFile.path}');
+              return;
+            }
+          } catch (e, s) {
+            Logs().e('Error copiando modelo desde ${extFile.path}: $e', e, s);
+          }
+        }
+      }
+    }
+
+    Logs().d(
+      'Descargando modelo $modelName desde HuggingFace a ${modelFile.path}...',
+    );
+    final url =
+        'https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$modelFileName';
+
+    final client = http.Client();
+    try {
+      final request = http.Request('GET', Uri.parse(url));
+      final response = await client.send(request);
+
+      if (response.statusCode != 200) {
+        throw 'Error HTTP ${response.statusCode} al descargar modelo';
+      }
+
+      final contentLength = response.contentLength ?? 0;
+      var downloaded = 0;
+      final sink = modelFile.openWrite();
+
+      await for (final chunk in response.stream) {
+        sink.add(chunk);
+        downloaded += chunk.length;
+        if (contentLength > 0 && onProgress != null) {
+          onProgress(downloaded / contentLength);
+        }
+      }
+      await sink.flush();
+      await sink.close();
+      final len = await modelFile.length();
+      Logs().d(
+        'Modelo $modelName descargado exitosamente. Tamaño: ${(len / (1024 * 1024)).toStringAsFixed(2)} MB',
+      );
+    } catch (e, s) {
+      if (await modelFile.exists()) {
+        try {
+          await modelFile.delete();
+        } catch (_) {}
+      }
+      Logs().e('Error descargando modelo: $e', e, s);
+      throw 'No se pudo descargar el modelo $modelName: $e';
+    } finally {
+      client.close();
+    }
+  }
+
+  /// Filtra el texto devuelto por Whisper: remueve tokens de ruido/silencio
+  /// que el modelo produce cuando no detecta voz real.
+  String _filterWhisperNoise(String text) {
+    final trimmed = text.trim();
+    if (trimmed.isEmpty) return '';
+
+    // Tokens que Whisper genera para silencio, ruido, música, etc.
+    final noiseTokens = [
+      r'\[BLANK_AUDIO\]',
+      r'\[música\]',
+      r'\[music\]',
+      r'\[silencio\]',
+      r'\[silence\]',
+      r'\[ruido\]',
+      r'\[noise\]',
+    ];
+
+    var cleaned = trimmed;
+    for (final token in noiseTokens) {
+      cleaned = cleaned.replaceAll(RegExp(token, caseSensitive: false), '');
+    }
+    
+    // Remove empty brackets or parentheses that might be left
+    cleaned = cleaned.replaceAll(RegExp(r'^\s*(\[.*?\]|\(.*?\))\s*$', multiLine: false), '');
+
+    return cleaned.trim();
+  }
+
+  /// Transcribe un mensaje de audio utilizando Whisper GGML on-device.
+  Future<String> transcribeEvent(
+    Event event, {
+    void Function(double progress)? onProgress,
+  }) async {
+    // 1. Si ya está transcripto, retornar directamente
+    final existing = await getTranscription(event.eventId);
+    if (existing != null && existing.isNotEmpty) {
+      return existing;
+    }
+
+    // 2. Obtener archivo de audio
+    final rawAudioFile = await getAudioFileForEvent(event);
+
+    // 3. Normalizar a WAV 16kHz mono para mayor precisión y compatibilidad
+    final wavPath = await _ensure16kWav(rawAudioFile);
+
+    // 4. Leer configuración de Whisper
+    final modelName = AppSettings.whisperModel.value;
+    final lang = AppSettings.whisperLang.value;
+    final prompt = AppSettings.whisperPrompt.value;
+    
+    WhisperModel selectedModel = WhisperModel.base;
+    if (modelName == 'tiny') selectedModel = WhisperModel.tiny;
+    if (modelName == 'small') selectedModel = WhisperModel.small;
+    if (modelName == 'medium') selectedModel = WhisperModel.medium;
+
+    // 4.5. Ensure model is downloaded
+    await _ensureModel(modelName, onProgress: onProgress);
+
+    // 5. Ejecutar inferencia de Whisper on-device
+    Logs().d(
+      'Iniciando transcripción. Modelo: $modelName, Lang: $lang, '
+      'Audio: $wavPath',
+    );
+    CrashLogger.addBreadcrumb('WHISPER', 'Iniciando transcripción Whisper (evento: ${event.eventId}, modelo: $modelName, lang: $lang)');
+    
+    dynamic result;
+    try {
+      final startTime = DateTime.now();
+      Logs().d('Ejecutando _whisperController.transcribe...');
+      result = await _whisperController.transcribe(
+        model: selectedModel,
+        audioPath: wavPath,
+        lang: lang,
+        initialPrompt: prompt.isNotEmpty ? prompt : null,
+        onProgress: (percent) {
+          Logs().v('Whisper progreso: $percent%');
+          if (onProgress != null) {
+            onProgress(percent.toDouble() / 100.0);
+          }
+        },
+      );
+      final elapsed = DateTime.now().difference(startTime).inMilliseconds;
+      Logs().d('Transcripción completada en ${elapsed}ms. Result: ${result != null}');
+      CrashLogger.addBreadcrumb('WHISPER', 'Transcripción completada en ${elapsed}ms');
+    } catch (e, s) {
+      Logs().e('Error al ejecutar Whisper', e, s);
+      CrashLogger.addBreadcrumb('WHISPER', 'Error en Whisper: $e');
+      throw 'Error en motor Whisper: $e';
+    }
+
+    if (result == null) {
+      throw 'Whisper no pudo inicializar o descargar el modelo $modelName';
+    }
+
+    final rawText = result.transcription.text ?? '';
+    Logs().d('Whisper resultado bruto: "$rawText"');
+    final text = _filterWhisperNoise(rawText);
+    
+    final finalText = text.isNotEmpty ? text : (rawText.trim().isNotEmpty ? rawText.trim() : '');
+    if (finalText.isEmpty) {
+      Logs().w(
+        'Transcripción vacía. Texto bruto fue: "$rawText". '
+        'Audio: $wavPath',
+      );
+      throw 'No se detectó voz clara en el audio';
+    }
+
+    // 6. Persistir resultado
+    await saveTranscription(event.eventId, finalText);
+
+    // Limpiar archivo temporal WAV para no inflar el disco
+    try {
+      final wFile = File(wavPath);
+      if (await wFile.exists()) {
+        await wFile.delete();
+      }
+    } catch (_) {}
+
+    // Programar liberación de modelo de RAM tras 90s de inactividad
+    _scheduleModelRelease();
+
+    return finalText;
+  }
+
+  /// Libera el modelo de la memoria RAM si es necesario
+  Future<void> releaseModel() async {
+    _idleTimer?.cancel();
+    _idleTimer = null;
+    try {
+      await _whisperController.releaseModel();
+      Logs().d('Whisper GGML model liberado de memoria.');
+    } catch (_) {}
+  }
+}
