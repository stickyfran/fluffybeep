+  final int? durationMs;
+  final Color color;
+  final Color inactiveColor;
+  final ValueNotifier<Duration?>? scrubbingDurationNotifier;
+  final VoidCallback? onTapWhenStopped;
+  final void Function(Duration)? onTapWhenStoppedWithSeek;
+  final void Function(Duration)? onSeek;
+
+  const _AudioScrubberWidget({
+    required this.audioPlayer,
+    required this.rawWaveform,
+    required this.durationMs,
+    required this.color,
+    required this.inactiveColor,
+    this.scrubbingDurationNotifier,
+    this.onTapWhenStopped,
+    this.onTapWhenStoppedWithSeek,
+    this.onSeek,
+  });
+
+  @override
+  State<_AudioScrubberWidget> createState() => _AudioScrubberWidgetState();
+}
+
+class _AudioScrubberWidgetState extends State<_AudioScrubberWidget> {
+  bool _isDragging = false;
+  double _dragPositionMs = 0.0;
+  StreamSubscription<Duration>? _positionSub;
+  double _currentPositionMs = 0.0;
+
+  int? _lastCount;
+  List<double>? _lastRaw;
+  List<double>? _resampledBars;
+
+  @override
+  void initState() {
+    super.initState();
+    _subscribeToPosition();
+  }
+
+  @override
+  void didUpdateWidget(covariant _AudioScrubberWidget oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.audioPlayer != widget.audioPlayer) {
+      _subscribeToPosition();
+    }
+  }
+
+  void _subscribeToPosition() {
+    _positionSub?.cancel();
+    _positionSub = null;
+    final player = widget.audioPlayer;
+    if (player != null) {
+      _currentPositionMs = player.position.inMilliseconds.toDouble();
+      _positionSub = player.positionStream.listen((pos) {
+        if (!_isDragging && mounted) {
+          setState(() {
+            _currentPositionMs = pos.inMilliseconds.toDouble();
+          });
+        }
+      });
+    } else {
+      _currentPositionMs = 0.0;
+    }
+  }
+
+  @override
+  void dispose() {
+    _positionSub?.cancel();
+    super.dispose();
+  }
+
+  List<double>? _getBars(int count) {
+    if (widget.rawWaveform == null) return null;
+    if (_lastCount == count && identical(_lastRaw, widget.rawWaveform)) {
+      return _resampledBars;
+    }
+    _lastCount = count;
+    _lastRaw = widget.rawWaveform;
+    _resampledBars = AudioPlayerWidget.resampleWaveform(widget.rawWaveform!, count);
+    return _resampledBars;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final player = widget.audioPlayer;
+    final totalDurationMs = (player?.duration?.inMilliseconds ??
+            widget.durationMs ??
+            1000)
+        .toDouble();
+    final effectiveTotalMs = totalDurationMs > 0 ? totalDurationMs : 1000.0;
+
+    var posMs = _isDragging ? _dragPositionMs : _currentPositionMs;
+    if (posMs > effectiveTotalMs) posMs = effectiveTotalMs;
+    if (posMs < 0) posMs = 0;
+
+    final progress = (posMs / effectiveTotalMs).clamp(0.0, 1.0);
+
+    return LayoutBuilder(
+      builder: (context, constraints) {
+        final width = constraints.maxWidth;
+        const double pitch = 4.0;
+        final count = (width / pitch).floor().clamp(16, 120);
+        final bars = _getBars(count);
+
+        return GestureDetector(
+          behavior: HitTestBehavior.opaque,
+          onTapDown: (details) {
+            if (width <= 0) return;
+            final frac = (details.localPosition.dx / width).clamp(0.0, 1.0);
+            final targetMs = frac * effectiveTotalMs;
+            HapticFeedback.selectionClick();
+            if (widget.audioPlayer == null) {
+              final targetDuration = Duration(milliseconds: targetMs.round());
+              setState(() {
+                _currentPositionMs = targetMs;
+              });
+              if (widget.onTapWhenStoppedWithSeek != null) {
+                widget.onTapWhenStoppedWithSeek!(targetDuration);
+              } else {
+                widget.onTapWhenStopped?.call();
+              }
+              return;
+            }
+            setState(() {
+              _currentPositionMs = targetMs;
+            });
+            widget.onSeek?.call(Duration(milliseconds: targetMs.round()));
+          },
+          onHorizontalDragStart: (details) {
+            if (width <= 0) return;
+            HapticFeedback.selectionClick();
+            final frac = (details.localPosition.dx / width).clamp(0.0, 1.0);
+            final targetMs = frac * effectiveTotalMs;
+            setState(() {
+              _isDragging = true;
+              _dragPositionMs = targetMs;
+            });
+            widget.scrubbingDurationNotifier?.value =
+                Duration(milliseconds: targetMs.round());
+          },
+          onHorizontalDragUpdate: (details) {
+            if (!_isDragging || width <= 0) return;
+            final prevFrac = (_dragPositionMs / effectiveTotalMs).clamp(0.0, 1.0);
+            final frac = (details.localPosition.dx / width).clamp(0.0, 1.0);
+            if ((frac * count).toInt() != (prevFrac * count).toInt()) {
+              HapticFeedback.selectionClick();
+            }
+            final targetMs = frac * effectiveTotalMs;
+            setState(() {
+              _dragPositionMs = targetMs;
+            });
+            widget.scrubbingDurationNotifier?.value =
+                Duration(milliseconds: targetMs.round());
+          },
+          onHorizontalDragEnd: (details) {
+            if (!_isDragging) return;
+            HapticFeedback.selectionClick();
+            final targetMs = _dragPositionMs;
+            setState(() {
+              _isDragging = false;
+              _currentPositionMs = targetMs;
+            });
+            widget.scrubbingDurationNotifier?.value = null;
+            if (widget.audioPlayer != null) {
+              widget.onSeek?.call(Duration(milliseconds: targetMs.round()));
+            } else if (widget.onTapWhenStoppedWithSeek != null) {
+              widget.onTapWhenStoppedWithSeek!(
+                Duration(milliseconds: targetMs.round()),
+              );
+            }
           },
+          onHorizontalDragCancel: () {
+            if (!_isDragging) return;
+            setState(() {
+              _isDragging = false;
+            });
+            widget.scrubbingDurationNotifier?.value = null;
+          },
+          child: SizedBox(
+            height: 32,
+            width: double.infinity,
+            child: CustomPaint(
+              size: Size(width, 32),
+              painter: _WaveformScrubberPainter(
+                bars: bars,
+                progress: progress,
+                isDragging: _isDragging,
+                activeColor: widget.color,
+                inactiveColor: widget.inactiveColor,
+              ),
+            ),
+          ),
         );
       },
     );
   }
 }
 
+class _WaveformScrubberPainter extends CustomPainter {
+  final List<double>? bars;
+  final double progress; // 0.0 to 1.0
+  final bool isDragging;
+  final Color activeColor;
+  final Color inactiveColor;
+
+  _WaveformScrubberPainter({
+    required this.bars,
+    required this.progress,
+    required this.isDragging,
+    required this.activeColor,
+    required this.inactiveColor,
+  });
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (size.width <= 0 || size.height <= 0) return;
+
+    final clampedProgress = progress.clamp(0.0, 1.0);
+    final xProgress = clampedProgress * size.width;
+
+    if (bars != null && bars!.isNotEmpty) {
+      final totalBars = bars!.length;
+      const double barWidth = 2.4;
+      final double spacing = totalBars > 1
+          ? (size.width - totalBars * barWidth) / (totalBars - 1)
+          : 0.0;
+
+      final activePaint = Paint()
+        ..color = activeColor
+        ..style = PaintingStyle.fill;
+
+      final inactivePaint = Paint()
+        ..color = inactiveColor
+        ..style = PaintingStyle.fill;
+
+      final maxHeight = size.height;
+
+      for (var i = 0; i < totalBars; i++) {
+        final barX = i * (barWidth + spacing);
+        final barCenterX = barX + barWidth / 2;
+        final ampFraction = bars![i].clamp(0.12, 1.0);
+        final barHeight = (maxHeight * ampFraction).clamp(4.0, maxHeight);
+        final barY = (size.height - barHeight) / 2;
+
+        final isPlayed = barCenterX <= xProgress;
+        final paint = isPlayed ? activePaint : inactivePaint;
+
+        final rrect = RRect.fromRectAndRadius(
+          Rect.fromLTWH(barX, barY, barWidth, barHeight),
+          const Radius.circular(1.2),
+        );
+        canvas.drawRRect(rrect, paint);
+      }
+    } else {
+      const trackHeight = 4.0;
+      final trackY = (size.height - trackHeight) / 2;
+
+      final inactivePaint = Paint()
+        ..color = inactiveColor
+        ..style = PaintingStyle.fill;
+      canvas.drawRRect(
+        RRect.fromRectAndRadius(
+          Rect.fromLTWH(0, trackY, size.width, trackHeight),
+          const Radius.circular(trackHeight / 2),
+        ),
+        inactivePaint,
+      );
+
+      if (xProgress > 0) {
+        final activePaint = Paint()
+          ..color = activeColor
+          ..style = PaintingStyle.fill;
+        canvas.drawRRect(
+          RRect.fromRectAndRadius(
+            Rect.fromLTWH(0, trackY, xProgress, trackHeight),
+            const Radius.circular(trackHeight / 2),
+          ),
+          activePaint,
+        );
+      }
+    }
+
+    if (isDragging) {
+      final cursorX = xProgress.clamp(1.5, size.width - 1.5);
+      final cursorPaint = Paint()
+        ..color = activeColor
+        ..style = PaintingStyle.fill;
+      final shadowPaint = Paint()
+        ..color = Colors.black.withValues(alpha: 0.25)
+        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 1.5);
+
+      final cursorRRect = RRect.fromRectAndRadius(
+        Rect.fromLTWH(cursorX - 1.25, 2.0, 2.5, size.height - 4.0),
+        const Radius.circular(1.25),
+      );
+      canvas.drawRRect(cursorRRect, shadowPaint);
+      canvas.drawRRect(cursorRRect, cursorPaint);
+    }
+  }
+
+  @override
+  bool shouldRepaint(_WaveformScrubberPainter oldDelegate) {
+    return oldDelegate.progress != progress ||
+        oldDelegate.isDragging != isDragging ||
+        oldDelegate.activeColor != activeColor ||
+        oldDelegate.inactiveColor != inactiveColor ||
+        oldDelegate.bars != bars;
+  }
+}
