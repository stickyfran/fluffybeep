+
+/// Widget inline que muestra la ficha y notas del contacto directamente
+/// en la pantalla de Detalles del Chat (sin requerir abrir un modal).
+class ContactProfileInlineCard extends StatefulWidget {
+  final Room room;
+
+  const ContactProfileInlineCard({super.key, required this.room});
+
+  @override
+  State<ContactProfileInlineCard> createState() => _ContactProfileInlineCardState();
+}
+
+class _ContactProfileInlineCardState extends State<ContactProfileInlineCard> {
+  ContactProfile _profile = const ContactProfile();
+  bool _isLoading = true;
+  bool _isAnalyzing = false;
+  bool _isEditing = false;
+  bool _isDownloadingHistory = false;
+  String _downloadStatus = '';
+
+  final _nombreCtrl = TextEditingController();
+  final _cumpleCtrl = TextEditingController();
+  final _direccionCtrl = TextEditingController();
+  final _profesionCtrl = TextEditingController();
+  final _estudiosCtrl = TextEditingController();
+  final _hobbiesCtrl = TextEditingController();
+  final _notasCtrl = TextEditingController();
+
+  @override
+  void initState() {
+    super.initState();
+    _loadProfile();
+  }
+
+  @override
+  void dispose() {
+    _nombreCtrl.dispose();
+    _cumpleCtrl.dispose();
+    _direccionCtrl.dispose();
+    _profesionCtrl.dispose();
+    _estudiosCtrl.dispose();
+    _hobbiesCtrl.dispose();
+    _notasCtrl.dispose();
+    super.dispose();
+  }
+
+  Future<void> _loadProfile() async {
+    setState(() => _isLoading = true);
+    final loaded = await ContactNotesManager.loadProfile(
+      widget.room.client,
+      widget.room.id,
+    );
+
+    // Auto-completar nombre si no fue especificado manualmente
+    var effectiveProfile = loaded;
+    if (loaded.nombre == null || loaded.nombre!.trim().isEmpty) {
+      final autoName = AiProfileService.resolveContactName(widget.room, profile: loaded);
+      if (autoName.isNotEmpty) {
+        effectiveProfile = loaded.copyWith(nombre: autoName);
+      }
+    }
+
+    if (!mounted) return;
+    setState(() {
+      _profile = effectiveProfile;
+      _initControllers(effectiveProfile);
+      _isLoading = false;
+    });
+  }
+
+  void _initControllers(ContactProfile p) {
+    _nombreCtrl.text = p.nombre ?? '';
+    _cumpleCtrl.text = p.cumpleanos ?? '';
+    _direccionCtrl.text = p.direccion ?? '';
+    _profesionCtrl.text = p.profesion ?? '';
+    _estudiosCtrl.text = p.estudiosFormales ?? '';
+    _hobbiesCtrl.text = p.hobbiesIntereses ?? '';
+    _notasCtrl.text = p.notasLibres ?? '';
+  }
+
+  Future<void> _saveCurrentProfile() async {
+    final updated = _profile.copyWith(
+      nombre: _nombreCtrl.text.trim().isNotEmpty ? _nombreCtrl.text.trim() : null,
+      cumpleanos: _cumpleCtrl.text.trim().isNotEmpty ? _cumpleCtrl.text.trim() : null,
+      direccion: _direccionCtrl.text.trim().isNotEmpty ? _direccionCtrl.text.trim() : null,
+      profesion: _profesionCtrl.text.trim().isNotEmpty ? _profesionCtrl.text.trim() : null,
+      estudiosFormales: _estudiosCtrl.text.trim().isNotEmpty ? _estudiosCtrl.text.trim() : null,
+      hobbiesIntereses: _hobbiesCtrl.text.trim().isNotEmpty ? _hobbiesCtrl.text.trim() : null,
+      notasLibres: _notasCtrl.text.trim().isNotEmpty ? _notasCtrl.text.trim() : null,
+      updatedAt: DateTime.now().millisecondsSinceEpoch,
+    );
+
+    setState(() {
+      _profile = updated;
+      _isEditing = false;
+    });
+
+    await ContactNotesManager.saveProfile(
+      widget.room.client,
+      widget.room.id,
+      updated,
+    );
+
+    if (mounted) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Ficha y notas guardadas en Matrix')),
+      );
+    }
+  }
+
+  Future<void> _runAiAnalysis({bool forceFull = false}) async {
+    setState(() => _isAnalyzing = true);
+    try {
+      final updated = await AiProfileService.analyzeAndMergeProfile(
+        room: widget.room,
+        currentProfile: _profile,
+        forceFull: forceFull,
+      );
+
+      if (!mounted) return;
+      final hadNewMessages = updated.lastAnalysisTime != _profile.lastAnalysisTime;
+
+      setState(() {
+        _profile = updated;
+        _initControllers(updated);
+        _isAnalyzing = false;
+      });
+
+      if (hadNewMessages) {
+        await ContactNotesManager.saveProfile(
+          widget.room.client,
+          widget.room.id,
+          updated,
+        );
+      }
+
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(
+            content: Text(
+              hadNewMessages
+                  ? '✨ Perfil y eventos actualizados con IA'
+                  : 'ℹ️ No hubo mensajes nuevos desde el último análisis de IA',
+            ),
+          ),
+        );
+      }
+    } catch (e) {
+      if (!mounted) return;
+      setState(() => _isAnalyzing = false);
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text('Error al analizar con IA: $e')),
+      );
+    }
+  }
+
+  Future<void> _downloadFullHistory() async {
+    final isMerged = BeeperMergeUtils.isRoomMerged(widget.room.id);
+    final siblings = isMerged ? BeeperMergeUtils.getSiblingRooms(widget.room.id) : <Room>[];
+    final totalChats = 1 + siblings.length;
+
+    setState(() {
+      _isDownloadingHistory = true;
+      _downloadStatus = 'Iniciando descarga ($totalChats ${totalChats == 1 ? 'chat' : 'chats vinculados'})...';
+    });
+
+    try {
+      final count = await ChatHistoryDownloader.downloadFullHistory(
+        room: widget.room,
+        onProgress: ({
+          required int downloadedCount,
+          required String currentRoomName,
+          required bool isCompleted,
+          String? error,
+        }) {
+          if (!mounted) return;
+          setState(() {
+            _downloadStatus = isCompleted
+                ? 'Historial completado: $downloadedCount mensajes guardados'
+                : 'Descargando $currentRoomName ($downloadedCount mensajes)...';
+          });
+        },
+      );
+
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(
+            content: Text('✅ Se descargaron $count mensajes en la base de datos local.'),
+            action: SnackBarAction(
+              label: 'Analizar con IA',
+              onPressed: () => _runAiAnalysis(forceFull: true),
+            ),
+            duration: const Duration(seconds: 5),
+          ),
+        );
+      }
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Error en la descarga: $e')),
+        );
+      }
+    } finally {
+      if (mounted) {
+        setState(() {
+          _isDownloadingHistory = false;
+          _downloadStatus = '';
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+
+    if (_isLoading) {
+      return const Padding(
+        padding: EdgeInsets.symmetric(vertical: 24.0),
+        child: Center(child: CircularProgressIndicator(strokeWidth: 2)),
+      );
+    }
+
+    return Container(
+      margin: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
+      decoration: BoxDecoration(
+        color: theme.colorScheme.surfaceContainerHighest.withValues(alpha: 0.35),
+        borderRadius: BorderRadius.circular(16),
+        border: Border.all(
+          color: theme.dividerColor.withValues(alpha: 0.5),
+        ),
+      ),
+      child: Padding(
+        padding: const EdgeInsets.all(16.0),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            // Cabecera de la Ficha con Botones de Acción
+            Row(
+              children: [
+                const Icon(Icons.badge_outlined, color: Colors.indigoAccent, size: 22),
+                const SizedBox(width: 8),
+                Expanded(
+                  child: Text(
+                    'Ficha y notas del contacto',
+                    style: theme.textTheme.titleMedium?.copyWith(
+                      fontWeight: FontWeight.bold,
+                    ),
+                  ),
+                ),
+                IconButton(
+                  tooltip: _isEditing ? 'Guardar' : 'Editar datos',
+                  icon: Icon(_isEditing ? Icons.check_circle : Icons.edit_outlined),
+                  color: _isEditing ? Colors.green : null,
+                  onPressed: _isEditing ? _saveCurrentProfile : () => setState(() => _isEditing = true),
+                ),
+                IconButton(
+                  tooltip: 'Actualizar con IA (nuevos mensajes)',
+                  icon: _isAnalyzing
+                      ? const SizedBox(
+                          width: 18,
+                          height: 18,
+                          child: CircularProgressIndicator(strokeWidth: 2),
+                        )
+                      : const Icon(Icons.auto_awesome, color: Colors.amber),
+                  onPressed: (_isAnalyzing || _isDownloadingHistory) ? null : () => _runAiAnalysis(forceFull: false),
+                ),
+                IconButton(
+                  tooltip: 'Descargar todo el historial del chat',
+                  icon: _isDownloadingHistory
+                      ? const SizedBox(
+                          width: 18,
+                          height: 18,
+                          child: CircularProgressIndicator(strokeWidth: 2),
+                        )
+                      : const Icon(Icons.download_for_offline_outlined, color: Colors.blueAccent),
+                  onPressed: (_isDownloadingHistory || _isAnalyzing) ? null : _downloadFullHistory,
+                ),
+              ],
+            ),
+
+            // Estado de descarga si está activo
+            if (_isDownloadingHistory) ...[
+              const SizedBox(height: 8),
+              Container(
+                padding: const EdgeInsets.all(8),
+                decoration: BoxDecoration(
+                  color: Colors.blue.withValues(alpha: 0.1),
+                  borderRadius: BorderRadius.circular(8),
+                ),
+                child: Row(
+                  children: [
+                    const SizedBox(
+                      width: 14,
+                      height: 14,
+                      child: CircularProgressIndicator(strokeWidth: 2),
+                    ),
+                    const SizedBox(width: 10),
+                    Expanded(
+                      child: Text(
+                        _downloadStatus,
+                        style: const TextStyle(fontSize: 12),
+                      ),
+                    ),
+                    GestureDetector(
+                      onTap: ChatHistoryDownloader.cancel,
+                      child: const Text('Cancelar', style: TextStyle(fontSize: 12, color: Colors.red)),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+
+            const Divider(height: 20),
+
+            // Contenido editable o vista de fichas
+            if (_isEditing) _buildEditForm(theme) else _buildDisplayView(theme),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _buildEditForm(ThemeData theme) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        TextField(
+          controller: _nombreCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Nombre Completo',
+            prefixIcon: Icon(Icons.person_outline),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _cumpleCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Cumpleaños / Fecha',
+            prefixIcon: Icon(Icons.cake_outlined),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _direccionCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Dirección o Zona',
+            prefixIcon: Icon(Icons.location_on_outlined),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _profesionCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Profesión / Ocupación',
+            prefixIcon: Icon(Icons.work_outline),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _estudiosCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Estudios Formales',
+            prefixIcon: Icon(Icons.school_outlined),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _hobbiesCtrl,
+          decoration: const InputDecoration(
+            labelText: 'Hobbies e Intereses',
+            prefixIcon: Icon(Icons.sports_esports_outlined),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 10),
+        TextField(
+          controller: _notasCtrl,
+          maxLines: 3,
+          decoration: const InputDecoration(
+            labelText: 'Notas Privadas Libres',
+            prefixIcon: Icon(Icons.notes_outlined),
+            isDense: true,
+          ),
+        ),
+        const SizedBox(height: 14),
+        Row(
+          mainAxisAlignment: MainAxisAlignment.end,
+          children: [
+            TextButton(
+              onPressed: () {
+                _initControllers(_profile);
+                setState(() => _isEditing = false);
+              },
+              child: const Text('Cancelar'),
+            ),
+            const SizedBox(width: 8),
+            ElevatedButton.icon(
+              onPressed: _saveCurrentProfile,
+              icon: const Icon(Icons.check, size: 18),
+              label: const Text('Guardar'),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
+
+  Widget _buildDisplayView(ThemeData theme) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        // Datos Personales
+        _buildInfoRow(Icons.person_outline, 'Nombre', _profile.nombre ?? 'Sin especificar'),
+        const Divider(height: 12),
+        _buildInfoRow(Icons.cake_outlined, 'Cumpleaños', _profile.cumpleanos ?? 'Sin especificar'),
+        const Divider(height: 12),
+        _buildInfoRow(Icons.location_on_outlined, 'Dirección', _profile.direccion ?? 'Sin especificar'),
+        const Divider(height: 12),
+        _buildInfoRow(Icons.work_outline, 'Profesión', _profile.profesion ?? 'Sin especificar'),
+        const Divider(height: 12),
+        _buildInfoRow(Icons.school_outlined, 'Estudios', _profile.estudiosFormales ?? 'Sin especificar'),
+        const Divider(height: 12),
+        _buildInfoRow(Icons.sports_esports_outlined, 'Hobbies', _profile.hobbiesIntereses ?? 'Sin especificar'),
+
+        // Próximos Eventos
+        if (_profile.proximosEventos.isNotEmpty) ...[
+          const SizedBox(height: 14),
+          _buildSectionHeader(Icons.event_outlined, 'Próximos Eventos', theme),
+          const SizedBox(height: 4),
+          ..._profile.proximosEventos.map((e) => Container(
+                margin: const EdgeInsets.symmetric(vertical: 2.0),
+                padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
+                decoration: BoxDecoration(
+                  color: Colors.blue.withValues(alpha: 0.1),
+                  borderRadius: BorderRadius.circular(8),
+                ),
+                child: Row(
+                  children: [
+                    const Icon(Icons.arrow_right, color: Colors.blueAccent, size: 18),
+                    const SizedBox(width: 4),
+                    Expanded(child: Text(e, style: const TextStyle(fontSize: 13))),
+                  ],
+                ),
+              )),
+        ],
+
+        // Eventos Pasados
+        if (_profile.eventosPasados.isNotEmpty) ...[
+          const SizedBox(height: 14),
+          _buildSectionHeader(
+            Icons.history_outlined,
+            'Eventos Pasados (${_profile.eventosPasados.length}/10)',
+            theme,
+          ),
+          const SizedBox(height: 4),
+          ..._profile.eventosPasados.map((e) => Container(
+                margin: const EdgeInsets.symmetric(vertical: 2.0),
+                padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
+                decoration: BoxDecoration(
+                  color: theme.colorScheme.surfaceContainerHighest.withValues(alpha: 0.3),
+                  borderRadius: BorderRadius.circular(8),
+                ),
+                child: Row(
+                  children: [
+                    const Icon(Icons.check_circle_outline, color: Colors.green, size: 16),
+                    const SizedBox(width: 6),
+                    Expanded(child: Text(e, style: const TextStyle(fontSize: 13))),
+                  ],
+                ),
+              )),
+        ],
+
+        // Notas Libres
+        if (_profile.notasLibres != null && _profile.notasLibres!.isNotEmpty) ...[
+          const SizedBox(height: 14),
+          _buildSectionHeader(Icons.notes_outlined, 'Notas Libres', theme),
+          const SizedBox(height: 4),
+          Container(
+            padding: const EdgeInsets.all(10),
+            decoration: BoxDecoration(
+              color: theme.colorScheme.surfaceContainerHighest.withValues(alpha: 0.3),
+              borderRadius: BorderRadius.circular(8),
+            ),
+            child: Text(_profile.notasLibres!, style: const TextStyle(fontSize: 13)),
+          ),
+        ],
+
+        // Indicador de último checkpoint
+        if (_profile.lastAnalysisTime != null) ...[
+          const SizedBox(height: 12),
+          Text(
+            'IA procesó hasta: ${DateTime.fromMillisecondsSinceEpoch(_profile.lastAnalysisTime!).toLocal().toString().substring(0, 16)}',
+            style: TextStyle(fontSize: 11, color: theme.textTheme.bodySmall?.color?.withValues(alpha: 0.6)),
+            textAlign: TextAlign.right,
+          ),
+        ],
+      ],
+    );
+  }
+
+  Widget _buildSectionHeader(IconData icon, String title, ThemeData theme) {
+    return Row(
+      children: [
+        Icon(icon, size: 16, color: theme.colorScheme.secondary),
+        const SizedBox(width: 6),
+        Text(
+          title,
