@@ -0,0 +1,226 @@
+// SPDX-FileCopyrightText: 2024-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+
+import '../../config/themes.dart';
+import '../../utils/scheduled_message_service.dart';
+import 'chat.dart';
+
+class ScheduledMessageBanner extends StatelessWidget {
+  final ChatController controller;
+
+  const ScheduledMessageBanner(this.controller, {super.key});
+
+  String _formatDateTime(DateTime dt) {
+    final now = DateTime.now();
+    final today = DateTime(now.year, now.month, now.day);
+    final msgDate = DateTime(dt.year, dt.month, dt.day);
+
+    final timeStr = DateFormat.jm().format(dt);
+    if (msgDate == today) {
+      return 'Hoy a las $timeStr';
+    } else if (msgDate == today.add(const Duration(days: 1))) {
+      return 'Mañana a las $timeStr';
+    } else {
+      return '${DateFormat.MMMd().format(dt)}, $timeStr';
+    }
+  }
+
+  void _showAllScheduledMessages(
+    BuildContext context,
+    List<ScheduledMessage> messages,
+  ) {
+    showModalBottomSheet(
+      context: context,
+      builder: (ctx) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Padding(
+              padding: const EdgeInsets.all(16.0),
+              child: Row(
+                children: [
+                  const Icon(Icons.schedule),
+                  const SizedBox(width: 8),
+                  Text(
+                    'Mensajes programados (${messages.length})',
+                    style: Theme.of(context).textTheme.titleMedium,
+                  ),
+                ],
+              ),
+            ),
+            const Divider(height: 1),
+            Flexible(
+              child: ListView.separated(
+                shrinkWrap: true,
+                itemCount: messages.length,
+                separatorBuilder: (_, __) => const Divider(height: 1),
+                itemBuilder: (ctx, i) {
+                  final msg = messages[i];
+                  return ListTile(
+                    leading: const Icon(Icons.access_time_outlined),
+                    title: Text(
+                      msg.body,
+                      maxLines: 2,
+                      overflow: TextOverflow.ellipsis,
+                    ),
+                    subtitle: Text(
+                      _formatDateTime(msg.scheduledAt),
+                      style: TextStyle(
+                        color: Theme.of(context).colorScheme.primary,
+                        fontWeight: FontWeight.bold,
+                      ),
+                    ),
+                    trailing: Row(
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        IconButton(
+                          icon: const Icon(Icons.edit_outlined),
+                          tooltip: 'Editar',
+                          onPressed: () {
+                            Navigator.of(ctx).pop();
+                            controller.sendController.text = msg.body;
+                            controller.isInputEmptyNotifier.value = false;
+                            ScheduledMessageService().cancelMessage(msg.id);
+                          },
+                        ),
+                        IconButton(
+                          icon: const Icon(Icons.send_outlined),
+                          tooltip: 'Enviar ahora',
+                          onPressed: () {
+                            Navigator.of(ctx).pop();
+                            ScheduledMessageService().sendNow(msg.id);
+                          },
+                        ),
+                        IconButton(
+                          icon: const Icon(Icons.close),
+                          tooltip: 'Cancelar',
+                          onPressed: () {
+                            ScheduledMessageService().cancelMessage(msg.id);
+                          },
+                        ),
+                      ],
+                    ),
+                  );
+                },
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final messages = ScheduledMessageService().getMessagesForRoom(controller.roomId);
+
+    if (messages.isEmpty) {
+      return const SizedBox.shrink();
+    }
+
+    final isSingle = messages.length == 1;
+    final singleMsg = messages.first;
+
+    return AnimatedContainer(
+      duration: FluffyThemes.animationDuration,
+      curve: FluffyThemes.animationCurve,
+      height: 52,
+      clipBehavior: Clip.hardEdge,
+      decoration: BoxDecoration(
+        color: theme.colorScheme.primaryContainer.withValues(alpha: 0.35),
+        border: Border(
+          bottom: BorderSide(
+            color: theme.dividerColor.withValues(alpha: 0.5),
+            width: 0.5,
+          ),
+        ),
+      ),
+      child: Material(
+        color: Colors.transparent,
+        child: InkWell(
+          onTap: isSingle ? null : () => _showAllScheduledMessages(context, messages),
+          child: Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 12.0),
+            child: Row(
+              children: [
+                Icon(
+                  Icons.schedule,
+                  size: 20,
+                  color: theme.colorScheme.primary,
+                ),
+                const SizedBox(width: 8),
+                Expanded(
+                  child: isSingle
+                      ? Column(
+                          mainAxisAlignment: MainAxisAlignment.center,
+                          crossAxisAlignment: CrossAxisAlignment.start,
+                          children: [
+                            Text(
+                              'Programado: ${_formatDateTime(singleMsg.scheduledAt)}',
+                              style: TextStyle(
+                                fontSize: 12,
+                                fontWeight: FontWeight.bold,
+                                color: theme.colorScheme.primary,
+                              ),
+                            ),
+                            Text(
+                              singleMsg.body,
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: TextStyle(
+                                fontSize: 13,
+                                color: theme.colorScheme.onSurface,
+                              ),
+                            ),
+                          ],
+                        )
+                      : Text(
+                          '${messages.length} mensajes programados (toca para ver)',
+                          style: TextStyle(
+                            fontSize: 13,
+                            fontWeight: FontWeight.w600,
+                            color: theme.colorScheme.primary,
+                          ),
+                        ),
+                ),
+                if (isSingle) ...[
+                  IconButton(
+                    icon: const Icon(Icons.edit_outlined, size: 18),
+                    tooltip: 'Editar mensaje',
+                    onPressed: () {
+                      controller.sendController.text = singleMsg.body;
+                      controller.isInputEmptyNotifier.value = false;
+                      ScheduledMessageService().cancelMessage(singleMsg.id);
+                    },
+                  ),
+                  IconButton(
+                    icon: const Icon(Icons.send_outlined, size: 18),
+                    tooltip: 'Enviar ahora',
+                    onPressed: () {
+                      ScheduledMessageService().sendNow(singleMsg.id);
+                    },
+                  ),
+                  IconButton(
+                    icon: const Icon(Icons.close, size: 18),
+                    tooltip: 'Cancelar programación',
+                    onPressed: () {
+                      ScheduledMessageService().cancelMessage(singleMsg.id);
+                    },
+                  ),
+                ] else ...[
+                  const Icon(Icons.chevron_right, size: 20),
+                ],
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
