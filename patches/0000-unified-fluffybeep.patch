+    final client = Matrix.of(context).client;
+    final labels = Map<String, dynamic>.from(BeeperBridgeUtils.getBeeperLabels(client));
+
+    final uuid = widget.labelUuid ?? 'label_${DateTime.now().millisecondsSinceEpoch}';
+    final existingLabel = labels[uuid] as Map?;
+
