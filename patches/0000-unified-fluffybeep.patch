new file mode 100644
index 0000000000000000000000000000000000000000..e3a03159134f7df3287cf7cae43d0db2516d1c80
--- /dev/null
+++ b/lib/models/contact_profile.dart
@@ -0,0 +1,215 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+class ContactProfile {
+  final String? nombre;
+  final String? cumpleanos;
+  final String? direccion;
+  final String? profesion;
+  final String? estudiosFormales;
+  final String? hobbiesIntereses;
+  final List<String> ultimasActividades;
+  final List<String> proximosEventos;
+  final List<String> eventosPasados;
+  final String? notasLibres;
+  final int? updatedAt;
+  final String? lastProcessedEventId;
+  final int? lastProcessedTimestamp;
+  final int? lastAnalysisTime;
+
+  const ContactProfile({
+    this.nombre,
+    this.cumpleanos,
+    this.direccion,
+    this.profesion,
+    this.estudiosFormales,
+    this.hobbiesIntereses,
+    this.ultimasActividades = const [],
+    this.proximosEventos = const [],
+    this.eventosPasados = const [],
+    this.notasLibres,
+    this.updatedAt,
+    this.lastProcessedEventId,
+    this.lastProcessedTimestamp,
+    this.lastAnalysisTime,
+  });
+
+  bool get isEmpty =>
+      (nombre == null || nombre!.trim().isEmpty) &&
+      (cumpleanos == null || cumpleanos!.trim().isEmpty) &&
+      (direccion == null || direccion!.trim().isEmpty) &&
+      (profesion == null || profesion!.trim().isEmpty) &&
+      (estudiosFormales == null || estudiosFormales!.trim().isEmpty) &&
+      (hobbiesIntereses == null || hobbiesIntereses!.trim().isEmpty) &&
+      ultimasActividades.isEmpty &&
+      proximosEventos.isEmpty &&
+      eventosPasados.isEmpty &&
+      (notasLibres == null || notasLibres!.trim().isEmpty);
+
+  factory ContactProfile.fromJson(Map<String, dynamic>? json) {
+    if (json == null) return const ContactProfile();
+
+    List<String> parseList(dynamic raw) {
+      if (raw is List) {
+        return raw
+            .map((e) => e?.toString().trim() ?? '')
+            .where((e) => e.isNotEmpty)
+            .toList();
+      }
+      return const [];
+    }
+
+    String? parseString(dynamic raw) {
+      if (raw == null) return null;
+      final str = raw.toString().trim();
+      return str.isNotEmpty ? str : null;
+    }
+
+    int? parseInt(dynamic raw) {
+      if (raw is int) return raw;
+      if (raw is num) return raw.toInt();
+      if (raw is String) return int.tryParse(raw);
+      return null;
+    }
+
+    return ContactProfile(
+      nombre: parseString(json['nombre']),
+      cumpleanos: parseString(json['cumpleanos']),
+      direccion: parseString(json['direccion']),
+      profesion: parseString(json['profesion']),
+      estudiosFormales: parseString(json['estudios_formales']),
+      hobbiesIntereses: parseString(json['hobbies_intereses']),
+      ultimasActividades: parseList(json['ultimas_actividades_relevantes']),
+      proximosEventos: parseList(json['proximos_eventos']),
+      eventosPasados: parseList(json['eventos_pasados']),
+      notasLibres: parseString(json['notas_libres']),
+      updatedAt: parseInt(json['updated_at']),
+      lastProcessedEventId: parseString(json['last_processed_event_id']),
+      lastProcessedTimestamp: parseInt(json['last_processed_timestamp']),
+      lastAnalysisTime: parseInt(json['last_analysis_time']),
+    );
+  }
+
+  Map<String, dynamic> toJson() {
+    return {
+      if (nombre != null) 'nombre': nombre,
+      if (cumpleanos != null) 'cumpleanos': cumpleanos,
+      if (direccion != null) 'direccion': direccion,
+      if (profesion != null) 'profesion': profesion,
+      if (estudiosFormales != null) 'estudios_formales': estudiosFormales,
+      if (hobbiesIntereses != null) 'hobbies_intereses': hobbiesIntereses,
+      'ultimas_actividades_relevantes': ultimasActividades,
+      'proximos_eventos': proximosEventos,
+      'eventos_pasados': eventosPasados,
+      if (notasLibres != null) 'notas_libres': notasLibres,
+      'updated_at': updatedAt ?? DateTime.now().millisecondsSinceEpoch,
+      if (lastProcessedEventId != null) 'last_processed_event_id': lastProcessedEventId,
+      if (lastProcessedTimestamp != null) 'last_processed_timestamp': lastProcessedTimestamp,
+      if (lastAnalysisTime != null) 'last_analysis_time': lastAnalysisTime,
+    };
+  }
+
+  /// Fusión incremental segura ("Diff & Merge"):
+  /// Preserva estrictamente los datos actuales si la sugerencia de la IA o actualización
+  /// no contiene datos nuevos o tiene valores vacíos/nulos.
+  ContactProfile mergeWith(ContactProfile suggested) {
+    final mergedNombre = (suggested.nombre != null && suggested.nombre!.trim().isNotEmpty)
+        ? suggested.nombre
+        : nombre;
+    final mergedCumpleanos = (suggested.cumpleanos != null && suggested.cumpleanos!.trim().isNotEmpty)
+        ? suggested.cumpleanos
+        : cumpleanos;
+    final mergedDireccion = (suggested.direccion != null && suggested.direccion!.trim().isNotEmpty)
+        ? suggested.direccion
+        : direccion;
+    final mergedProfesion = (suggested.profesion != null && suggested.profesion!.trim().isNotEmpty)
+        ? suggested.profesion
+        : profesion;
+    final mergedEstudios = (suggested.estudiosFormales != null && suggested.estudiosFormales!.trim().isNotEmpty)
+        ? suggested.estudiosFormales
+        : estudiosFormales;
+    final mergedHobbies = (suggested.hobbiesIntereses != null && suggested.hobbiesIntereses!.trim().isNotEmpty)
+        ? suggested.hobbiesIntereses
+        : hobbiesIntereses;
+    final mergedNotas = (suggested.notasLibres != null && suggested.notasLibres!.trim().isNotEmpty)
+        ? suggested.notasLibres
+        : notasLibres;
+
+    List<String> mergeList(List<String> base, List<String> incoming) {
+      final set = <String>{};
+      final result = <String>[];
+      for (final item in base) {
+        final trimmed = item.trim();
+        if (trimmed.isNotEmpty && set.add(trimmed.toLowerCase())) {
+          result.add(trimmed);
+        }
+      }
+      for (final item in incoming) {
+        final trimmed = item.trim();
+        if (trimmed.isNotEmpty && set.add(trimmed.toLowerCase())) {
+          result.add(trimmed);
+        }
+      }
+      return result;
+    }
+
+    final mergedActividades = mergeList(ultimasActividades, suggested.ultimasActividades);
+    final mergedProximos = mergeList(proximosEventos, suggested.proximosEventos);
+
+    // Eventos pasados: combinar entrantes con base y limitar a los 10 más recientes
+    final allEventosPasados = mergeList(suggested.eventosPasados, eventosPasados);
+    final cappedEventosPasados = allEventosPasados.take(10).toList();
+
+    return ContactProfile(
+      nombre: mergedNombre,
+      cumpleanos: mergedCumpleanos,
+      direccion: mergedDireccion,
+      profesion: mergedProfesion,
+      estudiosFormales: mergedEstudios,
+      hobbiesIntereses: mergedHobbies,
+      ultimasActividades: mergedActividades,
+      proximosEventos: mergedProximos,
+      eventosPasados: cappedEventosPasados,
+      notasLibres: mergedNotas,
+      updatedAt: DateTime.now().millisecondsSinceEpoch,
+      lastProcessedEventId: suggested.lastProcessedEventId ?? lastProcessedEventId,
+      lastProcessedTimestamp: suggested.lastProcessedTimestamp ?? lastProcessedTimestamp,
+      lastAnalysisTime: suggested.lastAnalysisTime ?? lastAnalysisTime,
+    );
+  }
+
+  ContactProfile copyWith({
+    String? nombre,
+    String? cumpleanos,
+    String? direccion,
+    String? profesion,
+    String? estudiosFormales,
+    String? hobbiesIntereses,
+    List<String>? ultimasActividades,
+    List<String>? proximosEventos,
+    List<String>? eventosPasados,
+    String? notasLibres,
+    int? updatedAt,
+    String? lastProcessedEventId,
+    int? lastProcessedTimestamp,
+    int? lastAnalysisTime,
+  }) {
+    return ContactProfile(
+      nombre: nombre ?? this.nombre,
+      cumpleanos: cumpleanos ?? this.cumpleanos,
+      direccion: direccion ?? this.direccion,
+      profesion: profesion ?? this.profesion,
+      estudiosFormales: estudiosFormales ?? this.estudiosFormales,
+      hobbiesIntereses: hobbiesIntereses ?? this.hobbiesIntereses,
+      ultimasActividades: ultimasActividades ?? this.ultimasActividades,
+      proximosEventos: proximosEventos ?? this.proximosEventos,
+      eventosPasados: eventosPasados ?? this.eventosPasados,
+      notasLibres: notasLibres ?? this.notasLibres,
+      updatedAt: updatedAt ?? this.updatedAt,
+      lastProcessedEventId: lastProcessedEventId ?? this.lastProcessedEventId,
+      lastProcessedTimestamp: lastProcessedTimestamp ?? this.lastProcessedTimestamp,
+      lastAnalysisTime: lastAnalysisTime ?? this.lastAnalysisTime,
+    );
+  }
+}
