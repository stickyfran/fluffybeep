+# Compile Vodozemac for web
+version=$(yq ".dependencies.flutter_vodozemac" < pubspec.yaml)
+version=$(printf "%s" "$version" | tr -d '"^')
+git clone https://github.com/famedly/dart-vodozemac.git -b ${version} .vodozemac
