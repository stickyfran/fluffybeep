+                              padding: EdgeInsets.all(12.0),
+                              child: Icon(Icons.forum),
+                            ),
+                            toolTip: L10n.of(context).chats,
+                            unreadBadgeFilter: (room) => true,
+                          );
+                        }
+                        i--;
+                        if (i == combinedItems.length) {
+                          return Material(
+                            color: Colors.transparent,
+                            child: PopupMenuButton<String>(
+                              icon: const Padding(
+                                padding: EdgeInsets.all(12.0),
+                                child: Icon(Icons.add),
+                              ),
+                              tooltip: 'Agregar...',
+                              onSelected: (val) async {
+                                if (val == 'space') {
+                                  context.go('/rooms/newspace');
+                                } else if (val == 'label') {
+                                  final created = await showDialog<bool>(
+                                    context: context,
+                                    useRootNavigator: false,
+                                    builder: (context) => const LabelEditorDialog(),
+                                  );
+                                  if (created == true && mounted) {
+                                    setState(() {});
+                                  }
+                                }
+                              },
+                              itemBuilder: (context) => [
+                                const PopupMenuItem(
+                                  value: 'space',
+                                  child: Row(
+                                    children: [
+                                      Icon(Icons.workspaces_outlined),
+                                      SizedBox(width: 8),
+                                      Text('Nuevo Espacio'),
+                                    ],
+                                  ),
+                                ),
+                                const PopupMenuItem(
+                                  value: 'label',
+                                  child: Row(
+                                    children: [
+                                      Icon(Icons.label_outline),
+                                      SizedBox(width: 8),
+                                      Text('Nueva Etiqueta'),
+                                    ],
+                                  ),
+                                ),
+                              ],
+                            ),
+                          );
+                        }
+                        final item = combinedItems[i];
+                        if (item.isSpace) {
+                          final space = item.space!;
+                          final displayname = space.getLocalizedDisplayname(
+                            MatrixLocals(L10n.of(context)),
+                          );
+                          final spaceChildrenIds = space.spaceChildren
+                              .map((c) => c.roomId)
+                              .toSet();
+                           return RepaintBoundary(
+                             child: NaviRailItem(
+                              toolTip: displayname,
+                            isSelected: widget.activeSpaceId == space.id,
+                            onTap: () => widget.onGoToSpaceId(space.id),
+                            onLongPress: () => _showSpaceMenu(context, space, client),
+                            unreadBadgeFilter: (room) =>
+                                spaceChildrenIds.contains(room.id),
+                            icon: Avatar(
+                              mxContent: space.avatar,
+                              name: displayname,
+                              shapeBorder: RoundedSuperellipseBorder(
+                                side: BorderSide(
+                                  width: 1,
+                                  color: Theme.of(context).dividerColor,
+                                ),
+                                borderRadius: BorderRadius.circular(
+                                  AppConfig.spaceBorderRadius,
+                                ),
+                              ),
+                              borderRadius: BorderRadius.circular(
+                                AppConfig.spaceBorderRadius,
+                              ),
+                            ),
+                          ),
+                        );
+                        } else if (item.isNetwork) {
+                          final net = item.network!;
+                          final isSelected = widget.activeSpaceId == 'virtual_space_${net.key}';
+                          
+                          // Mapa de emojis para cada red
+                          const emojiMap = {
+                            'whatsapp': '🟢',
+                            'instagram': '📸',
+                            'telegram': '✈️',
