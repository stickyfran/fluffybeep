+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state != AppLifecycleState.resumed) return;
+    if (!mounted) return;
+    setReadMarker();
+    _tryRecoverBadEncryptedMessages();
+  }
+
+  Future<void> _tryRecoverBadEncryptedMessages() async {
+    final client = room.client;
+    await client.oneShotSync().catchError((_) {});
+    
+    final badEvents = timeline?.events
+      .where((e) => e.messageType == MessageTypes.BadEncrypted)
+      .take(20) ?? [];
+    
+    for (final event in badEvents) {
+      final sessionId = event.content.tryGet<String>('session_id');
+      final senderKey = event.content.tryGet<String>('sender_key');
+      if (sessionId != null && senderKey != null) {
+        await client.encryption?.keyManager.maybeAutoRequest(
+          room.id, sessionId, senderKey,
+        );
+      }
+    }
+
+    timeline?.requestKeys(onlineKeyBackupOnly: false);
+  }
+
+  Future<void>? _setReadMarkerFuture;
+
+  void setReadMarker({String? eventId, bool force = false}) {
+    if (!force && (BeeperBridgeUtils.prefs?.getBool('beeper_manual_read_receipts') ?? false)) {
+      return;
+    }
+    if (eventId?.isValidMatrixIdStrict() == false) return;
+    if (!force && _setReadMarkerFuture != null) return;
+    if (!force && _scrolledUp) return;
+    if (!force && scrollUpBannerEventId != null) return;
+
+    if (!force &&
+        eventId == null &&
+        !room.hasNewMessages &&
+        room.notificationCount == 0 &&
+        !room.markedUnread) {
+      return;
+    }
+
+    // Do not send read markers when app is not in foreground
+    if (!force && WidgetsBinding.instance.lifecycleState != AppLifecycleState.resumed) {
+      return;
+    }
+
+    final currentTimeline = timeline;
+    final targetId = eventId ?? currentTimeline?.events.firstOrNull?.eventId ?? room.lastEvent?.eventId;
+
+    if (force || eventId != null) {
+      scrollUpBannerEventId = null;
+      if (room.markedUnread) {
+        room.markUnread(false);
+      }
+      room.notificationCount = 0;
+      room.highlightCount = 0;
+    }
+
+    // Clear local readMarkerEventId immediately so UI button vanishes
+    try {
+      if (force || eventId != null) {
+        readMarkerEventId = '';
+      }
+    } catch (_) {
+      // readMarkerEventId not yet initialized — skip
+    }
+
+    if (targetId == null) {
+      if (force && mounted) setState(() {});
+      return;
+    }
+
+    Logs().d('Set read marker...', targetId);
+
+    _setReadMarkerFuture = () async {
+      try {
+        if (room.markedUnread) {
+          await room.markUnread(false);
+        }
+        await room.setReadMarker(
+          targetId,
+          mRead: targetId,
+          public: AppSettings.sendPublicReadReceipts.value,
+        );
+        if (currentTimeline != null) {
+          try {
+            await currentTimeline.setReadMarker(
+              eventId: targetId,
+              public: AppSettings.sendPublicReadReceipts.value,
+            );
+          } catch (_) {
+            // Timeline may not contain targetId if outside loaded window
+          }
+        }
+        if (PlatformInfos.isMobile) {
+          final notifId = '${room.client.clientName}_${room.id}'.hashCode;
+          await FlutterLocalNotificationsPlugin().cancel(id: notifId);
+        }
+        final unreadCount = room.client.rooms
+            .where((r) => r.isUnreadOrInvited)
+            .length;
+        updateAppBadge(unreadCount);
+      } catch (e) {
+        Logs().w('Failed to set read marker', e);
+      } finally {
+        _setReadMarkerFuture = null;
+      }
+    }();
+
+    if (force && mounted) {
+      setState(() {});
+    }
+  }
