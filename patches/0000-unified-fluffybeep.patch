diff --git a/lib/utils/performance_logger.dart b/lib/utils/performance_logger.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1fe25d6d467139c8009086fe24e2e6b7b0c4bf0f
--- /dev/null
+++ b/lib/utils/performance_logger.dart
@@ -0,0 +1,240 @@
+// SPDX-FileCopyrightText: 2026 FluffyBeep Contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:isolate';
+import 'dart:ui';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/gestures.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+import 'crash_logger.dart';
+import 'file_logger.dart';
+
+class PerformanceLogger {
+  static bool _initialized = false;
+  static DateTime? _lastTouchLog;
+  static DateTime? _backgroundStartTime;
+  static Timer? _backgroundHeartbeatTimer;
+  static RawReceivePort? _isolateErrorPort;
+
+  static void init() {
+    if (!FileLogger.isEnabled()) return;
+    if (_initialized) return;
+    _initialized = true;
+
+    FileLogger.log('[PERF_INIT] Advanced Performance, Battery & Error Logger initialized.');
+
+    // 1. Capture Flutter framework errors
+    final originalOnError = FlutterError.onError;
+    FlutterError.onError = (FlutterErrorDetails details) {
+      final library = details.library ?? 'unknown';
+      final contextStr = details.context?.toString() ?? '';
+      FileLogger.log(
+        '[CRASH/FLUTTER_ERROR] Library: $library | Context: $contextStr | Exception: ${details.exceptionAsString()}\n'
+        'Stack:\n${details.stack}',
+      );
+      if (originalOnError != null) {
+        originalOnError(details);
+      }
+    };
+
+    // 2. Capture Async Platform/Dart errors
+    PlatformDispatcher.instance.onError = (Object error, StackTrace stack) {
+      FileLogger.log(
+        '[CRASH/ASYNC_ERROR] Unhandled async error: $error\nStack:\n$stack',
+      );
+      return false;
+    };
+
+    // 3. Capture Uncaught Isolate Errors
+    try {
+      _isolateErrorPort = RawReceivePort((dynamic pair) {
+        if (pair is List && pair.length >= 2) {
+          final error = pair[0];
+          final stack = pair[1];
+          FileLogger.log(
+            '[CRASH/ISOLATE_ERROR] Uncaught isolate error: $error\nStack:\n$stack',
+          );
+        }
+      });
+      Isolate.current.addErrorListener(_isolateErrorPort!.sendPort);
+    } catch (e) {
+      FileLogger.log('[PERF_INIT] Could not attach isolate error listener: $e');
+    }
+
+    // 4. Monitor App Lifecycle & Background Battery/Resource Usage
+    _setupLifecycleTracking();
+
+    // 5. Monitor Frame Timings (Jank, Slow Frames & UI Freezes with Route Context)
+    WidgetsBinding.instance.addTimingsCallback((List<FrameTiming> timings) {
+      if (!FileLogger.isEnabled()) return;
+      for (final timing in timings) {
+        final buildMs = timing.buildDuration.inMicroseconds / 1000.0;
+        final rasterMs = timing.rasterDuration.inMicroseconds / 1000.0;
+        final totalMs = timing.totalSpan.inMicroseconds / 1000.0;
+        final renderMs = buildMs + rasterMs;
+        final route = PerformanceLoggerObserver.currentRoute;
+
+        if (renderMs > 100.0) {
+          FileLogger.log(
+            '[PERF/UI_FREEZE] Severe UI freeze on "$route": Total=${totalMs.toStringAsFixed(1)}ms '
+            '(Build=${buildMs.toStringAsFixed(1)}ms, Raster=${rasterMs.toStringAsFixed(1)}ms)',
+          );
+        } else if (renderMs > 33.3) {
+          FileLogger.log(
+            '[PERF/JANK] Slow frame on "$route": Total=${totalMs.toStringAsFixed(1)}ms '
+            '(Build=${buildMs.toStringAsFixed(1)}ms, Raster=${rasterMs.toStringAsFixed(1)}ms)',
+          );
+        } else if (renderMs > 16.6) {
+          FileLogger.log(
+            '[PERF/SLOW_FRAME] Frame dropped on "$route": Total=${totalMs.toStringAsFixed(1)}ms '
+            '(Build=${buildMs.toStringAsFixed(1)}ms, Raster=${rasterMs.toStringAsFixed(1)}ms)',
+          );
+        }
+      }
+    });
+
+    // 6. Capture Hardware Keyboard events
+    HardwareKeyboard.instance.addHandler((KeyEvent event) {
+      if (!FileLogger.isEnabled()) return false;
+      final keyName = event.logicalKey.debugName ?? event.logicalKey.keyLabel;
+      final charStr = event.character != null ? ' char="${event.character}"' : '';
+      FileLogger.log(
+        '[USER_KEYBOARD] ${event.runtimeType}: key="$keyName"$charStr on "${PerformanceLoggerObserver.currentRoute}"',
+      );
+      return false;
+    });
+
+    // 7. Capture Global Touch & Pointer Interaction events
+    DateTime? lastMoveLog;
+    GestureBinding.instance.pointerRouter.addGlobalRoute((PointerEvent event) {
+      if (!FileLogger.isEnabled()) return;
+      final route = PerformanceLoggerObserver.currentRoute;
+      if (event is PointerDownEvent) {
+        FileLogger.log(
+          '[USER_TOUCH] Touch Down at (${event.position.dx.toStringAsFixed(0)}, ${event.position.dy.toStringAsFixed(0)}) on "$route"',
+        );
+      } else if (event is PointerUpEvent) {
+        FileLogger.log(
+          '[USER_TOUCH] Touch Up at (${event.position.dx.toStringAsFixed(0)}, ${event.position.dy.toStringAsFixed(0)}) on "$route"',
+        );
+      } else if (event is PointerMoveEvent) {
+        final now = DateTime.now();
+        if (lastMoveLog == null || now.difference(lastMoveLog!).inMilliseconds > 100) {
+          lastMoveLog = now;
+          FileLogger.log(
+            '[USER_TOUCH] Touch Move at (${event.position.dx.toStringAsFixed(0)}, ${event.position.dy.toStringAsFixed(0)}) delta=(${event.delta.dx.toStringAsFixed(1)}, ${event.delta.dy.toStringAsFixed(1)}) on "$route"',
+          );
+        }
+      }
+    });
+  }
+
+  static void _setupLifecycleTracking() {
+    WidgetsBinding.instance.addObserver(_PerformanceLifecycleObserver());
+  }
+
+  static void _handleLifecycleState(AppLifecycleState state) {
+    final timestamp = DateTime.now();
+    final cacheBytes = PaintingBinding.instance.imageCache.currentSizeBytes;
+    final cacheMb = (cacheBytes / (1024 * 1024)).toStringAsFixed(1);
+    final cacheCount = PaintingBinding.instance.imageCache.currentSize;
+
+    FileLogger.log(
+      '[APP_LIFECYCLE] State changed to: ${state.name} '
+      '(ImageCache: ${cacheMb}MB / $cacheCount items)',
+    );
+
+    if (state == AppLifecycleState.paused ||
+        state == AppLifecycleState.detached ||
+        state == AppLifecycleState.hidden) {
+      _backgroundStartTime ??= timestamp;
+      _startBackgroundHeartbeat();
+    } else if (state == AppLifecycleState.resumed) {
+      _stopBackgroundHeartbeat();
+      if (_backgroundStartTime != null) {
+        final bgSeconds = timestamp.difference(_backgroundStartTime!).inSeconds;
+        FileLogger.log(
+          '[BATTERY/BACKGROUND_STATS] Returned to foreground after ${bgSeconds}s in background.',
+        );
+        _backgroundStartTime = null;
+      }
+    }
+  }
+
+  static void _startBackgroundHeartbeat() {
+    // Only run the recurring heartbeat in debug mode to prevent waking the CPU
+    // and flash storage from Android Doze in production release builds.
+    if (!kDebugMode) return;
+    _backgroundHeartbeatTimer?.cancel();
+    _backgroundHeartbeatTimer = Timer.periodic(const Duration(minutes: 5), (timer) {
+      if (_backgroundStartTime != null) {
+        final elapsedMinutes = DateTime.now().difference(_backgroundStartTime!).inMinutes;
+        FileLogger.log(
+          '[BATTERY/RESOURCE_WARN] App active in background for $elapsedMinutes minutes. Monitoring background tasks.',
+        );
+      }
+    });
+  }
+
+  static void _stopBackgroundHeartbeat() {
+    _backgroundHeartbeatTimer?.cancel();
+    _backgroundHeartbeatTimer = null;
+  }
+
+  static void logAction(String action) {
+    FileLogger.log('[USER_ACTION] $action');
+    CrashLogger.addBreadcrumb('ACTION', action);
+  }
+}
+
+class _PerformanceLifecycleObserver with WidgetsBindingObserver {
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    PerformanceLogger._handleLifecycleState(state);
+  }
+}
+
+class PerformanceLoggerObserver extends NavigatorObserver {
+  static String currentRoute = 'unknown';
+  static final ValueNotifier<String> currentRouteNotifier = ValueNotifier<String>('unknown');
+
+  static String _getRouteName(Route<dynamic> route) {
+    final name = route.settings.name ?? route.runtimeType.toString();
+    final args = route.settings.arguments;
+    if (args != null) {
+      return '$name (args: $args)';
+    }
+    return name;
+  }
+
+  @override
+  void didPush(Route<dynamic> route, Route<dynamic>? previousRoute) {
+    super.didPush(route, previousRoute);
+    currentRoute = _getRouteName(route);
+    currentRouteNotifier.value = currentRoute;
+    PerformanceLogger.logAction('Screen Pushed: $currentRoute');
+    CrashLogger.addBreadcrumb('NAV', 'Screen Pushed: $currentRoute');
+  }
+
+  @override
+  void didPop(Route<dynamic> route, Route<dynamic>? previousRoute) {
+    super.didPop(route, previousRoute);
+    currentRoute = previousRoute != null ? _getRouteName(previousRoute) : 'unknown';
+    currentRouteNotifier.value = currentRoute;
+    PerformanceLogger.logAction('Screen Popped: ${_getRouteName(route)} -> Active: $currentRoute');
+    CrashLogger.addBreadcrumb('NAV', 'Screen Popped to: $currentRoute');
+  }
+
+  @override
+  void didReplace({Route<dynamic>? newRoute, Route<dynamic>? oldRoute}) {
+    super.didReplace(newRoute: newRoute, oldRoute: oldRoute);
+    if (newRoute != null) {
+      currentRoute = _getRouteName(newRoute);
+      currentRouteNotifier.value = currentRoute;
+      PerformanceLogger.logAction('Screen Replaced: $currentRoute');
+      CrashLogger.addBreadcrumb('NAV', 'Screen Replaced: $currentRoute');
+    }
+  }
+}
