+// SPDX-FileCopyrightText: 2026 Contributors to FluffyBeep
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+import 'package:matrix/matrix.dart';
+
+import '../config/setting_keys.dart';
+
+class AudioRouterService {
+  AudioRouterService._internal() {
+    _channel.setMethodCallHandler(_handleNativeCall);
+    final saved = AppSettings.audioPlaybackOutput.value;
+    _currentMode = saved == 'earpiece' ? 'earpiece' : 'speaker';
+    outputModeNotifier.value = _currentMode;
+  }
+
+  static final AudioRouterService instance = AudioRouterService._internal();
+
+  static const MethodChannel _channel =
+      MethodChannel('chat.fluffy.fluffybeep/audio_router');
+
+  final ValueNotifier<bool> isNearEarNotifier = ValueNotifier<bool>(false);
+  late final ValueNotifier<String> outputModeNotifier =
+      ValueNotifier<String>(_currentMode);
+  final ValueNotifier<double> playbackSpeedNotifier = ValueNotifier<double>(1.0);
+  bool _isSessionActive = false;
+  String _currentMode = 'speaker'; // 'speaker', 'earpiece'
+
+  bool get isSessionActive => _isSessionActive;
+  String get currentMode => _currentMode;
+
+  Future<void> _handleNativeCall(MethodCall call) async {
+    if (call.method == 'onProximityChanged') {
+      final isNear = call.arguments as bool? ?? false;
+      isNearEarNotifier.value = isNear;
+      Logs().v('Proximity sensor changed: isNear=$isNear');
+    }
+  }
+
+  /// Start an audio routing session with mode: 'speaker' | 'earpiece' | 'auto'
+  Future<void> startSession(String mode) async {
+    _currentMode = mode;
+    outputModeNotifier.value = mode;
+    _isSessionActive = true;
+    try {
+      await _channel.invokeMethod('startSession', {'mode': mode});
+    } catch (e, s) {
+      Logs().w('AudioRouterService.startSession failed', e, s);
+    }
+  }
+
+  /// Change the routing mode dynamically and persist globally
+  Future<void> setOutputMode(String mode) async {
+    _currentMode = mode;
+    outputModeNotifier.value = mode;
+    await AppSettings.audioPlaybackOutput.setItem(mode);
+    if (!_isSessionActive) return;
+    try {
+      await _channel.invokeMethod('setOutputMode', {'mode': mode});
+    } catch (e, s) {
+      Logs().w('AudioRouterService.setOutputMode failed', e, s);
+    }
+  }
+
+  /// Toggle between earpiece and speaker globally
+  Future<void> toggleOutputMode() async {
+    final next = _currentMode == 'earpiece' ? 'speaker' : 'earpiece';
+    await setOutputMode(next);
+  }
+
+  /// Stop audio routing session, restore AudioManager to NORMAL and release WakeLock
+  Future<void> stopSession() async {
+    if (!_isSessionActive) return;
+    _isSessionActive = false;
+    isNearEarNotifier.value = false;
+    try {
+      await _channel.invokeMethod('stopSession');
+    } catch (e, s) {
+      Logs().w('AudioRouterService.stopSession failed', e, s);
+    }
+  }
+
+  /// Queries whether the phone is currently near the ear
+  Future<bool> isNear() async {
+    try {
+      final res = await _channel.invokeMethod<bool>('isNear');
+      return res ?? false;
+    } catch (_) {
+      return false;
+    }
+  }
+}
