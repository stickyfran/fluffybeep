diff --git a/lib/pages/chat_search/chat_ai_query_sheet.dart b/lib/pages/chat_search/chat_ai_query_sheet.dart
new file mode 100644
index 0000000000000000000000000000000000000000..4a7871c3677b3223bb1dda5a335c24756bfdea46
--- /dev/null
+++ b/lib/pages/chat_search/chat_ai_query_sheet.dart
@@ -0,0 +1,435 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/utils/ai_profile_service.dart';
+import 'package:fluffychat/utils/chat_ai_query_service.dart';
+
+class ChatAiQuerySheet extends StatefulWidget {
+  final Room room;
+
+  const ChatAiQuerySheet({super.key, required this.room});
+
+  @override
+  State<ChatAiQuerySheet> createState() => _ChatAiQuerySheetState();
+}
+
+class _ChatAiQuerySheetState extends State<ChatAiQuerySheet> {
+  final TextEditingController _questionController = TextEditingController();
+  final ScrollController _scrollController = ScrollController();
+  final List<ChatAiQueryItem> _items = [];
+  bool _isLoading = false;
+  int _historyDepth = 200;
+
+  final List<String> _suggestedQueries = [
+    '¿Qué planes o citas acordamos?',
+    '¿Mencionó alguna dirección, lugar o dato clave?',
+    '¿Cuáles son los últimos temas importantes?',
+    '¿Hay algún pago, dinero o tarea pendiente?',
+  ];
+
+  @override
+  void dispose() {
+    _questionController.dispose();
+    _scrollController.dispose();
+    // Liberar la lista de consultas de la memoria
+    _items.clear();
+    super.dispose();
+  }
+
+  void _clearQueries() {
+    setState(() {
+      _items.clear();
+    });
+  }
+
+  Future<void> _submitQuery([String? predefinedQuestion]) async {
+    final text = (predefinedQuestion ?? _questionController.text).trim();
+    if (text.isEmpty || _isLoading) return;
+
+    _questionController.clear();
+    FocusScope.of(context).unfocus();
+
+    final newItem = ChatAiQueryItem(
+      question: text,
+      isLoading: true,
+      timestamp: DateTime.now(),
+    );
+
+    setState(() {
+      _items.add(newItem);
+      _isLoading = true;
+    });
+
+    _scrollToBottom();
+
+    try {
+      final answer = await ChatAiQueryService.askChatQuestion(
+        room: widget.room,
+        question: text,
+        chatHistoryDepth: _historyDepth,
+      );
+
+      if (!mounted) return;
+      setState(() {
+        final index = _items.indexOf(newItem);
+        if (index != -1) {
+          _items[index] = newItem.copyWith(
+            answer: answer,
+            isLoading: false,
+          );
+        }
+        _isLoading = false;
+      });
+    } catch (e) {
+      if (!mounted) return;
+      setState(() {
+        final index = _items.indexOf(newItem);
+        if (index != -1) {
+          _items[index] = newItem.copyWith(
+            error: e.toString(),
+            isLoading: false,
+          );
+        }
+        _isLoading = false;
+      });
+    }
+
+    _scrollToBottom();
+  }
+
+  void _scrollToBottom() {
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (_scrollController.hasClients) {
+        _scrollController.animateTo(
+          _scrollController.position.maxScrollExtent,
+          duration: const Duration(milliseconds: 300),
+          curve: Curves.easeOut,
+        );
+      }
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final contactName = AiProfileService.resolveContactName(widget.room);
+    final title = contactName.isNotEmpty ? contactName : widget.room.getLocalizedDisplayname();
+    final currentModel = AppSettings.aiModel.value.trim().isEmpty ? 'llama3.2' : AppSettings.aiModel.value.trim();
+
+    return DraggableScrollableSheet(
+      initialChildSize: 0.85,
+      minChildSize: 0.45,
+      maxChildSize: 0.95,
+      expand: false,
+      builder: (context, sheetScrollController) {
+        return Container(
+          decoration: BoxDecoration(
+            color: theme.scaffoldBackgroundColor,
+            borderRadius: const BorderRadius.vertical(top: Radius.circular(20)),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              // Barra superior / Tirador
+              Center(
+                child: Container(
+                  margin: const EdgeInsets.only(top: 12, bottom: 8),
+                  width: 40,
+                  height: 4,
+                  decoration: BoxDecoration(
+                    color: theme.dividerColor,
+                    borderRadius: BorderRadius.circular(2),
+                  ),
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 4.0),
+                child: Row(
+                  children: [
+                    const Icon(Icons.psychology_outlined, color: Colors.blueAccent),
+                    const SizedBox(width: 8),
+                    Expanded(
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text(
+                            'Consultar chat con IA',
+                            style: theme.textTheme.titleMedium?.copyWith(
+                              fontWeight: FontWeight.bold,
+                            ),
+                          ),
+                          Text(
+                            '$title • $currentModel',
+                            style: theme.textTheme.bodySmall?.copyWith(
+                              color: theme.colorScheme.onSurfaceVariant,
+                            ),
+                            maxLines: 1,
+                            overflow: TextOverflow.ellipsis,
+                          ),
+                        ],
+                      ),
+                    ),
+                    if (_items.isNotEmpty)
+                      IconButton(
+                        tooltip: 'Limpiar consultas',
+                        icon: const Icon(Icons.cleaning_services_outlined),
+                        onPressed: _clearQueries,
+                      ),
+                    IconButton(
+                      tooltip: 'Profundidad de historial',
+                      icon: const Icon(Icons.tune_outlined),
+                      onPressed: () => _showDepthPicker(context),
+                    ),
+                  ],
+                ),
+              ),
+              const Divider(height: 1),
+
+              // Contenido principal: historial de Q&A o sugerencias
+              Expanded(
+                child: _items.isEmpty
+                    ? _buildEmptyState(theme)
+                    : ListView.builder(
+                        controller: _scrollController,
+                        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+                        itemCount: _items.length,
+                        itemBuilder: (context, index) {
+                          return _buildQueryCard(theme, _items[index]);
+                        },
+                      ),
+              ),
+
+              // Barra de sugerencias si la lista tiene pocos items
+              if (_items.isEmpty)
+                SizedBox(
+                  height: 44,
+                  child: ListView.separated(
+                    scrollDirection: Axis.horizontal,
+                    padding: const EdgeInsets.symmetric(horizontal: 16),
+                    itemCount: _suggestedQueries.length,
+                    separatorBuilder: (_, __) => const SizedBox(width: 8),
+                    itemBuilder: (context, i) {
+                      final query = _suggestedQueries[i];
+                      return ActionChip(
+                        label: Text(query, style: const TextStyle(fontSize: 12)),
+                        onPressed: _isLoading ? null : () => _submitQuery(query),
+                      );
+                    },
+                  ),
+                ),
+
+              const SizedBox(height: 8),
+
+              // Campo de entrada de texto
+              Padding(
+                padding: EdgeInsets.only(
+                  left: 12,
+                  right: 12,
+                  bottom: MediaQuery.of(context).viewInsets.bottom + 12,
+                ),
+                child: Row(
+                  children: [
+                    Expanded(
+                      child: TextField(
+                        controller: _questionController,
+                        textInputAction: TextInputAction.send,
+                        onSubmitted: (_) => _submitQuery(),
+                        decoration: InputDecoration(
+                          hintText: 'Pregunta algo sobre el chat...',
+                          isDense: true,
+                          filled: true,
+                          fillColor: theme.colorScheme.surfaceContainerHighest.withValues(alpha: 0.5),
+                          border: OutlineInputBorder(
+                            borderRadius: BorderRadius.circular(24),
+                            borderSide: BorderSide.none,
+                          ),
+                          contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+                        ),
+                      ),
+                    ),
+                    const SizedBox(width: 8),
+                    IconButton.filled(
+                      onPressed: _isLoading ? null : () => _submitQuery(),
+                      icon: _isLoading
+                          ? const SizedBox(
+                              width: 18,
+                              height: 18,
+                              child: CircularProgressIndicator(
+                                strokeWidth: 2,
+                                color: Colors.white,
+                              ),
+                            )
+                          : const Icon(Icons.send),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _buildEmptyState(ThemeData theme) {
+    return Center(
+      child: Padding(
+        padding: const EdgeInsets.all(32.0),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(
+              Icons.chat_bubble_outline,
+              size: 48,
+              color: theme.colorScheme.outline,
+            ),
+            const SizedBox(height: 16),
+            Text(
+              'Consulta cualquier detalle del chat',
+              style: theme.textTheme.titleSmall?.copyWith(fontWeight: FontWeight.bold),
+            ),
+            const SizedBox(height: 8),
+            Text(
+              'En lugar de buscar mensaje por mensaje, pregúntale a la IA sobre fechas, acuerdos, direcciones o resúmenes de la conversación.',
+              textAlign: TextAlign.center,
+              style: theme.textTheme.bodySmall?.copyWith(
+                color: theme.colorScheme.onSurfaceVariant,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _buildQueryCard(ThemeData theme, ChatAiQueryItem item) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 16.0),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          // Pregunta del usuario
+          Align(
+            alignment: Alignment.centerRight,
+            child: Container(
+              margin: const EdgeInsets.only(left: 48),
+              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
+              decoration: BoxDecoration(
+                color: theme.colorScheme.primaryContainer,
+                borderRadius: BorderRadius.circular(16).copyWith(
+                  bottomRight: const Radius.circular(2),
+                ),
+              ),
+              child: Text(
+                item.question,
+                style: TextStyle(
+                  color: theme.colorScheme.onPrimaryContainer,
+                  fontWeight: FontWeight.w500,
+                ),
+              ),
+            ),
+          ),
+          const SizedBox(height: 8),
+
+          // Respuesta de la IA
+          Align(
+            alignment: Alignment.centerLeft,
+            child: Container(
+              margin: const EdgeInsets.only(right: 32),
+              padding: const EdgeInsets.all(14),
+              decoration: BoxDecoration(
+                color: theme.colorScheme.surfaceContainerHigh,
+                borderRadius: BorderRadius.circular(16).copyWith(
+                  bottomLeft: const Radius.circular(2),
+                ),
+              ),
+              child: item.isLoading
+                  ? const Row(
+                      mainAxisSize: MainAxisSize.min,
+                      children: [
+                        SizedBox(
+                          width: 16,
+                          height: 16,
+                          child: CircularProgressIndicator(strokeWidth: 2),
+                        ),
+                        SizedBox(width: 12),
+                        Text('Buscando en la conversación...', style: TextStyle(fontSize: 13)),
+                      ],
+                    )
+                  : item.error != null
+                      ? Row(
+                          crossAxisAlignment: CrossAxisAlignment.start,
+                          children: [
+                            const Icon(Icons.error_outline, color: Colors.red, size: 18),
+                            const SizedBox(width: 8),
+                            Expanded(
+                              child: Text(
+                                item.error!,
+                                style: TextStyle(
+                                  color: theme.colorScheme.error,
+                                  fontSize: 13,
+                                ),
+                              ),
+                            ),
+                          ],
+                        )
+                      : SelectableText(
+                          item.answer ?? '',
+                          style: const TextStyle(fontSize: 14, height: 1.4),
+                        ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  void _showDepthPicker(BuildContext context) {
+    showModalBottomSheet(
+      context: context,
+      builder: (ctx) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            const ListTile(
+              leading: Icon(Icons.tune_outlined),
+              title: Text('Alcance del historial a consultar'),
+              subtitle: Text('Más mensajes dan más contexto, pero pueden tardar más.'),
+            ),
+            RadioListTile<int>(
+              title: const Text('Últimos 100 mensajes (Rápido)'),
+              value: 100,
+              groupValue: _historyDepth,
+              onChanged: (val) {
+                if (val != null) setState(() => _historyDepth = val);
+                Navigator.pop(ctx);
+              },
+            ),
+            RadioListTile<int>(
+              title: const Text('Últimos 200 mensajes (Recomendado)'),
+              value: 200,
+              groupValue: _historyDepth,
+              onChanged: (val) {
+                if (val != null) setState(() => _historyDepth = val);
+                Navigator.pop(ctx);
+              },
+            ),
+            RadioListTile<int>(
+              title: const Text('Últimos 500 mensajes (Extenso)'),
+              value: 500,
+              groupValue: _historyDepth,
+              onChanged: (val) {
+                if (val != null) setState(() => _historyDepth = val);
+                Navigator.pop(ctx);
+              },
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
