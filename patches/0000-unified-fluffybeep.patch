+  /// Robust extraction of Instagram username and numeric ID from room or bridge events (cached O(1))
+  static ({String? username, String? numericId}) extractInstagramDetails(Room room) {
+    if (_extractedInstagramCache.containsKey(room.id)) {
+      return _extractedInstagramCache[room.id]!;
+    }
+    final details = _computeInstagramDetails(room);
+    _extractedInstagramCache[room.id] = details;
+    if (_extractedInstagramCache.length > maxCacheSize) {
+      _extractedInstagramCache.remove(_extractedInstagramCache.keys.first);
+    }
+    return details;
+  }
+
+  static ({String? username, String? numericId}) _computeInstagramDetails(Room room) {
+    String? username = BeeperMergeUtils.getCustomInstagramHandle(room.id);
+    String? numericId;
+
+    // 1. Check bridge state events
+    for (final stateKey in const [
+      'com.beeper.bridge',
+      'm.bridge',
+      'fi.mau.instagram',
+      'com.beeper.instagram',
+      'uk.half-shot.bridge',
+    ]) {
+      final events = room.states[stateKey]?.values ?? const <Event>[];
+      for (final event in events) {
+        final content = event.content;
+        final channel = content['channel'] is Map ? (content['channel'] as Map) : null;
+        final remoteUser = content['remote_user'] is Map ? (content['remote_user'] as Map) : null;
+        final sender = content['sender'] is Map ? (content['sender'] as Map) : null;
+        final beeper = content['beeper'] is Map ? (content['beeper'] as Map) : null;
+
+        final uCandidates = [
+          content['username'],
+          content['instagram_username'],
+          content['ig_username'],
+          channel?['username'],
+          channel?['displayname'],
+          remoteUser?['username'],
+          remoteUser?['displayname'],
+          sender?['username'],
+          sender?['displayname'],
+          beeper?['username'],
+          content['name'],
+        ];
+
+        for (final u in uCandidates) {
+          if (u != null && u.toString().isNotEmpty) {
+            final cleaned = cleanInstagramUsername(u.toString());
+            if (cleaned.isNotEmpty && RegExp(r'[a-zA-Z]').hasMatch(cleaned)) {
+              username ??= cleaned;
+              break;
+            }
+          }
+        }
+
+        final idCandidates = [
+          content['id'],
+          channel?['id'],
+          content['remote_id'],
+          sender?['id'],
+          remoteUser?['id'],
+          content['beeper_guid'],
+          beeper?['remote_user_id'],
+        ];
+
+        for (final id in idCandidates) {
+          if (id != null && id.toString().isNotEmpty) {
+            final str = id.toString().replaceAll(RegExp(r'^instagram:'), '');
+            if (RegExp(r'^\d+$').hasMatch(str)) {
+              numericId ??= str;
+            } else if (username == null && RegExp(r'[a-zA-Z]').hasMatch(str)) {
+              username = cleanInstagramUsername(str);
+            }
+          }
+        }
+      }
+    }
+
+    // 2. Check m.room.member events custom fields & displaynames
+    final memberEvents = room.states['m.room.member']?.values ?? const <Event>[];
+    for (final mEvent in memberEvents) {
+      final content = mEvent.content;
+      final u = content['username'] ?? content['instagram_username'] ?? content['ig_username'];
+      if (u != null && u.toString().isNotEmpty) {
+        final cleaned = cleanInstagramUsername(u.toString());
+        if (cleaned.isNotEmpty && RegExp(r'[a-zA-Z]').hasMatch(cleaned)) {
+          username ??= cleaned;
+        }
+      }
+      final guid = content['beeper_guid']?.toString();
+      if (guid != null && guid.startsWith('instagram:')) {
+        final part = guid.substring('instagram:'.length);
+        if (RegExp(r'^\d+$').hasMatch(part)) {
+          numericId ??= part;
+        } else if (username == null && RegExp(r'[a-zA-Z]').hasMatch(part)) {
+          username = cleanInstagramUsername(part);
+        }
+      }
+    }
+
+    // 3. Extract from member displaynames & room name (e.g. "John Doe (@johndoe)" or "@johndoe")
+    final candidateNames = <String>[
+      ...memberEvents.map((v) => v.content.tryGet<String>('displayname') ?? ''),
+      room.name,
+    ];
+
+    for (final name in candidateNames) {
+      if (username != null) break;
+      if (name.isEmpty) continue;
+
+      final parenMatch = RegExp(r'\(@?([a-zA-Z0-9._]{1,30})\)').firstMatch(name);
+      if (parenMatch != null) {
+        username = parenMatch.group(1);
+        break;
+      }
+
+      final atMatch = RegExp(r'@([a-zA-Z0-9._]{1,30})').firstMatch(name);
+      if (atMatch != null) {
+        username = atMatch.group(1);
+        break;
+      }
+
+      final cleanName = name.trim();
+      if (RegExp(r'^[a-zA-Z0-9._]{1,30}$').hasMatch(cleanName) && RegExp(r'[a-zA-Z]').hasMatch(cleanName)) {
+        username = cleanName;
+        break;
+      }
+    }
+
+    // 4. Check canonicalAlias & aliases
+    final allAliases = getRoomAliases(room);
+    for (final alias in allAliases) {
+      final match = RegExp(r'instagram(?:go)?[^:]*?_([^:@]+)(?:@|:|$)', caseSensitive: false).firstMatch(alias);
+      if (match != null) {
+        final part = match.group(1)!;
+        if (RegExp(r'^\d+$').hasMatch(part)) {
+          numericId ??= part;
+        } else if (username == null && RegExp(r'[a-zA-Z]').hasMatch(part)) {
+          username = cleanInstagramUsername(part);
+        }
+      }
+    }
+
+    // 5. Check room topic (e.g. "Instagram DM with @johndoe" or "https://instagram.com/johndoe")
+    if (username == null && room.topic.isNotEmpty) {
+      final topicMatch = RegExp(r'instagram\.com/(?:_u/)?([a-zA-Z0-9._]{1,30})', caseSensitive: false).firstMatch(room.topic) ??
+          RegExp(r'@([a-zA-Z0-9._]{1,30})').firstMatch(room.topic);
+      if (topicMatch != null) {
+        username = topicMatch.group(1);
+      }
+    }
+
+    // 6. Extract numeric ID or handle from candidate MXIDs
+    final candidateMxids = <String>[
+      if (room.directChatMatrixID != null) room.directChatMatrixID!,
+      if ((_roomDataCache[room.id]?.contactId ?? getCachedContactId(room.id)) != null)
+        (_roomDataCache[room.id]?.contactId ?? getCachedContactId(room.id))!,
+      room.id,
+    ];
+
+    for (final mxid in candidateMxids) {
+      if (mxid == room.client.userID || isBeeperBot(mxid)) continue;
+      final match = RegExp(r'instagram(?:go)?[^:]*?_([^:@]+)(?:@|:|$)', caseSensitive: false).firstMatch(mxid);
+      if (match != null) {
+        final part = match.group(1)!;
+        if (RegExp(r'^\d+$').hasMatch(part)) {
+          numericId ??= part;
+        } else if (username == null && RegExp(r'[a-zA-Z]').hasMatch(part)) {
+          username = cleanInstagramUsername(part);
+        }
+      }
+    }
+
+    return (username: username, numericId: numericId);
+  }
+
+  static String cleanInstagramUsername(String raw) {
+    return raw
+        .replaceAll('@', '')
+        .replaceAll(RegExp(r'^instagram(?:go)?_'), '')
+        .trim();
+  }
+
+  /// Get human-friendly account handle or phone for a room (e.g. "+54 9 11 1234 5678" or "@johndoe")
+  static String? getAccountHandle(Room room) {
+    final net = getRoomNetwork(room)?.key;
+    if (net == 'whatsapp' || net == 'whatsappgo') {
+      final phone = extractWhatsAppPhone(room);
+      if (phone != null) return formatPhoneNumber(phone);
+    } else if (net == 'instagram' || net == 'instagramgo') {
+      final ig = extractInstagramDetails(room);
+      if (ig.username != null) return '@${ig.username}';
+      if (ig.numericId != null) return '@${ig.numericId}';
+    } else if (net == 'telegram' || net == 'telegramgo') {
+      for (final name in [
+        room.name,
+        ...room.states['m.room.member']?.values.map((v) => v.content.tryGet<String>('displayname') ?? '') ?? <String>[],
+      ]) {
+        final atMatch = RegExp(r'@([a-zA-Z0-9_]{3,32})').firstMatch(name);
+        if (atMatch != null) return atMatch.group(0);
+      }
+    }
+
+    final dName = getRoomData(room).displayName;
+    if (dName != null && dName.isNotEmpty && dName != room.name) {
+      return dName.replaceAll('++', '+');
+    }
+    return null;
+  }
+
+
+  static Future<void> addStickerToWhatsappPack(BuildContext context, Event event) async {
+    final client = event.room.client;
+    final messenger = ScaffoldMessenger.of(context);
+
+    final result = await showFutureLoadingDialog<Uri?>(
+      context: context,
+      future: () async {
+        final MatrixFile matrixFile = await event.downloadAndDecryptAttachment();
+        final String filename = event.content['body']?.toString() ?? 'sticker';
+        final rawInfo = event.content['info'];
+        final String mimetype = (rawInfo is Map) ? (rawInfo['mimetype']?.toString() ?? 'image/png') : 'image/png';
+        final uri = await client.uploadContent(
+          matrixFile.bytes,
+          filename: filename,
+          contentType: mimetype,
+        );
+        return uri;
+      },
+    );
+
+    final mxcUri = result.result;
+    if (mxcUri == null) {
+      messenger.showSnackBar(
+        const SnackBar(content: Text('Error al subir el sticker a la cuenta')),
+      );
+      return;
+    }
+
+    try {
+      final accountDataEvent = client.accountData['im.ponies.user_emotes'];
+      Map<String, dynamic> packData;
+      if (accountDataEvent != null) {
+        packData = Map<String, dynamic>.from(accountDataEvent.content);
+      } else {
+        packData = {
+          'images': <String, dynamic>{},
+          'pack': {
+            'display_name': 'Mis stickers',
+            'usage': ['sticker'],
+          },
+        };
+      }
+
+      final images = Map<String, dynamic>.from(packData['images'] ?? <String, dynamic>{});
+      
+      final info = <String, dynamic>{};
+      final rawInfo = event.content['info'];
+      if (rawInfo is Map) {
+        info.addAll(Map<String, dynamic>.from(rawInfo));
+      }
+      
+      if (info['w'] is int && info['h'] is int) {
+        final int w = info['w'];
+        final int h = info['h'];
+        final ratio = w / h;
+        if (w > h) {
+          info['w'] = 256;
+          info['h'] = (256.0 / ratio).round();
+        } else {
+          info['h'] = 256;
+          info['w'] = (ratio * 256.0).round();
+        }
+      }
+
+      final stickerContent = <String, dynamic>{
+        'url': mxcUri.toString(),
+        'info': info,
+        'body': event.content['body'] ?? 'sticker',
+        'usage': ['sticker'],
+      };
+
+      // De-duplication check: if a sticker with the same URL already exists, don't add it again.
+      bool isDuplicate = false;
+      if (images.values.any((val) => val is Map && val['url'] == mxcUri.toString())) {
+        isDuplicate = true;
+      }
+
+      if (!isDuplicate) {
+        final String code = 'sticker_${DateTime.now().millisecondsSinceEpoch}';
+        images[code] = stickerContent;
+        packData['images'] = images;
+
+        await client.setAccountData(
+          client.userID!,
+          'im.ponies.user_emotes',
+          packData,
+        );
+
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Sticker agregado al paquete Mis stickers')),
+        );
+      } else {
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Este sticker ya está en tu paquete')),
+        );
+      }
+    } catch (e) {
+      messenger.showSnackBar(
+        SnackBar(content: Text('Error al guardar el sticker: $e')),
+      );
+    }
+  }
