+class _RecordingWaveformPainter extends CustomPainter {
+  final List<double> amplitudes;
+  final Color barColor;
+  final double maxHeight;
+
+  _RecordingWaveformPainter({
+    required this.amplitudes,
+    required this.barColor,
+    required this.maxHeight,
+  });
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (amplitudes.isEmpty) return;
+
+    final paint = Paint()
+      ..color = barColor
+      ..style = PaintingStyle.fill;
+
+    const barWidth = 4.0;
+    const barSpacing = 2.0;
+    const step = barWidth + barSpacing;
+
+    final maxBars = (size.width / step).floor();
+    if (maxBars <= 0) return;
+
+    final count = amplitudes.length < maxBars ? amplitudes.length : maxBars;
+    final startIndex = amplitudes.length - count;
+
+    // Draw from right to left (newest on the right)
+    for (var i = 0; i < count; i++) {
+      final amp = amplitudes[startIndex + i];
+      final barHeight = (maxHeight * (amp / 100)).clamp(2.0, maxHeight);
+      final x = size.width - ((count - i) * step);
+      final y = (size.height - barHeight) / 2;
+
+      final rrect = RRect.fromRectAndRadius(
+        Rect.fromLTWH(x, y, barWidth, barHeight),
+        const Radius.circular(2),
+      );
+      canvas.drawRRect(rrect, paint);
+    }
+  }
+
+  @override
+  bool shouldRepaint(_RecordingWaveformPainter oldDelegate) {
+    return oldDelegate.amplitudes.length != amplitudes.length ||
+        oldDelegate.barColor != barColor ||
+        oldDelegate.maxHeight != maxHeight;
+  }
+}
