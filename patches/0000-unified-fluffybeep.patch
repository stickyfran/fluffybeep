@@ -0,0 +1,129 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'package:matrix/matrix.dart';
+import 'beeper_merge_utils.dart';
+import 'file_logger.dart';
+
+typedef HistoryDownloadProgressCallback = void Function({
+  required int downloadedCount,
+  required String currentRoomName,
+  required bool isCompleted,
+  String? error,
+});
+
+/// Utilidad para descargar el historial completo de mensajes de una sala Matrix
+/// (y sus salas hermanas si está fusionada con WhatsApp / Instagram) paginando
+/// hacia atrás progresivamente en lotes contra el servidor de Beeper.
+class ChatHistoryDownloader {
+  static bool _isDownloading = false;
+  static bool get isDownloading => _isDownloading;
+  static bool _cancelRequested = false;
+
+  static void cancel() {
+    _cancelRequested = true;
+  }
+
+  /// Descarga todo el historial de [room] y sus salas fusionadas si las hubiera.
+  static Future<int> downloadFullHistory({
+    required Room room,
+    HistoryDownloadProgressCallback? onProgress,
+    int batchSize = 100,
+    Duration delayBetweenBatches = const Duration(milliseconds: 80),
+  }) async {
+    if (_isDownloading) {
+      throw StateError('Una descarga de historial ya está en progreso.');
+    }
+
+    _isDownloading = true;
+    _cancelRequested = false;
+    int totalDownloaded = 0;
+
+    try {
+      // 1. Determinar salas a procesar: la principal y cualquier hermana vinculada
+      final isMerged = BeeperMergeUtils.isRoomMerged(room.id);
+      final roomsToProcess = <Room>[room];
+      if (isMerged) {
+        final siblings = BeeperMergeUtils.getSiblingRooms(room.id);
+        for (final sib in siblings) {
+          if (!roomsToProcess.any((r) => r.id == sib.id)) {
+            roomsToProcess.add(sib);
+          }
+        }
+      }
+
+      for (int i = 0; i < roomsToProcess.length; i++) {
+        if (_cancelRequested) break;
+
+        final targetRoom = roomsToProcess[i];
+        final roomName = targetRoom.getLocalizedDisplayname();
+
+        onProgress?.call(
+          downloadedCount: totalDownloaded,
+          currentRoomName: roomName,
+          isCompleted: false,
+        );
+
+        int roomDownloaded = 0;
+        int emptyBatchCount = 0;
+
+        while (!_cancelRequested) {
+          try {
+            // Si la sala no tiene token de paginación previo, intentamos inicializarlo
+            if (targetRoom.prev_batch == null) {
+              await targetRoom.getTimeline(limit: 20);
+            }
+
+            if (targetRoom.prev_batch == null) {
+              FileLogger.log('[ChatHistoryDownloader] prev_batch is null for ${targetRoom.id}. Finished.');
+              break;
+            }
+
+            final count = await targetRoom.requestHistory(
+              historyCount: batchSize,
+              direction: Direction.b,
+            );
+
+            if (count > 0) {
+              roomDownloaded += count;
+              totalDownloaded += count;
+              emptyBatchCount = 0;
+              onProgress?.call(
+                downloadedCount: totalDownloaded,
+                currentRoomName: roomName,
+                isCompleted: false,
+              );
+            } else {
+              emptyBatchCount++;
+              if (emptyBatchCount >= 2) {
+                // Llegamos al principio del historial de esta sala
+                break;
+              }
+            }
+
+            if (delayBetweenBatches.inMilliseconds > 0) {
+              await Future.delayed(delayBetweenBatches);
+            }
+          } catch (e) {
+            FileLogger.log('[ChatHistoryDownloader] Error requesting history for ${targetRoom.id}: $e');
+            // Si el error es de permiso o batch inválido, salir de esta sala
+            break;
+          }
+        }
+      }
+
+      onProgress?.call(
+        downloadedCount: totalDownloaded,
+        currentRoomName: 'Completado',
+        isCompleted: true,
+      );
+
+      return totalDownloaded;
+    } finally {
+      _isDownloading = false;
+      _cancelRequested = false;
+    }
+  }
+}
