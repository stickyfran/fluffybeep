+  Future<void> _loadForcePublicToggle() async {
+    final prefs = await SharedPreferences.getInstance();
+    if (mounted) {
+      setState(() {
+        _forcePublicPushGateway = prefs.getBool('beeper_force_public_push_gateway') ?? false;
+      });
+    }
+  }
