+                  height: 4,
+                  decoration: BoxDecoration(
+                    color: theme.dividerColor,
+                    borderRadius: BorderRadius.circular(2),
+                  ),
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 4.0),
+                child: Row(
+                  children: [
+                    const Icon(Icons.badge_outlined, color: Colors.indigoAccent),
+                    const SizedBox(width: 8),
+                    Expanded(
+                      child: Text(
+                        'Perfil Privado & Notas',
+                        style: theme.textTheme.titleMedium?.copyWith(
+                          fontWeight: FontWeight.bold,
+                        ),
+                      ),
+                    ),
+                    if (!_isLoading) ...[
+                      IconButton(
+                        tooltip: _isEditing ? 'Guardar' : 'Editar',
+                        icon: Icon(_isEditing ? Icons.check : Icons.edit_outlined),
+                        onPressed: _isEditing ? _saveCurrentProfile : () => setState(() => _isEditing = true),
+                      ),
+                      IconButton(
+                        tooltip: 'Analizar chat con IA',
+                        icon: _isAnalyzing
+                            ? const SizedBox(
+                                width: 20,
+                                height: 20,
+                                child: CircularProgressIndicator(strokeWidth: 2),
+                              )
+                            : const Icon(Icons.psychology_outlined, color: Colors.blueAccent),
+                        onPressed: _isAnalyzing ? null : _runAiAnalysis,
+                      ),
+                    ],
+                  ],
+                ),
+              ),
+              const Divider(height: 1),
+              // Contenido principal
+              Expanded(
+                child: _isLoading
+                    ? const Center(child: CircularProgressIndicator())
+                    : ListView(
+                        controller: scrollController,
+                        padding: const EdgeInsets.all(16),
+                        children: [
+                          _buildProfileCards(theme),
+                        ],
+                      ),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _buildProfileCards(ThemeData theme) {
+    if (_isEditing) {
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          TextField(
