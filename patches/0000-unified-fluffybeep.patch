+  static Future<Event?> findNextAudioEvent(Event currentEvent) async {
+    try {
+      final room = currentEvent.room;
+      final timeline = await room.getTimeline();
+      final allEvents = timeline.events;
+
+      final audioEvents = allEvents.where((e) {
+        if (e.messageType == MessageTypes.Audio) return true;
+        if (e.messageType == MessageTypes.File) {
+          final body = e.body.toLowerCase();
+          return body.endsWith('.ogg') ||
+              body.endsWith('.opus') ||
+              body.endsWith('.mp3') ||
+              body.endsWith('.m4a') ||
+              body.endsWith('.wav');
+        }
+        return false;
+      }).toList();
+
+      if (audioEvents.isEmpty) return null;
+
+      audioEvents.sort((a, b) {
+        final cmp = a.originServerTs.compareTo(b.originServerTs);
+        if (cmp != 0) return cmp;
+        final indexA = allEvents.indexOf(a);
+        final indexB = allEvents.indexOf(b);
+        return indexB.compareTo(indexA);
+      });
+
+      final currentIndex =
+          audioEvents.indexWhere((e) => e.eventId == currentEvent.eventId);
+      if (currentIndex != -1 && currentIndex + 1 < audioEvents.length) {
+        return audioEvents[currentIndex + 1];
+      }
+    } catch (e, s) {
+      Logs().e('Failed to find next audio event', e, s);
+    }
+    return null;
+  }
