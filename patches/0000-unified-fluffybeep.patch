diff --git a/lib/utils/beeper_bridge_utils.dart b/lib/utils/beeper_bridge_utils.dart
new file mode 100644
index 0000000..cfb34a9
--- /dev/null
+++ b/lib/utils/beeper_bridge_utils.dart
@@ -0,0 +1,135 @@
+import 'package:matrix/matrix.dart';
+
+class BeeperBridgeUtils {
+  /// Regular expression to detect Beeper bridge bots.
+  /// Matches pattern like: @whatsappbot:beeper.local
+  static final RegExp beeperBotRegex = RegExp(r'^@.*bot.*:beeper\..*$');
+
+  /// Checks if a given matrix user ID belongs to a Beeper bridge bot.
+  static bool isBeeperBot(String userId) {
+    return beeperBotRegex.hasMatch(userId);
+  }
+
+  /// Determines if a room is a "Fake DM" created by Beeper.
+  /// A Fake DM is defined as a room with exactly 3 members:
+  /// 1. The local user (You)
+  /// 2. The real contact
+  /// 3. The Beeper bridge bot
+  static bool isFakeDM(Room room) {
+    final members = room.getParticipants();
+    
+    // A Fake DM must have exactly 3 participants (including the local user)
+    if (members.length != 3) {
+      return false;
+    }
+
+    bool hasLocalUser = false;
+    bool hasBot = false;
+    bool hasRealContact = false;
+
+    final clientUserId = room.client.userID;
+
+    for (var member in members) {
+      if (member.id == clientUserId) {
+        hasLocalUser = true;
+      } else if (isBeeperBot(member.id)) {
+        hasBot = true;
+      } else {
+        hasRealContact = true;
+      }
+    }
+
+    return hasLocalUser && hasBot && hasRealContact;
+  }
+
+  /// Extracts the real contact from a Fake DM room.
+  /// Returns null if it's not a Fake DM or if the contact cannot be found.
+  static User? getRealContactFromFakeDM(Room room) {
+    if (!isFakeDM(room)) return null;
+
+    final members = room.getParticipants();
+    final clientUserId = room.client.userID;
+
+    for (var member in members) {
+      if (member.id != clientUserId && !isBeeperBot(member.id)) {
+        return member;
+      }
+    }
+    
+    return null;
+  }
+
+  static const Map<String, BeeperNetSpec> networkMap = {
+    'whatsapp': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'whatsappgo': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'instagram': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'instagramgo': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'telegram': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'telegramgo': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'signal': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'signalgo': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'discord': BeeperNetSpec('Discord', 0xFF5865F2),
+    'discordgo': BeeperNetSpec('Discord', 0xFF5865F2),
+    'facebook': BeeperNetSpec('Messenger', 0xFF00B2FF),
+    'facebookgo': BeeperNetSpec('Messenger', 0xFF00B2FF),
+    'slack': BeeperNetSpec('Slack', 0xFF4A154B),
+    'slackgo': BeeperNetSpec('Slack', 0xFF4A154B),
+    'googlechat': BeeperNetSpec('Google Chat', 0xFF34A853),
+    'googlechatgo': BeeperNetSpec('Google Chat', 0xFF34A853),
+  };
+
+  /// Returns the detected Beeper network for a given room, or null if none is found.
+  static BeeperNetwork? getRoomNetwork(Room room) {
+    final participants = room.getParticipants();
+    for (final p in participants) {
+      if (p.id == room.client.userID) continue;
+      final localpart = p.id.split(':').first;
+      if (localpart.startsWith('@')) {
+        final rawPrefix = localpart.substring(1);
+        for (final entry in networkMap.entries) {
+          if (rawPrefix.startsWith('${entry.key}_') || rawPrefix == '${entry.key}bot') {
+            return BeeperNetwork(entry.value.name, entry.value.colorHex, entry.key);
+          }
+        }
+      }
+    }
+    final directId = room.directChatMatrixID;
+    if (directId != null) {
+      final localpart = directId.split(':').first;
+      if (localpart.startsWith('@')) {
+        final rawPrefix = localpart.substring(1);
+        for (final entry in networkMap.entries) {
+          if (rawPrefix.startsWith('${entry.key}_') || rawPrefix == '${entry.key}bot') {
+            return BeeperNetwork(entry.value.name, entry.value.colorHex, entry.key);
+          }
+        }
+      }
+    }
+    return null;
+  }
+}
+
+class BeeperNetwork {
+  final String name;
+  final int colorHex;
+  final String key;
+  const BeeperNetwork(this.name, this.colorHex, this.key);
+}
+
+class BeeperNetSpec {
+  final String name;
+  final int colorHex;
+  const BeeperNetSpec(this.name, this.colorHex);
+}
+
+extension RoomBeeperExtension on Room {
+  String getBeeperDisplayname(MatrixLocalizations localizations) {
+    if (BeeperBridgeUtils.isFakeDM(this)) {
+      final contact = BeeperBridgeUtils.getRealContactFromFakeDM(this);
+      if (contact != null) {
+        return contact.calcDisplayname();
+      }
+    }
+    return getLocalizedDisplayname(localizations);
+  }
+}
diff --git a/lib/widgets/cache_refresh_overlay.dart b/lib/widgets/cache_refresh_overlay.dart
new file mode 100644
index 0000000..c685695
--- /dev/null
+++ b/lib/widgets/cache_refresh_overlay.dart
@@ -0,0 +1,187 @@
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:fluffychat/utils/beeper_bridge_utils.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+
+class CacheRefreshOverlay extends StatefulWidget {
+  final Client client;
+  final SharedPreferences store;
+  final Widget child;
+
+  const CacheRefreshOverlay({
+    required this.client,
+    required this.store,
+    required this.child,
+    super.key,
+  });
+
+  @override
+  State<CacheRefreshOverlay> createState() => _CacheRefreshOverlayState();
+}
+
+class _CacheRefreshOverlayState extends State<CacheRefreshOverlay> {
+  bool _isSyncingInitial = true;
+  int _processedRooms = 0;
+  int _totalRooms = 0;
+  String _currentRoomName = '';
+  bool _completed = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _startPrewarming();
+  }
+
+  Future<void> _startPrewarming() async {
+    // 1. Wait for initial sync to complete (so rooms list is loaded)
+    if (widget.client.prevBatch == null) {
+      await widget.client.onSync.stream
+          .firstWhere((syncUpdate) => widget.client.prevBatch != null);
+    }
+
+    if (!mounted) return;
+    setState(() {
+      _isSyncingInitial = false;
+      _totalRooms = widget.client.rooms.length;
+    });
+
+    final rooms = List<Room>.from(widget.client.rooms);
+    final devicePixelRatio = MediaQuery.of(context).devicePixelRatio;
+
+    for (final room in rooms) {
+      if (!mounted) return;
+      
+      final l10n = L10n.of(context);
+      final roomName = room.getBeeperDisplayname(MatrixLocals(l10n));
+
+      setState(() {
+        _currentRoomName = roomName;
+      });
+
+      // 2. Pre-cache avatar
+      final avatarUri = BeeperBridgeUtils.isFakeDM(room)
+          ? (room.avatar ?? BeeperBridgeUtils.getRealContactFromFakeDM(room)?.avatarUrl)
+          : room.avatar;
+
+      if (avatarUri != null) {
+        try {
+          await widget.client.downloadMxcCached(
+            avatarUri,
+            width: 48 * devicePixelRatio,
+            height: 48 * devicePixelRatio,
+            thumbnailMethod: ThumbnailMethod.scale,
+            isThumbnail: true,
+          );
+        } catch (_) {
+          // Ignore download errors to continue warming up remaining rooms
+        }
+      }
+
+      // 3. Pre-cache timeline history (fetch latest 30 messages)
+      try {
+        final timeline = await room.getTimeline();
+        await timeline.requestHistory(historyCount: 30);
+        timeline.cancelSubscriptions();
+      } catch (_) {
+        // Ignore timeline errors to continue warming up remaining rooms
+      }
+
+      if (!mounted) return;
+      setState(() {
+        _processedRooms++;
+      });
+    }
+
+    // 4. Mark cache refresh as completed
+    await widget.store.setBool('beeper_needs_cache_refresh', false);
+    if (!mounted) return;
+    setState(() {
+      _completed = true;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_completed) {
+      return widget.child;
+    }
+
+    final theme = Theme.of(context);
+    final progress = _totalRooms > 0 ? _processedRooms / _totalRooms : 0.0;
+
+    return Scaffold(
+      backgroundColor: theme.colorScheme.scrim.withOpacity(0.9),
+      body: Center(
+        child: Container(
+          width: 320,
+          padding: const EdgeInsets.all(24),
+          decoration: BoxDecoration(
+            color: theme.colorScheme.surface,
+            borderRadius: BorderRadius.circular(28),
+            boxShadow: [
+              BoxShadow(
+                color: Colors.black.withOpacity(0.2),
+                blurRadius: 16,
+                offset: const Offset(0, 8),
+              ),
+            ],
+          ),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              const SizedBox(height: 8),
+              Text(
+                "Calentando Cach├⌐...",
+                style: theme.textTheme.titleMedium?.copyWith(
+                  fontWeight: FontWeight.bold,
+                ),
+              ),
+              const SizedBox(height: 12),
+              Text(
+                "Estamos descargando tus avatares e historial de mensajes recientes para que tu scroll sea inmediato y offline.",
+                textAlign: TextAlign.center,
+                style: theme.textTheme.bodyMedium?.copyWith(
+                  color: theme.colorScheme.onSurfaceVariant,
+                ),
+              ),
+              const SizedBox(height: 24),
+              if (_isSyncingInitial) ...[
+                const CircularProgressIndicator.adaptive(),
+                const SizedBox(height: 16),
+                Text(
+                  "Sincronizando con el servidor...",
+                  style: theme.textTheme.bodySmall,
+                ),
+              ] else ...[
+                LinearProgressIndicator(
+                  value: progress,
+                  borderRadius: BorderRadius.circular(8),
+                  minHeight: 8,
+                ),
+                const SizedBox(height: 16),
+                Text(
+                  "Procesando ${_processedRooms} de ${_totalRooms} chats",
+                  style: theme.textTheme.bodyMedium?.copyWith(
+                    fontWeight: FontWeight.bold,
+                  ),
+                ),
+                const SizedBox(height: 8),
+                Text(
+                  _currentRoomName,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: theme.textTheme.bodySmall?.copyWith(
+                    color: theme.colorScheme.primary,
+                  ),
+                ),
+              ],
+              const SizedBox(height: 8),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
