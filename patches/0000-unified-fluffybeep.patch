+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:flutter_foreground_task/flutter_foreground_task.dart';
+
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/beeper_bridge_utils.dart';
+import 'package:fluffychat/utils/client_download_content_extension.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+
+class CacheRefreshOverlay extends StatefulWidget {
+  final Client client;
+  final SharedPreferences store;
+  final Widget child;
+
+  const CacheRefreshOverlay({
+    required this.client,
+    required this.store,
+    required this.child,
+    super.key,
+  });
+
+  @override
+  State<CacheRefreshOverlay> createState() => _CacheRefreshOverlayState();
+}
+
+class _CacheRefreshOverlayState extends State<CacheRefreshOverlay> {
+  bool _isSyncingInitial = true;
+  bool _initialCompleted = false;
+  bool _minimized = false;
+  int _processedRooms = 0;
+  int _totalRooms = 0;
+  String _currentRoomName = '';
+  bool _completed = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _startPrewarming();
+  }
+
+  DateTime _getMessageTimestamp(Room room) {
+    final event = room.lastEvent;
+    if (event != null) {
+      final type = event.type;
+      if (type == 'm.room.message' ||
+          type == 'm.room.encrypted' ||
+          type == 'm.sticker') {
+        return event.originServerTs;
+      }
+    }
+    
+    final events = room.timeline?.events;
+    if (events != null && events.isNotEmpty) {
+      for (var i = events.length - 1; i >= 0; i--) {
+        final ev = events[i];
+        final t = ev.type;
+        if (t == 'm.room.message' ||
+            t == 'm.room.encrypted' ||
+            t == 'm.sticker') {
+          return ev.originServerTs;
+        }
+      }
+    }
+
+    return room.latestEventReceivedTime;
+  }
+
+  Future<void> _startPrewarming() async {
+    final devicePixelRatio = MediaQuery.devicePixelRatioOf(context);
+    final l10n = L10n.of(context);
+
+    // 1. Wait for initial sync to complete (so rooms list is loaded)
+    if (widget.client.prevBatch == null) {
+      await widget.client.onSync.stream
+          .firstWhere((syncUpdate) => widget.client.prevBatch != null);
+    }
+
+    if (!mounted) return;
+    setState(() {
+      _isSyncingInitial = false;
+      _totalRooms = widget.client.rooms.length;
+    });
+
+    final rooms = List<Room>.from(widget.client.rooms);
+    // Sort rooms by actual messages recency (newest first)
+    rooms.sort((a, b) {
+      final aTime = _getMessageTimestamp(a);
+      final bTime = _getMessageTimestamp(b);
+      return bTime.compareTo(aTime);
+    });
+
+    // 2. Start Foreground Service on Android to prevent system kill
+    if (PlatformInfos.isAndroid) {
+      try {
+        FlutterForegroundTask.init(
+          androidNotificationOptions: AndroidNotificationOptions(
+            channelId: 'beeper_reinit_channel_id',
+            channelName: 'Beeper Re-sync',
+            channelDescription: 'Sincronizando chats de Beeper en segundo plano',
+            onlyAlertOnce: true,
+          ),
+          iosNotificationOptions: const IOSNotificationOptions(),
+          foregroundTaskOptions: ForegroundTaskOptions(
+            eventAction: ForegroundTaskEventAction.nothing(),
+          ),
+        );
+        await FlutterForegroundTask.startService(
+          notificationTitle: 'Re-sincronizando chats (Beeper)',
+          notificationText: 'Descargando mensajes recientes...',
+        );
+      } catch (e) {
+        debugPrint('Failed to start Foreground Service: $e');
+      }
+    }
+
+    int count = 0;
+    for (final room in rooms) {
+      if (!mounted) break;
+      
+      final roomName = room.getBeeperDisplayname(MatrixLocals(l10n));
+
+      setState(() {
+        _currentRoomName = roomName;
+      });
+
+      if (PlatformInfos.isAndroid) {
+        FlutterForegroundTask.updateService(
+          notificationTitle: 'Re-sincronizando chats: $count de $_totalRooms',
+          notificationText: roomName,
+        );
+      }
+
+      // Pre-cache avatar
+      final avatarUri = BeeperBridgeUtils.isFakeDM(room)
+          ? (room.avatar ?? BeeperBridgeUtils.getRealContactFromFakeDM(room)?.avatarUrl)
+          : room.avatar;
+
+      if (avatarUri != null) {
+        try {
+          await widget.client.downloadMxcCached(
+            avatarUri,
+            width: 48 * devicePixelRatio,
+            height: 48 * devicePixelRatio,
+            thumbnailMethod: ThumbnailMethod.scale,
+            isThumbnail: true,
+          );
+        } catch (_) {}
+      }
+
+      // Pre-cache timeline history (fetch latest 30 messages)
+      try {
+        final timeline = await room.getTimeline();
+        await timeline.requestHistory(historyCount: 30);
+        timeline.cancelSubscriptions();
+      } catch (_) {}
+
+      count++;
+      if (!mounted) break;
+      setState(() {
+        _processedRooms = count;
+      });
+
+      // 3. Once the first 100 most recent chats are warmed up, dismiss full-screen blocking overlay
+      if (count == 100 && !_initialCompleted) {
+        setState(() {
+          _initialCompleted = true;
+        });
+      }
+    }
+
+    // 4. Mark cache refresh as completed
+    await widget.store.setBool('beeper_needs_cache_refresh', false);
+    
+    if (PlatformInfos.isAndroid) {
+      try {
+        await FlutterForegroundTask.stopService();
+      } catch (_) {}
+    }
+
+    if (!mounted) return;
+    setState(() {
+      _completed = true;
+    });
+
+    ScaffoldMessenger.of(context).showSnackBar(
+      const SnackBar(content: Text('Re-sincronización de Beeper completada.')),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_completed) {
+      return widget.child;
+    }
+
+    if (_initialCompleted) {
+      // Background Phase: Render the main app, with a floating minimized progress banner.
+      return Stack(
+        children: [
+          widget.child,
+          if (!_minimized)
+            Positioned(
+              bottom: 16,
+              left: 16,
+              right: 16,
+              child: SafeArea(
+                child: Material(
+                  elevation: 8,
+                  borderRadius: BorderRadius.circular(16),
+                  color: Theme.of(context).cardColor,
+                  child: Container(
+                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+                    child: Row(
+                      children: [
+                        const SizedBox(
+                          width: 20,
+                          height: 20,
+                          child: CircularProgressIndicator(strokeWidth: 2.5),
+                        ),
+                        const SizedBox(width: 16),
+                        Expanded(
