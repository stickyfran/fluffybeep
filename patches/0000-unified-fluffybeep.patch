+                const SnackBar(content: Text('Iniciando re-solicitud de claves...')),
+              );
+              try {
+                await client.oneShotSync().catchError((_) {});
+                for (final room in client.rooms) {
+                  final timeline = await room.getTimeline();
+                  timeline.requestKeys(onlineKeyBackupOnly: false);
+                  final badEvents = timeline.events.where(
+                    (e) => e.messageType == MessageTypes.BadEncrypted,
+                  ).take(10);
+                  for (final event in badEvents) {
+                    final sessionId = event.content.tryGet<String>('session_id');
+                    final senderKey = event.content.tryGet<String>('sender_key');
+                    if (sessionId != null && senderKey != null) {
+                      await client.encryption?.keyManager.maybeAutoRequest(
+                        room.id, sessionId, senderKey,
+                      );
+                    }
+                  }
+                }
+                if (context.mounted) {
+                  ScaffoldMessenger.of(context).showSnackBar(
+                    const SnackBar(content: Text('Claves re-solicitadas exitosamente.')),
+                  );
+                }
+              } catch (e) {
+                if (context.mounted) {
+                  ScaffoldMessenger.of(context).showSnackBar(
+                    SnackBar(content: Text('Error al re-solicitar claves: $e')),
+                  );
+                }
+              }
+            },
