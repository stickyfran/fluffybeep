+    _tickNotifier.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    const size = 8.0;
+
+    return ValueListenableBuilder<int>(
+      valueListenable: _tickNotifier,
+      builder: (context, tick, _) {
+        return Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            for (var i = 1; i <= 3; i++)
+              AnimatedContainer(
+                duration: animationDuration * 1.5,
+                curve: FluffyThemes.animationCurve,
+                width: size,
+                height: tick == i ? size * 2 : size,
+                margin: EdgeInsets.symmetric(
+                  horizontal: 2,
+                  vertical: tick == i ? 4 : 8,
+                ),
+                decoration: BoxDecoration(
+                  borderRadius: BorderRadius.circular(size * 2),
+                  color: theme.colorScheme.secondary,
+                ),
+              ),
+          ],
+        );
+      },
+    );
+  }
+}
diff --git a/lib/pages/chat_details/chat_details_media_tabs.dart b/lib/pages/chat_details/chat_details_media_tabs.dart
new file mode 100644
index 0000000000000000000000000000000000000000..480e524f72fe45d6d02b904ba1a485ae1dbd9609
--- /dev/null
+++ b/lib/pages/chat_details/chat_details_media_tabs.dart
@@ -0,0 +1,368 @@
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/pages/chat_search/chat_search_files_tab.dart';
+import 'package:fluffychat/pages/chat_search/chat_search_images_tab.dart';
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import 'package:matrix/matrix.dart';
+import 'package:url_launcher/url_launcher.dart' as url_launcher;
+import 'package:fluffychat/pages/chat_search/search_footer.dart';
+
+class ChatDetailsMediaTabs extends StatefulWidget {
+  final Room room;
+  const ChatDetailsMediaTabs({required this.room, super.key});
+
+  @override
+  State<ChatDetailsMediaTabs> createState() => _ChatDetailsMediaTabsState();
+}
+
+class _ChatDetailsMediaTabsState extends State<ChatDetailsMediaTabs> with SingleTickerProviderStateMixin {
+  late TabController _tabController;
+
+  final List<Event> _imagesEvents = [];
+  String? _imagesNextBatch;
+  bool _imagesLoading = false;
+  bool _imagesEndReached = false;
+  DateTime? _imagesSearchedUntil;
+
+  final List<Event> _videosEvents = [];
+  String? _videosNextBatch;
+  bool _videosLoading = false;
+  bool _videosEndReached = false;
+  DateTime? _videosSearchedUntil;
+
+  final List<Event> _filesEvents = [];
+  String? _filesNextBatch;
+  bool _filesLoading = false;
+  bool _filesEndReached = false;
+  DateTime? _filesSearchedUntil;
+
+  final List<Event> _audiosEvents = [];
+  String? _audiosNextBatch;
+  bool _audiosLoading = false;
+  bool _audiosEndReached = false;
+  DateTime? _audiosSearchedUntil;
+
+  final List<Event> _linksEvents = [];
+  String? _linksNextBatch;
+  bool _linksLoading = false;
+  bool _linksEndReached = false;
+  DateTime? _linksSearchedUntil;
+
+  @override
+  void initState() {
+    super.initState();
+    _tabController = TabController(length: 5, vsync: this);
+    _tabController.addListener(_onTabChanged);
+    _loadImages();
+  }
+
+  @override
+  void dispose() {
+    _tabController.dispose();
+    super.dispose();
+  }
+
+  void _onTabChanged() {
+    if (_tabController.index == 0 && _imagesEvents.isEmpty && !_imagesLoading && !_imagesEndReached) {
+      _loadImages();
+    } else if (_tabController.index == 1 && _videosEvents.isEmpty && !_videosLoading && !_videosEndReached) {
+      _loadVideos();
+    } else if (_tabController.index == 2 && _filesEvents.isEmpty && !_filesLoading && !_filesEndReached) {
+      _loadFiles();
+    } else if (_tabController.index == 3 && _audiosEvents.isEmpty && !_audiosLoading && !_audiosEndReached) {
+      _loadAudios();
+    } else if (_tabController.index == 4 && _linksEvents.isEmpty && !_linksLoading && !_linksEndReached) {
+      _loadLinks();
+    }
+  }
+
+  Future<void> _loadImages() async {
+    if (_imagesLoading || _imagesEndReached) return;
+    setState(() => _imagesLoading = true);
+    try {
+      final res = await widget.room.searchEvents(
+        searchFunc: (e) => e.messageType == MessageTypes.Image,
+        nextBatch: _imagesNextBatch,
+      );
+      if (mounted) {
+        setState(() {
+          _imagesEvents.addAll(res.events);
+          _imagesNextBatch = res.nextBatch;
+          _imagesEndReached = res.nextBatch == null || res.events.isEmpty;
+          _imagesSearchedUntil = res.searchedUntil ?? (res.events.isNotEmpty ? res.events.last.originServerTs : null);
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _imagesLoading = false);
+    }
+  }
+
+  Future<void> _loadVideos() async {
+    if (_videosLoading || _videosEndReached) return;
+    setState(() => _videosLoading = true);
+    try {
+      final res = await widget.room.searchEvents(
+        searchFunc: (e) => e.messageType == MessageTypes.Video,
+        nextBatch: _videosNextBatch,
+      );
+      if (mounted) {
+        setState(() {
+          _videosEvents.addAll(res.events);
+          _videosNextBatch = res.nextBatch;
+          _videosEndReached = res.nextBatch == null || res.events.isEmpty;
+          _videosSearchedUntil = res.searchedUntil ?? (res.events.isNotEmpty ? res.events.last.originServerTs : null);
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _videosLoading = false);
+    }
+  }
+
+  Future<void> _loadFiles() async {
+    if (_filesLoading || _filesEndReached) return;
+    setState(() => _filesLoading = true);
+    try {
+      final res = await widget.room.searchEvents(
+        searchFunc: (e) {
+          if (e.messageType != MessageTypes.File) return false;
+          final body = e.body.toLowerCase();
+          return !body.endsWith('.ogg') &&
+              !body.endsWith('.opus') &&
+              !body.endsWith('.mp3') &&
+              !body.endsWith('.m4a') &&
+              !body.endsWith('.wav');
+        },
+        nextBatch: _filesNextBatch,
+      );
+      if (mounted) {
+        setState(() {
+          _filesEvents.addAll(res.events);
+          _filesNextBatch = res.nextBatch;
+          _filesEndReached = res.nextBatch == null || res.events.isEmpty;
+          _filesSearchedUntil = res.searchedUntil ?? (res.events.isNotEmpty ? res.events.last.originServerTs : null);
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _filesLoading = false);
+    }
+  }
+
+  Future<void> _loadAudios() async {
+    if (_audiosLoading || _audiosEndReached) return;
+    setState(() => _audiosLoading = true);
+    try {
+      final res = await widget.room.searchEvents(
+        searchFunc: (e) {
+          if (e.messageType == MessageTypes.Audio) return true;
+          if (e.messageType == MessageTypes.File) {
+            final body = e.body.toLowerCase();
+            return body.endsWith('.ogg') ||
+                body.endsWith('.opus') ||
+                body.endsWith('.mp3') ||
+                body.endsWith('.m4a') ||
+                body.endsWith('.wav');
+          }
+          return false;
+        },
+        nextBatch: _audiosNextBatch,
+      );
+      if (mounted) {
+        setState(() {
+          _audiosEvents.addAll(res.events);
+          _audiosNextBatch = res.nextBatch;
+          _audiosEndReached = res.nextBatch == null || res.events.isEmpty;
+          _audiosSearchedUntil = res.searchedUntil ?? (res.events.isNotEmpty ? res.events.last.originServerTs : null);
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _audiosLoading = false);
+    }
+  }
+
+  Future<void> _loadLinks() async {
+    if (_linksLoading || _linksEndReached) return;
+    setState(() => _linksLoading = true);
+    try {
+      final res = await widget.room.searchEvents(
+        searchFunc: (e) {
+          if (!{MessageTypes.Text, MessageTypes.Notice}.contains(e.messageType)) return false;
+          final body = e.body;
+          return body.contains('http://') || body.contains('https://');
+        },
+        nextBatch: _linksNextBatch,
+      );
+      if (mounted) {
+        setState(() {
+          _linksEvents.addAll(res.events);
+          _linksNextBatch = res.nextBatch;
+          _linksEndReached = res.nextBatch == null || res.events.isEmpty;
+          _linksSearchedUntil = res.searchedUntil ?? (res.events.isNotEmpty ? res.events.last.originServerTs : null);
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _linksLoading = false);
+    }
+  }
+
+  bool _isExpanded = false;
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Row(
+          children: [
+            Expanded(
+              child: TabBar(
+                controller: _tabController,
+                labelColor: Theme.of(context).colorScheme.primary,
+                unselectedLabelColor: Theme.of(context).colorScheme.onSurfaceVariant,
+                isScrollable: true,
+                tabAlignment: TabAlignment.start,
+                tabs: [
+                  const Tab(text: 'Imágenes'),
+                  const Tab(text: 'Videos'),
+                  Tab(text: L10n.of(context).files),
+                  const Tab(text: 'Audios'),
+                  const Tab(text: 'Links'),
+                ],
+              ),
+            ),
+            IconButton(
+              tooltip: _isExpanded ? 'Reducir altura' : 'Expandir galería',
+              icon: Icon(
+                _isExpanded ? Icons.unfold_less_outlined : Icons.unfold_more_outlined,
+                size: 20,
+              ),
+              onPressed: () => setState(() => _isExpanded = !_isExpanded),
+            ),
+            IconButton(
+              tooltip: 'Abrir multimedia en pantalla completa',
+              icon: const Icon(Icons.open_in_new_outlined, size: 18),
+              onPressed: () => context.go('/rooms/${widget.room.id}/search'),
+            ),
+          ],
+        ),
+        AnimatedContainer(
+          duration: const Duration(milliseconds: 250),
+          curve: Curves.easeInOut,
+          height: _isExpanded ? 600.0 : 250.0, // Moderate height allows smooth page scrolling without trapping the finger
+          child: TabBarView(
+            controller: _tabController,
+            children: [
+              ChatSearchImagesTab(
+                room: widget.room,
+                events: _imagesEvents,
+                onStartSearch: _loadImages,
+                endReached: _imagesEndReached,
+                isLoading: _imagesLoading,
+                searchedUntil: _imagesSearchedUntil,
+                filterMessageType: MessageTypes.Image,
+              ),
+              ChatSearchImagesTab(
+                room: widget.room,
+                events: _videosEvents,
+                onStartSearch: _loadVideos,
+                endReached: _videosEndReached,
+                isLoading: _videosLoading,
+                searchedUntil: _videosSearchedUntil,
+                filterMessageType: MessageTypes.Video,
+              ),
+              ChatSearchFilesTab(
+                room: widget.room,
+                events: _filesEvents,
+                onStartSearch: _loadFiles,
+                endReached: _filesEndReached,
+                isLoading: _filesLoading,
+                searchedUntil: _filesSearchedUntil,
+              ),
+              ChatSearchFilesTab(
+                room: widget.room,
+                events: _audiosEvents,
+                onStartSearch: _loadAudios,
+                endReached: _audiosEndReached,
+                isLoading: _audiosLoading,
+                searchedUntil: _audiosSearchedUntil,
+              ),
+              _LinksTab(
+                room: widget.room,
+                events: _linksEvents,
+                onStartSearch: _loadLinks,
+                endReached: _linksEndReached,
+                isLoading: _linksLoading,
+                searchedUntil: _linksSearchedUntil,
+              ),
+            ],
+          ),
+        ),
+      ],
+    );
+  }
+}
+
+class _LinksTab extends StatelessWidget {
+  final Room room;
+  final List<Event> events;
+  final void Function() onStartSearch;
+  final bool endReached, isLoading;
+  final DateTime? searchedUntil;
+
+  const _LinksTab({
+    required this.room,
+    required this.events,
+    required this.onStartSearch,
+    required this.endReached,
+    required this.isLoading,
+    required this.searchedUntil,
+  });
+
+  static final RegExp _urlRegExp = RegExp(r'(https?:\/\/[^\s]+)');
+
+  @override
+  Widget build(BuildContext context) {
+    return ListView.builder(
+      itemCount: events.length + 1,
+      itemBuilder: (context, i) {
+        if (i == events.length) {
+          return SearchFooter(
+            endReached: endReached,
+            isLoading: isLoading,
+            onStartSearch: onStartSearch,
+            searchedUntil: searchedUntil,
+          );
+        }
+        
+        final event = events[i];
+        final body = event.body;
+        final match = _urlRegExp.firstMatch(body);
+        final urlStr = match?.group(0) ?? '';
+        
+        if (urlStr.isEmpty) return const SizedBox.shrink();
+
+        return ListTile(
+          leading: const CircleAvatar(child: Icon(Icons.link)),
+          title: Text(
+            urlStr,
+            maxLines: 1,
+            overflow: TextOverflow.ellipsis,
+            style: const TextStyle(color: Colors.blueAccent),
+          ),
+          subtitle: Text(
+            body.replaceAll(urlStr, '').trim(),
+            maxLines: 1,
+            overflow: TextOverflow.ellipsis,
+          ),
+          trailing: IconButton(
+            icon: const Icon(Icons.forum_outlined),
+            tooltip: 'Ir al mensaje',
+            onPressed: () => context.go(
+              '/rooms/${room.id}?event=${event.eventId}',
+            ),
+          ),
+          onTap: () => url_launcher.launchUrl(Uri.parse(urlStr)),
+        );
+      },
+    );
+  }
+}
