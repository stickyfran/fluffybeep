--- /dev/null
+++ b/lib/utils/encryption_health_monitor.dart
@@ -0,0 +1,83 @@
+import 'dart:async';
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:matrix/encryption.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:go_router/go_router.dart';
+
+class EncryptionHealthMonitor {
+  static final EncryptionHealthMonitor _instance = EncryptionHealthMonitor._internal();
+  factory EncryptionHealthMonitor() => _instance;
+  EncryptionHealthMonitor._internal();
+
+  Timer? _timer;
+  Client? _client;
+  BuildContext? _context;
+  bool _isPrompting = false;
+
+  void start(Client client, BuildContext context) {
+    _client = client;
+    _context = context;
+    _timer?.cancel();
+    // Check every 5 minutes
+    _timer = Timer.periodic(const Duration(minutes: 5), (_) => _checkHealth());
+    _checkHealth(); // Initial check
+  }
+
+  void stop() {
+    _timer?.cancel();
+    _timer = null;
+    _client = null;
+    _context = null;
+  }
+
+  Future<void> _checkHealth() async {
+    if (_client == null || _context == null || !_context!.mounted || _isPrompting) return;
+    final state = await _client!.getCryptoIdentityState();
+    
+    if (state.initialized && !state.connected) {
+      // Try to auto-restore using secure storage
+      final supportsSecureStorage = PlatformInfos.isMobile || PlatformInfos.isDesktop;
+      if (supportsSecureStorage) {
+        try {
+          final keyFromSecureStorage = await const FlutterSecureStorage().read(
+            key: 'ssss_recovery_key_${_client!.userID}',
+          );
+          if (keyFromSecureStorage != null) {
+            await _client!.restoreCryptoIdentity(keyFromSecureStorage);
+            final newState = await _client!.getCryptoIdentityState();
+            if (newState.connected) {
+              Logs().i('EncryptionHealthMonitor: Successfully auto-restored crypto identity from secure storage.');
+              return;
+            }
+          }
+        } catch (e) {
+          Logs().w('EncryptionHealthMonitor: Failed to auto-restore crypto identity', e);
+        }
+      }
+
+      // If auto-restore failed, prompt user
+      _isPrompting = true;
+      if (_context!.mounted) {
+        ScaffoldMessenger.of(_context!).showSnackBar(
+          SnackBar(
+            content: const Text('Problema con el cifrado de extremo a extremo. Por favor verifica tu sesión.'),
+            action: SnackBarAction(
+              label: 'Verificar',
+              onPressed: () {
+                _context!.go('/bootstrap');
+              },
+            ),
+            duration: const Duration(seconds: 10),
+          ),
+        );
+      }
+      
+      // Cooldown before prompting again
+      Future.delayed(const Duration(minutes: 10), () {
+        _isPrompting = false;
+      });
+    }
+  }
+}
