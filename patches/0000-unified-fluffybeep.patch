+
+class _CombinedRailItem {
+  final Room? space;
+  final BeeperNetwork? network;
+  final String? tag;
+  final String? labelUuid;
+  final String? labelTitle;
+  final String? labelEmoji;
+  final bool isSpace;
+  final bool isNetwork;
+  final bool isBeeperLabel;
+
+  _CombinedRailItem.space(this.space)
+      : network = null,
+        tag = null,
+        labelUuid = null,
+        labelTitle = null,
+        labelEmoji = null,
+        isSpace = true,
+        isNetwork = false,
+        isBeeperLabel = false;
+
+  _CombinedRailItem.network(this.network)
+      : space = null,
+        tag = null,
+        labelUuid = null,
+        labelTitle = null,
+        labelEmoji = null,
+        isSpace = false,
+        isNetwork = true,
+        isBeeperLabel = false;
+
+  _CombinedRailItem.tag(this.tag)
+      : space = null,
+        network = null,
+        labelUuid = null,
+        labelTitle = null,
+        labelEmoji = null,
+        isSpace = false,
+        isNetwork = false,
+        isBeeperLabel = false;
+
+  _CombinedRailItem.beeperLabel(this.labelUuid, this.labelTitle, {String? emoji})
+      : space = null,
+        network = null,
+        tag = null,
+        labelEmoji = emoji,
+        isSpace = false,
+        isNetwork = false,
+        isBeeperLabel = true;
+}
