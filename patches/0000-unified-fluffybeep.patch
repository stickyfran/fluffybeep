+              },
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  void _showTagMenu(
+    BuildContext context,
+    String tag,
+    Client client,
+  ) {
+    final displayName = tag.replaceFirst('u.', '');
+    showModalBottomSheet(
+      context: context,
+      builder: (context) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ListTile(
+              leading: const Icon(Icons.edit_outlined),
+              title: const Text('Editar etiqueta'),
+              onTap: () async {
+                Navigator.of(context).pop();
+                final textController = TextEditingController(text: displayName);
+                final newName = await showDialog<String>(
+                  context: context,
+                  builder: (context) => AlertDialog(
+                    title: const Text('Editar etiqueta'),
+                    content: TextField(
+                      controller: textController,
+                      autofocus: true,
+                      decoration: const InputDecoration(labelText: 'Nombre de la etiqueta'),
+                    ),
+                    actions: [
+                      TextButton(
+                        onPressed: () => Navigator.of(context).pop(),
+                        child: const Text('Cancelar'),
+                      ),
+                      ElevatedButton(
+                        onPressed: () => Navigator.of(context).pop(textController.text.trim()),
+                        child: const Text('Guardar'),
+                      ),
+                    ],
+                  ),
+                );
+                if (newName != null && newName.isNotEmpty && newName != displayName) {
+                  final newTag = 'u.$newName';
+                  for (final room in client.rooms) {
+                    if (room.tags.containsKey(tag)) {
+                      await room.addTag(newTag);
+                      await room.removeTag(tag);
+                    }
+                  }
+                  if (mounted) setState(() {});
+                }
+              },
+            ),
+            ListTile(
+              leading: const Icon(Icons.delete_outline, color: Colors.red),
+              title: const Text('Eliminar etiqueta', style: TextStyle(color: Colors.red)),
+              onTap: () async {
+                final confirmed = await showOkCancelAlertDialog(
+                  context: context,
+                  title: '¿Eliminar etiqueta?',
+                  message: '¿Estás seguro de que quieres eliminar la etiqueta "$displayName"? Esta acción eliminará la etiqueta de todos tus chats.',
+                  okLabel: 'Eliminar',
+                  cancelLabel: 'Cancelar',
+                  isDestructive: true,
+                );
+                if (confirmed == OkCancelResult.ok) {
+                  final navigator = Navigator.of(context);
+                  for (final room in client.rooms) {
+                    if (room.tags.containsKey(tag)) {
+                      await room.removeTag(tag);
+                    }
