+// SPDX-FileCopyrightText: 2024-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+
+class ScheduledTimePickerDialog extends StatelessWidget {
+  const ScheduledTimePickerDialog({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final now = DateTime.now();
+
+    final in30Minutes = now.add(const Duration(minutes: 30));
+    final in1Hour = now.add(const Duration(hours: 1));
+    final tomorrow9am = DateTime(now.year, now.month, now.day + 1, 9, 0);
+
+    return AlertDialog(
+      title: Row(
+        children: [
+          Icon(Icons.schedule, color: theme.colorScheme.primary),
+          const SizedBox(width: 10),
+          const Text('Programar mensaje'),
+        ],
+      ),
+      content: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            ListTile(
+              dense: true,
+              leading: const Icon(Icons.timer_outlined),
+              title: const Text('En 30 minutos'),
+              subtitle: Text(DateFormat.jm().format(in30Minutes)),
+              onTap: () => Navigator.of(context).pop(in30Minutes),
+            ),
+            ListTile(
+              dense: true,
+              leading: const Icon(Icons.hourglass_bottom_outlined),
+              title: const Text('En 1 hora'),
+              subtitle: Text(DateFormat.jm().format(in1Hour)),
+              onTap: () => Navigator.of(context).pop(in1Hour),
+            ),
+            ListTile(
+              dense: true,
+              leading: const Icon(Icons.wb_sunny_outlined),
+              title: const Text('Mañana por la mañana'),
+              subtitle: Text(
+                'Mañana, ${DateFormat.jm().format(tomorrow9am)}',
+              ),
+              onTap: () => Navigator.of(context).pop(tomorrow9am),
+            ),
+            const Divider(),
+            ListTile(
+              dense: true,
+              leading: const Icon(Icons.calendar_month_outlined),
+              title: const Text('Elegir fecha y hora...'),
+              onTap: () async {
+                final pickedDate = await showDatePicker(
+                  context: context,
+                  initialDate: now,
+                  firstDate: now,
+                  lastDate: now.add(const Duration(days: 365)),
+                );
+                if (pickedDate == null || !context.mounted) return;
+
+                final pickedTime = await showTimePicker(
+                  context: context,
+                  initialTime: TimeOfDay.fromDateTime(
+                    now.add(const Duration(minutes: 15)),
+                  ),
+                );
+                if (pickedTime == null || !context.mounted) return;
+
+                final finalDateTime = DateTime(
+                  pickedDate.year,
+                  pickedDate.month,
+                  pickedDate.day,
+                  pickedTime.hour,
+                  pickedTime.minute,
+                );
+
+                if (finalDateTime.isBefore(DateTime.now())) {
+                  ScaffoldMessenger.of(context).showSnackBar(
+                    const SnackBar(
+                      content: Text('La fecha seleccionada debe ser en el futuro.'),
+                    ),
+                  );
+                  return;
+                }
+
+                Navigator.of(context).pop(finalDateTime);
+              },
+            ),
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cancelar'),
+        ),
+      ],
+    );
+  }
+}
