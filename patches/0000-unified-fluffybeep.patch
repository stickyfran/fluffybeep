+class _LruMemoryCache {
+  final Map<String, Uint8List> _map = {};
+  final List<String> _keysOrder = [];
+  int _currentSizeBytes = 0;
+  static const int _maxSizeBytes = 30 * 1024 * 1024; // 30 MB
+
+  Uint8List? get(String key) {
+    if (!_map.containsKey(key)) return null;
+    _keysOrder.remove(key);
+    _keysOrder.add(key);
+    return _map[key];
+  }
+
+  void put(String key, Uint8List val) {
+    if (_map.containsKey(key)) {
+      _currentSizeBytes -= _map[key]!.length;
+      _keysOrder.remove(key);
+    }
+    _map[key] = val;
+    _keysOrder.add(key);
+    _currentSizeBytes += val.length;
+
+    while (_currentSizeBytes > _maxSizeBytes && _keysOrder.isNotEmpty) {
+      final oldestKey = _keysOrder.removeAt(0);
+      final removedVal = _map.remove(oldestKey);
+      if (removedVal != null) {
+        _currentSizeBytes -= removedVal.length;
+      }
+    }
+  }
+
+  void clear() {
+    _map.clear();
+    _keysOrder.clear();
+    _currentSizeBytes = 0;
+  }
+}
