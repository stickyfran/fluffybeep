new file mode 100644
index 0000000..a4520c6
--- /dev/null
+++ b/lib/pages/settings_tags/settings_tags.dart
@@ -0,0 +1,141 @@
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/widgets/matrix.dart';
+import 'package:fluffychat/widgets/adaptive_dialogs/show_ok_cancel_alert_dialog.dart';
+import 'package:fluffychat/widgets/adaptive_dialogs/show_text_input_dialog.dart';
+
+class SettingsTags extends StatefulWidget {
+  const SettingsTags({super.key});
+
+  @override
+  State<SettingsTags> createState() => _SettingsTagsState();
+}
+
+class _SettingsTagsState extends State<SettingsTags> {
+  @override
+  Widget build(BuildContext context) {
+    final client = Matrix.of(context).client;
+    final theme = Theme.of(context);
+
+    return Scaffold(
+      appBar: AppBar(
+        title: const Text('Etiquetas de Matrix'),
+      ),
+      body: StreamBuilder(
+        stream: client.onSync.stream.where((s) => s.hasRoomUpdate),
+        builder: (context, _) {
+          final customTags = <String>{};
+          for (final room in client.rooms) {
+            for (final tag in room.tags.keys) {
+              if (tag.startsWith('u.')) {
+                customTags.add(tag);
+              }
+            }
+          }
+          final tagsList = customTags.toList()..sort();
+
+          if (tagsList.isEmpty) {
+            return Center(
+              child: Padding(
+                padding: const EdgeInsets.all(16.0),
+                child: Text(
+                  'No tienes etiquetas de Matrix creadas.',
+                  style: theme.textTheme.bodyLarge?.copyWith(
+                    color: theme.colorScheme.outline,
+                  ),
+                ),
+              ),
+            );
+          }
+
+          return ListView.builder(
+            itemCount: tagsList.length,
+            itemBuilder: (context, index) {
+              final tag = tagsList[index];
+              final displayName = tag.replaceFirst('u.', '');
+
+              return ListTile(
+                leading: const Icon(Icons.label_outline),
+                title: Text(displayName),
+                trailing: Row(
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    IconButton(
+                      icon: const Icon(Icons.edit_outlined),
+                      onPressed: () => _editTag(tag, displayName, client),
+                      tooltip: 'Editar etiqueta',
+                    ),
+                    IconButton(
+                      icon: const Icon(Icons.delete_outline, color: Colors.red),
+                      onPressed: () => _deleteTag(tag, displayName, client),
+                      tooltip: 'Eliminar etiqueta',
+                    ),
+                  ],
+                ),
+              );
+            },
+          );
+        },
+      ),
+    );
+  }
+
+  Future<void> _editTag(String oldTag, String currentName, Client client) async {
+    final newName = await showTextInputDialog(
+      context: context,
+      title: 'Editar etiqueta',
+      okLabel: 'Guardar',
+      cancelLabel: 'Cancelar',
+      initialText: currentName,
+    );
+
+    if (newName != null && newName.trim().isNotEmpty && newName.trim() != currentName) {
+      final newTag = 'u.${newName.trim()}';
+      final scaffoldMessenger = ScaffoldMessenger.of(context);
+      
+      for (final room in client.rooms) {
+        if (room.tags.containsKey(oldTag)) {
+          try {
+            await room.addTag(newTag);
+            await room.removeTag(oldTag);
+          } catch (e) {
+            // Logs or silent fail
+          }
+        }
+      }
+
+      scaffoldMessenger.showSnackBar(
+        SnackBar(content: Text('Etiqueta cambiada a "$newName"')),
+      );
+    }
+  }
+
+  Future<void> _deleteTag(String tag, String displayName, Client client) async {
+    final consent = await showOkCancelAlertDialog(
+      context: context,
+      title: '¿Eliminar etiqueta?',
+      message: '¿Estás seguro de que quieres eliminar la etiqueta "$displayName" de todos los chats? Esta acción no se puede deshacer.',
+      okLabel: 'Eliminar',
+      cancelLabel: 'Cancelar',
+      isDestructive: true,
+    );
+
+    if (consent == OkCancelResult.ok) {
+      final scaffoldMessenger = ScaffoldMessenger.of(context);
+      for (final room in client.rooms) {
+        if (room.tags.containsKey(tag)) {
+          try {
+            await room.removeTag(tag);
+          } catch (e) {
+            // Silent
+          }
+        }
+      }
+
+      scaffoldMessenger.showSnackBar(
+        SnackBar(content: Text('Etiqueta "$displayName" eliminada')),
+      );
+    }
+  }
+}
