+class LabelSoundsDialog extends StatefulWidget {
+  final Client client;
+  const LabelSoundsDialog({required this.client, super.key});
+
+  @override
+  State<LabelSoundsDialog> createState() => _LabelSoundsDialogState();
+}
+
+class _LabelSoundsDialogState extends State<LabelSoundsDialog> {
+  Map<String, String> _sounds = {};
+  bool _loading = true;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadSounds();
+  }
+
+  Future<void> _loadSounds() async {
+    final prefs = await SharedPreferences.getInstance();
+    final keys = prefs.getKeys().where((k) => k.startsWith('beeper_sound_'));
+    final sounds = <String, String>{};
+    for (final k in keys) {
+      sounds[k.replaceFirst('beeper_sound_', '')] = prefs.getString(k) ?? 'default';
+    }
+    setState(() {
+      _sounds = sounds;
+      _loading = false;
+    });
+  }
+
+  Future<void> _setSound(String labelKey, String sound) async {
+    final prefs = await SharedPreferences.getInstance();
+    if (sound == 'default') {
+      await prefs.remove('beeper_sound_$labelKey');
+    } else {
+      await prefs.setString('beeper_sound_$labelKey', sound);
+    }
+    _loadSounds();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_loading) {
+      return const AlertDialog(
+        content: SizedBox(
+          height: 100,
+          child: Center(child: CircularProgressIndicator.adaptive()),
+        ),
+      );
+    }
+
+    final theme = Theme.of(context);
+    final beeperLabels = BeeperBridgeUtils.getBeeperLabels(widget.client);
+    
+    final items = <Map<String, String>>[];
+    
+    BeeperBridgeUtils.networkMap.forEach((key, spec) {
+      final baseKey = BeeperBridgeUtils.getBaseNetworkKey(key);
+      if (!items.any((i) => i['key'] == baseKey)) {
+        items.add({
+          'key': baseKey,
+          'title': spec.name,
+          'type': 'network',
+        });
+      }
+    });
+
+    beeperLabels.forEach((uuid, data) {
+      if (uuid == '_hidden_networks') return;
+      if (data is Map) {
+        items.add({
+          'key': uuid,
+          'title': data['title']?.toString() ?? 'Etiqueta',
+          'type': 'label',
+        });
+      }
+    });
+
+    return AlertDialog(
+      title: const Text('Sonidos por Label/Red'),
+      content: SizedBox(
+        width: double.maxFinite,
+        height: 400,
+        child: ListView.builder(
+          shrinkWrap: true,
+          itemCount: items.length,
+          itemBuilder: (context, index) {
+            final item = items[index];
+            final key = item['key']!;
+            final title = item['title']!;
+            final currentSound = _sounds[key] ?? 'default';
+
+            return ListTile(
+              title: Text(title),
+              subtitle: Text('Sonido: ${currentSound == 'default' ? 'Predeterminado' : currentSound}'),
+              trailing: const Icon(Icons.music_note_outlined),
+              onTap: () => _selectSoundForLabel(key, title, currentSound),
+            );
+          },
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cerrar'),
+        ),
+      ],
+    );
+  }
+
+  void _selectSoundForLabel(String labelKey, String labelTitle, String currentSound) {
+    showDialog(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text('Sonido para $labelTitle'),
+        content: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            RadioListTile<String>(
+              title: const Text('Predeterminado'),
+              value: 'default',
+              groupValue: currentSound,
+              onChanged: (val) {
+                _setSound(labelKey, val!);
+                Navigator.of(context).pop();
+              },
+            ),
+            RadioListTile<String>(
+              title: const Text('Notificación (custom)'),
+              value: 'notification',
+              groupValue: currentSound,
+              onChanged: (val) {
+                _setSound(labelKey, val!);
+                Navigator.of(context).pop();
+              },
+            ),
+            RadioListTile<String>(
+              title: const Text('Llamada (custom)'),
+              value: 'call',
+              groupValue: currentSound,
+              onChanged: (val) {
+                _setSound(labelKey, val!);
+                Navigator.of(context).pop();
+              },
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
