+                    ),
+                    child: Row(
+                      mainAxisSize: .min,
+                      children: <Widget>[
+                        SizedBox(
+                          width: buttonSize,
+                          height: buttonSize,
+                          child: status == AudioPlayerStatus.downloading
+                              ? CircularProgressIndicator(
+                                  strokeWidth: 2,
+                                  color: widget.color,
+                                  value: _downloadProgress,
+                                )
+                              : InkWell(
+                                  borderRadius: BorderRadius.circular(64),
+                                  onLongPress: () =>
+                                      widget.event.saveFile(context),
+                                  onTap: _onButtonTap,
+                                  child: Material(
+                                    color: widget.color.withAlpha(64),
+                                    borderRadius: BorderRadius.circular(64),
+                                    child: Icon(
