+    this.onLongPress,
+    this.onForget,
+    this.filter,
+    this.space,
+    super.key,
+  });
+
+  @override
+  State<ChatListItem> createState() => _ChatListItemState();
+}
+
+class _ChatListItemState extends State<ChatListItem>
+    with AutomaticKeepAliveClientMixin {
+  Future<void>? _loadHeroUsersFuture;
+  Future<String>? _calcLocalizedBodyFuture;
+
+  @override
+  bool get wantKeepAlive => false;
+
+  @override
+  void initState() {
+    super.initState();
+    _initHeroFuture();
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _initLocalizedBodyFuture();
+  }
+
+  @override
+  void didUpdateWidget(ChatListItem oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.room != widget.room) {
+      _initHeroFuture();
+      _initLocalizedBodyFuture();
+    } else {
+      final cachedRealEvent = BeeperBridgeUtils.lastRealMessageCache[widget.room.id];
+      final lastEvent = cachedRealEvent ?? (widget.room.lastEvent?.type.startsWith('com.beeper') == true ? null : widget.room.lastEvent);
+      final oldCachedRealEvent = BeeperBridgeUtils.lastRealMessageCache[oldWidget.room.id];
+      final oldLastEvent = oldCachedRealEvent ?? (oldWidget.room.lastEvent?.type.startsWith('com.beeper') == true ? null : oldWidget.room.lastEvent);
+
+      if (lastEvent?.eventId != oldLastEvent?.eventId ||
+          lastEvent?.type != oldLastEvent?.type ||
+          lastEvent?.redacted != oldLastEvent?.redacted) {
+        _initLocalizedBodyFuture();
+      }
+    }
+  }
+
+  void _initHeroFuture() {
+    _loadHeroUsersFuture = widget.room.name.isEmpty ? widget.room.loadHeroUsers() : null;
+  }
+
+  void _initLocalizedBodyFuture() {
+    final beeperData = BeeperBridgeUtils.getRoomData(widget.room);
+    final cachedRealEvent = BeeperBridgeUtils.lastRealMessageCache[widget.room.id];
+    final lastEvent = cachedRealEvent ?? (widget.room.lastEvent?.type.startsWith('com.beeper') == true ? null : widget.room.lastEvent);
+    final isBeeperFakeDM = beeperData.isFakeDM;
+    final directChatMatrixId = widget.room.directChatMatrixID;
+    final isDirectChat = directChatMatrixId != null || isBeeperFakeDM;
+    final needLastEventSender =
+        lastEvent != null &&
+        widget.room.getState(EventTypes.RoomMember, lastEvent.senderId) == null;
+
+    if (needLastEventSender && lastEvent != null) {
+      _calcLocalizedBodyFuture = lastEvent.calcLocalizedBody(
+        MatrixLocals(L10n.of(context)),
+        hideReply: true,
+        hideEdit: true,
+        plaintextBody: true,
+        removeMarkdown: true,
+        withSenderNamePrefix:
+            (!isDirectChat || directChatMatrixId != lastEvent.senderId),
+      );
+    } else {
+      _calcLocalizedBodyFuture = null;
+    }
+  }
+
