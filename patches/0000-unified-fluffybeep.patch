+import 'package:flutter/material.dart';
+
+class SearchChatFab extends StatefulWidget {
+  final ChatListController controller;
+  final bool extended;
+
+  const SearchChatFab({
+    required this.controller,
+    this.extended = false,
+    super.key,
+  });
+
+  @override
+  State<SearchChatFab> createState() => _SearchChatFabState();
+}
+
+class _SearchChatFabState extends State<SearchChatFab> {
+  @override
+  void initState() {
+    super.initState();
+    widget.controller.searchFocusNode.addListener(_onStateChange);
+    widget.controller.searchController.addListener(_onStateChange);
+  }
+
+  @override
+  void dispose() {
+    widget.controller.searchFocusNode.removeListener(_onStateChange);
+    widget.controller.searchController.removeListener(_onStateChange);
+    super.dispose();
+  }
+
+  void _onStateChange() {
+    if (mounted) setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final isFocused = widget.controller.searchFocusNode.hasFocus ||
+        widget.controller.searchController.text.isNotEmpty ||
+        widget.controller.isSearchMode;
+    final theme = Theme.of(context);
+    final bgColor = isFocused
+        ? theme.colorScheme.surfaceContainerHigh
+        : theme.colorScheme.surfaceContainerHigh.withValues(alpha: 0.65);
+
+    return Material(
+      elevation: isFocused ? 6 : 2,
+      borderRadius: BorderRadius.circular(28),
+      color: bgColor,
+      child: TextField(
+        controller: widget.controller.searchController,
+        focusNode: widget.controller.searchFocusNode,
+        autofocus: false,
+        onChanged: widget.controller.onSearchEnter,
+        onTap: () {
+          if (!widget.controller.isSearchMode) {
+            widget.controller.startSearch();
+          }
+        },
+        decoration: InputDecoration(
+          hintText: L10n.of(context).searchChatsRooms,
+          prefixIcon: const Icon(Icons.search),
+          suffixIcon: widget.controller.isSearchMode
+              ? IconButton(
+                  icon: const Icon(Icons.close),
+                  onPressed: widget.controller.cancelSearch,
+                )
+              : null,
+          border: InputBorder.none,
+          contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
+        ),
+      ),
+    );
+  }
+}
