+                                                )
+                                                .length ??
+                                            0,
+                                      ),
+                                    Membership.knock => L10n.of(
+                                      context,
+                                    ).knocking,
+                                    Membership.leave => L10n.of(
+                                      context,
+                                    ).leftTheChat,
+                                  }),
+                                  selected:
+                                      controller.membershipFilter ==
+                                      availableFilters[i],
+                                  onSelected: (_) => controller
+                                      .setMembershipFilter(availableFilters[i]),
+                                ),
+                              ),
+                            ),
+                          ),
+                      ],
+                    );
+                  }
+                  i--;
+                  return ParticipantListItem(members[i]);
+                },
+              ),
+      ),
+    );
+  }
+}
