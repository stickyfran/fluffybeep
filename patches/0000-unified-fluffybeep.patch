+
+  const MergedContact({
+    required this.id,
+    required this.displayName,
+    this.avatarMxc,
+    required this.roomIds,
+    this.phoneContactId,
+    this.customWhatsAppPhone,
+    this.customInstagramHandle,
+    required this.createdAt,
+  });
+
+  Map<String, dynamic> toJson() => {
+    'displayName': displayName,
+    if (avatarMxc != null) 'avatarMxc': avatarMxc,
+    'roomIds': roomIds,
+    if (phoneContactId != null) 'phoneContactId': phoneContactId,
+    if (customWhatsAppPhone != null) 'customWhatsAppPhone': customWhatsAppPhone,
+    if (customInstagramHandle != null) 'customInstagramHandle': customInstagramHandle,
+    'createdAt': createdAt,
+  };
+
+  factory MergedContact.fromJson(String id, Map<dynamic, dynamic> json) => MergedContact(
+    id: id,
+    displayName: BeeperBridgeUtils.sanitizeDisplayName(json['displayName']?.toString() ?? ''),
+    avatarMxc: json['avatarMxc']?.toString(),
+    roomIds: (json['roomIds'] is List)
+        ? List<String>.from((json['roomIds'] as List).whereType<String>())
+        : <String>[],
+    phoneContactId: json['phoneContactId']?.toString(),
+    customWhatsAppPhone: json['customWhatsAppPhone']?.toString(),
+    customInstagramHandle: json['customInstagramHandle']?.toString(),
+    createdAt: json['createdAt'] is int
+        ? json['createdAt'] as int
+        : (DateTime.now().millisecondsSinceEpoch ~/ 1000),
+  );
+
+  MergedContact copyWith({
+    String? displayName,
+    String? avatarMxc,
+    List<String>? roomIds,
+    String? phoneContactId,
+    String? customWhatsAppPhone,
+    String? customInstagramHandle,
+  }) {
+    return MergedContact(
+      id: id,
+      displayName: displayName ?? this.displayName,
+      avatarMxc: avatarMxc ?? this.avatarMxc,
+      roomIds: roomIds ?? this.roomIds,
+      phoneContactId: phoneContactId ?? this.phoneContactId,
+      customWhatsAppPhone: customWhatsAppPhone ?? this.customWhatsAppPhone,
+      customInstagramHandle: customInstagramHandle ?? this.customInstagramHandle,
+      createdAt: createdAt,
+    );
+  }
+}
+
+class BeeperMergeUtils {
+  static const String accountDataKey = 'com.beeper.merged_contacts';
+
+  /// Global notifier to trigger UI updates immediately across all screens
+  static final ValueNotifier<int> mergeChangeNotifier = ValueNotifier<int>(0);
+
+  static Map<String, MergedContact> _contactsCache = <String, MergedContact>{};
+  static dynamic _lastMergeDataRef;
+
+  /// Map of roomId -> mergeId for O(1) membership queries
+  static Map<String, String> _roomToMergeId = <String, String>{};
+
+  /// Precomputed sibling rooms map: key is roomId or mergeId -> List<Room>
+  static Map<String, List<Room>> _mergeSiblingRooms = <String, List<Room>>{};
+
+  static List<List<Room>>? _cachedSuggestions;
+
+  static void invalidateSuggestionsCache() {
+    _cachedSuggestions = null;
+  }
+
+  static void invalidateCache() {
+    _lastMergeDataRef = null;
+    _contactsCache = <String, MergedContact>{};
+    _roomToMergeId = <String, String>{};
+    _mergeSiblingRooms = <String, List<Room>>{};
+    _cachedSuggestions = null;
+    BeeperFuzzyMatcher.clearCaches();
+  }
+
+  static void _invalidateDerivedMaps() {
+    final newMap = <String, String>{};
+    for (final contact in _contactsCache.values) {
+      for (final rId in contact.roomIds) {
+        newMap[rId] = contact.id;
+      }
+    }
+    _roomToMergeId = newMap;
+    _mergeSiblingRooms = <String, List<Room>>{};
+  }
+
+  /// Get all merged contacts from Account Data (with instant local backup fallback and dual sync)
+  static Map<String, MergedContact> getMergedContacts(Client client) {
+    final event = client.accountData[accountDataKey];
+    dynamic content = event?.content;
+
+    Map<String, dynamic> mergedMap = {};
+
+    // 1. Load com.beeper.merged_contacts
+    if (content is Map && content['contacts'] is Map) {
+      for (final e in (content['contacts'] as Map).entries) {
+        if (e.value is Map) {
+          mergedMap[e.key.toString()] = Map<String, dynamic>.from(e.value as Map);
+        }
+      }
+    }
+
+    // 2. Also check m.fluffybeep.merges (used by fluffybeep-x / Element X) and merge any additions
+    final xEvent = client.accountData['m.fluffybeep.merges'];
+    final xMerges = xEvent?.content['merges'];
+    if (xMerges is List && xMerges.isNotEmpty) {
+      for (final m in xMerges) {
+        if (m is Map && m['id'] != null) {
+          final id = m['id'].toString();
+          final xRooms = List<String>.from(m['roomIds'] as List? ?? <dynamic>[]);
+          if (mergedMap.containsKey(id)) {
+            // Union roomIds
+            final existingRooms = List<String>.from(mergedMap[id]!['roomIds'] as List? ?? <dynamic>[]);
+            final combinedRooms = LinkedHashSet<String>.from([...existingRooms, ...xRooms]).toList();
+            mergedMap[id]!['roomIds'] = combinedRooms;
+          } else {
+            mergedMap[id] = {
+              'displayName': m['displayName']?.toString().replaceAll('++', '+') ?? '',
+              'roomIds': xRooms,
+              'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+            };
+          }
+        }
+      }
+    }
+
+    // 3. Fallback to local SharedPreferences backup if account data not yet synced
+    if (mergedMap.isEmpty) {
+      final localBackup = BeeperBridgeUtils.prefs?.getString('beeper_merged_contacts_backup');
+      if (localBackup != null && localBackup.isNotEmpty) {
+        try {
+          final decoded = jsonDecode(localBackup);
+          if (decoded is Map) {
+            for (final e in decoded.entries) {
+              if (e.value is Map) {
+                mergedMap[e.key.toString()] = Map<String, dynamic>.from(e.value as Map);
+              }
+            }
+          }
+        } catch (_) {}
+      }
+    }
+
+    if (mergedMap.isNotEmpty) {
+      content = {'contacts': mergedMap};
+    }
+
+    if (content != null && identical(content, _lastMergeDataRef)) {
+      return _contactsCache;
+    }
+    _lastMergeDataRef = content;
+
+    if (mergedMap.isEmpty) {
+      _contactsCache = <String, MergedContact>{};
+      _invalidateDerivedMaps();
+      return _contactsCache;
+    }
+
+    final parsed = <String, MergedContact>{};
+    final clientServer = client.userID?.split(':').lastOrNull;
+
+    for (final entry in mergedMap.entries) {
+      final mc = MergedContact.fromJson(entry.key, entry.value);
+
+      // Sanitize: filter out dead room IDs from foreign servers (e.g. legacy :beeper.local)
+      final validRooms = mc.roomIds.where((rId) {
+        if (clientServer != null && client.rooms.isNotEmpty) {
+          final rServer = rId.split(':').lastOrNull;
+          if (rServer != null && rServer != clientServer && client.getRoomById(rId) == null) {
+            return false;
+          }
+        }
+        return true;
+      }).toList();
+
+      // Valid if 2+ rooms, OR 1 room and linked to phone contact / custom phone / custom handle (Triple Merge)
+      final isTripleOrCustomMerged = (mc.phoneContactId != null && mc.phoneContactId!.isNotEmpty) ||
+          (mc.customWhatsAppPhone != null && mc.customWhatsAppPhone!.isNotEmpty) ||
+          (mc.customInstagramHandle != null && mc.customInstagramHandle!.isNotEmpty);
+
+      if (validRooms.length >= 2 || (validRooms.isNotEmpty && isTripleOrCustomMerged)) {
+        parsed[mc.id] = mc.copyWith(
+          displayName: BeeperBridgeUtils.sanitizeDisplayName(mc.displayName),
+          roomIds: validRooms,
+        );
+      }
+    }
+
+    _contactsCache = parsed;
+    _invalidateDerivedMaps();
+    updateSiblingRooms(client);
+    return _contactsCache;
+  }
+
+  /// Check if a roomId is part of any merged contact (O(1))
+  static bool isRoomMerged(String roomId) => _roomToMergeId.containsKey(roomId);
+
+  /// Get merge ID for a room ID (O(1))
+  static String? getMergeIdForRoom(String roomId) => _roomToMergeId[roomId];
+
+  /// Get sibling rooms for a roomId (O(1))
+  static List<Room> getSiblingRooms(String roomId, [Client? client]) {
+    var rooms = _mergeSiblingRooms[roomId];
+    if ((rooms == null || rooms.isEmpty) && client != null) {
+      updateSiblingRooms(client);
+      rooms = _mergeSiblingRooms[roomId];
+    }
+    return rooms ?? const <Room>[];
+  }
+
+  /// Get custom assigned WhatsApp phone for a room or its merged contact
+  static String? getCustomWhatsAppPhone(String roomId) {
+    final mergeId = _roomToMergeId[roomId];
+    if (mergeId != null) {
+      final mc = _contactsCache[mergeId];
+      if (mc?.customWhatsAppPhone != null && mc!.customWhatsAppPhone!.isNotEmpty) {
+        return mc.customWhatsAppPhone;
+      }
+    }
+    return BeeperBridgeUtils.prefs?.getString('custom_wa_phone_$roomId');
+  }
+
+  /// Get custom assigned Instagram handle for a room or its merged contact
+  static String? getCustomInstagramHandle(String roomId) {
+    final mergeId = _roomToMergeId[roomId];
+    if (mergeId != null) {
+      final mc = _contactsCache[mergeId];
+      if (mc?.customInstagramHandle != null && mc!.customInstagramHandle!.isNotEmpty) {
+        return mc.customInstagramHandle;
+      }
+    }
+    return BeeperBridgeUtils.prefs?.getString('custom_ig_handle_$roomId');
+  }
+
+  /// Set custom assigned WhatsApp phone for a room or its merged contact
+  static Future<void> setCustomWhatsAppPhone(Client client, String roomId, String? phone) async {
+    final clean = phone?.replaceAll(RegExp(r'\D'), '');
+    if (clean != null && clean.isNotEmpty) {
+      await BeeperBridgeUtils.prefs?.setString('custom_wa_phone_$roomId', clean);
+    } else {
+      await BeeperBridgeUtils.prefs?.remove('custom_wa_phone_$roomId');
+    }
+    BeeperBridgeUtils.invalidateExtractedPhone(roomId);
+    final mergeId = _roomToMergeId[roomId];
+    if (mergeId != null) {
+      final siblings = getSiblingRooms(roomId, client);
+      for (final s in siblings) {
+        BeeperBridgeUtils.invalidateExtractedPhone(s.id);
+      }
+      final current = getMergedContacts(client);
+      final mc = current[mergeId];
+      if (mc != null) {
+        final updated = mc.copyWith(customWhatsAppPhone: clean);
+        final map = <String, dynamic>{};
+        for (final e in current.entries) {
+          map[e.key] = e.key == mergeId ? updated.toJson() : e.value.toJson();
+        }
+        await _save(client, map);
+      }
+    }
+    mergeChangeNotifier.value++;
+  }
+
+  /// Set custom assigned Instagram handle for a room or its merged contact
+  static Future<void> setCustomInstagramHandle(Client client, String roomId, String? handle) async {
+    final clean = handle != null && handle.trim().isNotEmpty
+        ? BeeperBridgeUtils.cleanInstagramUsername(handle)
+        : null;
+    if (clean != null && clean.isNotEmpty) {
+      await BeeperBridgeUtils.prefs?.setString('custom_ig_handle_$roomId', clean);
+    } else {
+      await BeeperBridgeUtils.prefs?.remove('custom_ig_handle_$roomId');
+    }
+    BeeperBridgeUtils.invalidateExtractedInstagram(roomId);
+    final mergeId = _roomToMergeId[roomId];
+    if (mergeId != null) {
+      final siblings = getSiblingRooms(roomId, client);
+      for (final s in siblings) {
+        BeeperBridgeUtils.invalidateExtractedInstagram(s.id);
+      }
+      final current = getMergedContacts(client);
+      final mc = current[mergeId];
+      if (mc != null) {
+        final updated = mc.copyWith(customInstagramHandle: clean);
+        final map = <String, dynamic>{};
+        for (final e in current.entries) {
+          map[e.key] = e.key == mergeId ? updated.toJson() : e.value.toJson();
+        }
+        await _save(client, map);
+      }
+    }
+    mergeChangeNotifier.value++;
+  }
+
+  /// Updates the sibling rooms cache with active Matrix Client instance
+  static void updateSiblingRooms(Client client) {
+    final contacts = _contactsCache.isNotEmpty ? _contactsCache : getMergedContacts(client);
+    final newSiblingMap = <String, List<Room>>{};
+
+    for (final contact in contacts.values) {
+      final rooms = <Room>[];
+      for (final rId in contact.roomIds) {
+        final r = client.getRoomById(rId);
+        if (r != null) {
+          rooms.add(r);
+        }
+      }
+
+      if (rooms.isNotEmpty) {
+        newSiblingMap[contact.id] = rooms;
+        for (final r in rooms) {
+          newSiblingMap[r.id] = rooms;
+        }
+      }
+    }
+    _mergeSiblingRooms = newSiblingMap;
+  }
+
+  /// Save raw merged contacts map to Account Data and notify all listeners immediately
+  static Future<void> _save(Client client, Map<String, dynamic> contacts) async {
+    // 1. Invalidate local cache and update in-memory contacts directly
+    final parsed = <String, MergedContact>{};
+    for (final entry in contacts.entries) {
+      if (entry.value is Map) {
+        final mc = MergedContact.fromJson(entry.key.toString(), entry.value as Map);
+        final isTripleOrCustom = (mc.phoneContactId != null && mc.phoneContactId!.isNotEmpty) ||
+            (mc.customWhatsAppPhone != null && mc.customWhatsAppPhone!.isNotEmpty) ||
+            (mc.customInstagramHandle != null && mc.customInstagramHandle!.isNotEmpty);
+        if (mc.roomIds.length >= 2 || (mc.roomIds.isNotEmpty && isTripleOrCustom)) {
+          parsed[mc.id] = mc;
+        }
+      }
+    }
+    _contactsCache = parsed;
+    _invalidateDerivedMaps();
+    _lastMergeDataRef = {'contacts': contacts};
+    _cachedSuggestions = null;
+    BeeperFuzzyMatcher.clearCaches();
+
+    // 2. Rebuild sibling maps
+    updateSiblingRooms(client);
+
+    // 3. Trigger UI listeners immediately
+    mergeChangeNotifier.value++;
+
+    // 4. Save to local SharedPreferences as instant offline/restart backup
+    try {
+      final jsonStr = jsonEncode(contacts);
+      BeeperBridgeUtils.prefs?.setString('beeper_merged_contacts_backup', jsonStr);
+    } catch (_) {}
+
+    // 5. Send to homeserver asynchronously (DUAL SYNC: com.beeper.merged_contacts and m.fluffybeep.merges)
+    try {
+      await client.setAccountData(
+        client.userID!,
+        accountDataKey,
+        {'contacts': contacts},
+      );
+    } catch (_) {}
+
+    try {
+      final mergesList = <Map<String, dynamic>>[];
+      for (final mc in parsed.values) {
+        mergesList.add({
+          'id': mc.id,
+          'displayName': mc.displayName,
+          'roomIds': mc.roomIds,
+          'activeRoomId': mc.roomIds.firstOrNull,
+        });
+      }
+      await client.setAccountData(
+        client.userID!,
+        'm.fluffybeep.merges',
+        {'merges': mergesList},
+      );
+    } catch (_) {}
+  }
+
+  /// Create or update a merged contact
+  static Future<String> addMerge(
+    Client client, {
+    String? existingMergeId,
+    required List<String> roomIds,
+    required String displayName,
+    String? phoneContactId,
+    String? avatarMxc,
+  }) async {
+    final current = getMergedContacts(client);
+    final map = <String, dynamic>{};
+    for (final e in current.entries) {
+      map[e.key] = e.value.toJson();
+    }
+
+    final uniqueRoomIds = LinkedHashSet<String>.from(roomIds).toList();
+
+    // Check if any of these roomIds already belongs to an existing merge if not explicitly provided
+    existingMergeId ??= () {
+      for (final rId in uniqueRoomIds) {
+        if (_roomToMergeId.containsKey(rId)) {
+          return _roomToMergeId[rId];
+        }
+      }
+      return null;
+    }();
+
+    final mergeId = existingMergeId ??
+        'mc_${DateTime.now().millisecondsSinceEpoch}_${uniqueRoomIds.isNotEmpty ? uniqueRoomIds.first.hashCode.abs() : 0}';
+
+    // Remove these roomIds from any OTHER existing merge to prevent collisions
+    for (final entry in map.entries.toList()) {
+      if (entry.key != mergeId && entry.value is Map) {
+        final otherRooms = List<String>.from(entry.value['roomIds'] as List? ?? <dynamic>[]);
+        otherRooms.removeWhere((rId) => uniqueRoomIds.contains(rId));
+        final otherHasMeta = entry.value['phoneContactId'] != null ||
+            entry.value['customWhatsAppPhone'] != null ||
+            entry.value['customInstagramHandle'] != null;
+        if (otherRooms.length < 2 && (!otherHasMeta || otherRooms.isEmpty)) {
+          map.remove(entry.key);
+        } else {
+          entry.value['roomIds'] = otherRooms;
+        }
+      }
+    }
+
+    final hasTripleMeta = (phoneContactId != null && phoneContactId.isNotEmpty) ||
+        (uniqueRoomIds.length == 1 && BeeperMergeUtils.getCustomWhatsAppPhone(uniqueRoomIds.first) != null) ||
+        (uniqueRoomIds.length == 1 && BeeperMergeUtils.getCustomInstagramHandle(uniqueRoomIds.first) != null);
+
+    if (uniqueRoomIds.length < 2 && (!hasTripleMeta || uniqueRoomIds.isEmpty)) {
+      map.remove(mergeId);
+    } else {
+      map[mergeId] = {
+        'displayName': displayName.trim(),
+        if (avatarMxc != null) 'avatarMxc': avatarMxc,
+        'roomIds': uniqueRoomIds,
+        if (phoneContactId != null) 'phoneContactId': phoneContactId,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await _save(client, map);
+    return mergeId;
+  }
+
+  /// Rename a merged contact
+  static Future<void> renameMerge(
+    Client client,
+    String mergeId,
+    String newDisplayName,
+  ) async {
+    final current = getMergedContacts(client);
+    final map = <String, dynamic>{};
+    for (final e in current.entries) {
+      map[e.key] = e.value.toJson();
+    }
+    if (map.containsKey(mergeId) && map[mergeId] is Map) {
+      map[mergeId]['displayName'] = newDisplayName.trim();
+      await _save(client, map);
+    }
+  }
+
+  /// Remove an entire merged contact
+  static Future<void> removeMerge(Client client, String mergeId) async {
+    final current = getMergedContacts(client);
+    final map = <String, dynamic>{};
+    for (final e in current.entries) {
+      if (e.key != mergeId) {
+        map[e.key] = e.value.toJson();
+      }
+    }
+    await _save(client, map);
+  }
+
+  /// Remove a single room from a merged contact
+  static Future<void> removeRoomFromMerge(
+    Client client,
+    String mergeId,
+    String roomId,
+  ) async {
+    final current = getMergedContacts(client);
+    final map = <String, dynamic>{};
+    for (final e in current.entries) {
+      map[e.key] = e.value.toJson();
+    }
+
+    if (map.containsKey(mergeId) && map[mergeId] is Map) {
+      final rooms = List<String>.from(map[mergeId]['roomIds'] as List? ?? <dynamic>[]);
+      rooms.remove(roomId);
+      final hasMeta = map[mergeId]['phoneContactId'] != null ||
+          map[mergeId]['customWhatsAppPhone'] != null ||
+          map[mergeId]['customInstagramHandle'] != null;
+      if (rooms.length < 2 && (!hasMeta || rooms.isEmpty)) {
+        map.remove(mergeId);
+      } else {
+        map[mergeId]['roomIds'] = rooms;
+      }
+      await _save(client, map);
+    }
+  }
+
+  /// Extract phone number from WhatsApp MXID or room (ignoring internal WhatsApp LIDs)
+  static String? extractPhoneFromMxid(String mxid) {
+    if (mxid.contains('lid')) return null;
+    final match = RegExp(r'(?:whatsapp|w4b)[^:]*?(\d{7,16})', caseSensitive: false).firstMatch(mxid);
+    return match?.group(1);
+  }
+
+  /// Normalize display name for fuzzy grouping across networks (e.g. "Juan Perez" vs "Juan Perez (@juanperez)")
+  static String normalizeDisplayName(String name) {
+    return name
+        .replaceAll(RegExp(r'\[(?:whatsapp|instagram|telegram|signal|discord|slack|facebook)\]', caseSensitive: false), '')
+        .replaceAll(RegExp(r'\(@?[a-zA-Z0-9._]+\)'), '') // remove (@username) suffix
+        .replaceAll(RegExp(r'\+{0,2}[0-9\s\-\.\(\)]+'), '') // remove phone number fragments with single or double plus
+        .toLowerCase()
+        .replaceAll(RegExp(r'[^\p{L}\p{N}]', unicode: true), '') // keep unicode letters and digits
+        .trim();
+  }
+
+  /// Calculate suggested merges across bridged rooms
+  static List<List<Room>> getSuggestedMerges(
+    Client client, [
+    List<CachedPhoneContact>? phoneContacts,
+  ]) {
+    if (_cachedSuggestions != null) {
+      return _cachedSuggestions!;
+    }
+
+    getMergedContacts(client); // Ensure cache is loaded
+
+    final bridgedRooms = client.rooms
+        .where((r) =>
+            !r.isSpace &&
+            BeeperBridgeUtils.getRoomData(r).networkKey != null &&
+            !isRoomMerged(r.id))
+        .toList();
+
+    if (bridgedRooms.length < 2) return const <List<Room>>[];
+
+    final groups = <String, List<Room>>{};
+
+    // Precompute normalized phone contacts map ONCE to avoid O(N * M) repeated regex normalization
+    final normPhoneContactMap = <String, CachedPhoneContact>{};
+    if (phoneContacts != null && phoneContacts.isNotEmpty) {
+      for (final pc in phoneContacts) {
+        final norm = normalizeDisplayName(pc.displayName);
+        if (norm.isNotEmpty) {
+          normPhoneContactMap[norm] = pc;
+        }
+      }
+    }
+
+    for (final room in bridgedRooms) {
+      final beeperData = BeeperBridgeUtils.getRoomData(room);
+      final netKey = beeperData.networkKey;
+
+      // 1. WhatsApp phone match
+      if (netKey == 'whatsapp' || netKey == 'whatsappgo') {
+        final phone = BeeperBridgeUtils.extractWhatsAppPhone(room);
+        if (phone != null && phone.length >= 7) {
+          // Index by last 8 digits for international code resilience
+          final key = phone.length >= 8
+              ? 'phone_${phone.substring(phone.length - 8)}'
+              : 'phone_$phone';
+          groups.putIfAbsent(key, () => <Room>[]).add(room);
+          continue;
+        }
+      }
+
+      // 2. Instagram username match
+      if (netKey == 'instagram' || netKey == 'instagramgo') {
+        final ig = BeeperBridgeUtils.extractInstagramDetails(room);
+        if (ig.username != null && ig.username!.length >= 3) {
+          groups.putIfAbsent('ig_${ig.username!.toLowerCase()}', () => <Room>[]).add(room);
+        }
+      }
+
+      // 3. Phone contacts match if available (O(1) map lookup)
+      if (normPhoneContactMap.isNotEmpty) {
+        final dName = beeperData.displayName ?? room.name;
+        final normDName = normalizeDisplayName(dName);
+        if (normDName.isNotEmpty) {
+          final pc = normPhoneContactMap[normDName];
+          if (pc != null) {
+            groups.putIfAbsent('contact_${pc.id}', () => <Room>[]).add(room);
+            continue;
+          }
+        }
+      }
+    }
+
+    // 4. Normalized display name and fast token-indexed matching
+    final tokenIndex = <String, List<Room>>{};
+
+    for (final room in bridgedRooms) {
+      final beeperData = BeeperBridgeUtils.getRoomData(room);
+      final name = beeperData.displayName ?? room.name;
+      final norm = normalizeDisplayName(name);
+      if (norm.length >= 3) {
+        groups.putIfAbsent('name_$norm', () => <Room>[]).add(room);
+      }
+
+      final tokens = BeeperFuzzyMatcher.extractTokens(name);
+      for (final t in tokens) {
+        if (t.length >= 4) {
+          tokenIndex.putIfAbsent(t, () => <Room>[]).add(room);
+        }
+      }
+    }
+
+    // 5. Match candidate pairs that share significant tokens (e.g. shared surname)
+    final comparedPairs = <String>{};
+    for (final entry in tokenIndex.entries) {
+      final candidates = entry.value;
+      if (candidates.length >= 2 && candidates.length <= 6) {
+        for (var i = 0; i < candidates.length; i++) {
+          for (var j = i + 1; j < candidates.length; j++) {
+            final r1 = candidates[i];
+            final r2 = candidates[j];
+            if (r1.id == r2.id) continue;
+            final pairKey = r1.id.compareTo(r2.id) < 0 ? '${r1.id}_${r2.id}' : '${r2.id}_${r1.id}';
+            if (!comparedPairs.add(pairKey)) continue;
+
+            final sim = BeeperFuzzyMatcher.computeRoomSimilarity(r1, r2);
+            if (sim >= 0.70) {
+              final key = 'fuzzy_$pairKey';
+              groups.putIfAbsent(key, () => <Room>[r1, r2]);
+            }
+          }
+        }
+      }
+    }
+
+    final result = groups.values
+        .where((list) => list.length >= 2)
+        .toList();
+    _cachedSuggestions = result;
+    return result;
+  }
+}
diff --git a/lib/utils/beeper_phone_contacts.dart b/lib/utils/beeper_phone_contacts.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1ef3f97f4214f9d7a725bef09043f69150733edd
--- /dev/null
+++ b/lib/utils/beeper_phone_contacts.dart
@@ -0,0 +1,187 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:typed_data';
+import 'package:flutter/foundation.dart';
+import 'package:flutter_contacts/flutter_contacts.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'beeper_bridge_utils.dart';
+
+class CachedPhoneContact {
+  final String id;
+  final String displayName;
+  final List<String> normalizedPhones;
+  final Uint8List? thumbnail;
+
+  const CachedPhoneContact({
+    required this.id,
+    required this.displayName,
+    required this.normalizedPhones,
+    this.thumbnail,
+  });
+}
+
+class BeeperPhoneContacts {
+  static List<CachedPhoneContact> _contacts = <CachedPhoneContact>[];
+  static Map<String, CachedPhoneContact> _phoneIndex = <String, CachedPhoneContact>{};
+  static Map<String, CachedPhoneContact> _nameIndex = <String, CachedPhoneContact>{};
+  static bool _loaded = false;
+  static bool _isLoading = false;
+  static bool _permissionDenied = false;
+
+  static bool get isLoaded => _loaded;
+  static bool get isPermissionDenied => _permissionDenied;
+  static List<CachedPhoneContact> get contacts => _contacts;
+
+  static bool get isPermissionAsked {
+    final prefs = BeeperBridgeUtils.prefs;
+    return prefs?.getBool('beeper_contacts_permission_asked') ?? false;
+  }
+
+  /// Normalize phone string: removes all non-digit characters, leading zeroes
+  static String normalizePhone(String raw) {
+    return raw
+        .replaceAll(RegExp(r'[^\d]'), '')
+        .replaceFirst(RegExp(r'^00'), '')
+        .replaceFirst(RegExp(r'^0'), '');
+  }
+
+  /// Request permission and load phone contacts into fast indexed cache
+  static Future<bool> load({bool requestPermission = true}) async {
+    if (_loaded) return true;
+    if (_isLoading) return false;
+    if (kIsWeb || (defaultTargetPlatform != TargetPlatform.android && defaultTargetPlatform != TargetPlatform.iOS)) {
+      // Desktop / web: silently skip
+      return false;
+    }
+
+    final prefs = BeeperBridgeUtils.prefs ?? await SharedPreferences.getInstance();
+    final wasGranted = prefs.getBool('beeper_contacts_permission_granted') ?? false;
+
+    if (!requestPermission && !wasGranted) {
+      return false;
+    }
+
+    _isLoading = true;
+    try {
+      final granted = await FlutterContacts.requestPermission(readonly: true);
+      if (!granted) {
+        _permissionDenied = true;
+        _isLoading = false;
+        await prefs.setBool('beeper_contacts_permission_granted', false);
+        return false;
+      }
+
+      await prefs.setBool('beeper_contacts_permission_granted', true);
+      await prefs.setBool('beeper_contacts_permission_asked', true);
+
+      final rawList = await FlutterContacts.getContacts(
+        withProperties: true,
+        withThumbnail: false,
+      );
+
+      final list = <CachedPhoneContact>[];
+      final index = <String, CachedPhoneContact>{};
+      final nameIdx = <String, CachedPhoneContact>{};
+
+      for (final c in rawList) {
+        final phones = <String>[];
+        for (final p in c.phones) {
+          final norm = normalizePhone(p.number);
+          if (norm.length >= 7) {
+            phones.add(norm);
+          }
+        }
+
+        final cached = CachedPhoneContact(
+          id: c.id,
+          displayName: c.displayName.isNotEmpty ? c.displayName : (phones.isNotEmpty ? phones.first : 'Contacto'),
+          normalizedPhones: phones,
+          thumbnail: c.thumbnail,
+        );
+        list.add(cached);
+
+        final cleanName = BeeperBridgeUtils.sanitizeDisplayName(cached.displayName).toLowerCase();
+        if (cleanName.isNotEmpty) {
+          nameIdx[cleanName] = cached;
+        }
+
+        // Index by full phone number and by last 8 digits for fuzzy match
+        for (final p in phones) {
+          index[p] = cached;
+          if (p.length >= 8) {
+            index[p.substring(p.length - 8)] = cached;
+          }
+        }
+      }
+
+      _contacts = list;
+      _phoneIndex = index;
+      _nameIndex = nameIdx;
+      _loaded = true;
+      _permissionDenied = false;
+      _isLoading = false;
+      return true;
+    } catch (e) {
+      debugPrint('[BeeperPhoneContacts] Error loading phone contacts: $e');
+      _permissionDenied = true;
+      _isLoading = false;
+      return false;
+    }
+  }
+
+  /// Lookup contact by phone number (O(1))
+  static CachedPhoneContact? findByPhone(String phone) {
+    if (!_loaded || _phoneIndex.isEmpty) return null;
+    final norm = normalizePhone(phone);
+    if (_phoneIndex.containsKey(norm)) {
+      return _phoneIndex[norm];
+    }
+    if (norm.length >= 8) {
+      final sub = norm.substring(norm.length - 8);
+      if (_phoneIndex.containsKey(sub)) {
+        return _phoneIndex[sub];
+      }
+    }
+    return null;
+  }
+
+  /// Lookup contact by ID with graceful fallback by name or phone if ID format changed (e.g. across sync or platforms)
+  static CachedPhoneContact? findById(String id) {
+    for (final c in _contacts) {
+      if (c.id == id) return c;
+    }
+    // Fallback: If id is formatted as a name slug (e.g. "merge_bruno_musco" or "bruno musco")
+    final nameCandidate = id.replaceFirst(RegExp(r'^merge_'), '').replaceAll('_', ' ');
+    final byName = findByName(nameCandidate);
+    if (byName != null) return byName;
+    return null;
+  }
+
+  /// Lookup contact by Display Name (O(1))
+  static CachedPhoneContact? findByName(String name) {
+    if (!_loaded || _nameIndex.isEmpty) return null;
+    final clean = BeeperBridgeUtils.sanitizeDisplayName(name).toLowerCase();
+    return _nameIndex[clean];
+  }
+
+  /// Resolve a contact using any available identifier (id, name, or phone)
+  static CachedPhoneContact? resolveContact({String? id, String? name, String? phone}) {
+    if (!_loaded) return null;
+    if (id != null && id.isNotEmpty) {
+      final c = findById(id);
+      if (c != null) return c;
+    }
+    if (phone != null && phone.isNotEmpty) {
+      final c = findByPhone(phone);
+      if (c != null) return c;
+    }
+    if (name != null && name.isNotEmpty) {
+      final c = findByName(name);
+      if (c != null) return c;
+    }
+    return null;
+  }
+}
+
diff --git a/lib/utils/beeper_sync_manager.dart b/lib/utils/beeper_sync_manager.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9e5790d3c4007047717129d3ce6f673b81509553
--- /dev/null
+++ b/lib/utils/beeper_sync_manager.dart
@@ -0,0 +1,225 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:typed_data';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_foreground_task/flutter_foreground_task.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:wakelock_plus/wakelock_plus.dart';
+
+import 'beeper_bridge_utils.dart';
+import 'beeper_merge_utils.dart';
+import 'beeper_phone_contacts.dart';
+import 'client_download_content_extension.dart';
+import 'matrix_sdk_extensions/matrix_locals.dart';
+import 'start_push_foreground_service.dart';
+
+class BeeperSyncProgress {
+  final bool isSyncing;
+  final int processedRooms;
+  final int totalRooms;
+  final String currentRoomName;
+  final double progress;
+
+  const BeeperSyncProgress({
+    this.isSyncing = false,
+    this.processedRooms = 0,
+    this.totalRooms = 0,
+    this.currentRoomName = '',
+    this.progress = 0.0,
+  });
+}
+
+class BeeperSyncManager {
+  static final ValueNotifier<BeeperSyncProgress> progressNotifier =
+      ValueNotifier<BeeperSyncProgress>(const BeeperSyncProgress());
+
+  static bool get isSyncing => progressNotifier.value.isSyncing;
+
+  static Completer<void>? _activeSyncCompleter;
+
+  static const String _syncedRoomIdsKey = 'beeper_resync_completed_room_ids';
+  /// Android 14 shortService imposes a hard 180s limit. We stop the foreground
+  /// service proactively at 150s to avoid ForegroundServiceTimeoutException crashes.
+  static const int _maxForegroundServiceDurationSeconds = 150;
+
+  /// Starts a full background synchronization of ALL rooms, contacts, and avatars
+  static Future<void> startFullSync(
+    Client client, {
+    bool invalidateCachesFirst = false,
+    MatrixLocals? locals,
+    VoidCallback? onCompleted,
+  }) async {
+    if (isSyncing) {
+      return _activeSyncCompleter?.future;
+    }
+
+    final completer = _activeSyncCompleter = Completer<void>();
+    final prefs = await SharedPreferences.getInstance();
+
+    progressNotifier.value = const BeeperSyncProgress(
+      isSyncing: true,
+      processedRooms: 0,
+      totalRooms: 0,
+      currentRoomName: 'Iniciando sincronización...',
+      progress: 0.0,
+    );
+
+    try {
+      if (invalidateCachesFirst) {
+        await prefs.remove(_syncedRoomIdsKey);
+        BeeperBridgeUtils.invalidateAllRoomCaches();
+        BeeperMergeUtils.invalidateCache();
+      }
+
+      // Keep device awake and start foreground task if supported
+      try {
+        await WakelockPlus.enable();
+      } catch (_) {}
+      try {
+        await ForegroundServices.startService('beeper_resync');
+      } catch (_) {}
+
+      final syncStopwatch = Stopwatch()..start();
+      bool reachedServiceTimeout = false;
+
+      // Preload phone contacts in background
+      BeeperPhoneContacts.load(requestPermission: false).catchError((_) => false);
+
+      // Wait for initial matrix sync if not already done
+      if (client.prevBatch == null) {
+        await client.onSync.stream.firstWhere((s) => client.prevBatch != null).timeout(
+          const Duration(seconds: 20),
+          onTimeout: () => SyncUpdate(nextBatch: client.prevBatch ?? ''),
+        );
+      }
+
+      // Collect ALL non-space rooms
+      final allRooms = client.rooms.where((r) => !r.isSpace).toList();
+      allRooms.sort((a, b) {
+        final aTime = a.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        final bTime = b.lastEvent?.originServerTs ?? DateTime.fromMillisecondsSinceEpoch(0);
+        return bTime.compareTo(aTime);
+      });
+
+      final total = allRooms.length;
+
+      // Load existing checkpoint to resume without repeating already synced rooms
+      final completedRoomIds = (prefs.getStringList(_syncedRoomIdsKey) ?? <String>[]).toSet();
+      final pendingRooms = allRooms.where((r) => !completedRoomIds.contains(r.id)).toList();
+      var processed = total - pendingRooms.length;
+
+      final initialProgress = total > 0 ? (processed / total).clamp(0.0, 1.0) : 0.0;
+      progressNotifier.value = BeeperSyncProgress(
+        isSyncing: true,
+        processedRooms: processed,
+        totalRooms: total,
+        currentRoomName: pendingRooms.isEmpty ? 'Sincronización al día' : 'Preparando chats...',
+        progress: initialProgress,
+      );
+
+      if (pendingRooms.isNotEmpty) {
+        // Process remaining rooms concurrently in batches of 4
+        const batchSize = 4;
+
+        for (var i = 0; i < pendingRooms.length; i += batchSize) {
+          // Android 14 watchdog: gracefully stop shortService before the 180s OS crash limit
+          if (!reachedServiceTimeout && syncStopwatch.elapsed.inSeconds >= _maxForegroundServiceDurationSeconds) {
+            reachedServiceTimeout = true;
+            Logs().i('[BeeperSync] Approaching Android 14 shortService 3min limit (150s elapsed). Stopping foreground service to prevent OS crash.');
+            try {
+              await ForegroundServices.stopService('beeper_resync');
+            } catch (_) {}
+          }
+
+          // If service was stopped and app is backgrounded, pause cleanly to save battery
+          if (reachedServiceTimeout && WidgetsBinding.instance.lifecycleState != AppLifecycleState.resumed) {
+            Logs().i('[BeeperSync] App is in background and foreground service stopped safely. Pausing resync ($processed/$total completed).');
+            break;
+          }
+
+          final batch = pendingRooms.sublist(i, (i + batchSize).clamp(0, pendingRooms.length));
+
+          await Future.wait(batch.map((room) async {
+            try {
+              final name = locals != null
+                  ? room.getBeeperDisplayname(locals)
+                  : (BeeperBridgeUtils.getRoomData(room).displayName ?? room.name);
+
+              // Fetch recent history for this room (saving events into local DB)
+              await room.getTimeline().then((t) => t.requestHistory(historyCount: 30));
+
+              // Cache avatar image if present
+              final avatarUrl = room.beeperAvatarUrl;
+              if (avatarUrl != null) {
+                await client.downloadMxcCached(avatarUrl).catchError((_) => Uint8List(0));
+              }
+
+              processed++;
+              completedRoomIds.add(room.id);
+              final currentProgress = total > 0 ? (processed / total).clamp(0.0, 1.0) : 0.0;
+
+              progressNotifier.value = BeeperSyncProgress(
+                isSyncing: true,
+                processedRooms: processed,
+                totalRooms: total,
+                currentRoomName: name,
+                progress: currentProgress,
+              );
+
+              // Update Android notification while service is still running
+              if (!reachedServiceTimeout) {
+                try {
+                  final pct = (currentProgress * 100).toInt();
+                  FlutterForegroundTask.updateService(
+                    notificationTitle: 'Sincronizando chats de Beeper ($pct%)',
+                    notificationText: '$processed de $total: $name',
+                  );
+                } catch (_) {}
+              }
+            } catch (_) {}
+          }));
+
+          // Persist incremental checkpoint so interrupted syncs never repeat work
+          await prefs.setStringList(_syncedRoomIdsKey, completedRoomIds.toList());
+        }
+      }
+
+      // Rebuild merges and sibling relations
+      BeeperMergeUtils.updateSiblingRooms(client);
+      BeeperMergeUtils.mergeChangeNotifier.value++;
+
+      // If all rooms finished successfully, clear the checkpoint and reset flag
+      if (completedRoomIds.length >= total) {
+        await prefs.remove(_syncedRoomIdsKey);
+        await prefs.setBool('beeper_needs_cache_refresh', false);
+      }
+
+    } catch (e, s) {
+      debugPrint('Error during Beeper full sync: $e\n$s');
+    } finally {
+      try {
+        await WakelockPlus.disable();
+      } catch (_) {}
+      try {
+        await ForegroundServices.stopService('beeper_resync');
+      } catch (_) {}
+
+      progressNotifier.value = const BeeperSyncProgress(
+        isSyncing: false,
+        processedRooms: 0,
+        totalRooms: 0,
+        currentRoomName: '',
+        progress: 1.0,
+      );
+
+      if (!completer.isCompleted) completer.complete();
+      _activeSyncCompleter = null;
+      onCompleted?.call();
+    }
+  }
+}
diff --git a/lib/utils/beeper_video_thumbnail_cache.dart b/lib/utils/beeper_video_thumbnail_cache.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1e8d472364ff7e40f62c9699c964fd4384b6ae74
--- /dev/null
+++ b/lib/utils/beeper_video_thumbnail_cache.dart
@@ -0,0 +1,134 @@
+// SPDX-FileCopyrightText: 2026 Beeper / Fluffybeep Contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:io';
+import 'dart:typed_data';
+import 'package:flutter/foundation.dart';
+import 'package:matrix/matrix.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:video_compress/video_compress.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+
+/// Performance-optimized asynchronous thumbnail cache for video events.
+/// Provides instant in-memory (RAM) retrieval and persistent disk caching
+/// to prevent UI jank and eliminate blurry BlurHash placeholders for videos.
+class BeeperVideoThumbnailCache {
+  static const int _maxMemoryCacheItems = 50;
+  static final Map<String, Uint8List> _memoryCache = {};
+  static final Map<String, Future<Uint8List?>> _pendingTasks = {};
+  static String? _cacheDirPath;
+
+  static void _putMemoryCache(String key, Uint8List bytes) {
+    if (_memoryCache.length >= _maxMemoryCacheItems) {
+      _memoryCache.remove(_memoryCache.keys.first);
+    }
+    _memoryCache[key] = bytes;
+  }
+
+  /// Retrieves thumbnail bytes from memory or disk cache if available.
+  static Uint8List? getMemoryThumbnail(String key) {
+    return _memoryCache[key];
+  }
+
+  /// Ensures cache directory path is initialized.
+  static Future<String> _getCacheDir() async {
+    if (_cacheDirPath != null) return _cacheDirPath!;
+    final tempDir = await getTemporaryDirectory();
+    final dir = Directory('${tempDir.path}/beeper_video_thumbnails');
+    if (!await dir.exists()) {
+      await dir.create(recursive: true);
+    }
+    _cacheDirPath = dir.path;
+    return _cacheDirPath!;
+  }
+
+  /// Gets or generates high-quality thumbnail bytes for a video event.
+  static Future<Uint8List?> getOrGenerateThumbnail(Event event) async {
+    final key = event.transactionId ?? event.eventId;
+    if (key.isEmpty) return null;
+
+    // 1. Check memory RAM cache
+    if (_memoryCache.containsKey(key)) {
+      return _memoryCache[key];
+    }
+
+    // 2. Prevent duplicate concurrent extraction requests
+    if (_pendingTasks.containsKey(key)) {
+      return _pendingTasks[key];
+    }
+
+    final task = _loadOrGenerate(event, key);
+    _pendingTasks[key] = task;
+
+    try {
+      final result = await task;
+      if (result != null) {
+        _putMemoryCache(key, result);
+      }
+      return result;
+    } finally {
+      _pendingTasks.remove(key);
+    }
+  }
+
+  static Future<Uint8List?> _loadOrGenerate(Event event, String key) async {
+    try {
+      final cacheDir = await _getCacheDir();
+      final fileKey = key.replaceAll(RegExp(r'[^\w\.-]'), '_');
+      final diskFile = File('$cacheDir/$fileKey.jpg');
+
+      // Check disk cache
+      if (await diskFile.exists()) {
+        final bytes = await diskFile.readAsBytes();
+        if (bytes.isNotEmpty) {
+          _memoryCache[key] = bytes;
+          return bytes;
+        }
+      }
+
+      // If matrix event thumbnail is available, download and cache it
+      if (event.hasThumbnail) {
+        try {
+          final thumbnailData = await event.downloadAndDecryptAttachment(
+            getThumbnail: true,
+          );
+          if (thumbnailData.bytes.isNotEmpty) {
+            await diskFile.writeAsBytes(thumbnailData.bytes);
+            _memoryCache[key] = thumbnailData.bytes;
+            return thumbnailData.bytes;
+          }
+        } catch (_) {}
+      }
+
+      // Otherwise, download full video attachment and generate frame thumbnail locally
+      final attachmentData = await event.downloadAndDecryptAttachment(
+        getThumbnail: false,
+      );
+
+      final tempVideoFile = File('$cacheDir/temp_$fileKey.mp4');
+      await tempVideoFile.writeAsBytes(attachmentData.bytes);
+
+      Uint8List? thumbBytes;
+      try {
+        if (PlatformInfos.isMobile) {
+          thumbBytes = await VideoCompress.getByteThumbnail(tempVideoFile.path);
+        }
+      } finally {
+        if (await tempVideoFile.exists()) {
+          try {
+            await tempVideoFile.delete();
+          } catch (_) {}
+        }
+      }
+
+      if (thumbBytes != null && thumbBytes.isNotEmpty) {
+        await diskFile.writeAsBytes(thumbBytes);
+        _putMemoryCache(key, thumbBytes);
+        return thumbBytes;
+      }
+    } catch (e) {
+      debugPrint('BeeperVideoThumbnailCache error for ${event.eventId}: $e');
+    }
+    return null;
+  }
+}
diff --git a/lib/utils/chat_ai_query_service.dart b/lib/utils/chat_ai_query_service.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1716e0a27b2357ffa51fa0c43858777f710535f7
--- /dev/null
+++ b/lib/utils/chat_ai_query_service.dart
@@ -0,0 +1,157 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+import 'package:intl/intl.dart';
+import 'package:matrix/matrix.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'ai_profile_service.dart';
+import 'file_logger.dart';
+
+class ChatAiQueryItem {
+  final String question;
+  final String? answer;
+  final bool isLoading;
+  final String? error;
+  final DateTime timestamp;
+
+  const ChatAiQueryItem({
+    required this.question,
+    this.answer,
+    this.isLoading = false,
+    this.error,
+    required this.timestamp,
+  });
+
+  ChatAiQueryItem copyWith({
+    String? question,
+    String? answer,
+    bool? isLoading,
+    String? error,
+    DateTime? timestamp,
+  }) {
+    return ChatAiQueryItem(
+      question: question ?? this.question,
+      answer: answer ?? this.answer,
+      isLoading: isLoading ?? this.isLoading,
+      error: error ?? this.error,
+      timestamp: timestamp ?? this.timestamp,
+    );
+  }
+}
+
+/// Servicio desacoplado y sin estado persistente en SQLite para responder preguntas
+/// sobre el historial de un chat utilizando un modelo de lenguaje (Ollama o API compatible OpenAI).
+class ChatAiQueryService {
+  static final DateFormat _dateFormat = DateFormat('yyyy-MM-dd HH:mm');
+
+  /// Consulta al modelo sobre la conversación en [room].
+  /// [chatHistoryDepth] define cuántos mensajes recientes extraer (ej. 200).
+  static Future<String> askChatQuestion({
+    required Room room,
+    required String question,
+    int chatHistoryDepth = 200,
+  }) async {
+    final endpoint = AppSettings.aiEndpoint.value.trim();
+    final apiKey = AppSettings.aiApiKey.value.trim();
+    final model = AppSettings.aiModel.value.trim().isEmpty ? 'llama3.2' : AppSettings.aiModel.value.trim();
+
+    if (endpoint.isEmpty) {
+      throw 'No hay un servidor de IA configurado. Configura el Endpoint en Ajustes > Ajustes de Chat > Configuración de IA (ej. Ollama local o API OpenAI/Groq).';
+    }
+
+    // 1. Extraer el contexto limpio del chat con marcas temporales y notas de voz transcriptas
+    final extraction = await AiProfileService.extractChatContext(
+      room,
+      forceFull: true,
+      maxMessages: chatHistoryDepth,
+    );
+
+    if (extraction.textContext.trim().isEmpty) {
+      return 'No hay suficientes mensajes o historial en este chat para responder a la consulta.';
+    }
+
+    final contactName = AiProfileService.resolveContactName(room);
+    final nowStr = _dateFormat.format(DateTime.now());
+
+    final systemPrompt = '''
+Eres un asistente ultra preciso de búsqueda e interpretación de conversaciones de mensajería.
+Tu objetivo es responder de forma directa, útil y honesta a la pregunta del usuario sobre el chat.
+El interlocutor es "${contactName.isNotEmpty ? contactName : 'Contacto'}" y el usuario es "Yo".
+
+REGLAS ESTRICTAS DE RESPUESTA:
+1. BASADO EXCLUSIVAMENTE EN EL TEXTO: Responde ÚNICAMENTE con información que esté explícita o claramente evidenciada en los mensajes proporcionados.
+2. CERO ALUCINACIONES: Si la pregunta indaga sobre algo que NO fue mencionado o no está claro en los mensajes, di exactamente: "No encontré menciones sobre eso en los mensajes de la conversación." No supongas ni inventes detalles.
+3. CITAS Y MARCAS TEMPORALES: Cuando encuentres el dato, incluye brevemente la fecha o momento de la conversación de donde surge (ej. "[2026-04-10 14:20] Contacto dijo: ...").
+4. INTERPRETACIÓN TEMPORAL: La fecha actual de referencia es $nowStr. Si un mensaje decía "mañana", "el jueves" o "la próxima semana", calcula el día exacto tomando la marca de tiempo de dicho mensaje.
+5. CONCISIÓN: Sé directo y breve. No des rodeos ni introducciones largas.
+''';
+
+    final userPrompt = '''
+FECHA ACTUAL: $nowStr
+INTERLOCUTOR / CONTACTO: ${contactName.isNotEmpty ? contactName : 'Contacto'}
+
+HISTORIAL DE MENSAJES (orden cronológico):
+${extraction.textContext}
+
+PREGUNTA DEL USUARIO:
+$question
+''';
+
+    final uri = Uri.parse(endpoint);
+    final headers = <String, String>{
+      'Content-Type': 'application/json',
+      if (apiKey.isNotEmpty) 'Authorization': 'Bearer $apiKey',
+    };
+
+    Map<String, dynamic> body;
+    if (endpoint.contains('/chat/completions')) {
+      body = {
+        'model': model,
+        'messages': [
+          {'role': 'system', 'content': systemPrompt},
+          {'role': 'user', 'content': userPrompt},
+        ],
+        'temperature': 0.2,
+      };
+    } else {
+      // Formato nativo Ollama /api/generate
+      body = {
+        'model': model,
+        'system': systemPrompt,
+        'prompt': userPrompt,
+        'stream': false,
+      };
+    }
+
+    final response = await http
+        .post(uri, headers: headers, body: jsonEncode(body))
+        .timeout(const Duration(seconds: 40));
+
+    if (response.statusCode >= 200 && response.statusCode < 300) {
+      final jsonResponse = jsonDecode(utf8.decode(response.bodyBytes));
+      String content = '';
+      if (jsonResponse is Map<String, dynamic>) {
+        if (jsonResponse.containsKey('choices') && jsonResponse['choices'] is List) {
+          final choices = jsonResponse['choices'] as List;
+          if (choices.isNotEmpty && choices[0] is Map) {
+            content = choices[0]['message']?['content'] ?? '';
+          }
+        } else if (jsonResponse.containsKey('response')) {
+          content = jsonResponse['response']?.toString() ?? '';
+        }
+      }
+
+      final trimmed = content.trim();
+      if (trimmed.isNotEmpty) {
+        return trimmed;
+      }
+      throw 'El modelo devolvió una respuesta vacía.';
+    } else {
+      FileLogger.log('[ChatAiQueryService] HTTP ${response.statusCode}: ${response.body}');
+      throw 'Error en el servidor de IA (${response.statusCode}): ${response.reasonPhrase ?? response.body}';
+    }
+  }
+}
