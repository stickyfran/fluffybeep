diff --git a/lib/pages/merge_contact_picker/merge_contact_picker.dart b/lib/pages/merge_contact_picker/merge_contact_picker.dart
new file mode 100644
index 0000000000000000000000000000000000000000..57591c5ab6330957c8988c2ee0a67f743a6d1e54
--- /dev/null
+++ b/lib/pages/merge_contact_picker/merge_contact_picker.dart
@@ -0,0 +1,950 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:collection';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import '../../config/themes.dart';
+import '../../utils/beeper_bridge_utils.dart';
+import '../../utils/beeper_merge_utils.dart';
+import '../../utils/beeper_phone_contacts.dart';
+import '../../utils/beeper_fuzzy_matcher.dart';
+import '../../widgets/avatar.dart';
+import '../../widgets/matrix.dart';
+
+Future<void> showMergeContactPicker(BuildContext context, [Room? initialRoom]) async {
+  final client = initialRoom?.client ?? Matrix.of(context).client;
+  await showModalBottomSheet<void>(
+    context: context,
+    isScrollControlled: true,
+    backgroundColor: Colors.transparent,
+    builder: (ctx) => MergeContactPicker(initialRoom: initialRoom, client: client),
+  );
+}
+
+class MergeContactPicker extends StatefulWidget {
+  final Room? initialRoom;
+  final Client client;
+
+  const MergeContactPicker({
+    super.key,
+    this.initialRoom,
+    required this.client,
+  });
+
+  @override
+  State<MergeContactPicker> createState() => _MergeContactPickerState();
+}
+
+class _MergePickerRoomItem {
+  final Room room;
+  final String displayName;
+  final String? accountHandle;
+  final String searchKey;
+  final BeeperNetwork? network;
+  final Uri? avatarUrl;
+  final double similarity;
+
+  const _MergePickerRoomItem({
+    required this.room,
+    required this.displayName,
+    this.accountHandle,
+    required this.searchKey,
+    required this.network,
+    required this.avatarUrl,
+    this.similarity = 0.0,
+  });
+
+  _MergePickerRoomItem copyWith({
+    double? similarity,
+  }) => _MergePickerRoomItem(
+    room: room,
+    displayName: displayName,
+    accountHandle: accountHandle,
+    searchKey: searchKey,
+    network: network,
+    avatarUrl: avatarUrl,
+    similarity: similarity ?? this.similarity,
+  );
+}
+
+class _MergeContactPickerState extends State<MergeContactPicker> {
+  final Set<String> _selectedRoomIds = <String>{};
+  final TextEditingController _searchController = TextEditingController();
+  final TextEditingController _nameController = TextEditingController();
+  final ValueNotifier<String> _searchFilterNotifier = ValueNotifier<String>('');
+  Timer? _searchDebounceTimer;
+
+  String? _matchedPhoneContactId;
+  bool _isLoadingContacts = false;
+  bool _isSaving = false;
+  bool _isUnmerging = false;
+  String? _existingMergeId;
+
+  List<_MergePickerRoomItem> _allRoomItems = const [];
+  List<List<Room>> _suggestions = const [];
+
+  @override
+  void initState() {
+    super.initState();
+    final client = widget.client;
+
+    if (widget.initialRoom != null) {
+      _existingMergeId = BeeperMergeUtils.getMergeIdForRoom(widget.initialRoom!.id);
+      if (_existingMergeId != null) {
+        final siblings = BeeperMergeUtils.getSiblingRooms(widget.initialRoom!.id);
+        for (final s in siblings) {
+          _selectedRoomIds.add(s.id);
+        }
+        final mc = BeeperMergeUtils.getMergedContacts(client)[_existingMergeId];
+        if (mc != null) {
+          _nameController.text = mc.displayName;
+          _matchedPhoneContactId = mc.phoneContactId;
+        }
+      } else {
+        _selectedRoomIds.add(widget.initialRoom!.id);
+        final initialData = BeeperBridgeUtils.getRoomData(widget.initialRoom!);
+        _nameController.text = initialData.displayName ?? widget.initialRoom!.name;
+      }
+    }
+
+    // Build base room items immediately in < 2ms without heavy fuzzy matching or participant loading
+    _buildFastRoomItems();
+
+    _searchController.addListener(() {
+      _searchDebounceTimer?.cancel();
+      _searchDebounceTimer = Timer(const Duration(milliseconds: 250), () {
+        if (!mounted) return;
+        final text = _searchController.text.trim().toLowerCase();
+        if (_searchFilterNotifier.value != text) {
+          _searchFilterNotifier.value = text;
+        }
+      });
+    });
+
+    // Run heavy analysis (phone matching, suggestions, similarities) asynchronously
+    // after the bottom sheet has smoothly animated into view.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) {
+        _loadBackgroundAnalysis();
+      }
+    });
+  }
+
+  static List<_MergePickerRoomItem>? _cachedGlobalRoomItems;
+  static int _cachedGlobalRoomCount = 0;
+
+  static void invalidateRoomItemsCache() {
+    _cachedGlobalRoomItems = null;
+    _cachedGlobalRoomCount = 0;
+  }
+
+  void _buildFastRoomItems() {
+    final client = widget.client;
+    final nonSpaceRooms = client.rooms.where((r) => !r.isSpace).toList();
+
+    List<_MergePickerRoomItem> items;
+    if (_cachedGlobalRoomItems != null && _cachedGlobalRoomCount == nonSpaceRooms.length) {
+      items = List<_MergePickerRoomItem>.from(_cachedGlobalRoomItems!);
+    } else {
+      items = <_MergePickerRoomItem>[];
+      for (final room in nonSpaceRooms) {
+        final data = BeeperBridgeUtils.getRoomData(room);
+        final dName = data.displayName ?? room.name;
+        final net = BeeperBridgeUtils.getRoomNetwork(room);
+        final handle = BeeperBridgeUtils.getAccountHandle(room);
+        final searchKey = '${dName.toLowerCase()} ${room.name.toLowerCase()} ${handle?.toLowerCase() ?? ''} ${(data.networkKey ?? '').toLowerCase()} ${room.id.toLowerCase()}';
+
+        items.add(_MergePickerRoomItem(
+          room: room,
+          displayName: dName,
+          accountHandle: handle,
+          searchKey: searchKey,
+          network: net,
+          avatarUrl: data.avatarUrl,
+          similarity: 0.0,
+        ));
+      }
+      _cachedGlobalRoomItems = List<_MergePickerRoomItem>.from(items);
+      _cachedGlobalRoomCount = nonSpaceRooms.length;
+    }
+
+    _sortRoomItems(items);
+    _allRoomItems = items;
+  }
+
+  void _sortRoomItems(List<_MergePickerRoomItem> items) {
+    items.sort((a, b) {
+      final aSelected = _selectedRoomIds.contains(a.room.id);
+      final bSelected = _selectedRoomIds.contains(b.room.id);
+      if (aSelected && !bSelected) return -1;
+      if (!aSelected && bSelected) return 1;
+      if (aSelected && bSelected) {
+        return a.displayName.toLowerCase().compareTo(b.displayName.toLowerCase());
+      }
+
+      final aHasSim = a.similarity >= 0.20;
+      final bHasSim = b.similarity >= 0.20;
+      if (aHasSim && !bHasSim) return -1;
+      if (!aHasSim && bHasSim) return 1;
+      if (aHasSim && bHasSim) {
+        final diff = b.similarity.compareTo(a.similarity);
+        if (diff != 0) return diff;
+      }
+
+      return a.displayName.toLowerCase().compareTo(b.displayName.toLowerCase());
+    });
+  }
+
+  Future<void> _loadBackgroundAnalysis() async {
+    // 1. Wait for bottom sheet transition animation to finish smoothly
+    await Future.delayed(const Duration(milliseconds: 200));
+    if (!mounted) return;
+
+    // 2. Check phone contact match if phone contacts are already loaded
+    if (BeeperPhoneContacts.isLoaded) {
+      _checkPhoneMatch();
+      if (mounted) setState(() {});
+    }
+
+    // 3. Compute suggestions (instant if cached)
+    _computeSuggestions();
+    if (mounted && _suggestions.isNotEmpty) {
+      setState(() {});
+    }
+
+    // 4. Compute similarities progressively (instant if cached)
+    await _updateSimilaritiesAsync();
+  }
+
+  Future<void> _updateSimilaritiesAsync() async {
+    final client = widget.client;
+    final sourceRooms = _selectedRoomIds.isNotEmpty
+        ? _selectedRoomIds
+            .map((id) => client.getRoomById(id))
+            .whereType<Room>()
+            .toList()
+        : (widget.initialRoom != null ? [widget.initialRoom!] : <Room>[]);
+
+    if (sourceRooms.isEmpty) return;
+
+    final updatedItems = List<_MergePickerRoomItem>.from(_allRoomItems);
+    bool hasAnySim = false;
+
+    for (var i = 0; i < updatedItems.length; i++) {
+      if (i > 0 && i % 30 == 0) {
+        await Future.delayed(const Duration(milliseconds: 1));
+        if (!mounted) return;
+      }
+
+      final item = updatedItems[i];
+      if (_selectedRoomIds.contains(item.room.id)) continue;
+
+      var maxSim = 0.0;
+      for (final sRoom in sourceRooms) {
+        final sim = BeeperFuzzyMatcher.computeRoomSimilarity(sRoom, item.room);
+        if (sim > maxSim) maxSim = sim;
+      }
+
+      if (maxSim > 0.0) {
+        hasAnySim = true;
+        updatedItems[i] = item.copyWith(similarity: maxSim);
+      }
+    }
+
+    if (hasAnySim && mounted) {
+      _sortRoomItems(updatedItems);
+      setState(() {
+        _allRoomItems = updatedItems;
+      });
+    }
+  }
+
+  void _computeSuggestions() {
+    final client = widget.client;
+    _suggestions = BeeperMergeUtils.getSuggestedMerges(
+      client,
+      BeeperPhoneContacts.isLoaded ? BeeperPhoneContacts.contacts : null,
+    );
+  }
+
+  Future<void> _initPhoneContacts() async {
+    if (BeeperPhoneContacts.isLoaded) {
+      _checkPhoneMatch();
+      _computeSuggestions();
+      if (mounted) setState(() {});
+    }
+  }
+
+  void _checkPhoneMatch() {
+    if (_matchedPhoneContactId != null) return;
+    for (final rId in _selectedRoomIds) {
+      final room = widget.client.getRoomById(rId);
+      if (room == null) continue;
+      final beeperData = BeeperBridgeUtils.getRoomData(room);
+
+      // 1. Try extracted WhatsApp phone
+      final phone = BeeperBridgeUtils.extractWhatsAppPhone(room);
+      if (phone != null && phone.isNotEmpty) {
+        final pc = BeeperPhoneContacts.findByPhone(phone);
+        if (pc != null) {
+          _matchedPhoneContactId = pc.id;
+          if (_nameController.text.isEmpty || (widget.initialRoom != null && _nameController.text == widget.initialRoom!.name)) {
+            _nameController.text = pc.displayName;
+          }
+          break;
+        }
+      }
+
+      // 2. Try contactId if available
+      final contactId = beeperData.contactId ?? room.directChatMatrixID;
+      if (contactId != null) {
+        final p = BeeperMergeUtils.extractPhoneFromMxid(contactId);
+        if (p != null) {
+          final pc = BeeperPhoneContacts.findByPhone(p);
+          if (pc != null) {
+            _matchedPhoneContactId = pc.id;
+            if (_nameController.text.isEmpty || (widget.initialRoom != null && _nameController.text == widget.initialRoom!.name)) {
+              _nameController.text = pc.displayName;
+            }
+            break;
+          }
+        }
+      }
+
+      // 3. Try match by room name or display name in phone contacts
+      final dName = beeperData.displayName ?? room.name;
+      if (dName.isNotEmpty) {
+        final pc = BeeperPhoneContacts.findByName(dName);
+        if (pc != null) {
+          _matchedPhoneContactId = pc.id;
+          if (_nameController.text.isEmpty || (widget.initialRoom != null && _nameController.text == widget.initialRoom!.name)) {
+            _nameController.text = pc.displayName;
+          }
+          break;
+        }
+      }
+    }
+  }
+
+  Future<void> _pickPhoneContact() async {
+    if (!BeeperPhoneContacts.isLoaded) {
+      await _requestPhonePermission();
+      if (!BeeperPhoneContacts.isLoaded) return;
+    }
+
+    final contacts = BeeperPhoneContacts.contacts;
+    if (contacts.isEmpty) {
+      if (!mounted) return;
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('No se encontraron contactos en la libreta.')),
+      );
+      return;
+    }
+
+    final selected = await showModalBottomSheet<CachedPhoneContact>(
+      context: context,
+      isScrollControlled: true,
+      backgroundColor: Theme.of(context).colorScheme.surface,
+      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
+      builder: (sheetContext) {
+        String filter = '';
+        return StatefulBuilder(
+          builder: (ctx, setSheetState) {
+            final filtered = filter.isEmpty
+                ? contacts
+                : contacts.where((c) {
+                    final q = filter.toLowerCase();
+                    return c.displayName.toLowerCase().contains(q) ||
+                        c.normalizedPhones.any((p) => p.contains(q));
+                  }).toList();
+
+            return Container(
+              height: MediaQuery.sizeOf(ctx).height * 0.75,
+              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
+              child: Column(
+                children: [
