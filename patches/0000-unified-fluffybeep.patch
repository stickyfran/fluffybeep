+      await tester.pump(const Duration(milliseconds: 500));
+    }
+  }
+
+  Future<Finder> _ensureVisible(Object object, {int? index}) async {
+    var finder = object.toFinder();
+    if (finder.evaluate().isEmpty) await waitFor(object);
