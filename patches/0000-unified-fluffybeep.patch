+                            onChanged: controller.isLoading
+                                ? null
+                                : rule.ruleId != '.m.rule.master' &&
+                                      Matrix.of(
+                                        context,
+                                      ).client.allPushNotificationsMuted
+                                ? null
+                                : (_) => controller.togglePushRule(
+                                    category.kind,
+                                    rule,
+                                  ),
+                          ),
+                        ),
+                      Divider(color: theme.dividerColor),
+                    ],
+                  if (Platform.isAndroid) ...[
+                    StatefulBuilder(
+                      builder: (context, setTileState) {
+                        return FutureBuilder<bool>(
+                          future: BackgroundPush.isIgnoringBatteryOptimizations(),
+                          builder: (context, snapshot) {
+                            final isExempted = snapshot.data ?? true;
+                            return Column(
+                              mainAxisSize: MainAxisSize.min,
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                ListTile(
+                                  title: Text(
+                                    'Segundo plano y Batería',
+                                    style: TextStyle(
+                                      color: theme.colorScheme.secondary,
+                                      fontWeight: FontWeight.bold,
+                                    ),
+                                  ),
+                                ),
+                                ListTile(
+                                  leading: Icon(
+                                    isExempted ? Icons.battery_charging_full : Icons.battery_alert,
+                                    color: isExempted ? Colors.green : Colors.orange,
+                                  ),
+                                  title: Text(
+                                    isExempted
+                                        ? 'Sin restricciones de batería ✓'
+                                        : 'Restricciones de batería activas',
+                                  ),
+                                  subtitle: Text(
+                                    isExempted
+                                        ? 'Las notificaciones llegarán sin demora en segundo plano.'
+                                        : 'Android puede demorar o silenciar notificaciones con la pantalla apagada. Toca para desactivar la optimización.',
+                                  ),
+                                  trailing: isExempted
+                                      ? null
+                                      : const Icon(Icons.chevron_right),
+                                  onTap: isExempted
+                                      ? null
+                                      : () async {
+                                          await BackgroundPush.requestBatteryOptimizationExemption();
+                                          setTileState(() {});
+                                        },
+                                ),
+                                Divider(color: theme.dividerColor),
+                              ],
+                            );
+                          },
+                        );
