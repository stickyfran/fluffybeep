diff --git a/lib/utils/beeper_bridge_utils.dart b/lib/utils/beeper_bridge_utils.dart
new file mode 100644
index 0000000..962894e
--- /dev/null
+++ b/lib/utils/beeper_bridge_utils.dart
@@ -0,0 +1,753 @@
+import 'dart:typed_data';
+
+import 'package:fluffychat/widgets/future_loading_dialog.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'file_logger.dart';
+
+class BeeperRoomData {
+  final String? contactId;
+  final bool isFakeDM;
+  final Uri? avatarUrl;
+  final String? displayName;
+  final String? networkKey;
+  final bool fromCache;
+
+  const BeeperRoomData({
+    this.contactId,
+    this.isFakeDM = false,
+    this.avatarUrl,
+    this.displayName,
+    this.networkKey,
+    this.fromCache = false,
+  });
+}
+
+class BeeperBridgeUtils {
+  // --- INICIO SISTEMA DE CACHÉ PERSISTENTE ---
+  static SharedPreferences? prefs;
+
+  static void initCacheWithPrefs(SharedPreferences sharedPrefs) {
+    FileLogger.log('[BeeperBridgeUtils] initCacheWithPrefs called');
+    prefs = sharedPrefs;
+  }
+
+  static void saveName(String roomId, String name) {
+    if (prefs == null) return;
+    final key = 'beeper_name_$roomId';
+    if (prefs!.getString(key) != name) {
+      prefs!.setString(key, name);
+    }
+  }
+
+  static String? getCachedName(String roomId) {
+    return prefs?.getString('beeper_name_$roomId');
+  }
+
+  static void saveAvatar(String roomId, String url) {
+    if (prefs == null) return;
+    final key = 'beeper_avatar_$roomId';
+    if (prefs!.getString(key) != url) {
+      prefs!.setString(key, url);
+    }
+  }
+
+  static String? getCachedAvatar(String roomId) {
+    return prefs?.getString('beeper_avatar_$roomId');
+  }
+
+  static void saveContactId(String roomId, String contactId) {
+    if (prefs == null) return;
+    final key = 'beeper_contact_$roomId';
+    if (prefs!.getString(key) != contactId) {
+      prefs!.setString(key, contactId);
+    }
+  }
+
+  static String? getCachedContactId(String roomId) {
+    return prefs?.getString('beeper_contact_$roomId');
+  }
+
+  static void saveIsFakeDM(String roomId, bool isFake) {
+    if (prefs == null) return;
+    final key = 'beeper_isfakedm_$roomId';
+    if (prefs!.getBool(key) != isFake) {
+      prefs!.setBool(key, isFake);
+    }
+  }
+
+  static bool? getCachedIsFakeDM(String roomId) {
+    return prefs?.getBool('beeper_isfakedm_$roomId');
+  }
+
+  /// Caché de red Beeper (clave como 'whatsapp', 'instagram', etc.)
+  static void saveRoomNetwork(String roomId, String networkKey) {
+    if (prefs == null) return;
+    final key = 'beeper_net_$roomId';
+    if (prefs!.getString(key) != networkKey) {
+      prefs!.setString(key, networkKey);
+    }
+  }
+
+  static String? getCachedRoomNetwork(String roomId) {
+    return prefs?.getString('beeper_net_$roomId');
+  }
+
+  /// Caché de timestamp del último mensaje real (en milisegundos desde epoch)
+  static void saveLastTimestamp(String roomId, int milliseconds) {
+    if (prefs == null) return;
+    prefs!.setInt('beeper_ts_$roomId', milliseconds); // siempre sobreescribir
+  }
+
+  static int? getCachedLastTimestamp(String roomId) {
+    return prefs?.getInt('beeper_ts_$roomId');
+  }
+
+  static void preloadCacheFromDisk(SharedPreferences sharedPrefs, List<String> roomIds) {
+    prefs = sharedPrefs;
+    for (final roomId in roomIds) {
+      final name = prefs!.getString('beeper_name_$roomId');
+      final avatar = prefs!.getString('beeper_avatar_$roomId');
+      final contact = prefs!.getString('beeper_contact_$roomId');
+      final isFake = prefs!.getBool('beeper_isfakedm_$roomId');
+      final network = prefs!.getString('beeper_net_$roomId');
+      
+      if (name != null || avatar != null || contact != null) {
+        _roomDataCache[roomId] = BeeperRoomData(
+          contactId: contact,
+          isFakeDM: isFake ?? false,
+          avatarUrl: avatar != null ? Uri.tryParse(avatar) : null,
+          displayName: name,
+          networkKey: network,
+          fromCache: true,
+        );
+        _roomDataSignatures[roomId] = -1; // Special hash value for preloaded entries
+      }
+    }
+  }
+  // --- FIN SISTEMA DE CACHÉ PERSISTENTE ---
+
+  /// Caché en RAM — O(1) lookup, invalidada por sync
+  static final Map<String, BeeperRoomData> _roomDataCache = {};
+  static final Map<String, int> _roomDataSignatures = {};
+
+  static int _getRoomSignature(Room room) {
+    final lastEventId = room.lastEvent?.eventId?.hashCode ?? 0;
+    final memberCount = room.states['m.room.member']?.length ?? 0;
+    final nameEvent = room.states['m.room.name']?.values.firstOrNull;
+    final nameEventSig = nameEvent != null ? nameEvent.content.hashCode : 0;
+    final avatarEvent = room.states['m.room.avatar']?.values.firstOrNull;
+    final avatarEventSig = avatarEvent != null ? avatarEvent.content.hashCode : 0;
+    return Object.hash(lastEventId, memberCount, nameEventSig, avatarEventSig);
+  }
+
+  /// Cola de escrituras diferidas a SharedPreferences
+  static final Map<String, BeeperRoomData> _pendingDiskWrites = {};
+  static bool _diskFlushScheduled = false;
+
+  static void _scheduleDiskFlush() {
+    if (_diskFlushScheduled || prefs == null) return;
+    _diskFlushScheduled = true;
+    Future.delayed(const Duration(seconds: 2), _flushToDisk);
+  }
+
+  static Future<void> _flushToDisk() async {
+    _diskFlushScheduled = false;
+    if (prefs == null || _pendingDiskWrites.isEmpty) return;
+
+    final batch = Map<String, BeeperRoomData>.from(_pendingDiskWrites);
+    _pendingDiskWrites.clear();
+
+    for (final entry in batch.entries) {
+      final roomId = entry.key;
+      final d = entry.value;
+      if (d.contactId != null) saveContactId(roomId, d.contactId!);
+      saveIsFakeDM(roomId, d.isFakeDM);
+      if (d.networkKey != null) saveRoomNetwork(roomId, d.networkKey!);
+      if (d.displayName != null) saveName(roomId, d.displayName!);
+      if (d.avatarUrl != null) saveAvatar(roomId, d.avatarUrl.toString());
+    }
+  }
+
+  /// Obtener todos los datos Beeper de una sala (RAM cache first with signature check)
+  static BeeperRoomData getRoomData(Room room) {
+    final sig = _getRoomSignature(room);
+    final cachedSig = _roomDataSignatures[room.id];
+    if (cachedSig == sig) {
+      final cached = _roomDataCache[room.id];
+      if (cached != null) return cached;
+    }
+
+    final data = _computeRoomData(room);
+    _roomDataCache[room.id] = data;
+    _roomDataSignatures[room.id] = sig;
+
+    // Solo persistir si los datos son frescos (no leídos ya de la caché)
+    if (!data.fromCache) {
+      _pendingDiskWrites[room.id] = data;
+      _scheduleDiskFlush();
+    }
+
+    return data;
+  }
+
+  static void invalidateAllRoomCaches() {
+    _roomDataCache.clear();
+    _roomDataSignatures.clear();
+  }
+
+  static BeeperRoomData _computeRoomData(Room room) {
+    // Logging removed from hot path to improve scroll performance.
+    final memberStates = room.states['m.room.member'];
+    String? contactId;
+    String? networkKey;
+    int activeMembers = 0;
+    bool onlyBotLoaded = false;
+
+    // 1. Una sola iteración sobre memberStates
+    if (memberStates != null && memberStates.isNotEmpty) {
+      bool foundBot = false;
+      for (final entry in memberStates.entries) {
+        final mxid = entry.key;
+        final membership = entry.value.content.tryGet<String>('membership');
+        if (membership != 'join' && membership != 'invite') continue;
+        activeMembers++;
+        if (mxid == room.client.userID) continue;
+
+        // Detectar red del participante
+        if (networkKey == null) {
+          final localpart = mxid.split(':').first.toLowerCase();
+          if (localpart.startsWith('@')) {
+            final rawPrefix = localpart.substring(1);
+            for (final netEntry in networkMap.entries) {
+              if (rawPrefix.startsWith('${netEntry.key}_') ||
+                  rawPrefix == '${netEntry.key}bot') {
+                networkKey = getBaseNetworkKey(netEntry.key);
+                break;
+              }
+            }
+          }
+        }
+
+        // Clasificar: bot o contacto real
+        if (isBeeperBot(mxid)) {
+          foundBot = true;
+        } else {
+          contactId = mxid;
+        }
+      }
+
+      // Detector de datos incompletos en el primer sync
+      if (foundBot && contactId == null && activeMembers <= 2) {
+        onlyBotLoaded = true;
+      }
+    }
+
+    // 2. Si no hay miembros o sólo se cargó el bot de puente de Beeper, rescatar de la caché
+    if (onlyBotLoaded || memberStates == null || memberStates.isEmpty) {
+      final cachedContactId = getCachedContactId(room.id);
+      final cachedIsFakeDM = getCachedIsFakeDM(room.id);
+      final cachedName = getCachedName(room.id);
+      final cachedAvatar = getCachedAvatar(room.id);
+      final cachedNetwork = getCachedRoomNetwork(room.id);
+
+      if (cachedContactId != null || cachedIsFakeDM != null) {
+        return BeeperRoomData(
+          contactId: cachedContactId,
+          isFakeDM: cachedIsFakeDM ?? false,
+          avatarUrl: cachedAvatar != null ? Uri.tryParse(cachedAvatar) : null,
+          displayName: cachedName,
+          networkKey: cachedNetwork ?? networkKey,
+          fromCache: true,
+        );
+      }
+    }
+
+    // 3. Si hay datos válidos completos, calcular valores vivos
+    final hasRoomName = room.states['m.room.name']
+        ?.values.firstOrNull?.content
+        .tryGet<String>('name')?.trim().isNotEmpty == true;
+
+    final isFakeDM = !hasRoomName && activeMembers > 0
+        && activeMembers <= 3 && contactId != null;
+
+    // Avatar
+    Uri? avatarUrl;
+    final avatarEvent = room.states['m.room.avatar']?.values.firstOrNull;
+    final urlStr = avatarEvent?.content.tryGet<String>('url');
+    if (urlStr != null && urlStr.trim().isNotEmpty) {
+      avatarUrl = Uri.tryParse(urlStr);
+    } else if (contactId != null && memberStates != null) {
+      final memberAvatar = memberStates[contactId]
+          ?.content.tryGet<String>('avatar_url');
+      if (memberAvatar != null && memberAvatar.trim().isNotEmpty) {
+        avatarUrl = Uri.tryParse(memberAvatar);
+      }
+    }
+    // Firewall: si es DM falso sin avatar propio, devolver null para evitar el logo del bot
+    if (avatarUrl == null && !isFakeDM) {
+      avatarUrl = room.avatar;
+    }
+
+    // DisplayName
+    String? displayName;
+    if (hasRoomName) {
+      displayName = room.states['m.room.name']!
+          .values.first.content.tryGet<String>('name')!.trim();
+    } else if (contactId != null && memberStates != null) {
+      final dn = memberStates[contactId]
+          ?.content.tryGet<String>('displayname');
+      if (dn != null && dn.trim().isNotEmpty) {
+        displayName = dn;
+      } else {
+        displayName = contactId.split(':').first.replaceAll('@', '');
+      }
+    }
+
+    // Network fallback
+    if (networkKey == null) {
+      final directId = room.directChatMatrixID;
+      if (directId != null) {
+        final localpart = directId.split(':').first.toLowerCase();
+        if (localpart.startsWith('@')) {
+          final rawPrefix = localpart.substring(1);
+          for (final netEntry in networkMap.entries) {
+            if (rawPrefix.startsWith('${netEntry.key}_') ||
+                rawPrefix == '${netEntry.key}bot') {
+              networkKey = getBaseNetworkKey(netEntry.key);
+              break;
+            }
+          }
+        }
+      }
+    }
+
+    return BeeperRoomData(
+      contactId: contactId,
+      isFakeDM: isFakeDM,
+      avatarUrl: avatarUrl,
+      displayName: displayName,
+      networkKey: networkKey,
+    );
+  }
+
+  static final Map<String, Event> lastRealMessageCache = {};
+
+  static bool isBeeperBot(String userId) {
+    final localpart = userId.split(':').first.toLowerCase();
+    return localpart.endsWith('bot') && userId.contains('beeper');
+  }
+
+  static bool isFakeDM(Room room) => room.isBeeperFakeDM;
+
+  static User? getRealContactFromFakeDM(Room room) {
+    if (!isFakeDM(room)) return null;
+
+    final directId = room.directChatMatrixID;
+    if (directId != null) {
+      final participant = room
+          .getParticipants()
+          .where((m) => m.id == directId)
+          .firstOrNull;
+      if (participant != null) return participant;
+    }
+
+    final members = room.getParticipants();
+    final clientUserId = room.client.userID;
+
+    for (var member in members) {
+      if (member.id != clientUserId && !isBeeperBot(member.id)) {
+        return member;
+      }
+    }
+
+    for (var member in members) {
+      if (member.id != clientUserId) {
+        return member;
+      }
+    }
+
+    return null;
+  }
+
+  static const Map<String, BeeperNetSpec> networkMap = {
+    'whatsapp': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'whatsappgo': BeeperNetSpec('WhatsApp', 0xFF25D366),
+    'instagram': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'instagramgo': BeeperNetSpec('Instagram', 0xFFE1306C),
+    'telegram': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'telegramgo': BeeperNetSpec('Telegram', 0xFF2AABEE),
+    'signal': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'signalgo': BeeperNetSpec('Signal', 0xFF3A76F0),
+    'discord': BeeperNetSpec('Discord', 0xFF5865F2),
+    'discordgo': BeeperNetSpec('Discord', 0xFF5865F2),
+    'facebook': BeeperNetSpec('Facebook', 0xFF00B2FF),
+    'facebookgo': BeeperNetSpec('Facebook', 0xFF00B2FF),
+    'slack': BeeperNetSpec('Slack', 0xFF4A154B),
+    'slackgo': BeeperNetSpec('Slack', 0xFF4A154B),
+    'googlechat': BeeperNetSpec('Google Chat', 0xFF34A853),
+    'googlechatgo': BeeperNetSpec('Google Chat', 0xFF34A853),
+  };
+
+  static String getBaseNetworkKey(String key) {
+    if (key.endsWith('go')) {
+      return key.substring(0, key.length - 2);
+    }
+    return key;
+  }
+
+  static BeeperNetwork? getRoomNetwork(Room room) {
+    var key = getRoomData(room).networkKey;
+    if (key == null) return null;
+    key = getBaseNetworkKey(key);
+    if (!networkMap.containsKey(key)) return null;
+    final spec = networkMap[key]!;
+    return BeeperNetwork(spec.name, spec.colorHex, key);
+  }
+
+
+  static Future<void> addStickerToWhatsappPack(BuildContext context, Event event) async {
+    final client = event.room.client;
+    final messenger = ScaffoldMessenger.of(context);
+
+    final result = await showFutureLoadingDialog<Uri?>(
+      context: context,
+      future: () async {
+        final MatrixFile matrixFile = await event.downloadAndDecryptAttachment();
+        final String filename = event.content['body']?.toString() ?? 'sticker';
+        final rawInfo = event.content['info'];
+        final String mimetype = (rawInfo is Map) ? (rawInfo['mimetype']?.toString() ?? 'image/png') : 'image/png';
+        final uri = await client.uploadContent(
+          matrixFile.bytes,
+          filename: filename,
+          contentType: mimetype,
+        );
+        return uri;
+      },
+    );
+
+    final mxcUri = result.result;
+    if (mxcUri == null) {
+      messenger.showSnackBar(
+        const SnackBar(content: Text('Error al subir el sticker a la cuenta')),
+      );
+      return;
+    }
+
+    try {
+      final accountDataEvent = client.accountData['im.ponies.user_emotes'];
+      Map<String, dynamic> packData;
+      if (accountDataEvent != null) {
+        packData = Map<String, dynamic>.from(accountDataEvent.content);
+      } else {
+        packData = {
+          'images': <String, dynamic>{},
+          'pack': {
+            'display_name': 'Mis stickers',
+            'usage': ['sticker'],
+          },
+        };
+      }
+
+      final images = Map<String, dynamic>.from(packData['images'] ?? <String, dynamic>{});
+      
+      final info = <String, dynamic>{};
+      final rawInfo = event.content['info'];
+      if (rawInfo is Map) {
+        info.addAll(Map<String, dynamic>.from(rawInfo));
+      }
+      
+      if (info['w'] is int && info['h'] is int) {
+        final int w = info['w'];
+        final int h = info['h'];
+        final ratio = w / h;
+        if (w > h) {
+          info['w'] = 256;
+          info['h'] = (256.0 / ratio).round();
+        } else {
+          info['h'] = 256;
+          info['w'] = (ratio * 256.0).round();
+        }
+      }
+
+      final stickerContent = <String, dynamic>{
+        'url': mxcUri.toString(),
+        'info': info,
+        'body': event.content['body'] ?? 'sticker',
+        'usage': ['sticker'],
+      };
+
+      // De-duplication check: if a sticker with the same URL already exists, don't add it again.
+      bool isDuplicate = false;
+      if (images.values.any((val) => val is Map && val['url'] == mxcUri.toString())) {
+        isDuplicate = true;
+      }
+
+      if (!isDuplicate) {
+        final String code = 'sticker_${DateTime.now().millisecondsSinceEpoch}';
+        images[code] = stickerContent;
+        packData['images'] = images;
+
+        await client.setAccountData(
+          client.userID!,
+          'im.ponies.user_emotes',
+          packData,
+        );
+
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Sticker agregado al paquete Mis stickers')),
+        );
+      } else {
+        messenger.showSnackBar(
+          const SnackBar(content: Text('Este sticker ya está en tu paquete')),
+        );
+      }
+    } catch (e) {
+      messenger.showSnackBar(
+        SnackBar(content: Text('Error al guardar el sticker: $e')),
+      );
+    }
+  }
+
+  /// Get all Beeper labels from Account Data.
+  static Map<String, dynamic> getBeeperLabels(Client client) {
+    try {
+      final accountDataEvent = client.accountData['com.beeper.labels'];
+      if (accountDataEvent != null && accountDataEvent.content is Map) {
+        return Map<String, dynamic>.from(accountDataEvent.content);
+      }
+    } catch (e) {
+      Logs().e('Error reading com.beeper.labels: $e');
+    }
+    return {};
+  }
+
+  /// Save Beeper labels map to Account Data.
+  static Future<void> setBeeperLabels(Client client, Map<String, dynamic> labels) async {
+    try {
+      await client.setAccountData(
+        client.userID!,
+        'com.beeper.labels',
+        labels,
+      );
+    } catch (e) {
+      Logs().e('Error saving com.beeper.labels: $e');
+    }
+  }
+
+  /// Check if a room is hidden from the main inbox due to a label with isShownInInbox = false.
+  static bool isRoomHiddenInInbox(Client client, String roomId) {
+    final labels = getBeeperLabels(client);
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map) {
+        final isShown = val['isShownInInbox'];
+        if (isShown == false) {
+          final rooms = val['rooms'];
+          if (rooms is List && rooms.contains(roomId)) {
+            return true;
+          }
+        }
+      }
+    }
+    return false;
+  }
+
+  /// Helper to get hidden networks using a special '_hidden_networks' key in Beeper labels.
+  static List<String> getHiddenNetworks(Client client) {
+    final labels = getBeeperLabels(client);
+    final hiddenEntry = labels['_hidden_networks'];
+    if (hiddenEntry is Map) {
+      final rooms = hiddenEntry['rooms'];
+      if (rooms is List) {
+        return List<String>.from(rooms);
+      }
+    }
+    return [];
+  }
+
+  /// Helper to set hidden networks using a special '_hidden_networks' key in Beeper labels.
+  static Future<void> setHiddenNetworks(Client client, List<String> hiddenKeys) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    labels['_hidden_networks'] = {
+      'title': 'Hidden Networks',
+      'rooms': hiddenKeys,
+      'isShownInInbox': false,
+      'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+    };
+    await setBeeperLabels(client, labels);
+  }
+
+  /// Check if a network is contained (hidden from inbox).
+  static bool isNetworkContained(Client client, String networkKey, String networkName) {
+    final labels = getBeeperLabels(client);
+    for (final val in labels.values) {
+      if (val is Map && val['title'] == networkName) {
+        return val['isShownInInbox'] == false;
+      }
+    }
+    return false;
+  }
+
+  /// Toggle containment of a network.
+  static Future<void> setNetworkContained(Client client, String networkKey, String networkName, bool contained) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    String? foundUuid;
+    Map<String, dynamic>? foundLabel;
+
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map && val['title'] == networkName) {
+        foundUuid = entry.key;
+        foundLabel = Map<String, dynamic>.from(val);
+        break;
+      }
+    }
+
+    final netRooms = client.rooms
+        .where((r) => getRoomNetwork(r)?.key == networkKey)
+        .map((r) => r.id)
+        .toList();
+
+    if (foundLabel != null && foundUuid != null) {
+      foundLabel['isShownInInbox'] = !contained;
+      final existingRooms = List<String>.from(foundLabel['rooms'] ?? []);
+      for (final rId in netRooms) {
+        if (contained) {
+          if (!existingRooms.contains(rId)) existingRooms.add(rId);
+        } else {
+          existingRooms.remove(rId);
+        }
+      }
+      foundLabel['rooms'] = existingRooms;
+      labels[foundUuid] = foundLabel;
+    } else if (contained) {
+      final newUuid = 'label_${DateTime.now().millisecondsSinceEpoch}_$networkKey';
+      labels[newUuid] = {
+        'title': networkName,
+        'rooms': netRooms,
+        'isShownInInbox': false,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await setBeeperLabels(client, labels);
+  }
+
+  /// Check if a tag is contained.
+  static bool isTagContained(Client client, String tag) {
+    final labels = getBeeperLabels(client);
+    final displayName = tag.replaceFirst('u.', '');
+    for (final val in labels.values) {
+      if (val is Map && val['title'] == displayName) {
+        return val['isShownInInbox'] == false;
+      }
+    }
+    return false;
+  }
+
+  /// Toggle containment of a custom tag.
+  static Future<void> setTagContained(Client client, String tag, bool contained) async {
+    final labels = Map<String, dynamic>.from(getBeeperLabels(client));
+    final displayName = tag.replaceFirst('u.', '');
+    String? foundUuid;
+    Map<String, dynamic>? foundLabel;
+
+    for (final entry in labels.entries) {
+      final val = entry.value;
+      if (val is Map && val['title'] == displayName) {
+        foundUuid = entry.key;
+        foundLabel = Map<String, dynamic>.from(val);
+        break;
+      }
+    }
+
+    final tagRooms = client.rooms
+        .where((r) => r.tags.keys.contains(tag))
+        .map((r) => r.id)
+        .toList();
+
+    if (foundLabel != null && foundUuid != null) {
+      foundLabel['isShownInInbox'] = !contained;
+      final existingRooms = List<String>.from(foundLabel['rooms'] ?? []);
+      for (final rId in tagRooms) {
+        if (contained) {
+          if (!existingRooms.contains(rId)) existingRooms.add(rId);
+        } else {
+          existingRooms.remove(rId);
+        }
+      }
+      foundLabel['rooms'] = existingRooms;
+      labels[foundUuid] = foundLabel;
+    } else if (contained) {
+      final newUuid = 'label_${DateTime.now().millisecondsSinceEpoch}_${tag.replaceAll(".", "_")}';
+      labels[newUuid] = {
+        'title': displayName,
+        'rooms': tagRooms,
+        'isShownInInbox': false,
+        'createdAt': DateTime.now().millisecondsSinceEpoch ~/ 1000,
+      };
+    }
+
+    await setBeeperLabels(client, labels);
+  }
+
+  static final Map<String, DateTime> _lastMessageTimeCache = {};
+
+  static DateTime? getLastMessageTime(String roomId) => _lastMessageTimeCache[roomId];
+
+  static void setLastMessageTime(String roomId, DateTime time) {
+    _lastMessageTimeCache[roomId] = time;
+  }
+
+  /// Returns the last real message event in a room, skipping state events
+  /// and other technical events (e.g. m.room.member, m.room.topic, etc.).
+  /// Only returns events of type m.room.message, m.room.encrypted, or m.sticker.
+  ///
+  /// Strategy:
+  ///   1. Walk room.timeline?.events backward (in-memory, already loaded events)
+  ///      for the most accurate result without any DB hit.
+  ///   2. Fall back to room.lastEvent if the timeline is empty or unavailable.
+  static Event? getLastRealMessage(Room room) {
+    const realMessageTypes = {
+      EventTypes.Message,    // m.room.message
+      EventTypes.Encrypted,  // m.room.encrypted
+      EventTypes.Sticker,    // m.sticker
+    };
+
+    // matrix SDK 8.x doesn't expose a room.timeline getter.
+    // Fallback directly to room.lastEvent.
+    final lastEvent = room.lastEvent;
+    if (lastEvent != null && realMessageTypes.contains(lastEvent.type)) {
+      return lastEvent;
+    }
+
+    return null;
+  }
+}
+
+class BeeperNetwork {
+  final String name;
+  final int colorHex;
+  final String key;
+  const BeeperNetwork(this.name, this.colorHex, this.key);
+}
+
+class BeeperNetSpec {
+  final String name;
+  final int colorHex;
+  const BeeperNetSpec(this.name, this.colorHex);
+}
+
+extension RoomBeeperExtension on Room {
+  BeeperRoomData get _beeperData => BeeperBridgeUtils.getRoomData(this);
+
+  String? get beeperContactId => _beeperData.contactId;
+  bool get isBeeperFakeDM => _beeperData.isFakeDM;
+  Uri? get beeperAvatarUrl => _beeperData.avatarUrl;
+
+  String getBeeperDisplayname(MatrixLocalizations locals) {
+    return _beeperData.displayName ?? getLocalizedDisplayname(locals);
+  }
+}
