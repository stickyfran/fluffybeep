@@ -0,0 +1,269 @@
+// SPDX-FileCopyrightText: 2026-Present Contributors to FluffyBeep
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+import '../../config/themes.dart';
+import '../../utils/beeper_bridge_utils.dart';
+import '../../utils/beeper_merge_utils.dart';
+import '../../utils/beeper_phone_contacts.dart';
+import '../../widgets/adaptive_dialogs/show_ok_cancel_alert_dialog.dart';
+import '../../widgets/avatar.dart';
+import '../../widgets/layouts/max_width_body.dart';
+import '../../widgets/matrix.dart';
+import '../merge_contact_picker/merge_contact_picker.dart';
+
+class MergedContactsSettings extends StatefulWidget {
+  const MergedContactsSettings({super.key});
+
+  @override
+  State<MergedContactsSettings> createState() => _MergedContactsSettingsState();
+}
+
+class _MergedContactsSettingsState extends State<MergedContactsSettings> {
+  @override
+  void initState() {
+    super.initState();
+    BeeperMergeUtils.mergeChangeNotifier.addListener(_onMergeChange);
+  }
+
+  @override
+  void dispose() {
+    BeeperMergeUtils.mergeChangeNotifier.removeListener(_onMergeChange);
+    super.dispose();
+  }
+
+  void _onMergeChange() {
+    if (mounted) setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final client = Matrix.of(context).client;
+    final mergedContacts = BeeperMergeUtils.getMergedContacts(client).values.toList();
+
+    return Scaffold(
+      appBar: AppBar(
+        title: const Text('Contactos fusionados'),
+        automaticallyImplyLeading: !FluffyThemes.isColumnMode(context),
+        centerTitle: FluffyThemes.isColumnMode(context),
+      ),
+      floatingActionButton: FloatingActionButton.extended(
+        onPressed: () => _pickRoomToMerge(context, client),
+        icon: const Icon(Icons.add_link),
+        label: const Text('Fusionar chats'),
+      ),
+      body: MaxWidthBody(
+        child: mergedContacts.isEmpty
+            ? Center(
+                child: Padding(
+                  padding: const EdgeInsets.all(32.0),
+                  child: Column(
+                    mainAxisAlignment: MainAxisAlignment.center,
+                    children: [
+                      Icon(
+                        Icons.merge_type,
+                        size: 80,
+                        color: theme.colorScheme.primary.withValues(alpha: 0.5),
+                      ),
+                      const SizedBox(height: 16),
+                      Text(
+                        'No tienes contactos fusionados',
+                        style: theme.textTheme.titleMedium?.copyWith(
+                          fontWeight: FontWeight.bold,
+                        ),
+                      ),
+                      const SizedBox(height: 8),
+                      Text(
+                        'Puedes unificar chats de una misma persona en diferentes redes (WhatsApp, Telegram, Signal, etc.) en una sola conversación.',
+                        textAlign: TextAlign.center,
+                        style: theme.textTheme.bodyMedium?.copyWith(
+                          color: theme.colorScheme.outline,
+                        ),
+                      ),
+                      const SizedBox(height: 24),
+                      FilledButton.icon(
+                        onPressed: () => _pickRoomToMerge(context, client),
+                        icon: const Icon(Icons.add_link),
+                        label: const Text('Unificar un contacto'),
+                      ),
+                    ],
+                  ),
+                ),
+              )
+            : ListView.separated(
+                padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 8),
+                itemCount: mergedContacts.length,
+                separatorBuilder: (_, __) => Divider(color: theme.dividerColor.withValues(alpha: 0.5)),
+                itemBuilder: (context, index) {
+                  final contact = mergedContacts[index];
+                  final rooms = contact.roomIds
+                      .map((id) => client.getRoomById(id))
+                      .whereType<Room>()
+                      .toList();
+
+                  final phoneContact = contact.phoneContactId != null
+                      ? BeeperPhoneContacts.findById(contact.phoneContactId!)
+                      : null;
+
+                  final beeperData = rooms.isNotEmpty ? BeeperBridgeUtils.getRoomData(rooms.first) : null;
+                  final displayName = contact.displayName.isNotEmpty
+                      ? contact.displayName
+                      : (beeperData?.displayName ?? (rooms.isNotEmpty ? rooms.first.name : 'Contacto'));
+
+                  final networks = <BeeperNetwork>[];
+                  final seenNetKeys = <String>{};
+                  for (final r in rooms) {
+                    final net = BeeperBridgeUtils.getRoomNetwork(r);
+                    if (net != null && seenNetKeys.add(net.key)) {
+                      networks.add(net);
+                    }
+                  }
+
+                  return ListTile(
+                    leading: SizedBox(
+                      width: 44,
+                      height: 44,
+                      child: Stack(
+                        clipBehavior: Clip.none,
+                        children: [
+                          if (phoneContact?.thumbnail != null)
+                            ClipRRect(
+                              borderRadius: BorderRadius.circular(22),
+                              child: Image.memory(
+                                phoneContact!.thumbnail!,
+                                width: 44,
+                                height: 44,
+                                fit: BoxFit.cover,
+                              ),
+                            )
+                          else
+                            Avatar(
+                              mxContent: beeperData?.avatarUrl,
+                              name: displayName,
+                              size: 44,
+                            ),
+                          Positioned(
+                            bottom: -1,
+                            right: -1,
+                            child: Row(
+                              mainAxisSize: MainAxisSize.min,
+                              children: networks.take(3).map((net) {
+                                return Container(
+                                  margin: const EdgeInsets.only(left: 1),
+                                  width: 5,
+                                  height: 5,
+                                  decoration: BoxDecoration(
+                                    shape: BoxShape.circle,
+                                    color: Color(net.colorHex),
+                                    border: Border.all(
+                                      color: theme.colorScheme.surface,
+                                      width: 0.8,
+                                    ),
+                                  ),
+                                );
+                              }).toList(),
+                            ),
+                          ),
+                        ],
+                      ),
+                    ),
+                    title: Row(
+                      children: [
+                        Expanded(
+                          child: Text(
+                            displayName,
+                            style: const TextStyle(fontWeight: FontWeight.bold),
+                            maxLines: 1,
+                            overflow: TextOverflow.ellipsis,
+                          ),
+                        ),
+                        Container(
+                          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
+                          decoration: BoxDecoration(
+                            color: theme.colorScheme.primaryContainer,
+                            borderRadius: BorderRadius.circular(8),
+                          ),
+                          child: Text(
+                            '${contact.roomIds.length} chats',
+                            style: TextStyle(
+                              fontSize: 11,
+                              fontWeight: FontWeight.bold,
+                              color: theme.colorScheme.onPrimaryContainer,
+                            ),
+                          ),
+                        ),
+                      ],
+                    ),
+                    subtitle: Text(
+                      rooms.isNotEmpty
+                          ? rooms.map((r) {
+                              final net = BeeperBridgeUtils.getRoomNetwork(r);
+                              return net?.name ?? r.name;
+                            }).join(' • ')
+                          : '${contact.roomIds.length} chats vinculados',
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(color: theme.colorScheme.outline, fontSize: 12),
+                    ),
+                    trailing: PopupMenuButton<String>(
+                      icon: const Icon(Icons.more_vert),
+                      onSelected: (action) async {
+                        if (action == 'edit') {
+                          await showMergeContactPicker(context, rooms.isNotEmpty ? rooms.first : null);
+                          if (mounted) setState(() {});
+                        } else if (action == 'unmerge') {
+                          final consent = await showOkCancelAlertDialog(
+                            context: context,
+                            title: 'Desfusionar contacto',
+                            message: '¿Estás seguro de que quieres separar los chats de "$displayName"?',
+                            okLabel: 'Desfusionar',
+                            isDestructive: true,
+                          );
+                          if (consent == OkCancelResult.ok) {
+                            await BeeperMergeUtils.removeMerge(client, contact.id);
+                            if (mounted) setState(() {});
+                          }
+                        }
+                      },
+                      itemBuilder: (context) => [
+                        const PopupMenuItem(
+                          value: 'edit',
+                          child: Row(
+                            children: [
+                              Icon(Icons.edit_outlined),
+                              SizedBox(width: 12),
+                              Text('Editar chats'),
+                            ],
+                          ),
+                        ),
+                        PopupMenuItem(
+                          value: 'unmerge',
+                          child: Row(
+                            children: [
+                              Icon(Icons.link_off_outlined, color: theme.colorScheme.error),
+                              SizedBox(width: 12),
+                              Text('Desfusionar', style: TextStyle(color: theme.colorScheme.error)),
+                            ],
+                          ),
+                        ),
+                      ],
+                    ),
+                    onTap: () async {
+                      await showMergeContactPicker(context, rooms.isNotEmpty ? rooms.first : null);
+                      if (mounted) setState(() {});
+                    },
+                  );
+                },
+              ),
+      ),
+    );
+  }
+
