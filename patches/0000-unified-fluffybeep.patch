+    }
+    for (final b in resBundles.values) {
+      b.sort(
+        (a, b) => a.bundle!.priority == null
+            ? 1
+            : b.bundle!.priority == null
+            ? -1
+            : a.bundle!.priority!.compareTo(b.bundle!.priority!),
+      );
