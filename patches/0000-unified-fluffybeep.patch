+    } else if (category == 'events') {
+      switch (permissionKey) {
+        case EventTypes.RoomName:
+          return L10n.of(context).changeTheNameOfTheGroup;
+        case EventTypes.RoomTopic:
+          return L10n.of(context).changeTheDescriptionOfTheGroup;
