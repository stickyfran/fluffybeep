+  Future<void> onVoiceMessageSend(
+    String path,
+    int duration,
+    List<int> waveform,
+    String fileName,
+  ) async {
+    if (_isSendingVoiceMessage) return;
+    if (_lastVoiceMessageSentPath == path &&
+        _lastVoiceMessageSentAt != null &&
+        DateTime.now().difference(_lastVoiceMessageSentAt!) <
+            const Duration(seconds: 3)) {
+      Logs().w('Ignoring duplicate voice message send for path $path');
+      return;
+    }
+    _isSendingVoiceMessage = true;
+    try {
+      final proceed = await showTrustUserInRoomDialog(context, room);
+      if (!mounted || !proceed) return;
+      final scaffoldMessenger = ScaffoldMessenger.of(context);
+      final audioFile = XFile(path);
+
+      final bytesResult = await showFutureLoadingDialog(
+        context: context,
+        future: audioFile.readAsBytes,
+      );
+      final bytes = bytesResult.result;
+      if (bytes == null || bytes.isEmpty) {
+        if (mounted) {
+          scaffoldMessenger.showSnackBar(
+            const SnackBar(content: Text('Error: El archivo de audio grabado está vacío.')),
+          );
+        }
+        return;
+      }
+
+      final mimeType = lookupMimeType(fileName, headerBytes: bytes);
+      var effectiveMimeType = mimeType;
+      if (effectiveMimeType == 'audio/ogg' ||
+          (fileName.endsWith('.ogg') &&
+              (effectiveMimeType == null || effectiveMimeType == 'audio/ogg'))) {
+        effectiveMimeType = 'audio/ogg';
+      } else if (fileName.endsWith('.m4a') || fileName.endsWith('.aac') || effectiveMimeType == 'audio/mp4') {
+        effectiveMimeType = 'audio/mp4';
+      } else if (effectiveMimeType == null) {
+        if (fileName.endsWith('.ogg')) {
+          effectiveMimeType = 'audio/ogg';
+        } else {
+          effectiveMimeType = 'audio/mp4';
+        }
+      }
+
+      final extension = mimeType == null ? null : extensionFromMime(mimeType);
+      if (extension != null) {
+        fileName =
+            'voice_message_${DateTime.now().millisecondsSinceEpoch}.$extension';
+      }
+
+      final file = MatrixAudioFile(
+        bytes: bytes,
+        name: fileName,
+        mimeType: effectiveMimeType,
+      );
+
+      try {
+        await room.sendFileEvent(
+          file,
+          inReplyTo: replyEvent,
+          threadRootEventId: activeThreadId,
+          extraContent: {
+            'filename': file.name,
+            'info': {
+              ...file.info,
+              'duration': duration,
+              'size': bytes.length,
+              if (effectiveMimeType != null) 'mimetype': effectiveMimeType,
+            },
+            'org.matrix.msc3245.voice': {},
+            'org.matrix.msc1767.audio': {
+              'duration': duration,
+              'waveform': waveform,
+            },
+          },
+        );
+        _lastVoiceMessageSentPath = path;
+        _lastVoiceMessageSentAt = DateTime.now();
+      } catch (e) {
+        if (!mounted) return;
+        scaffoldMessenger.showSnackBar(
+          SnackBar(content: Text(e.toLocalizedString(context))),
+        );
+        return;
+      }
+      setState(() {
+        replyEvent = null;
+      });
+    } finally {
+      _isSendingVoiceMessage = false;
+    }
+  }
