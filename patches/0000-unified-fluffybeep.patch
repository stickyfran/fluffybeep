diff --git a/update_routes.py b/update_routes.py
new file mode 100644
index 0000000..6363b09
--- /dev/null
+++ b/update_routes.py
@@ -0,0 +1,47 @@
+import re
+
+file_path = 'lib/config/routes.dart'
+with open(file_path, 'r', encoding='utf-8') as f:
+    content = f.read()
+
+if 'deferred_widget.dart' not in content:
+    content = content.replace(
+        "import 'package:flutter/material.dart';",
+        "import 'package:flutter/material.dart';\nimport 'package:fluffychat/widgets/deferred_widget.dart';"
+    )
+
+pages_to_defer = {
+    'settings/patches_settings.dart': ('patches', 'SettingsPatches'),
+    'settings_3pid/settings_3pid.dart': ('settings_3pid', 'Settings3Pid'),
+    'settings_chat/settings_chat.dart': ('settings_chat', 'SettingsChat'),
+    'settings_emotes/settings_emotes.dart': ('settings_emotes', 'SettingsEmotes'),
+    'settings_homeserver/settings_homeserver.dart': ('settings_homeserver', 'SettingsHomeserver'),
+    'settings_ignore_list/settings_ignore_list.dart': ('settings_ignore_list', 'SettingsIgnoreList'),
+    'settings_notifications/settings_notifications.dart': ('settings_notifications', 'SettingsNotifications'),
+    'settings_password/settings_password.dart': ('settings_password', 'SettingsPassword'),
+    'settings_security/settings_security.dart': ('settings_security', 'SettingsSecurity'),
+    'settings_style/settings_style.dart': ('settings_style', 'SettingsStyle'),
+}
+
+for path, (prefix, class_name) in pages_to_defer.items():
+    content = re.sub(
+        r"import 'package:fluffychat/pages/" + re.escape(path) + r"';",
+        f"import 'package:fluffychat/pages/{path}' deferred as {prefix};",
+        content
+    )
+    
+    content = re.sub(
+        r"const " + class_name + r"\(\)",
+        f"DeferredWidget(libraryLoader: {prefix}.loadLibrary, createWidget: () => {prefix}.{class_name}())",
+        content
+    )
+    content = re.sub(
+        r"(?<!\.)" + class_name + r"\(\)",
+        f"DeferredWidget(libraryLoader: {prefix}.loadLibrary, createWidget: () => {prefix}.{class_name}())",
+        content
+    )
+
+with open(file_path, 'w', encoding='utf-8') as f:
+    f.write(content)
+
+print('Updated routes.dart')
