diff --git a/lib/utils/contact_notes_manager.dart b/lib/utils/contact_notes_manager.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9192e1e3367a521f53fd0e6e35c9a17c3d1b2398
--- /dev/null
+++ b/lib/utils/contact_notes_manager.dart
@@ -0,0 +1,122 @@
+// SPDX-FileCopyrightText: 2026-Present FluffyBeep Contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+import 'package:matrix/matrix.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:fluffychat/models/contact_profile.dart';
+import 'file_logger.dart';
+
+/// Gestor de persistencia y sincronización de perfiles y notas privadas en Matrix.
+/// Utiliza `m.room.account_data` bajo el tipo 'im.nheko.contact_notes' / 'com.fluffybeep.contact_profile'
+/// con soporte de fallback y caché local en SharedPreferences para carga instantánea y 0 consumo en background.
+class ContactNotesManager {
+  static const String accountDataType = 'im.nheko.contact_notes';
+  static const String localPrefPrefix = 'contact_profile_';
+
+  static SharedPreferences? _prefs;
+
+  static Future<void> _ensurePrefs() async {
+    _prefs ??= await SharedPreferences.getInstance();
+  }
+
+  /// Lee el perfil desde la caché local en memoria/disco (0 latencia, 0 tráfico de red).
+  static ContactProfile? getCachedProfile(String roomId) {
+    if (_prefs == null) return null;
+    final raw = _prefs!.getString('$localPrefPrefix$roomId');
+    if (raw == null || raw.isEmpty) return null;
+    try {
+      final map = jsonDecode(raw);
+      if (map is Map<String, dynamic>) {
+        return ContactProfile.fromJson(map);
+      }
+    } catch (e) {
+      FileLogger.log('[ContactNotesManager] Error parsing local cache: $e');
+    }
+    return null;
+  }
+
+  /// Carga el perfil: primero retorna caché si existe, y luego sincroniza bajo demanda
+  /// con el Homeserver Matrix de Beeper usando account_data.
+  static Future<ContactProfile> loadProfile(Client client, String roomId) async {
+    await _ensurePrefs();
+    final cached = getCachedProfile(roomId);
+
+    // Intentar leer de accountData en memoria del cliente Matrix si estuviera presente
+    try {
+      final room = client.getRoomById(roomId);
+      final rawAccountData = room?.roomAccountData[accountDataType]?.content;
+      if (rawAccountData != null && rawAccountData.isNotEmpty) {
+        final profile = ContactProfile.fromJson(rawAccountData);
+        _saveToLocalCache(roomId, profile);
+        return profile;
+      }
+    } catch (_) {}
+
+    // Si tenemos datos en caché, devolverlos de inmediato
+    if (cached != null) {
+      return cached;
+    }
+
+    // Petición HTTP on-demand directa al endpoint Matrix si no estaba en caché:
+    // GET /_matrix/client/v3/user/{userId}/rooms/{roomId}/account_data/{type}
+    try {
+      final userId = client.userID;
+      if (userId != null) {
+        final encodedUserId = Uri.encodeComponent(userId);
+        final encodedRoomId = Uri.encodeComponent(roomId);
+        final encodedType = Uri.encodeComponent(accountDataType);
+
+        final response = await client.request(
+          RequestType.GET,
+          '/client/v3/user/$encodedUserId/rooms/$encodedRoomId/account_data/$encodedType',
+        );
+
+        if (response != null && response is Map<String, dynamic>) {
+          final profile = ContactProfile.fromJson(response);
+          _saveToLocalCache(roomId, profile);
+          return profile;
+        }
+      }
+    } catch (e) {
+      FileLogger.log('[ContactNotesManager] On-demand GET failed (no notes yet or offline): $e');
+    }
+
+    return const ContactProfile();
+  }
+
+  /// Guarda el perfil en SharedPreferences y lo sincroniza con Matrix Homeserver.
+  static Future<void> saveProfile(Client client, String roomId, ContactProfile profile) async {
+    await _ensurePrefs();
+
+    // 1. Guardar en almacenamiento local para acceso offline instantáneo
+    _saveToLocalCache(roomId, profile);
+
+    // 2. Guardar en Matrix Homeserver (m.room.account_data)
+    try {
+      final userId = client.userID;
+      if (userId == null) return;
+
+      final encodedUserId = Uri.encodeComponent(userId);
+      final encodedRoomId = Uri.encodeComponent(roomId);
+      final encodedType = Uri.encodeComponent(accountDataType);
+
+      await client.request(
+        RequestType.PUT,
+        '/client/v3/user/$encodedUserId/rooms/$encodedRoomId/account_data/$encodedType',
+        data: profile.toJson(),
+      );
+
+      FileLogger.log('[ContactNotesManager] Saved profile to account_data for room $roomId');
+    } catch (e) {
+      FileLogger.log('[ContactNotesManager] Failed to PUT account_data: $e');
+    }
+  }
+
+  static void _saveToLocalCache(String roomId, ContactProfile profile) {
+    if (_prefs == null) return;
+    final jsonString = jsonEncode(profile.toJson());
+    _prefs!.setString('$localPrefPrefix$roomId', jsonString);
+  }
+}
